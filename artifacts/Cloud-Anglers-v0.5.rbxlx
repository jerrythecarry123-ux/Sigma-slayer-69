      <Item class="ModuleScript" referent="RBX00000009">
        <Properties>
          <string name="Name">FishingConfig</string>
          <ProtectedString name="Source">--!strict
-- Shared presentation/tuning values. The server still owns every attempt.
return table.freeze({
	PreparationTime = 0.8,
	BiteTimeout = 12,
	ChargeLeadTime = 0.3,
	ChargeDuration = 2.8,
	StartCooldown = 0.6,
	MaxDistance = 16,
	RequestCapacity = 12,
	RequestsPerSecond = 5,
	SpeciesName = "Pufflet",
	CreatePrototypeWorld = true,
	EnableSaving = true,
	SaveInStudio = false,
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000A">
        <Properties>
          <string name="Name">FishingRules</string>
          <ProtectedString name="Source">--!strict
-- Pure rules: usable in Roblox and the standalone Luau test runner.
local Rules = {
	NormalMin = 0.22,
	NormalMax = 0.95,
	FineMin = 0.48,
	FineMax = 0.84,
	BrilliantMin = 0.61,
	BrilliantMax = 0.75,
}

function Rules.qualityAt(progress: number): string?
	if progress ~= progress or progress &lt; Rules.NormalMin or progress &gt; Rules.NormalMax then
		return nil
	end
	if progress &gt;= Rules.BrilliantMin and progress &lt;= Rules.BrilliantMax then
		return "Brilliant"
	end
	if progress &gt;= Rules.FineMin and progress &lt;= Rules.FineMax then
		return "Fine"
	end
	return "Normal"
end

return table.freeze(Rules)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000B">
        <Properties>
          <string name="Name">FishModel</string>
          <ProtectedString name="Source">--!strict
local Catalog = require(script.Parent:WaitForChild("FishCatalog"))
local Fish = {}

local function shape(parent: Model, name: string, size: Vector3, position: Vector3, color: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = Enum.PartType.Ball
	part.Size = size
	part.Position = position
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Parent = parent
	return part
end

function Fish.create(parent: Instance, name: string?, speciesId: string?): Model
	local species = Catalog.get(speciesId)
	local bodyColor = Color3.fromRGB(table.unpack(species.Body))
	local finColor = Color3.fromRGB(table.unpack(species.Fin))
	local model = Instance.new("Model")
	model.Name = name or species.Name
	model:SetAttribute("SpeciesId", species.Id)
	local kind = species.Shape
	local size = if kind == "Ray" then Vector3.new(3.8, 0.95, 2.1)
		elseif kind == "Long" or kind == "Lure" then Vector3.new(2.2, 1.5, 2.7) else Vector3.new(2.8, 2, 1.9)
	local body = shape(model, "Body", size, Vector3.zero, bodyColor)
	model.PrimaryPart = body
	shape(model, "Belly", size * Vector3.new(0.75, 0.65, 0.86), Vector3.new(0, -size.Y * 0.18, -0.1),
		bodyColor:Lerp(Color3.new(1, 1, 1), 0.65))
	local front = -size.Z * 0.45
	for _, side in { -1, 1 } do
		local fin = shape(model, "Fin", if kind == "Ray" then Vector3.new(2.4, 0.2, 2.2) else Vector3.new(0.9, 0.22, 1),
			Vector3.new(side * size.X * 0.48, -0.08, 0.2), finColor)
		fin.CFrame *= CFrame.Angles(0, 0, side * 0.22)
		fin:SetAttribute("FinRest", fin.CFrame)
		fin:SetAttribute("Side", side)
		shape(model, "Tail", Vector3.new(0.9, 1, 0.28), Vector3.new(side * 0.32, 0, size.Z * 0.7), finColor)
		shape(model, "EyeWhite", Vector3.new(0.58, 0.6, 0.3), Vector3.new(side * 0.65, size.Y * 0.16, front), Color3.new(1, 1, 1))
		shape(model, "Pupil", Vector3.new(0.27, 0.32, 0.15), Vector3.new(side * 0.65, size.Y * 0.17, front - 0.17), Color3.fromRGB(25, 44, 63))
		shape(model, "EyeGlint", Vector3.new(0.09, 0.11, 0.07), Vector3.new(side * 0.65 - 0.05, size.Y * 0.17 + 0.08, front - 0.25), Color3.new(1, 1, 1))
		shape(model, "Cheek", Vector3.new(0.36, 0.17, 0.15), Vector3.new(side * 0.98, -0.12, front + 0.16), Color3.fromRGB(255, 164, 153))
		if kind == "Whiskers" then
			local whisker = shape(model, "Whisker", Vector3.new(1.1, 0.09, 0.09), Vector3.new(side * 1.12, -0.18, front - 0.03), finColor)
			whisker.CFrame *= CFrame.Angles(0, side * -0.35, side * 0.2)
		end
	end
	shape(model, "Mouth", Vector3.new(0.3, 0.14, 0.16), Vector3.new(0, -0.2, front - 0.18), Color3.fromRGB(81, 59, 61))
	if kind == "Spiky" or kind == "Whiskers" then
		for index = -1, 1 do
			shape(model, "Crown", Vector3.new(0.35, 0.6 - math.abs(index) * 0.15, 0.5), Vector3.new(index * 0.4, size.Y * 0.5, 0.1), finColor)
		end
	elseif kind == "Lure" then
		shape(model, "LureStem", Vector3.new(0.13, 0.9, 0.13), Vector3.new(0, 1, front + 0.2), finColor)
		local lure = shape(model, "LureGlow", Vector3.new(0.45, 0.45, 0.45), Vector3.new(0, 1.5, front + 0.2), finColor)
		lure.Material = Enum.Material.Neon
	end
	model.Parent = parent
	return model
end

function Fish.animate(model: Model, time: number)
	local pivot = model:GetPivot()
	for _, child in model:GetChildren() do
		if child.Name == "Fin" and child:IsA("BasePart") then
			local rest = child:GetAttribute("FinRest")
			local side = child:GetAttribute("Side")
			if typeof(rest) == "CFrame" and typeof(side) == "number" then
				child.CFrame = pivot * rest * CFrame.Angles(0, 0, math.sin(time * 6) * 0.16 * side)
			end
		end
	end
end

return Fish
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000C">
        <Properties>
          <string name="Name">FishCatalog</string>
          <ProtectedString name="Source">--!strict
-- Plain data so server progression can be tested without Roblox services.
export type Species = {
	Id: string, Name: string, Rarity: string, Level: number, Weight: number,
	Coins: number, Body: { number }, Fin: { number }, Shape: string, Hint: string,
}
local Catalog = {}
Catalog.Species = {
	{ Id = "pufflet", Name = "Pufflet", Rarity = "Common", Level = 0, Weight = 40, Coins = 8,
		Body = {255, 206, 99}, Fin = {247, 146, 107}, Shape = "Round", Hint = "A sunny little cloud drifter." },
	{ Id = "mintfin", Name = "Mintfin", Rarity = "Common", Level = 0, Weight = 35, Coins = 9,
		Body = {96, 221, 192}, Fin = {54, 157, 163}, Shape = "Long", Hint = "Follows the coolest cloud currents." },
	{ Id = "emberfin", Name = "Emberfin", Rarity = "Uncommon", Level = 0, Weight = 25, Coins = 12,
		Body = {255, 139, 123}, Fin = {255, 212, 120}, Shape = "Spiky", Hint = "A warm glow beneath the mist." },
	{ Id = "starwhisker", Name = "Starwhisker", Rarity = "Rare", Level = 1, Weight = 16, Coins = 18,
		Body = {182, 164, 249}, Fin = {255, 220, 139}, Shape = "Whiskers", Hint = "Breeze Rod unlocks this stargazer." },
	{ Id = "moonray", Name = "Moonray", Rarity = "Rare", Level = 1, Weight = 12, Coins = 22,
		Body = {124, 184, 249}, Fin = {192, 223, 255}, Shape = "Ray", Hint = "Breeze Rod reaches its quiet current." },
	{ Id = "aurorafin", Name = "Aurorafin", Rarity = "Epic", Level = 2, Weight = 7, Coins = 35,
		Body = {218, 146, 245}, Fin = {110, 241, 226}, Shape = "Lure", Hint = "Nimbus Rod reveals a living aurora." },
} :: { Species }
Catalog.Rods = {
	{ Name = "Driftwood Rod", Cost = 0, Bonus = 0, Description = "Your first three species await." },
	{ Name = "Breeze Rod", Cost = 32, Bonus = 15, Description = "Unlock 2 rare species. Earn 15% more coins." },
	{ Name = "Nimbus Rod", Cost = 90, Bonus = 30, Description = "Unlock Aurorafin. Earn 30% more coins." },
	{ Name = "Aurora Rod", Cost = 160, Bonus = 45, Description = "A golden rod. Earn 45% more coins." },
}
Catalog.Goals = {
	{ Title = "Land your first fish", Kind = "Catches", Target = 1, Reward = 10 },
	{ Title = "Discover 3 different species", Kind = "Species", Target = 3, Reward = 20 },
	{ Title = "Upgrade to the Breeze Rod", Kind = "Rod", Target = 1, Reward = 20 },
	{ Title = "Land a Brilliant catch", Kind = "Brilliant", Target = 1, Reward = 25 },
	{ Title = "Complete your field journal", Kind = "Species", Target = 6, Reward = 50 },
}

function Catalog.get(id: string?): Species
	for _, species in Catalog.Species do
		if species.Id == id then return species end
	end
	return Catalog.Species[1]
end

return Catalog
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX00000004">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX0000000D">
      <Properties>
        <string name="Name">FishingEngine</string>
        <ProtectedString name="Source">--!strict
-- Pure server state machine. Roblox services are kept in FishingService.
type Config = {
	read PreparationTime: number, read BiteTimeout: number, read ChargeLeadTime: number,
	read ChargeDuration: number, read StartCooldown: number, read RequestCapacity: number,
	read RequestsPerSecond: number, read SpeciesName: string,
}
type Attempt = {
	id: number, phase: string, readyAt: number, expiresAt: number, chargeAt: number?,
}
type Session = {
	attempt: Attempt?, catches: number, nextStart: number, tokens: number,
	tokenTime: number,
	profile: any?,
}
type Packet = { [string]: any }
local Engine = {}
Engine.__index = Engine
type EngineData = {
	config: Config,
	rules: { read qualityAt: (number) -&gt; string? },
	sessions: { [number]: Session },
	sequence: number,
	progression: any?,
}
export type FishingEngine = typeof(setmetatable({} :: EngineData, Engine))

function Engine.new(config: Config, rules: { read qualityAt: (number) -&gt; string? }, progression: any?): FishingEngine
	return setmetatable({ config = config, rules = rules, sessions = {}, sequence = 0, progression = progression }, Engine)
end

function Engine.addPlayer(self: FishingEngine, userId: number, now: number, initialProfile: any?)
	if self.sessions[userId] then return end
	self.sessions[userId] = {
		attempt = nil, catches = 0, nextStart = now,
		tokens = self.config.RequestCapacity, tokenTime = now,
		profile = if self.progression then (if initialProfile then self.progression.copy(initialProfile) else self.progression.create()) else nil,
	}
	if initialProfile then self.sessions[userId].catches = initialProfile.catches end
end

function Engine.exportProfile(self: FishingEngine, userId: number): any?
	local session = self.sessions[userId]
	return if session and session.profile and self.progression then self.progression.copy(session.profile) else nil
end

function Engine.removePlayer(self: FishingEngine, userId: number)
	self.sessions[userId] = nil
end

function Engine.snapshot(self: FishingEngine, userId: number): Packet?
	local session = self.sessions[userId]
	if not session then return nil end
	local packet: Packet = { phase = "Idle", catches = session.catches, nextStart = session.nextStart }
	if self.progression and session.profile then packet.profile = self.progression.snapshot(session.profile) end
	local attempt = session.attempt
	if attempt then
		packet.phase = attempt.phase
		packet.attemptId = attempt.id
		packet.readyAt = attempt.readyAt
		packet.expiresAt = attempt.expiresAt
		packet.chargeAt = attempt.chargeAt
		packet.duration = self.config.ChargeDuration
	end
	return packet
end

function Engine.finish(self: FishingEngine, userId: number, now: number, message: string): Packet
	local session = self.sessions[userId]
	session.attempt = nil
	session.nextStart = now + self.config.StartCooldown
	local packet = self:snapshot(userId) :: Packet
	packet.message = message
	return packet
end

function Engine.interrupt(self: FishingEngine, userId: number, now: number, message: string): Packet?
	local session = self.sessions[userId]
	if not session or not session.attempt then return nil end
	return self:finish(userId, now, message)
end

function Engine.tick(self: FishingEngine, userId: number, now: number, canFish: boolean): Packet?
	local session = self.sessions[userId]
	local attempt = if session then session.attempt else nil
	if not attempt then return nil end
	if not canFish then
		return self:finish(userId, now, "Fishing stopped. Return to the glowing spot on the dock.")
	end
	if now &gt; attempt.expiresAt then
		return self:finish(userId, now, "It swam away. Cast again!")
	end
	return nil
end

function Engine.command(
	self: FishingEngine, userId: number, action: any, attemptId: any, now: number, canFish: boolean
): Packet?
	local session = self.sessions[userId]
	if not session then return nil end
	-- Rate-limit all requests, including malformed and unknown actions.
	session.tokens = math.min(self.config.RequestCapacity,
		session.tokens + math.max(0, now - session.tokenTime) * self.config.RequestsPerSecond)
	session.tokenTime = now
	if session.tokens &lt; 1 then return nil end
	session.tokens -= 1
	if type(action) ~= "string" then return nil end
	if action == "Sync" then return self:snapshot(userId) end
	local aborted = self:tick(userId, now, canFish)
	if aborted then return aborted end
	if action == "Upgrade" and self.progression and session.profile then
		local packet = self:snapshot(userId) :: Packet
		if session.attempt then
			packet.message = "Finish your cast before changing rods."
			return packet
		end
		if type(attemptId) ~= "number" or attemptId ~= session.profile.level then
			packet.message = "Your rod changed. Check the workshop again."
			return packet
		end
		local purchase = self.progression.upgrade(session.profile)
		packet = self:snapshot(userId) :: Packet
		packet.purchase = purchase
		packet.message = purchase.message
		return packet
	end
	if action == "Start" then
		if session.attempt or now &lt; session.nextStart then return self:snapshot(userId) end
		if not canFish then
			local packet = self:snapshot(userId) :: Packet
			packet.message = "Walk to the glowing spot at the end of the dock."
			return packet
		end
		self.sequence += 1
		local readyAt = now + self.config.PreparationTime
		session.attempt = {
			id = self.sequence, phase = "Waiting", readyAt = readyAt,
			expiresAt = readyAt + self.config.BiteTimeout,
		}
		return self:snapshot(userId)
	end
	local attempt = session.attempt
	if not attempt or type(attemptId) ~= "number" or attemptId ~= attempt.id then return nil end
	if action == "Cancel" then
		return self:finish(userId, now, "Cast cancelled. Ready when you are.")
	elseif action == "Hold" then
		if attempt.phase ~= "Waiting" or now &lt; attempt.readyAt then return self:snapshot(userId) end
		attempt.phase = "Reeling"
		local chargeAt = now + self.config.ChargeLeadTime
		attempt.chargeAt = chargeAt
		attempt.expiresAt = chargeAt + self.config.ChargeDuration
		return self:snapshot(userId)
	elseif action == "Release" and attempt.phase == "Reeling" then
		-- No client-supplied quality, timestamp, species or reward is trusted.
		local progress = (now - (attempt.chargeAt :: number)) / self.config.ChargeDuration
		local quality = self.rules.qualityAt(progress)
		if not quality then return self:finish(userId, now, "It got away! Release inside the colored zone.") end
		session.catches += 1
		local reward = if self.progression and session.profile then self.progression.catch(session.profile, quality)
			else { species = self.config.SpeciesName, quality = quality }
		local packet = self:finish(userId, now, "You caught a " .. self.config.SpeciesName .. "!")
		packet.message = "You caught a " .. reward.species .. "!"
		packet.result = reward
		return packet
	end
	return nil
end

return Engine
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000000E">
      <Properties>
        <string name="Name">WorldPrimitives</string>
        <ProtectedString name="Source">--!strict
-- Original modular scenery. Cylinders in Roblox run along their local X axis.
local Kit = {}

export type Options = {
	material: Enum.Material?, collidable: boolean?, shadow: boolean?,
	transparency: number?, reflectance: number?,
}

Kit.palette = table.freeze({
	Grass = Color3.fromRGB(134, 177, 119), Moss = Color3.fromRGB(83, 131, 98),
	Leaf = Color3.fromRGB(103, 155, 105), Lime = Color3.fromRGB(178, 193, 112),
	Pine = Color3.fromRGB(54, 110, 100), PineLight = Color3.fromRGB(96, 153, 123),
	Blossom = Color3.fromRGB(237, 175, 162), BlossomLight = Color3.fromRGB(255, 219, 192),
	Stone = Color3.fromRGB(142, 159, 156), DeepStone = Color3.fromRGB(88, 116, 126),
	Cliff = Color3.fromRGB(119, 141, 143), Limestone = Color3.fromRGB(187, 188, 162),
	Sand = Color3.fromRGB(229, 213, 172), Wood = Color3.fromRGB(138, 96, 66),
	Bark = Color3.fromRGB(106, 81, 59), BarkLight = Color3.fromRGB(161, 119, 77),
	Plank = Color3.fromRGB(194, 151, 103), Cream = Color3.fromRGB(251, 236, 200),
	Teal = Color3.fromRGB(52, 122, 120), Water = Color3.fromRGB(91, 190, 188),
	Cloud = Color3.fromRGB(242, 244, 235), Coral = Color3.fromRGB(227, 157, 131),
	Brass = Color3.fromRGB(185, 146, 82), Iron = Color3.fromRGB(65, 83, 84),
	Lavender = Color3.fromRGB(164, 149, 191), Gold = Color3.fromRGB(243, 190, 85),
})

local function finish(p: BasePart, parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, options: Options?)
	local opts = options or {}
	p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
	p.Anchored = true
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.CanCollide = opts.collidable == true
	-- Scenery never needs touch events. Solid architecture remains queryable for cameras.
	p.CanTouch, p.CanQuery = false, opts.collidable == true
	p.CastShadow = opts.shadow ~= false
	p.Transparency, p.Reflectance = opts.transparency or 0, opts.reflectance or 0
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
end

function Kit.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, options: Options?): Part
	local p = Instance.new("Part")
	finish(p, parent, name, size, cf, color, options)
	return p
end

function Kit.ball(parent: Instance, name: string, size: Vector3, pos: Vector3, color: Color3, options: Options?): Part
	local p = Kit.part(parent, name, size, CFrame.new(pos), color, options)
	p.Shape = Enum.PartType.Ball
	return p
end

function Kit.disk(parent: Instance, name: string, width: number, depth: number, thickness: number, pos: Vector3, color: Color3, options: Options?): Part
	local p = Kit.part(parent, name, Vector3.new(thickness, width, depth),
		CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color, options)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Kit.beam(parent: Instance, name: string, a: Vector3, b: Vector3, width: number, color: Color3, options: Options?): Part
	local length = (b - a).Magnitude
	assert(length &gt; 0.001, "A scenery beam needs two distinct endpoints")
	local p = Kit.part(parent, name, Vector3.new(length, width, width),
		CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0), color, options)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Kit.wedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, options: Options?): WedgePart
	local p = Instance.new("WedgePart")
	finish(p, parent, name, size, cf, color, options)
	return p
end

function Kit.model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name, model.Parent = name, parent
	return model
end

function Kit.sign(parent: BasePart, title: string, subtitle: string, color: Color3?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name, gui.Face = "PaintedSign", Enum.NormalId.Front
	gui.SizingMode, gui.CanvasSize = Enum.SurfaceGuiSizingMode.FixedSize, Vector2.new(900, 280)
	gui.LightInfluence, gui.Brightness, gui.AlwaysOnTop = 0.7, 1, false
	gui.Parent = parent
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name, titleLabel.BackgroundTransparency = "Title", 1
	titleLabel.Size, titleLabel.Position = UDim2.fromScale(0.9, 0.5), UDim2.fromScale(0.05, 0.1)
	titleLabel.Font, titleLabel.TextSize, titleLabel.Text = Enum.Font.GothamBold, 61, title
	titleLabel.TextColor3, titleLabel.AutoLocalize = color or Kit.palette.Cream, false
	titleLabel.TextScaled, titleLabel.TextWrapped, titleLabel.Parent = true, true, gui
	local sub = titleLabel:Clone()
	sub.Name, sub.Text, sub.Font = "Caption", subtitle, Enum.Font.Gotham
	sub.Size, sub.Position, sub.Parent = UDim2.fromScale(0.88, 0.23), UDim2.fromScale(0.06, 0.65), gui
	return gui
end

function Kit.lantern(parent: Instance, pos: Vector3, scale: number?, shadowLight: boolean?): Model
	local s, c = scale or 1, Kit.palette
	local model = Kit.model(parent, "HarborLantern")
	local metal = { material = Enum.Material.Metal }
	Kit.beam(model, "HangingStem", pos + Vector3.new(0, 0.9, 0) * s, pos + Vector3.new(0, 1.6, 0) * s, 0.1 * s, c.Iron, metal)
	Kit.disk(model, "HangingEye", 0.38 * s, 0.38 * s, 0.09 * s, pos + Vector3.yAxis * 1.32 * s, c.Brass, metal)
	local glass = Kit.part(model, "AmberGlass", Vector3.new(0.82, 1.08, 0.82) * s, CFrame.new(pos),
		Color3.fromRGB(255, 222, 163), { material = Enum.Material.Glass, transparency = 0.38, shadow = false })
	Kit.part(model, "CandleGlow", Vector3.new(0.24, 0.7, 0.24) * s, CFrame.new(pos), c.Cream,
		{ material = Enum.Material.Neon, shadow = false })
	for _, y in { -0.64, 0.64 } do
		Kit.part(model, "LanternRim", Vector3.new(1.12, 0.16, 1.12) * s,
			CFrame.new(pos + Vector3.yAxis * y * s), c.Iron, metal)
	end
	for _, x in { -0.46, 0.46 } do
		for _, z in { -0.46, 0.46 } do
			Kit.beam(model, "CornerBrass", pos + Vector3.new(x, -0.61, z) * s,
				pos + Vector3.new(x, 0.61, z) * s, 0.075 * s, c.Brass, metal)
		end
	end
	for _, side in { -1, 1 } do
		Kit.wedge(model, "PitchedHood", Vector3.new(1.24, 0.34, 0.64) * s,
			CFrame.new(pos + Vector3.new(0, 0.87, side * 0.3) * s) * CFrame.Angles(0, if side == 1 then math.pi else 0, 0), c.Teal, metal)
	end
	local light = Instance.new("PointLight")
	light.Name, light.Color = "WarmPool", Color3.fromRGB(255, 216, 150)
	light.Brightness, light.Range, light.Shadows = 0.65, 13 * s, shadowLight == true
	light.Parent = glass
	return model
end

return Kit
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000000F">
      <Properties>
        <string name="Name">WorldNature</string>
        <ProtectedString name="Source">--!strict
-- Original reusable nature, built from a small number of broad, readable shapes.
-- Positions are ground height except cloud (center) and islandUnderside (meadow top).
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local C = Kit.palette
local Nature = {}

local wood = { material = Enum.Material.Wood }
local trunkWood = { material = Enum.Material.Wood, collidable = true }
local leaves = { material = Enum.Material.Grass }
local tinyLeaves = { material = Enum.Material.Grass, shadow = false }

-- Overlapping domes with a low faceted leaf skirt soften the branched silhouette.
local function leafCrown(parent: Instance, center: Vector3, width: number, height: number, depth: number, tint: Color3, yaw: number)
	local frame = CFrame.new(center) * CFrame.Angles(0, yaw, 0)
	Kit.ball(parent, "CanopyHeart", Vector3.new(width * .95, height, depth * .95), center, tint, leaves)
	for i = 0, 3 do
		local rotation = CFrame.Angles(0, i * math.pi / 2, 0)
		local shoulder = frame * rotation * CFrame.new(0, -height * .19, -depth * .2)
		Kit.wedge(parent, "LeafShoulder", Vector3.new(width * .64, height * .55, depth * .55), shoulder,
			tint:Lerp(if i % 2 == 0 then C.Lime else C.Pine, 0.07), leaves)
	end
end

local function roots(parent: Instance, pos: Vector3, scale: number, random: Random)
	for i = 1, 4 do
		local a = i * math.pi / 2 + random:NextNumber(-0.25, 0.25)
		Kit.beam(parent, "ButtressRoot", pos + Vector3.yAxis * 1.7 * scale,
			pos + Vector3.new(math.cos(a) * 2.6, 0.17, math.sin(a) * 2.6) * scale,
			0.65 * scale, C.Bark, wood)
	end
end

local function broadleaf(parent: Instance, pos: Vector3, scale: number, blossom: boolean, random: Random)
	local trunkTop = pos + Vector3.new(0.6, 10.8, -0.6) * scale
	local bend = pos + Vector3.new(-0.5, 5.3, 0.2) * scale
	Kit.beam(parent, "LowerTrunk", pos - Vector3.yAxis * 0.12 * scale, bend, 1.8 * scale, C.Bark, trunkWood)
	Kit.beam(parent, "UpperTrunk", bend, trunkTop, 1.25 * scale, C.BarkLight, trunkWood)
	roots(parent, pos, scale, random)
	for i = 1, 3 do
		local a = i * math.pi * 0.65
		local offset = Vector3.new(math.cos(a) * 0.71, 0, math.sin(a) * 0.71) * scale
		Kit.beam(parent, "BarkSeam", pos + offset + Vector3.yAxis * scale,
			bend + offset * 0.7 - Vector3.yAxis * scale, 0.12 * scale, C.Bark:Lerp(C.DeepStone, 0.3), wood)
	end
	local baseTint = if blossom then C.Blossom else C.Leaf
	for i = 1, 5 do
		local angle = i * math.pi * 0.4 + random:NextNumber(-0.14, 0.14)
		local reach = random:NextNumber(3.8, 5.8) * scale
		local endPos = trunkTop + Vector3.new(math.cos(angle) * reach, random:NextNumber(0.1, 3.2) * scale, math.sin(angle) * reach)
		local elbow = bend + Vector3.new(math.cos(angle) * reach * 0.45, (3.5 + i % 2) * scale, math.sin(angle) * reach * 0.45)
		Kit.beam(parent, "CrookedBough", bend, elbow, 0.75 * scale, C.Bark, wood)
		Kit.beam(parent, "CrownBranch", elbow, endPos, 0.47 * scale, C.BarkLight, wood)
		local tint = baseTint:Lerp(if blossom then C.BlossomLight else C.Lime, random:NextNumber(0.02, 0.28))
		leafCrown(parent, endPos + Vector3.yAxis * 1.2 * scale,
			random:NextNumber(7.1, 8.8) * scale, random:NextNumber(3.6, 4.8) * scale, 7.3 * scale, tint, angle)
		if blossom and i % 2 == 0 then
			-- Small drooping blossom sprays read close up; the large crown carries the silhouette.
			for spray = 1, 3 do
				local drop = endPos + Vector3.new(spray - 2, -1.1 - spray * 0.24, -1.8) * scale
				Kit.ball(parent, "BlossomSpray", Vector3.new(0.45, 0.9, 0.45) * scale, drop,
					C.BlossomLight, { shadow = false })
			end
		end
	end
	leafCrown(parent, trunkTop + Vector3.new(-0.7, 4, 0.4) * scale, 8.7 * scale, 4.2 * scale, 8.1 * scale,
		baseTint:Lerp(if blossom then C.BlossomLight else C.Lime, 0.18), random:NextNumber(0, math.pi))
end

local function canopyTriangle(parent: Instance, a: Vector3, b: Vector3, c: Vector3, tint: Color3)
	local ab,ac,bc=b-a,c-a,c-b
	local abd,acd,bcd=ab:Dot(ab),ac:Dot(ac),bc:Dot(bc)
	if abd&gt;acd and abd&gt;bcd then c,a=a,c elseif acd&gt;bcd and acd&gt;abd then a,b=b,a end
	ab,ac,bc=b-a,c-a,c-b
	local right=ac:Cross(ab).Unit
	local back=bc.Unit
	local up=bc:Cross(right).Unit
	local height=math.abs(ab:Dot(up))
	local first,second=math.abs(ab:Dot(back)),math.abs(ac:Dot(back))
	if first&gt;.001 then Kit.wedge(parent,"EvergreenBough",Vector3.new(.12,height,first),CFrame.fromMatrix((a+b)/2,right,up,back),tint,leaves) end
	if second&gt;.001 then Kit.wedge(parent,"EvergreenBough",Vector3.new(.12,height,second),CFrame.fromMatrix((a+c)/2,-right,up,-back),tint,leaves) end
end
local function pine(parent: Instance, pos: Vector3, scale: number, random: Random)
	Kit.beam(parent,"PineTrunk",pos,pos+Vector3.yAxis*22.8*scale,1.15*scale,C.Bark,trunkWood)
	roots(parent,pos,scale*.7,random)
	local yaw=random:NextNumber(0,math.pi)
	-- Closed, overlapping hexagonal needle skirts form a clean conifer silhouette.
	for tier=0,5 do
		local radius=(7.1-tier*.98)*scale
		local base=pos+Vector3.yAxis*(3+tier*3.1)*scale
		local tip=base+Vector3.yAxis*(8-tier*.12)*scale
		local tint=C.Pine:Lerp(C.PineLight,tier*.06)
		for face=0,5 do
			local a=yaw+face*math.pi/3
			local b=yaw+(face+1)*math.pi/3
			local left=base+Vector3.new(math.cos(a)*radius,0,math.sin(a)*radius)
			local right=base+Vector3.new(math.cos(b)*radius,0,math.sin(b)*radius)
			canopyTriangle(parent,tip,left,right,tint:Lerp(C.PineLight,face%2*.035))
		end
		Kit.disk(parent,"NeedleSkirtUnderside",radius*1.7,radius*1.7,.12*scale,base,tint,leaves)
	end
end

local function palm(parent: Instance, pos: Vector3, scale: number, random: Random)
	local curve = Vector3.new(random:NextNumber(1.8, 3.8), 0, random:NextNumber(-2.2, 2.2)) * scale
	local previous = pos
	for segment = 1, 6 do
		local t = segment / 6
		local nextPos = pos + Vector3.yAxis * 16.8 * t * scale + curve * t * t
		Kit.beam(parent, "CurvedPalmTrunk", previous, nextPos, (1.1 - t * 0.45) * scale,
			if segment % 2 == 0 then C.BarkLight else C.Wood, trunkWood)
		-- Short collars emphasize growth rings without texturing every face.
		local direction = (nextPos - previous).Unit
		Kit.beam(parent, "PalmGrowthRing", nextPos - direction * 0.1 * scale,
			nextPos + direction * 0.1 * scale, (1.22 - t * 0.43) * scale, C.Bark, wood)
		previous = nextPos
	end
	for frond = 1, 8 do
		local angle = frond * math.pi / 4 + random:NextNumber(-0.1, 0.1)
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local start = previous
		local tint = C.PineLight:Lerp(C.Lime, frond % 3 * 0.16)
		for section = 1, 3 do
			local finish = previous + direction * section * 3.5 * scale
				+ Vector3.yAxis * (if section == 1 then 2.5 elseif section == 2 then 1.1 else -2.5) * scale
			Kit.wedge(parent, "PalmLeaf", Vector3.new((3.2 - section * 0.65) * scale, 0.26 * scale, (finish - start).Magnitude + 0.2 * scale),
				CFrame.lookAt((start + finish) / 2, finish), tint, leaves)
			start = finish
		end
	end
	for nut = 1, 3 do
		local angle = nut * math.pi * 2 / 3
		Kit.ball(parent, "Coconut", Vector3.one * 0.83 * scale,
			previous + Vector3.new(math.cos(angle) * 0.65, -0.6, math.sin(angle) * 0.65) * scale, C.Bark, wood)
	end
end

function Nature.tree(parent: Instance, pos: Vector3, scale: number, kind: string, seed: number): Model
	local model = Kit.model(parent, kind .. "Tree")
	local random = Random.new(seed)
	if kind == "Pine" then pine(model, pos, scale, random)
	elseif kind == "Palm" then palm(model, pos, scale, random)
	else broadleaf(model, pos, scale, kind == "Blossom", random) end
	return model
end

function Nature.rock(parent: Instance, pos: Vector3, size: Vector3, seed: number, moss: boolean?): Model
	local model = Kit.model(parent, "WeatheredRock")
	local random = Random.new(seed)
	local yaw = random:NextNumber(0, math.pi)
	local frame = CFrame.new(pos + Vector3.yAxis * size.Y * 0.34) * CFrame.Angles(0.05, yaw, -0.06)
	local tint = C.Stone:Lerp(C.DeepStone, random:NextNumber(0, 0.24))
	Kit.part(model, "RockCore", size * Vector3.new(0.7, 0.7, 0.7), frame, tint,
		{ material = Enum.Material.Slate, collidable = size.Y &gt;= 3 })
	for facet = 0, 3 do
		local turn = CFrame.Angles(0, facet * math.pi / 2, 0)
		Kit.wedge(model, "StoneFacet", size * Vector3.new(0.74, 0.88, 0.61),
			frame * turn * CFrame.new(0, 0, -size.Z * 0.2), tint:Lerp(C.Limestone, facet % 3 * 0.08),
			{ material = Enum.Material.Slate })
	end
	for fragment = 1, 2 do
		local side = if fragment == 1 then -1 else 1
		Kit.wedge(model, "FallenChip", size * Vector3.new(0.24, 0.2, 0.34),
			CFrame.new(pos + Vector3.new(side * size.X * 0.52, size.Y * 0.03, size.Z * 0.2)) * CFrame.Angles(0, yaw + fragment, 0),
			C.DeepStone:Lerp(tint, 0.6), { material = Enum.Material.Slate })
	end
	if moss then
		for patch = 1, 2 do
			Kit.wedge(model, "ClingingMoss", size * Vector3.new(0.44, 0.04, 0.4),
				CFrame.new(pos + Vector3.new((patch - 1.5) * size.X * 0.3, size.Y * 0.73, 0)) * CFrame.Angles(0.04, yaw, 0.07),
				C.Moss:Lerp(C.Grass, patch * 0.15), leaves)
		end
	end
	return model
end

function Nature.garden(parent: Instance, center: Vector3, radius: Vector2, count: number, seed: number, kind: string?): Model
	local model = Kit.model(parent, (kind or "Meadow") .. "Garden")
	local random = Random.new(seed)
	local limit = math.clamp(math.floor(count), 1, if kind == "Lavender" then 16 else 32)
	for index = 1, limit do
		local a, distance = random:NextNumber(0, math.pi * 2), math.sqrt(random:NextNumber())
		local pos = center + Vector3.new(math.cos(a) * radius.X * distance, 0, math.sin(a) * radius.Y * distance)
		local yaw = random:NextNumber(0, math.pi * 2)
		local height = random:NextNumber(0.65, 1.3)
		if kind == "Reeds" then
			for stem = 1, 3 do
				local h = height * (1.8 + stem * 0.35)
				local bottom = pos + Vector3.new((stem - 2) * 0.22, 0, (stem % 2) * 0.18)
				Kit.beam(model, "ReedStem", bottom, bottom + Vector3.yAxis * h, 0.055, C.Moss, tinyLeaves)
				Kit.beam(model, "ReedHead", bottom + Vector3.yAxis * h, bottom + Vector3.yAxis * (h + 0.48), 0.16, C.Wood, { shadow = false })
			end
		elseif kind == "Lavender" then
			for stem = 1, 3 do
				local point = pos + Vector3.new((stem - 2) * 0.25, height + stem * 0.13, 0)
				Kit.beam(model, "LavenderStem", pos, point, 0.045, C.Moss, tinyLeaves)
				for bud = 1, 3 do
					Kit.ball(model, "LavenderBud", Vector3.new(0.19, 0.28, 0.19), point - Vector3.yAxis * bud * 0.16,
						C.Lavender:Lerp(C.Cream, bud * 0.08), { shadow = false })
				end
			end
		else
			for blade = 1, 3 do
				local cf = CFrame.new(pos + Vector3.yAxis * height * 0.45)
					* CFrame.Angles(0, yaw + blade * 2.1, (blade - 2) * 0.22)
				Kit.wedge(model, "MeadowBlade", Vector3.new(0.09, height, 0.38), cf,
					C.Moss:Lerp(C.Lime, random:NextNumber(0, 0.3)), tinyLeaves)
			end
			if kind ~= "Grass" and index % 3 == 0 then
				local point = pos + Vector3.yAxis * (height + 0.25)
				Kit.beam(model, "WildflowerStem", pos, point, 0.045, C.Moss, tinyLeaves)
				local tint = if index % 2 == 0 then C.Cream else C.Coral
				for petal = 1, 4 do
					local angle = petal * math.pi / 2 + yaw
					local flower = Kit.ball(model, "WildflowerPetal", Vector3.new(0.36, 0.1, 0.59),
						point + Vector3.new(math.cos(angle) * 0.2, 0, math.sin(angle) * 0.2), tint, { shadow = false })
					flower.CFrame *= CFrame.Angles(0, -angle + math.pi / 2, 0)
				end
				Kit.ball(model, "WildflowerHeart", Vector3.new(0.21, 0.15, 0.21), point + Vector3.yAxis * 0.07, C.Gold, { shadow = false })
			end
		end
	end
	return model
end

function Nature.cloud(parent: Instance, pos: Vector3, size: Vector3, seed: number): Model
	local model = Kit.model(parent, "DriftingCloud")
	local random = Random.new(seed)
	for puff = 0, 6 do
		local angle = puff * math.pi / 3
		local center = pos + Vector3.new(math.cos(angle) * size.X * 0.23, random:NextNumber(-0.12, 0.14) * size.Y, math.sin(angle) * size.Z * 0.22)
		Kit.ball(model, "CloudVolume", size * Vector3.new(random:NextNumber(0.48, 0.7), random:NextNumber(0.63, 0.98), random:NextNumber(0.55, 0.78)),
			center, C.Cloud:Lerp(C.Cream, puff % 3 * 0.025), { shadow = false, transparency = 0.035 })
	end
	return model
end

function Nature.islandUnderside(parent: Instance, center: Vector3, width: number, depth: number, seed: number): Model
	local model = Kit.model(parent, "AncientFloatingCliffs")
	local random = Random.new(seed)
	local height = math.min(width * 0.31, 53)
	-- Stone masses overlap internally. The outer silhouette carries actual facets and strata.
	Kit.ball(model, "CliffMass", Vector3.new(width * 0.95, height * 1.25, depth * 0.95), center - Vector3.yAxis * height * 0.66,
		C.Cliff, { material = Enum.Material.Slate })
	Kit.ball(model, "WeatheredKeel", Vector3.new(width * 0.59, height * 1.23, depth * 0.55),
		center + Vector3.new(-width * 0.035, -height * 1.03, depth * 0.03), C.DeepStone, { material = Enum.Material.Slate })
	local segments = math.clamp(math.floor((width + depth) / 12), 14, 28)
	for index = 1, segments do
		local angle = index / segments * math.pi * 2
		local sway = random:NextNumber(0.9, 1.03)
		local rim = center + Vector3.new(math.cos(angle) * width * 0.435 * sway, -height * 0.43, math.sin(angle) * depth * 0.435 * sway)
		local frame = CFrame.new(rim) * CFrame.Angles(random:NextNumber(-0.08, 0.08), -angle, random:NextNumber(-0.11, 0.11))
		local broad = math.pi * math.min(width, depth) / segments * 1.3
		local tint = C.Stone:Lerp(C.DeepStone, index % 4 * 0.13)
		Kit.part(model, "FracturedCliffFace", Vector3.new(broad, height * random:NextNumber(0.58, 0.81), broad * 0.8), frame,
			tint, { material = Enum.Material.Slate })
		Kit.part(model, "SedimentaryBand", Vector3.new(broad * 1.02, height * 0.045, broad * 0.82),
			frame * CFrame.new(0, height * (if index % 2 == 0 then -0.06 else 0.13), 0), C.Limestone:Lerp(tint, 0.65),
			{ material = Enum.Material.Limestone })
		if index % 2 == 0 then
			Kit.wedge(model, "HangingSpur", Vector3.new(broad * 0.7, height * 0.8, broad * 0.66),
				CFrame.new(rim + Vector3.new(-math.cos(angle) * broad * 0.28, -height * 0.42, -math.sin(angle) * broad * 0.28))
					* CFrame.Angles(math.pi, -angle + 0.3, 0), C.DeepStone, { material = Enum.Material.Slate })
		end
		-- Ledges sit below the walkable cap, leaving the root's route geometry unobstructed.
		if index % 3 == 0 then
			Kit.wedge(model, "MossyCliffLedge", Vector3.new(broad * 0.85, 1.2, broad * 0.75),
				CFrame.new(rim + Vector3.yAxis * height * 0.24) * CFrame.Angles(0, -angle, 0), C.Moss, leaves)
		end
	end
	return model
end

return Nature
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000010">
      <Properties>
        <string name="Name">WorldArchitecture</string>
        <ProtectedString name="Source">--!strict
-- Original, explorable harbor buildings. Every public entry stays open; decorative
-- glazing, ropes and shingles do not add physics work to the walking surfaces.
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))

local Architecture = {}
local C = {
	Timber = Color3.fromRGB(102, 67, 48),
	Wood = Color3.fromRGB(167, 116, 73),
	Plank = Color3.fromRGB(192, 145, 94),
	Dark = Color3.fromRGB(47, 66, 69),
	Cream = Color3.fromRGB(242, 225, 182),
	Stone = Color3.fromRGB(169, 174, 160),
	Moss = Color3.fromRGB(102, 130, 84),
	Glass = Color3.fromRGB(151, 204, 199),
	Gold = Color3.fromRGB(227, 176, 82),
	Rope = Color3.fromRGB(209, 191, 145),
	Roof = Color3.fromRGB(80, 126, 133),
}
local WOOD = Enum.Material.Wood
local PLANKS = Enum.Material.WoodPlanks
local STONE = Enum.Material.Slate
local METAL = Enum.Material.Metal

local function p(parent, name, size, cf, color, material, collidable)
	return Kit.part(parent, name, size, cf, color, {
		material = material or WOOD,
		collidable = collidable == true,
	})
end

local function beam(parent, name, a, b, thickness, color, material)
	return Kit.beam(parent, name, a, b, thickness, color, { material = material or WOOD })
end

local function localBeam(parent, cf, name, a, b, thickness, color, material)
	return beam(parent, name, cf:PointToWorldSpace(a), cf:PointToWorldSpace(b), thickness, color, material)
end

local function localBall(parent, cf, name, size, position, color, material)
	return Kit.ball(parent, name, size, cf:PointToWorldSpace(position), color, {
		material = material or WOOD,
	})
end

local function barrel(parent, cf, scale)
	local model = Kit.model(parent, "CooperedBarrel")
	local s = scale or 1
	local center = cf * CFrame.new(0, 1.1 * s, 0)
	Kit.disk(model, "OakStaves", 1.9 * s, 1.9 * s, 2.2 * s, center.Position, C.Wood, { material = WOOD })
	for _, y in { 0.25, 0.65, 1.75, 2.05 } do
		Kit.disk(model, "IronHoop", 1.99 * s, 1.99 * s, 0.11 * s, (cf * CFrame.new(0, y * s, 0)).Position, C.Dark, { material = METAL })
	end
	for i = 0, 7 do
		local angle = i * math.pi / 4
		p(model, "StaveSeam", Vector3.new(0.035 * s, 1.85 * s, 0.035 * s),
			cf * CFrame.new(math.sin(angle) * 0.94 * s, 1.1 * s, math.cos(angle) * 0.94 * s),
			C.Timber, WOOD)
	end
	p(model, "LidCrossbar", Vector3.new(1.5 * s, 0.1 * s, 0.18 * s), cf * CFrame.new(0, 2.24 * s, 0), C.Timber)
	return model
end

local function crate(parent, cf, size)
	local model = Kit.model(parent, "SlattedCrate")
	p(model, "CrateBody", size, cf * CFrame.new(0, size.Y / 2, 0), C.Wood)
	for _, side in { -1, 1 } do
		for _, y in { 0.18, size.Y - 0.18 } do
			p(model, "Binding", Vector3.new(size.X + 0.1, 0.16, 0.12), cf * CFrame.new(0, y, side * size.Z / 2), C.Plank)
		end
		p(model, "CornerBinding", Vector3.new(0.13, size.Y, size.Z + 0.12), cf * CFrame.new(side * (size.X / 2 - 0.13), size.Y / 2, 0), C.Plank)
	end
	local diagonal = math.atan2(size.Y, size.X)
	p(model, "DiagonalBrace", Vector3.new(math.sqrt(size.X ^ 2 + size.Y ^ 2) - 0.1, 0.2, 0.14),
		cf * CFrame.new(0, size.Y / 2, -size.Z / 2 - 0.08) * CFrame.Angles(0, 0, diagonal), C.Timber)
	return model
end

local function ropeCoil(parent, cf, radius)
	for ring = 0, 1 do
		local r = radius - ring * 0.17
		for i = 0, 9 do
			local a = i * math.pi / 5
			local b = (i + 1) * math.pi / 5
			localBeam(parent, cf, "CoiledMooringRope",
				Vector3.new(math.sin(a) * r, 0.12 + ring * 0.07, math.cos(a) * r),
				Vector3.new(math.sin(b) * r, 0.12 + ring * 0.07, math.cos(b) * r), 0.12, C.Rope)
		end
	end
end

local function window(parent, cf, width, height, shutters)
	p(parent, "RecessedWindow", Vector3.new(width, height, 0.1), cf, C.Dark)
	Kit.part(parent, "WindowGlass", Vector3.new(width - 0.3, height - 0.3, 0.11), cf * CFrame.new(0, 0, -0.08), C.Glass,
		{ material = Enum.Material.Glass, transparency = 0.22, reflectance = 0.15 })
	for _, side in { -1, 1 } do
		p(parent, "WindowJamb", Vector3.new(0.16, height + 0.25, 0.24), cf * CFrame.new(side * width / 2, 0, -0.08), C.Cream)
		p(parent, "WindowLintel", Vector3.new(width + 0.3, 0.16, 0.24), cf * CFrame.new(0, side * height / 2, -0.08), C.Cream)
		if shutters then
			p(parent, "PaintedShutter", Vector3.new(width * 0.26, height, 0.14), cf * CFrame.new(side * width * 0.7, 0, -0.02), C.Roof, PLANKS)
			p(parent, "ShutterHinge", Vector3.new(width * 0.26, 0.12, 0.12), cf * CFrame.new(side * width * 0.7, -height * 0.29, -0.12), C.Dark, METAL)
		end
	end
	p(parent, "WindowMullion", Vector3.new(0.1, height, 0.2), cf * CFrame.new(0, 0, -0.15), C.Cream)
	p(parent, "WindowTransom", Vector3.new(width, 0.1, 0.2), cf * CFrame.new(0, 0.05, -0.15), C.Cream)
	p(parent, "DeepWindowSill", Vector3.new(width + 0.65, 0.2, 0.65), cf * CFrame.new(0, -height / 2 - 0.08, -0.2), C.Timber)
end

local function flowerBox(parent, cf, width, tint)
	p(parent, "WindowFlowerBox", Vector3.new(width, 0.65, 0.7), cf, C.Wood, PLANKS)
	p(parent, "Soil", Vector3.new(width - 0.16, 0.08, 0.54), cf * CFrame.new(0, 0.32, 0), C.Timber, Enum.Material.Ground)
	for i = 1, 4 do
		local x = (i - 2.5) * width / 4
		localBall(parent, cf, "TrailingLeaf", Vector3.new(0.65, 0.55, 0.65), Vector3.new(x, 0.5, -0.05), C.Moss, Enum.Material.Grass)
		localBall(parent, cf, "WindowBlossom", Vector3.new(0.36, 0.27, 0.36), Vector3.new(x + 0.05, 0.8, -0.12), tint, Enum.Material.SmoothPlastic)
	end
end

function Architecture.cottage(parent, cf, width, depth, tint, kind)
	local buildingKind = kind or "Cottage"
	local model = Kit.model(parent, buildingKind .. "House")
	local w, d = math.max(width, 16), math.max(depth, 12)
	local h = 9.2
	local half, front = w / 2, -d / 2
	local roofColor = buildingKind == "Workshop" and C.Roof
		or (buildingKind == "Cafe" and Color3.fromRGB(165, 96, 77) or Color3.fromRGB(107, 124, 101))
	-- Stone footings, an open doorway and a real timber floor make the porch explorable.
	p(model, "RaisedTimberFloor", Vector3.new(w, 0.4, d), cf * CFrame.new(0, 0, 0), C.Plank, PLANKS, true)
	p(model, "RearWall", Vector3.new(w, h, 0.5), cf * CFrame.new(0, h / 2, d / 2), tint, Enum.Material.Plaster, true)
	for _, side in { -1, 1 } do
		p(model, "SideWall", Vector3.new(0.5, h, d), cf * CFrame.new(side * half, h / 2, 0), tint, Enum.Material.Plaster, true)
		local bay = (w - 3.8) / 2
		p(model, "FrontWallBay", Vector3.new(bay, h, 0.5), cf * CFrame.new(side * (1.9 + bay / 2), h / 2, front), tint, Enum.Material.Plaster, true)
		p(model, "DoorJamb", Vector3.new(0.24, 7.2, 0.7), cf * CFrame.new(side * 1.94, 3.6, front - 0.12), C.Timber)
		for _, z in { front, d / 2 } do
			p(model, "ExposedCornerTimber", Vector3.new(0.34, h + 0.1, 0.65), cf * CFrame.new(side * (half - 0.1), h / 2, z), C.Timber)
		end
		p(model, "FoundationStones", Vector3.new(1.5, 0.9, d + 0.5), cf * CFrame.new(side * (half - 0.7), -0.45, 0), C.Stone, STONE)
		p(model, "LowerWallTimber", Vector3.new(0.28, 0.3, d), cf * CFrame.new(side * (half + 0.15), 0.8, 0), C.Timber)
		window(model, cf * CFrame.new(side * w * 0.3, 4.8, front - 0.31), math.min(3.2, w * 0.16), 3.3, true)
		flowerBox(model, cf * CFrame.new(side * w * 0.3, 2.65, front - 0.72), math.min(3.7, w * 0.18),
			buildingKind == "Cafe" and Color3.fromRGB(245, 208, 108) or Color3.fromRGB(224, 150, 141))
		window(model, cf * CFrame.new(side * (half + 0.31), 4.8, d * 0.12) * CFrame.Angles(0, -side * math.pi / 2, 0), 3.2, 3.3, false)
	end
	p(model, "DoorLintel", Vector3.new(4.2, 0.3, 0.7), cf * CFrame.new(0, 7.15, front - 0.12), C.Timber)
	p(model, "DoorwayHeadWall", Vector3.new(3.8, h - 7.25, 0.5), cf * CFrame.new(0, (h + 7.25) / 2, front), tint, Enum.Material.Plaster, true)
	-- Layered slate tiles follow the real roof slope, catching light on every row.
	local overhang, rise = 1.25, 4.3
	local roofHalf = half + overhang
	local pitch = math.atan2(rise, roofHalf)
	local slope = math.sqrt(roofHalf ^ 2 + rise ^ 2)
	local roofDepth = d + 2.6
	local cols = math.max(4, math.floor(roofDepth / 2.5))
	for _, side in { -1, 1 } do
		local roofCf = cf * CFrame.new(side * roofHalf / 2, h + rise / 2, 0) * CFrame.Angles(0, 0, -side * pitch)
		p(model, "RoofUnderlay", Vector3.new(slope + 0.2, 0.35, roofDepth), roofCf, roofColor, STONE, true)
		for row = 0, 3 do
			for col = 0, cols - 1 do
				local shift = (row % 2 == 1 and 0.12 or -0.12)
				local tileCf = roofCf * CFrame.new(-slope / 2 + (row + 0.5) * slope / 4, 0.24 + row * 0.008,
					-roofDepth / 2 + (col + 0.5) * roofDepth / cols + shift)
				local shade = ((row * 7 + col * 3) % 5) * 0.025
				p(model, "IndividualSlateShingle", Vector3.new(slope / 4 + 0.12, 0.12, roofDepth / cols - 0.09), tileCf,
					roofColor:Lerp(C.Cream, shade), STONE)
			end
		end
		for _, z in { -roofDepth / 2, roofDepth / 2 } do
			localBeam(model, cf, "CarvedGableTrim", Vector3.new(side * roofHalf, h, z), Vector3.new(0, h + rise, z), 0.27, C.Cream)
		end
		p(model, "EaveTimber", Vector3.new(0.24, 0.28, roofDepth + 0.3), cf * CFrame.new(side * roofHalf, h, 0), C.Timber)
	end
	p(model, "RidgeCap", Vector3.new(0.48, 0.35, roofDepth + 0.2), cf * CFrame.new(0, h + rise + 0.13, 0), C.Dark, METAL)
	-- Stepped plaster infill stays under the sloping roof; exposed framing gives
	-- the attic real depth without closing the entrance below it.
	for _, z in { -d / 2 - 0.08, d / 2 + 0.08 } do
		for i = -5, 5 do
			local x = i * w / 11
			local panelHeight = rise * (1 - (math.abs(x) + w / 22) / roofHalf)
			p(model, "GablePlasterInfill", Vector3.new(w / 11 + 0.02, panelHeight, 0.18), cf * CFrame.new(x, h + panelHeight / 2, z), tint, Enum.Material.Plaster)
		end
		for i = -3, 3 do
			local x = i * half / 4
			local beamHeight = rise * (1 - math.abs(x) / roofHalf)
			p(model, "GableLattice", Vector3.new(0.19, beamHeight, 0.2), cf * CFrame.new(x, h + beamHeight / 2, z), C.Timber)
		end
		p(model, "GableCrossbeam", Vector3.new(w + 0.5, 0.26, 0.4), cf * CFrame.new(0, h, z), C.Timber)
		local outside = z &lt; 0 and -0.2 or 0.2
		local ring = Kit.disk(model, "RoundAtticWindowFrame", 2.1, 2.1, 0.2, (cf * CFrame.new(0, h + 1.75, z + outside)).Position, C.Cream, { material = WOOD })
		ring.CFrame = cf * CFrame.new(0, h + 1.75, z + outside) * CFrame.Angles(0, math.pi / 2, 0)
		local glass = Kit.disk(model, "RoundAtticWindow", 1.65, 1.65, 0.22, ring.Position, C.Glass, { material = Enum.Material.Glass, reflectance = 0.1 })
		glass.CFrame = ring.CFrame
	end
	-- The sheltered porch is a visual landmark and a usable place to stand.
	local porchZ = front - 2.5
	p(model, "PorchFloor", Vector3.new(w + 1.4, 0.35, 5), cf * CFrame.new(0, -0.025, porchZ), C.Plank, PLANKS, true)
	p(model, "PorchFrontRiser", Vector3.new(w + 1.4, 0.65, 0.3), cf * CFrame.new(0, -0.3, front - 5), C.Timber)
	for _, side in { -1, 1 } do
		p(model, "PorchPost", Vector3.new(0.38, 7.3, 0.38), cf * CFrame.new(side * half, 3.5, front - 4.5), C.Timber)
		localBeam(model, cf, "PorchKneeBrace", Vector3.new(side * half, 5.6, front - 4.5), Vector3.new(side * (half - 1.4), 7, front - 4.5), 0.23, C.Cream)
		localBeam(model, cf, "PorchKneeBrace", Vector3.new(side * half, 5.6, front - 4.5), Vector3.new(side * half, 7, front - 3.1), 0.23, C.Cream)
	end
	p(model, "PorchCanopy", Vector3.new(w + 2, 0.27, 5.4), cf * CFrame.new(0, 7.5, front - 2.6) * CFrame.Angles(math.rad(7), 0, 0), roofColor, PLANKS)
	p(model, "PorchFascia", Vector3.new(w + 2, 0.35, 0.26), cf * CFrame.new(0, 7.1, front - 5.2), C.Cream)
	local label = buildingKind == "Workshop" and "THE ROD WORKSHOP" or (buildingKind == "Cafe" and "THE TIDE TABLE" or "HARBOR COTTAGE")
	local subtitle = buildingKind == "Workshop" and "A better rod. A bigger adventure." or (buildingKind == "Cafe" and "The harbor's quiet corner" or "A little home above the clouds")
	local sign = p(model, "PaintedShopSign", Vector3.new(math.min(11, w - 3), 1.55, 0.22), cf * CFrame.new(0, 6.45, front - 5.28), C.Dark)
	Kit.sign(sign, label, subtitle, C.Cream)
	Kit.lantern(model, cf:PointToWorldSpace(Vector3.new(half - 0.8, 5.4, front - 4.5)), 0.7, false)
	-- A quiet interior, visible through the open door, rewards looking around.
	p(model, "WovenInteriorRug", Vector3.new(w * 0.53, 0.035, d * 0.55), cf * CFrame.new(0, 0.23, 0), Color3.fromRGB(121, 157, 150), Enum.Material.Fabric)
	p(model, "RearDisplayShelf", Vector3.new(w - 3, 0.22, 1.2), cf * CFrame.new(0, 4.6, d / 2 - 0.8), C.Timber)
	p(model, "BackCounter", Vector3.new(w - 4, 2.8, 1.7), cf * CFrame.new(0, 1.6, d / 2 - 1.25), tint:Lerp(C.Timber, 0.3), PLANKS, true)
	p(model, "CounterTop", Vector3.new(w - 3.5, 0.2, 2.1), cf * CFrame.new(0, 3.1, d / 2 - 1.25), C.Plank)
	for i = -1, 1 do
		local x = i * (w - 4) / 3
		localBall(model, cf, "GlazedStoragePot", Vector3.new(0.85, 0.95, 0.85), Vector3.new(x, 5.15, d / 2 - 0.8),
			i == 0 and C.Gold or C.Roof, Enum.Material.CeramicTiles)
	end
	if buildingKind == "Workshop" then
		local trigger = p(model, "WorkshopJournalStand", Vector3.new(2.3, 2.5, 1.1), cf * CFrame.new(half - 3, 1.4, front - 2.6), C.Roof, PLANKS, true)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "RodWorkshopPrompt"
		prompt.ActionText = "Open journal"
		prompt.ObjectText = "Rod Workshop"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = trigger
		for i = 0, 3 do
			local x = -half + 2 + i * 0.72
			localBeam(model, cf, "WorkshopRod", Vector3.new(x, 0.4, d / 2 - 2), Vector3.new(x + 0.3, 6.5, d / 2 - 2), 0.09, i % 2 == 0 and C.Gold or C.Dark)
		end
	else
		p(model, "PorchBenchSeat", Vector3.new(4, 0.24, 1.3), cf * CFrame.new(-half + 3.1, 1.4, porchZ), C.Plank, WOOD, true)
		p(model, "PorchBenchBack", Vector3.new(4, 1.3, 0.18), cf * CFrame.new(-half + 3.1, 2.1, porchZ + 0.55), C.Timber)
		for _, x in { -half + 1.8, -half + 4.4 } do
			p(model, "BenchLeg", Vector3.new(0.3, 1.4, 1.1), cf * CFrame.new(x, 0.65, porchZ), C.Timber)
		end
	end
	local chimneyCf = cf * CFrame.new(half * 0.52, h + 3.1, d * 0.23)
	p(model, "ChimneyStack", Vector3.new(1.4, 4, 1.5), chimneyCf, Color3.fromRGB(144, 109, 87), Enum.Material.Brick)
	p(model, "ChimneyCap", Vector3.new(1.8, 0.28, 1.9), chimneyCf * CFrame.new(0, 2, 0), C.Stone, STONE)
	p(model, "ChimneyOpening", Vector3.new(0.9, 0.03, 1), chimneyCf * CFrame.new(0, 2.15, 0), C.Dark, STONE)
	return model
end

function Architecture.dock(parent, a, b, width, name, rails)
	local model = Kit.model(parent, name or "HarborBoardwalk")
	local length = (b - a).Magnitude
	if length &lt; 0.1 then return model end
	local basis = CFrame.lookAt((a + b) / 2, b)
	local up = basis.UpVector
	-- One uninterrupted collider keeps small gaps between visible planks harmless.
	local floor = p(model, "ContinuousWalkSurface", Vector3.new(width, 0.42, length), basis - up * 0.21, C.Timber, WOOD, true)
	floor.Transparency = 1
	local count = math.min(48, math.max(2, math.ceil(length / 2.25)))
	for i = 0, count - 1 do
		local plankCf = basis * CFrame.new(0, -0.02, -length / 2 + (i + 0.5) * length / count)
		p(model, "WeatheredDeckPlank", Vector3.new(width, 0.16, length / count - 0.045), plankCf,
			C.Plank:Lerp(C.Timber, (i % 4) * 0.055), WOOD)
		if i % 4 == 0 then
			for _, side in { -1, 1 } do
				p(model, "IronDeckNail", Vector3.new(0.08, 0.018, 0.08), plankCf * CFrame.new(side * (width / 2 - 0.4), 0.09, 0), C.Dark, METAL)
			end
		end
	end
	for _, side in { -1, 1 } do
		p(model, "LongitudinalStringer", Vector3.new(0.55, 0.9, length + 0.6), basis * CFrame.new(side * (width / 2 - 0.8), -0.75, 0), C.Timber)
	end
	local bays = math.min(4, math.max(1, math.ceil(length / 17)))
	for i = 0, bays do
		local z = -length / 2 + i * length / bays
		for _, side in { -1, 1 } do
			local postCf = basis * CFrame.new(side * (width / 2 - 0.25), 0, z)
			if i % 2 == 0 or i == bays then
				p(model, "DeepTimberPile", Vector3.new(0.8, 7, 0.8), postCf * CFrame.new(0, -3.5, 0), C.Timber)
				p(model, "PileWaterlineBand", Vector3.new(0.83, 0.35, 0.83), postCf * CFrame.new(0, -2.7, 0), C.Dark, METAL)
			end
			if rails ~= false then
				p(model, "RopeRailPost", Vector3.new(0.45, 3.5, 0.45), postCf * CFrame.new(0, 1.7, 0), C.Timber, WOOD, true)
				p(model, "PostCap", Vector3.new(0.6, 0.16, 0.6), postCf * CFrame.new(0, 3.5, 0), C.Plank)
			end
		end
		if i &lt; bays and rails ~= false then
			for _, side in { -1, 1 } do
				local x = side * (width / 2 - 0.25)
				local nextZ = z + length / bays
				for _, h in { 1.4, 3.1 } do
					local start = Vector3.new(x, h, z)
					local middle = Vector3.new(x, h - 0.3, (z + nextZ) / 2)
					local finish = Vector3.new(x, h, nextZ)
					localBeam(model, basis, "SaggingHempRail", start, middle, 0.14, C.Rope)
					localBeam(model, basis, "SaggingHempRail", middle, finish, 0.14, C.Rope)
				end
				p(model, "SafeRailCollider", Vector3.new(0.12, 2.5, length / bays), basis * CFrame.new(x, 1.75, (z + nextZ) / 2), C.Timber, WOOD, true).Transparency = 1
			end
		end
	end
	if length &gt;= 25 then
		Kit.lantern(model, (basis * CFrame.new(width / 2 - 0.25, 3.9, -length * 0.28)).Position, 0.65, false)
	end
	return model
end

function Architecture.lighthouse(parent, cf)
	local model = Kit.model(parent, "WayfarerLighthouse")
	local n, r = 12, 6
	local tangentWidth = 2 * r * math.tan(math.pi / n) + 0.04
	Kit.disk(model, "OctagonalFoundation", 16, 16, 0.7, cf:PointToWorldSpace(Vector3.new(0, -0.35, 0)), C.Stone, { material = STONE, collidable = true })
	for i = 0, n - 1 do
		local angle = i * math.pi * 2 / n
		local face = cf * CFrame.Angles(0, -angle, 0) * CFrame.new(0, 0, -r)
		if i == 0 then
			p(model, "DoorwayUpperWall", Vector3.new(tangentWidth, 17.4, 0.6), face * CFrame.new(0, 16.7, 0), C.Cream, Enum.Material.Plaster, true)
		elseif i == 3 or i == 9 then
			p(model, "WindowLowerWall", Vector3.new(tangentWidth, 11, 0.6), face * CFrame.new(0, 5.5, 0), C.Cream, Enum.Material.Plaster, true)
			p(model, "WindowUpperWall", Vector3.new(tangentWidth, 10.9, 0.6), face * CFrame.new(0, 19.95, 0), C.Cream, Enum.Material.Plaster, true)
			window(model, face * CFrame.new(0, 12.75, -0.32), tangentWidth - 0.3, 3.5, false)
		else
			p(model, "LimewashedTowerWall", Vector3.new(tangentWidth, 25.4, 0.6), face * CFrame.new(0, 12.7, 0), C.Cream, Enum.Material.Plaster, true)
		end
		-- Painted banding and footings make the silhouette readable from other islands.
		if i ~= 0 then
			p(model, "TowerStoneFooting", Vector3.new(tangentWidth + 0.12, 1.2, 0.82), face * CFrame.new(0, 0.6, 0), C.Stone, STONE, true)
		end
		for _, y in { 9.3, 23.7 } do
			p(model, "MarinerBlueBand", Vector3.new(tangentWidth + 0.12, 1, 0.76), face * CFrame.new(0, y, -0.08), C.Roof, Enum.Material.Plaster)
		end
	end
	-- 7.8 studs of rise per revolution leave enough headroom for a standard R15
	-- avatar. The final 26.65-stud tread meets the 27-stud lookout deck.
	for i = 0, 40 do
		local angle = i * math.pi / 6
		local stepCf = cf * CFrame.Angles(0, -angle, 0) * CFrame.new(0, i * 0.65 + 0.325, -3.05)
		p(model, "SpiralStairTread", Vector3.new(2.2, 0.65, 3.6), stepCf, C.Plank, WOOD, true)
		if i % 3 == 0 then
			p(model, "InnerStairBaluster", Vector3.new(0.12, 2.7, 0.12), stepCf * CFrame.new(0, 1.6, 1.68), C.Dark, METAL)
		end
	end
	p(model, "CentralStairMast", Vector3.new(0.65, 29, 0.65), cf * CFrame.new(0, 14.5, 0), C.Timber)
	for i = 0, n - 1 do
		local angle = i * math.pi * 2 / n
		local ring = cf * CFrame.Angles(0, -angle, 0)
		p(model, "AccessibleLookoutBalcony", Vector3.new(4.2, 0.45, 3), ring * CFrame.new(0, 26.775, -6.2), C.Stone, STONE, true)
		p(model, "LookoutRailingPost", Vector3.new(0.16, 3.2, 0.16), ring * CFrame.new(0, 28.6, -7.55), C.Dark, METAL)
		local barrier = p(model, "LookoutRailingCollider", Vector3.new(4.2, 2.8, 0.15), ring * CFrame.new(0, 28.4, -7.55), C.Dark, METAL, true)
		barrier.Transparency = 1
		local a = Vector3.new(math.sin(angle) * 7.55, 30.15, -math.cos(angle) * 7.55)
		local nextAngle = angle + math.pi * 2 / n
		local b = Vector3.new(math.sin(nextAngle) * 7.55, 30.15, -math.cos(nextAngle) * 7.55)
		localBeam(model, cf, "ContinuousBalconyHandrail", a, b, 0.15, C.Dark, METAL)
		localBeam(model, cf, "BalconyLowerRail", a - Vector3.new(0, 1.5, 0), b - Vector3.new(0, 1.5, 0), 0.1, C.Dark, METAL)
		if i ~= 0 then
			Kit.part(model, "LanternRoomGlazing", Vector3.new(2.4, 5.8, 0.12), ring * CFrame.new(0, 31.6, -4.45), C.Glass,
				{ material = Enum.Material.Glass, transparency = 0.58, reflectance = 0.1 })
		end
		p(model, "LanternRoomUpright", Vector3.new(0.14, 6.3, 0.14), ring * CFrame.new(0, 31.6, -4.5), C.Dark, METAL)
		localBeam(model, cf, "CopperDomeRib", Vector3.new(math.sin(angle) * 5.3, 34.5, -math.cos(angle) * 5.3), Vector3.new(0, 37.7, 0), 0.14, C.Dark, METAL)
	end
	Kit.disk(model, "LanternRoomCornice", 10.5, 10.5, 0.36, cf:PointToWorldSpace(Vector3.new(0, 34.5, 0)), C.Dark, { material = METAL })
	localBall(model, cf, "VerdigrisDome", Vector3.new(10.4, 5.1, 10.4), Vector3.new(0, 35.3, 0), C.Roof, METAL)
	localBall(model, cf, "LighthouseLens", Vector3.new(2.6, 3.4, 2.6), Vector3.new(0, 31.4, 0), C.Gold, Enum.Material.Neon)
	local lampMount = p(model, "LensPedestal", Vector3.new(1.1, 1.8, 1.1), cf * CFrame.new(0, 28.7, 0), C.Dark, METAL)
	local light = Instance.new("PointLight")
	light.Name = "WarmNavigationLight"
	light.Color = Color3.fromRGB(255, 220, 158)
	light.Brightness = 1.5
	light.Range = 32
	light.Shadows = false
	light.Parent = lampMount
	p(model, "WeatherVaneMast", Vector3.new(0.14, 3.8, 0.14), cf * CFrame.new(0, 39, 0), C.Dark, METAL)
	p(model, "WeatherVaneArrow", Vector3.new(3.2, 0.16, 0.16), cf * CFrame.new(0, 40, 0), C.Gold, METAL)
	Kit.wedge(model, "WeatherVanePennant", Vector3.new(0.08, 0.9, 1.5), cf * CFrame.new(1.2, 39.8, 0) * CFrame.Angles(0, math.pi / 2, 0), C.Gold, { material = METAL })
	local sign = p(model, "LighthousePlaque", Vector3.new(4.2, 1, 0.15), cf * CFrame.new(0, 7.4, -6.4), C.Dark)
	Kit.sign(sign, "WAYFARER LIGHT", "Climb to the harbor lookout", C.Cream)
	return model
end

function Architecture.ruins(parent, cf)
	local model = Kit.model(parent, "OldCloudObservatory")
	Kit.disk(model, "WeatheredObservatoryFloor", 29, 25, 0.45, cf:PointToWorldSpace(Vector3.new(0, -0.165, 0)), C.Stone,
		{ material = Enum.Material.Limestone, collidable = true })
	for _, side in { -1, 1 } do
		local x = side * 6.4
		p(model, "ColumnPedestal", Vector3.new(3.5, 0.8, 3.5), cf * CFrame.new(x, 0.4, -1), C.Stone, Enum.Material.Limestone, true)
		for segment = 0, 2 do
			Kit.disk(model, "AgedColumnDrum", 2.45 - segment * 0.08, 2.45 - segment * 0.08, 2.2,
				cf:PointToWorldSpace(Vector3.new(x + (segment == 1 and side * 0.08 or 0), 1.9 + segment * 2.2, -1)), C.Stone:Lerp(C.Cream, segment * 0.04),
				{ material = Enum.Material.Limestone, collidable = true })
		end
		p(model, "ColumnCapital", Vector3.new(3, 0.55, 3), cf * CFrame.new(x, 7.55, -1), C.Stone, Enum.Material.Limestone)
		localBall(model, cf, "MossOnCapital", Vector3.new(2.2, 0.15, 1.4), Vector3.new(x, 7.87, -1.4), C.Moss, Enum.Material.Grass)
	end
	for i = 0, 10 do
		local angle = (i + 0.5) / 11 * math.pi
		local center = Vector3.new(math.cos(angle) * 6.4, 7.5 + math.sin(angle) * 6.4, -1)
		p(model, "RadialArchVoussoir", Vector3.new(2.03, 2.2, 2.6), cf * CFrame.new(center) * CFrame.Angles(0, 0, angle - math.pi / 2),
			i == 5 and C.Cream or C.Stone, Enum.Material.Limestone, true)
	end
	p(model, "ArchKeystoneCarving", Vector3.new(0.6, 1.25, 0.1), cf * CFrame.new(0, 13.75, -2.36), C.Gold, METAL)
	-- A legible, original telescope silhouette points above the clouds.
	local pivot = Vector3.new(0, 4.3, 4.2)
	for i = 0, 2 do
		local a = i * math.pi * 2 / 3
		localBeam(model, cf, "BrassTelescopeTripod", Vector3.new(math.sin(a) * 2.5, 0.1, 4.2 + math.cos(a) * 2.5), pivot, 0.25, C.Timber)
	end
	local start, finish = Vector3.new(0, 3.6, 6.4), Vector3.new(0, 6.2, 0.6)
	localBeam(model, cf, "TelescopeBrassBody", start, finish, 1.1, C.Gold, METAL)
	local direction = (finish - start).Unit
	localBeam(model, cf, "TelescopeObjectiveRim", finish - direction * 0.15, finish + direction * 0.2, 1.45, C.Dark, METAL)
	localBeam(model, cf, "TelescopeBlueLens", finish + direction * 0.21, finish + direction * 0.24, 1.21, C.Glass, Enum.Material.Glass)
	localBeam(model, cf, "TelescopeEyepiece", start - direction * 0.55, start, 0.45, C.Dark, METAL)
	for i = 0, 5 do
		local angle = i * math.pi / 3
		p(model, "BrokenMasonry", Vector3.new(1.8 + i % 2, 0.7 + (i % 3) * 0.35, 1.5),
			cf * CFrame.new(math.sin(angle) * 10.7, 0.5, 3 + math.cos(angle) * 7.6) * CFrame.Angles(0, angle, math.rad(5 * (i % 2))),
			C.Stone, Enum.Material.Limestone)
	end
	for _, side in { -1, 1 } do
		p(model, "ObservatoryBench", Vector3.new(5.5, 0.5, 1.6), cf * CFrame.new(side * 9, 1.4, 4), C.Stone, STONE, true)
		for _, z in { 2.9, 5.1 } do
			p(model, "BenchStoneLeg", Vector3.new(1.2, 1.3, 0.8), cf * CFrame.new(side * 9, 0.65, z), C.Stone, STONE)
		end
	end
	local sign = p(model, "ObservatoryPlaque", Vector3.new(5.4, 1.2, 0.2), cf * CFrame.new(-9.4, 2.2, -5.5) * CFrame.Angles(math.rad(12), 0, 0), C.Dark)
	Kit.sign(sign, "THE OLD OBSERVATORY", "A quiet place to watch the cloud tides", C.Cream)
	return model
end

function Architecture.props(parent, cf, kind)
	local model = Kit.model(parent, (kind or "Fishing") .. "Details")
	if kind == "Market" then
		p(model, "MarketCounter", Vector3.new(7.8, 2.7, 3.1), cf * CFrame.new(0, 1.35, 0), C.Wood, PLANKS, true)
		p(model, "CounterEdge", Vector3.new(8.2, 0.22, 3.5), cf * CFrame.new(0, 2.8, 0), C.Plank)
		for _, side in { -1, 1 } do
			p(model, "StallAwningPost", Vector3.new(0.3, 7.3, 0.3), cf * CFrame.new(side * 3.75, 3.65, 1.25), C.Timber)
			localBeam(model, cf, "AwningBrace", Vector3.new(side * 3.75, 5.2, 1.25), Vector3.new(side * 2.65, 6.9, 1.25), 0.18, C.Timber)
		end
		for i = 0, 7 do
			local color = i % 2 == 0 and C.Cream or Color3.fromRGB(103, 163, 155)
			local awningCf = cf * CFrame.new(-3.5 + i, 6.7, -0.2) * CFrame.Angles(math.rad(9), 0, 0)
			p(model, "StripedCanvasAwning", Vector3.new(0.97, 0.14, 5.2), awningCf, color, Enum.Material.Fabric)
			p(model, "ScallopedAwningValance", Vector3.new(0.97, 0.5, 0.12), cf * CFrame.new(-3.5 + i, 6.06, -2.77), color, Enum.Material.Fabric)
		end
		for _, x in { -2.3, 0, 2.3 } do
			p(model, "ProduceTray", Vector3.new(1.9, 0.35, 2.2), cf * CFrame.new(x, 3.05, 0), C.Timber, PLANKS)
			for i = 0, 2 do
				localBall(model, cf, "SeaGlassFloat", Vector3.new(0.7, 0.6, 0.7), Vector3.new(x + (i - 1) * 0.5, 3.5, 0.1 * (i % 2)),
					i == 1 and C.Gold or C.Glass, Enum.Material.Glass)
			end
		end
		local sign = p(model, "MarketPaintedSign", Vector3.new(5.2, 1, 0.15), cf * CFrame.new(0, 1.6, -1.64), C.Dark)
		Kit.sign(sign, "HARBOR SUPPLIES", "Made for a slower afternoon", C.Cream)
		barrel(model, cf * CFrame.new(5.1, 0, 0.6), 0.9)
	elseif kind == "Picnic" then
		p(model, "PicnicTableTop", Vector3.new(5.4, 0.3, 3), cf * CFrame.new(0, 2.3, 0), C.Plank, PLANKS, true)
		for _, side in { -1, 1 } do
			p(model, "PicnicBench", Vector3.new(6, 0.22, 1.2), cf * CFrame.new(0, 1.25, side * 2.5), C.Plank, WOOD, true)
			for _, x in { -1.8, 1.8 } do
				p(model, "BenchSupport", Vector3.new(0.25, 1.25, 1), cf * CFrame.new(x, 0.6, side * 2.5), C.Timber)
			end
			p(model, "TableTrestle", Vector3.new(0.28, 2.2, 2.8), cf * CFrame.new(side * 1.8, 1.1, 0) * CFrame.Angles(0, 0, side * math.rad(9)), C.Timber)
		end
		Kit.disk(model, "PicnicPlate", 0.9, 0.9, 0.05, cf:PointToWorldSpace(Vector3.new(1.4, 2.5, 0.2)), C.Cream, { material = Enum.Material.SmoothPlastic })
		localBall(model, cf, "GlazedTeapot", Vector3.new(0.75, 0.65, 0.75), Vector3.new(-0.8, 2.77, 0), C.Roof, Enum.Material.SmoothPlastic)
		localBeam(model, cf, "TeapotSpout", Vector3.new(-0.5, 2.7, 0), Vector3.new(-0.2, 2.95, 0), 0.13, C.Roof)
		Kit.lantern(model, cf:PointToWorldSpace(Vector3.new(0, 2.65, 0)), 0.5, false)
	else
		crate(model, cf * CFrame.new(-1.5, 0, 0), Vector3.new(2.5, 1.9, 2.1))
		crate(model, cf * CFrame.new(-1.3, 1.94, 0.1) * CFrame.Angles(0, math.rad(12), 0), Vector3.new(2, 1.3, 1.7))
		barrel(model, cf * CFrame.new(1.6, 0, 0.6), 0.9)
		ropeCoil(model, cf * CFrame.new(0.7, 0, -1.6), 0.75)
		Kit.disk(model, "BaitPail", 1, 1, 1.15, cf:PointToWorldSpace(Vector3.new(2.9, 0.58, -1.1)), C.Dark, { material = METAL })
		Kit.disk(model, "PailOpenTop", 0.83, 0.83, 0.035, cf:PointToWorldSpace(Vector3.new(2.9, 1.16, -1.1)), C.Timber, { material = Enum.Material.Ground })
		localBeam(model, cf, "PailHandle", Vector3.new(2.42, 0.9, -1.1), Vector3.new(2.9, 1.8, -1.1), 0.065, C.Dark, METAL)
		localBeam(model, cf, "PailHandle", Vector3.new(2.9, 1.8, -1.1), Vector3.new(3.38, 0.9, -1.1), 0.065, C.Dark, METAL)
		localBeam(model, cf, "RestingFishingRod", Vector3.new(-2, 0.2, 1), Vector3.new(-0.7, 5.1, 1.1), 0.08, C.Gold)
	end
	return model
end

return Architecture
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000011">
      <Properties>
        <string name="Name">WorldLayout</string>
        <ProtectedString name="Source">--!strict
-- Inset-free world coordinates. Heights are walking surfaces; water sits below decks.
local Layout = {}
Layout.Islands = {
	{ Id = "harbor", Name = "Sundrift Harbor", Center = {0, 12, 0}, Radius = {130, 105}, Seed = 14, Kind = "Harbor" },
	{ Id = "blossom", Name = "Petalwind Grove", Center = {-246, 28, 15}, Radius = {84, 79}, Seed = 21, Kind = "Blossom" },
	{ Id = "forest", Name = "Evergreen Reach", Center = {262, 24, -10}, Radius = {88, 92}, Seed = 35, Kind = "Forest" },
	{ Id = "cove", Name = "Tideglass Cove", Center = {-228, 4, -211}, Radius = {79, 77}, Seed = 46, Kind = "Cove" },
	{ Id = "summit", Name = "Starfall Lookout", Center = {252, 60, -244}, Radius = {72, 76}, Seed = 51, Kind = "Summit" },
}
Layout.Bridges = {
	{ Id = "petal_bridge", From = "harbor", To = "blossom", A = {-105, 12, 10}, B = {-183, 28, 12}, Width = 16 },
	{ Id = "evergreen_bridge", From = "harbor", To = "forest", A = {107, 12, 4}, B = {194, 24, -5}, Width = 16 },
	{ Id = "cove_bridge", From = "blossom", To = "cove", A = {-247, 28, -47}, B = {-232, 4, -150}, Width = 14 },
	{ Id = "summit_bridge", From = "forest", To = "summit", A = {264, 24, -83}, B = {253, 60, -189}, Width = 16 },
}
Layout.Waters = {
	{ Id = "harbor", Center = {0, 8, 166}, Radius = {65, 55} },
	{ Id = "blossom", Center = {-242, 24, 147}, Radius = {49, 47} },
	{ Id = "forest", Center = {270, 20, 144}, Radius = {48, 46} },
	{ Id = "cove", Center = {-355, 0, -211}, Radius = {48, 45} },
	{ Id = "summit", Center = {367, 56, -244}, Radius = {46, 47} },
}
Layout.Docks = {
	{ Id = "harbor", A = {0, 12, 88}, B = {0, 12, 135}, Width = 23, Spot = {0, 12.1, 126}, Yaw = math.pi },
	{ Id = "blossom", A = {-242, 28, 77}, B = {-242, 28, 123}, Width = 17, Spot = {-242, 28.1, 115}, Yaw = math.pi },
	{ Id = "forest", A = {270, 24, 69}, B = {270, 24, 119}, Width = 18, Spot = {270, 24.1, 111}, Yaw = math.pi },
	{ Id = "cove", A = {-289, 4, -211}, B = {-333, 4, -211}, Width = 18, Spot = {-325, 4.1, -211}, Yaw = math.pi / 2 },
	{ Id = "summit", A = {310, 60, -244}, B = {345, 60, -244}, Width = 17, Spot = {337, 60.1, -244}, Yaw = -math.pi / 2 },
}
Layout.Paths = {
	{ Island = "harbor", Width = 13, Points = {{0,12,-62},{5,12,-40},{4,12,-25},{4,12,3},{0,12,29},{7,12,52},{0,12,72},{0,12,90}} },
	{ Island = "harbor", Width = 11, Points = {{-106,12,10},{-77,12,9},{-36,12,7},{0,12,4},{34,12,4},{68,12,0},{108,12,4}} },
	{ Island = "harbor", Width = 8, Points = {{0,12,-30},{-20,12,-47},{-37,12,-73},{-48,12,-69}} },
	{ Island = "blossom", Width = 10, Points = {{-182,28,12},{-218,28,8},{-246,28,15},{-242,28,45},{-242,28,79}} },
	{ Island = "blossom", Width = 9, Points = {{-246,28,15},{-247,28,-16},{-247,28,-48}} },
	{ Island = "forest", Width = 10, Points = {{193,24,-5},{224,24,-5},{264,24,-8},{270,24,30},{270,24,70}} },
	{ Island = "forest", Width = 10, Points = {{264,24,-8},{264,24,-44},{264,24,-84}} },
	{ Island = "cove", Width = 10, Points = {{-232,4,-149},{-229,4,-181},{-236,4,-211},{-266,4,-211},{-290,4,-211}} },
	{ Island = "summit", Width = 10, Points = {{253,60,-188},{253,60,-216},{253,60,-244},{286,60,-244},{311,60,-244}} },
}
Layout.Spawn = {0, 12, -58}

function Layout.outline(island: any): {{ number }}
	local points = {}
	for i = 1, 20 do
		local a = (i - 1) * math.pi / 10
		local variation = 1 + math.sin(a * 3 + island.Seed) * 0.055 + math.cos(a * 5 + island.Seed) * 0.025
		table.insert(points, {island.Center[1] + math.cos(a) * island.Radius[1] * variation,
			island.Center[2], island.Center[3] + math.sin(a) * island.Radius[2] * variation})
	end
	return points
end
-- Keep a level landing over each coast. The rise occurs over open air, so a
-- sloping boardwalk cannot disappear under the higher island's solid floor.
function Layout.bridgePoints(bridge: any): {{number}}
	local from, to = nil, nil
	for _, data in Layout.Islands do
		if data.Id==bridge.From then from=data end
		if data.Id==bridge.To then to=data end
	end
	assert(from and to,"Bridge references missing islands")
	local function contains(polygon: {{number}},x: number,z: number): boolean
		local inside=false
		for i,a in polygon do
			local b=polygon[i%#polygon+1]
			if (a[3]&gt;z)~=(b[3]&gt;z) and x&lt;(b[1]-a[1])*(z-a[3])/(b[3]-a[3])+a[1] then inside=not inside end
		end
		return inside
	end
	local a,b=bridge.A,bridge.B
	local dx,dz=b[1]-a[1],b[3]-a[3]
	local distance=math.sqrt(dx*dx+dz*dz)
	local lastFrom,firstTo=0,1
	local fromPoly,toPoly=Layout.outline(from),Layout.outline(to)
	for i=0,400 do
		local t=i/400
		for _,offset in {-bridge.Width/2,0,bridge.Width/2} do
			local x,z=a[1]+dx*t-dz/distance*offset,a[3]+dz*t+dx/distance*offset
			if contains(fromPoly,x,z) then lastFrom=math.max(lastFrom,t) end
			if contains(toPoly,x,z) then firstTo=math.min(firstTo,t) end
		end
	end
	local start=lastFrom+2/distance
	local finish=firstTo-2/distance
	assert(start&lt;finish,"Bridge needs an open span between its islands")
	return {a,{a[1]+dx*start,a[2],a[3]+dz*start},{a[1]+dx*finish,b[2],a[3]+dz*finish},b}
end
return Layout
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000012">
      <Properties>
        <string name="Name">PrototypeWorld</string>
        <ProtectedString name="Source">--!strict
-- Five original, connected sky islands. World generation never changes a custom map.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Fish = require(Shared:WaitForChild("FishModel"))
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Nature = require(script.Parent:WaitForChild("WorldNature"))
local Architecture = require(script.Parent:WaitForChild("WorldArchitecture"))
local Layout = require(script.Parent:WaitForChild("WorldLayout"))
local C = Kit.palette
local World = {}
local function v(p: {number}): Vector3 return Vector3.new(p[1], p[2], p[3]) end

-- Two thin solid wedges form an exact triangle, including irregular coastlines.
local function triangle(parent: Instance, name: string, a: Vector3, b: Vector3, c: Vector3, color: Color3, material: Enum.Material, solid: boolean, shadow: boolean?)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd &gt; acd and abd &gt; bcd then c, a = a, c
	elseif acd &gt; bcd and acd &gt; abd then a, b = b, a end
	ab, ac, bc = b - a, c - a, c - b
	if ac:Cross(ab).Magnitude &lt; 0.001 then return end
	local right = ac:Cross(ab).Unit
	local back = bc.Unit
	local up = bc:Cross(right).Unit
	local height = math.abs(ab:Dot(up))
	local options = {material = material, collidable = solid, shadow = shadow ~= false}
	local thickness = if solid then 0.7 else 0.45
	local l1, l2 = math.abs(ab:Dot(back)), math.abs(ac:Dot(back))
	if l1 &gt; 0.01 then Kit.wedge(parent, name, Vector3.new(thickness, height, l1), CFrame.fromMatrix((a+b)/2, right, up, back), color, options) end
	if l2 &gt; 0.01 then Kit.wedge(parent, name, Vector3.new(thickness, height, l2), CFrame.fromMatrix((a+c)/2, -right, up, -back), color, options) end
end
local function island(parent: Instance, data: any, color: Color3, material: Enum.Material): Model
	local model = Kit.model(parent, data.Name)
	model:SetAttribute("ZoneId", data.Id)
	local center = v(data.Center)
	local edge = Layout.outline(data)
	local n = #edge
	for i = 1, n do
		local j = i % n + 1
		-- Triangle center is half the floor thickness below the declared walking surface.
		triangle(model, "WalkableMeadow", center - Vector3.yAxis * 0.35, v(edge[i]) - Vector3.yAxis * 0.35,
			v(edge[j]) - Vector3.yAxis * 0.35, color, material, true)
		local tiers = if data.Basin then { {1,-.75},{.94,-10},{.12,-40} } else { {1,-.75},{1.01,-6},{.86,-24},{.12,-57} }
		for tier = 1, #tiers - 1 do
			local top, bottom = tiers[tier], tiers[tier+1]
			local function ring(k: number, t: {number}): Vector3
				local offset = (v(edge[k]) - center) * t[1]
				return center + offset + Vector3.yAxis * t[2]
			end
			local a,b,c,d = ring(i,top),ring(j,top),ring(i,bottom),ring(j,bottom)
			local tint = if tier == 1 then C.Limestone else (if (i+tier)%3 == 0 then C.DeepStone else C.Cliff)
			triangle(model, "StratifiedCliff", a,b,c,tint,Enum.Material.Slate,false)
			triangle(model, "StratifiedCliff", b,d,c,tint,Enum.Material.Slate,false)
		end
	end
	return model
end
local function path(parent: Instance, points: {{number}}, width: number, material: Enum.Material?, tint: Color3?, lift: number?)
	-- A joined miter strip avoids coplanar disks/rectangles flickering at every bend.
	local left,right={},{}
	for i,p in points do
		local before=v(points[math.max(1,i-1)])
		local after=v(points[math.min(#points,i+1)])
		local direction=(after-before).Unit
		local normal=Vector3.new(-direction.Z,0,direction.X)
		local point=v(p)+Vector3.yAxis*(-.135+(lift or 0))
		left[i],right[i]=point+normal*width/2,point-normal*width/2
	end
	for i=1,#points-1 do
		triangle(parent,"WornFootpath",left[i],right[i],left[i+1],tint or C.Sand,material or Enum.Material.Ground,false,false)
		triangle(parent,"WornFootpath",right[i],right[i+1],left[i+1],tint or C.Sand,material or Enum.Material.Ground,false,false)
	end
end
local function waypost(parent: Instance, pos: Vector3, title: string, subtitle: string, yaw: number?)
	Kit.beam(parent,"Waypost",pos,pos+Vector3.yAxis*6,0.35,C.Wood,{material=Enum.Material.Wood})
	local board = Kit.part(parent,"TrailSign",Vector3.new(8,2.1,0.3),CFrame.new(pos+Vector3.yAxis*5.3)*CFrame.Angles(0,yaw or 0,0),C.Teal)
	Kit.sign(board,title,subtitle)
end
local function lampPost(parent: Instance, pos: Vector3, lightShadow: boolean?)
	Kit.beam(parent,"TurnedLampPost",pos,pos+Vector3.yAxis*7.6,0.3,C.Iron,{material=Enum.Material.Metal})
	Kit.beam(parent,"CurvedLampArm",pos+Vector3.yAxis*7.6,pos+Vector3.new(1.2,7.6,0),0.2,C.Iron)
	Kit.lantern(parent,pos+Vector3.new(1.2,6,0),0.9,lightShadow)
end
local function water(parent: Instance, data: any)
	local center = v(data.Center)
	-- Native Terrain water supplies Roblox's own wave and reflection shader.
	local min = center - Vector3.new(data.Radius[1]+4, 8, data.Radius[2]+4)
	local max = center + Vector3.new(data.Radius[1]+4, 0, data.Radius[2]+4)
	local region = Region3.new(min,max):ExpandToGrid(4)
	local size = region.Size / 4
	local origin = region.CFrame.Position - region.Size / 2
	local materials, occupancy = {}, {}
	for x = 1, size.X do
		materials[x], occupancy[x] = {}, {}
		for y = 1, size.Y do
			materials[x][y], occupancy[x][y] = {}, {}
			for z = 1, size.Z do
				local p = origin + Vector3.new((x-.5)*4,(y-.5)*4,(z-.5)*4)
				local inside = ((p.X-center.X)/data.Radius[1])^2+((p.Z-center.Z)/data.Radius[2])^2 &lt; 1
				materials[x][y][z] = if inside then Enum.Material.Water else Enum.Material.Air
				occupancy[x][y][z] = if inside then 1 else 0
			end
		end
	end
	workspace.Terrain:WriteVoxels(region,4,materials,occupancy)
	-- Lower basin, exposed stone collar, reeds and a small cascade over the rim.
	local basin = {Id=data.Id.."_lagoon",Name="SuspendedLagoon",Center={center.X,center.Y-5,center.Z},Radius={data.Radius[1]+5,data.Radius[2]+5},Seed=13,Basin=true}
	local model = island(parent,basin,Color3.fromRGB(115,164,141),Enum.Material.Sand)
	for i = 1, 12 do
		local a=i*math.pi/6
		local p=center+Vector3.new(math.cos(a)*(data.Radius[1]+2),-.8,math.sin(a)*(data.Radius[2]+2))
		Nature.rock(model,p,Vector3.new(5.5,2.8,4.6),i*11,true)
	end
	for i = 1, 9 do
		local a = i*2.4
		local glint = Kit.beam(model,"WaterGlint",center+Vector3.new(math.cos(a)*data.Radius[1]*.65,.16,math.sin(a)*data.Radius[2]*.65),
			center+Vector3.new(math.cos(a)*data.Radius[1]*.65+2.5,.16,math.sin(a)*data.Radius[2]*.65),.045,C.Cream,{shadow=false,transparency=.78})
		glint:SetAttribute("GlintPhase",i)
	end
	local fallPos = center + Vector3.new(data.Radius[1]*.45,0,data.Radius[2]*.89)
	for i = -1,1 do
		Kit.part(model,"WaterfallCurtain",Vector3.new(2.8,55,0.2),CFrame.new(fallPos+Vector3.new(i*2.6,-27.5,0)),C.Water,
			{material=Enum.Material.Glass,transparency=.33,shadow=false})
		local streak=Kit.part(model,"FlowStreak",Vector3.new(.14,8,0.1),CFrame.new(fallPos+Vector3.new(i*2.5,-27,0.2)),C.Cream,{shadow=false,transparency=.58})
		streak:SetAttribute("FlowStart",streak.CFrame)
		streak:SetAttribute("FlowPhase",i*.27)
		streak:SetAttribute("FlowDistance",48)
		streak:SetAttribute("FlowSpeed",12)
	end
	Nature.cloud(model,fallPos-Vector3.yAxis*55,Vector3.new(21,8,14),83)
end
local function plaza(parent: Instance)
	Kit.disk(parent,"TownSquare",45,45,.2,Vector3.new(-8,12.11,-2),C.Limestone,{material=Enum.Material.Cobblestone})
	-- Small koi fountain: clear routes pass either side, not through its bowl.
	local f=Kit.model(parent,"CloudKoiFountain")
	Kit.disk(f,"FountainBase",11,11,.4,Vector3.new(-17,12.4,-14),C.Stone,{material=Enum.Material.Marble,collidable=true})
	Kit.disk(f,"Basin",9.6,9.6,.65,Vector3.new(-17,13,-14),C.Limestone,{material=Enum.Material.Marble,collidable=true})
	Kit.disk(f,"FountainWater",8.8,8.8,.08,Vector3.new(-17,13.37,-14),C.Water,{material=Enum.Material.Glass,transparency=.22,shadow=false})
	Kit.disk(f,"Pedestal",2.7,2.7,2,Vector3.new(-17,14,-14),C.Stone,{material=Enum.Material.Marble})
	local koi=Fish.create(f,"GoldenKoi","pufflet")
	koi:PivotTo(CFrame.new(-17,16,-14)*CFrame.Angles(0,.4,.2))
	for _,p in koi:GetChildren() do if p:IsA("BasePart") then p.Material=Enum.Material.Metal; p.Color=C.Brass; p.CastShadow=true end end
end
local function windmill(parent: Instance, pos: Vector3)
	local model=Kit.model(parent,"PetalwindMill")
	Kit.disk(model,"StonePlinth",12,12,.5,pos+Vector3.yAxis*.25,C.Limestone,{material=Enum.Material.Cobblestone,collidable=true})
	for i=0,7 do
		local a=i*math.pi/4
		Kit.part(model,"MillWall",Vector3.new(4.2,18,.5),CFrame.new(pos+Vector3.new(math.sin(a)*4.6,9,math.cos(a)*4.6))*CFrame.Angles(0,a,0),C.Cream,{material=Enum.Material.Plaster,collidable=true})
	end
	for i=0,7 do
		local a=i*math.pi/4
		Kit.wedge(model,"MillRoof",Vector3.new(4.4,5,6),CFrame.new(pos+Vector3.new(math.sin(a)*2,20,math.cos(a)*2))*CFrame.Angles(0,a,0),C.Teal,{material=Enum.Material.Slate})
	end
	local origin=CFrame.new(pos+Vector3.new(0,15,-6))
	local rotor=Kit.model(model,"MillBlades")
	rotor.WorldPivot=origin
	for i=0,3 do
		local cf=origin*CFrame.Angles(0,0,i*math.pi/2)
		Kit.part(rotor,"SailSpar",Vector3.new(.35,15,.35),cf*CFrame.new(0,7,0),C.Wood,{material=Enum.Material.Wood})
		Kit.part(rotor,"CanvasSail",Vector3.new(2.5,10,.16),cf*CFrame.new(1.2,8.5,0),C.Cream,{material=Enum.Material.Fabric})
		for n=1,4 do Kit.part(rotor,"SailBatten",Vector3.new(2.7,.13,.2),cf*CFrame.new(1.2,4+n*2,0),C.Wood) end
	end
	Kit.ball(rotor,"Hub",Vector3.new(2,2,1),origin.Position,C.Brass,{material=Enum.Material.Metal})
	rotor:SetAttribute("SpinOrigin",origin)
	rotor:SetAttribute("SpinRate",.13)
end
local function hill(parent: Instance, pos: Vector3, width: number, depth: number, height: number)
	local peak=pos+Vector3.yAxis*height
	for i=1,10 do
		local a,b=i*math.pi/5,(i+1)*math.pi/5
		triangle(parent,"GrassyKnoll",peak,pos+Vector3.new(math.cos(a)*width/2,.04,math.sin(a)*depth/2),
			pos+Vector3.new(math.cos(b)*width/2,.04,math.sin(b)*depth/2),C.Grass,Enum.Material.Grass,true)
	end
end
local function townDetails(parent: Instance)
	-- Waist-high planters frame the square without blocking either main route.
	for i,pos in {Vector3.new(-34,12,-9),Vector3.new(21,12,19),Vector3.new(-18,12,31)} do
		local model=Kit.model(parent,"SquarePlanter")
		Kit.part(model,"LimestoneBox",Vector3.new(9,.9,4),CFrame.new(pos+Vector3.yAxis*.45),C.Limestone,{material=Enum.Material.Limestone,collidable=true})
		Kit.part(model,"DarkSoil",Vector3.new(8.3,.12,3.3),CFrame.new(pos+Vector3.yAxis*.96),C.Wood,{material=Enum.Material.Ground,shadow=false})
		Nature.garden(model,pos+Vector3.yAxis*1.05,Vector2.new(3.4,1.2),8,i*71,"Lavender")
	end
	Architecture.props(parent,CFrame.new(-26,12,23)*CFrame.Angles(0,math.pi/2,0),"Picnic")
	Architecture.props(parent,CFrame.new(30,12,53)*CFrame.Angles(0,-.4,0),"Picnic")
	-- A generous casting entrance: beam and lights sit above avatar head height.
	local gate=Kit.model(parent,"SundriftPierGateway")
	for _,x in {-13,13} do
		Kit.beam(gate,"TurnedPierPost",Vector3.new(x,12,84),Vector3.new(x,23,84),.8,C.Wood,{material=Enum.Material.Wood,collidable=true})
		Kit.beam(gate,"GatewayBrace",Vector3.new(x,20,84),Vector3.new(x*.7,23,84),.4,C.Wood)
		Kit.lantern(gate,Vector3.new(x*.85,20.4,84),1,false)
	end
	Kit.part(gate,"CarvedLintel",Vector3.new(28,.7,1),CFrame.new(0,23,84),C.Wood,{material=Enum.Material.Wood})
	local sign=Kit.part(gate,"PierName",Vector3.new(13,2.7,.28),CFrame.new(0,21.3,83.7),C.Teal)
	Kit.sign(sign,"SUNDRIFT PIER","A new discovery is one cast away")
	for _,x in {-9,9} do
		local banner=Kit.part(gate,"LinenPennant",Vector3.new(1.3,3.1,.06),CFrame.new(x,21,84),C.Coral,{material=Enum.Material.Fabric})
		banner.CanCollide=false
	end
	hill(parent,Vector3.new(76,12,64),33,30,5)
	Nature.tree(parent,Vector3.new(76,17,64),.9,"Oak",233)
	hill(parent,Vector3.new(-102,12,-31),28,33,4)
	Nature.tree(parent,Vector3.new(-102,16,-31),.85,"Oak",237)
end
local function grotto(parent: Instance, cf: CFrame)
	local model=Kit.model(parent,"TideglassGrotto")
	for _,side in {-1,1} do
		Kit.wedge(model,"WeatheredArchPillar",Vector3.new(8,13,12),cf*CFrame.new(side*8,6.5,0)*CFrame.Angles(0,side*math.pi/2,0),C.DeepStone,{material=Enum.Material.Slate,collidable=true})
		Kit.part(model,"PillarCore",Vector3.new(5,12,8),cf*CFrame.new(side*8,6,-1),C.Cliff,{material=Enum.Material.Slate,collidable=true})
	end
	Kit.part(model,"ShadedCaveRoof",Vector3.new(24,5,13),cf*CFrame.new(0,14,0),C.Cliff,{material=Enum.Material.Slate,collidable=true})
	Kit.part(model,"CaveBackWall",Vector3.new(24,12,1),cf*CFrame.new(0,6,5.5),C.DeepStone,{material=Enum.Material.Slate,collidable=true})
	Nature.rock(model,cf:PointToWorldSpace(Vector3.new(-3,16.3,1)),Vector3.new(19,5,12),607,true)
	for i=1,6 do
		local x=(i-3.5)*1.4
		local crystal=Kit.wedge(model,"TideglassCrystal",Vector3.new(.8,2+i%3,1),cf*CFrame.new(x,1.1,3.6)*CFrame.Angles(0,i*.6,-.12+x*.03),
			if i%2==0 then C.Water else C.Lavender,{material=Enum.Material.Neon,shadow=false})
		crystal.Transparency=.12
	end
	local sign=Kit.part(model,"GrottoPlaque",Vector3.new(5.4,1.6,.2),cf*CFrame.new(9,2,-6.3),C.Teal)
	Kit.sign(sign,"TIDEGLASS GROTTO","A little shade beneath the palms")
end
local function skyship(parent: Instance)
	local model=Kit.model(parent,"SkySail")
	local o=Vector3.new(15,91,266)
	Kit.ball(model,"LinenEnvelope",Vector3.new(25,19,48),o,C.Cream,{material=Enum.Material.Fabric})
	for _,z in {-12,0,12} do
		Kit.ball(model,"EnvelopeBand",Vector3.new(25.25,19.25,2.6),o+Vector3.new(0,0,z),C.Coral,{material=Enum.Material.Fabric})
	end
	Kit.part(model,"BoatCabin",Vector3.new(9,5,16),CFrame.new(o+Vector3.new(0,-17,0)),C.Wood,{material=Enum.Material.WoodPlanks})
	for _,x in {-4.6,4.6} do
		for _,z in {-7,7} do Kit.beam(model,"AirshipRigging",o+Vector3.new(x,-15,z),o+Vector3.new(x,-7,z*1.5),.13,C.Iron) end
	end
	Kit.wedge(model,"TailFin",Vector3.new(.4,10,12),CFrame.new(o+Vector3.new(0,1,26)),C.Teal,{material=Enum.Material.Fabric})
	model:SetAttribute("DriftOrigin",model:GetPivot())
end
function World.create(): BasePart
	assert(not workspace:FindFirstChild("MolnfiskarnaPrototype"),"World already exists. Disable CreatePrototypeWorld to use a custom map.")
	local root=Instance.new("Folder")
	root.Name="MolnfiskarnaPrototype"
	-- Build before parenting: each streamed model arrives with its geometry/attributes.
	local regions={}
	-- An early spawn platform holds joining avatars while the larger world is built.
	local spawn=Instance.new("SpawnLocation")
	spawn.Name,spawn.Size,spawn.CFrame="HarborSpawn",Vector3.new(14,.3,14),CFrame.new(v(Layout.Spawn)+Vector3.yAxis*.2)*CFrame.Angles(0,math.pi,0)
	spawn.Anchored,spawn.Neutral,spawn.Duration,spawn.Transparency,spawn.CastShadow=true,true,0,1,false
	spawn.Parent=workspace
	Lighting.ClockTime,Lighting.Brightness,Lighting.GlobalShadows=15.2,2.5,true
	Lighting.ShadowSoftness=.32
	Lighting.Ambient,Lighting.OutdoorAmbient=Color3.fromRGB(65,83,100),Color3.fromRGB(111,130,142)
	Lighting.EnvironmentDiffuseScale,Lighting.EnvironmentSpecularScale=.7,.8
	local atmosphere=Instance.new("Atmosphere")
	atmosphere.Name,atmosphere.Density,atmosphere.Offset,atmosphere.Haze,atmosphere.Glare="SundriftAtmosphere",.21,.15,1,.1
	atmosphere.Color,atmosphere.Decay,atmosphere.Parent=Color3.fromRGB(216,232,233),Color3.fromRGB(143,167,188),Lighting
	local sky=Instance.new("Sky")
	sky.Name,sky.SunAngularSize,sky.MoonAngularSize,sky.StarCount,sky.Parent="SundriftSky",9,9,800,Lighting
	local clouds=Instance.new("Clouds")
	clouds.Name,clouds.Cover,clouds.Density,clouds.Color,clouds.Parent="HighClouds",.28,.38,C.Cloud,workspace.Terrain
	local color=Instance.new("ColorCorrectionEffect")
	color.Name,color.Saturation,color.Contrast,color.TintColor,color.Parent="HarborGrade",.05,.07,Color3.fromRGB(255,246,229),Lighting
	local bloom=Instance.new("BloomEffect")
	bloom.Name,bloom.Intensity,bloom.Threshold,bloom.Size,bloom.Parent="LanternBloom",.08,1.9,24,Lighting
	local rays=Instance.new("SunRaysEffect")
	rays.Intensity,rays.Spread,rays.Parent=.025,.85,Lighting
	workspace.Terrain.WaterColor,workspace.Terrain.WaterReflectance,workspace.Terrain.WaterTransparency=C.Water,.45,.25
	workspace.Terrain.WaterWaveSize,workspace.Terrain.WaterWaveSpeed=.14,7
	for _,data in Layout.Islands do
		local tint=if data.Kind=="Cove" then C.Sand elseif data.Kind=="Summit" then C.Moss else C.Grass
		regions[data.Id]=island(root,data,tint,if data.Kind=="Cove" then Enum.Material.Sand else Enum.Material.Grass)
	end
	for i,data in Layout.Paths do path(regions[data.Island],data.Points,data.Width,nil,nil,i*.012) end
	-- The fountain has a broad walkable ring; the main trail goes around its center.
	plaza(regions.harbor)
	townDetails(regions.harbor)
	Architecture.cottage(regions.harbor,CFrame.new(52,12,-20)*CFrame.Angles(0,math.pi,0),26,22,Color3.fromRGB(220,215,176),"Workshop")
	Architecture.cottage(regions.harbor,CFrame.new(-52,12,-20)*CFrame.Angles(0,math.pi,0),26,22,Color3.fromRGB(237,207,169),"Cafe")
	Architecture.cottage(regions.harbor,CFrame.new(67,12,-48)*CFrame.Angles(0,math.pi/4,0),21,18,Color3.fromRGB(208,218,183),"Cottage")
	Architecture.lighthouse(regions.harbor,CFrame.new(-48,12,-60))
	Architecture.props(regions.harbor,CFrame.new(-72,12,43)*CFrame.Angles(0,-.3,0),"Market")
	Architecture.props(regions.harbor,CFrame.new(66,12,43),"Market")
	Architecture.props(regions.harbor,CFrame.new(-46,12,27),"Picnic")
	Architecture.props(regions.harbor,CFrame.new(16,12,85),"Fishing")
	windmill(regions.blossom,Vector3.new(-272,28,35))
	Architecture.props(regions.blossom,CFrame.new(-216,28,47),"Picnic")
	Architecture.cottage(regions.forest,CFrame.new(299,24,-36)*CFrame.Angles(0,math.pi/2,0),20,17,Color3.fromRGB(184,201,169),"Cottage")
	Architecture.props(regions.forest,CFrame.new(249,24,45),"Fishing")
	Architecture.ruins(regions.summit,CFrame.new(244,60,-268))
	Architecture.props(regions.summit,CFrame.new(285,60,-224),"Picnic")
	Architecture.props(regions.cove,CFrame.new(-250,4,-235),"Fishing")
	Architecture.props(regions.cove,CFrame.new(-211,4,-201),"Picnic")
	grotto(regions.cove,CFrame.new(-227,4,-246)*CFrame.Angles(0,math.pi,0))
	for _,bridge in Layout.Bridges do
		local points=Layout.bridgePoints(bridge)
		for i=1,#points-1 do Architecture.dock(root,v(points[i]),v(points[i+1]),bridge.Width,bridge.Id.."_"..i,true) end
	end
	local spots=Instance.new("Folder")
	spots.Name,spots.Parent="FishingSpots",root
	local first: BasePart?=nil
	for _,data in Layout.Waters do water(root,data) end
	for _,dock in Layout.Docks do
		local deck=Architecture.dock(root,v(dock.A),v(dock.B),dock.Width,dock.Id.."_pier",true)
		local zone=nil
		for _,w in Layout.Waters do if w.Id==dock.Id then zone=w end end
		local spot=Kit.part(spots,"FishingSpot",Vector3.new(dock.Width-5,.05,10),CFrame.new(v(dock.Spot))*CFrame.Angles(0,dock.Yaw,0),C.Teal,{transparency=.72,shadow=false})
		spot:SetAttribute("ZoneId",dock.Id)
		for _,region in Layout.Islands do if region.Id==dock.Id then spot:SetAttribute("ZoneName",region.Name) end end
		spot:SetAttribute("WaterY",zone.Center[2])
		if not first then first=spot end
		local basis=CFrame.lookAt(v(dock.A),v(dock.B))
		Architecture.props(deck,basis*CFrame.new(dock.Width*.34,0,-5),"Fishing")
	end
	-- Deliberate clearings keep the paths, entrances and vistas open.
	local trees: {{any}}={
		{"harbor",-92,12,-25,1.25,"Oak"},{"harbor",90,12,34,1.35,"Oak"},{"harbor",-87,12,65,1.2,"Oak"},
		{"harbor",45,12,-72,1.05,"Blossom"},{"harbor",-75,12,-72,1.15,"Oak"},{"harbor",86,12,-17,1.0,"Oak"},
		{"blossom",-283,28,-23,1.25,"Blossom"},{"blossom",-211,28,-20,1.2,"Blossom"},{"blossom",-290,28,64,1.1,"Blossom"},
		{"blossom",-223,28,55,1,"Blossom"},{"blossom",-268,28,-35,1.15,"Blossom"},
		{"forest",221,24,27,1.25,"Pine"},{"forest",235,24,-42,1.65,"Pine"},{"forest",289,24,49,1.35,"Pine"},
		{"forest",319,24,3,1.7,"Pine"},{"forest",300,24,-65,1.3,"Pine"},{"forest",281,24,-66,1.15,"Pine"},
		{"forest",228,24,48,1.2,"Oak"},{"forest",307,24,30,1.1,"Pine"},
		{"cove",-269,4,-179,1.4,"Palm"},{"cove",-199,4,-236,1.55,"Palm"},{"cove",-259,4,-251,1.2,"Palm"},
		{"cove",-207,4,-167,1.15,"Palm"},{"cove",-278,4,-226,1.3,"Palm"},
		{"summit",219,60,-213,.95,"Pine"},{"summit",291,60,-274,1.1,"Pine"},
	}
	for i,t in trees do Nature.tree(regions[t[1]],Vector3.new(t[2],t[3],t[4]),t[5],t[6],i*17) end
	local gardens: {{any}}={
		{"harbor",-30,12,-25,10,7,20},{"harbor",28,12,35,14,9,24},{"harbor",-36,12,61,15,8,22},
		{"blossom",-280,28,1,11,9,24},{"blossom",-213,28,33,9,8,20},{"forest",239,24,23,12,10,25},
		{"forest",293,24,19,11,7,22},{"summit",223,60,-266,12,9,24},{"cove",-253,4,-185,9,8,18},
	}
	for i,g in gardens do Nature.garden(regions[g[1]],Vector3.new(g[2],g[3],g[4]),Vector2.new(g[5],g[6]),g[7],i*53,if g[1]=="summit" then "Lavender" else "Grass") end
	for i,pos in {Vector3.new(-95,12,34),Vector3.new(87,12,-58),Vector3.new(-289,28,38),Vector3.new(321,24,-29),Vector3.new(-182,4,-211),Vector3.new(210,60,-254)} do
		Nature.rock(root,pos,Vector3.new(11+i%3*2,8+i%2*4,9),i*19,true)
	end
	for _,p in {Vector3.new(-20,12,-35),Vector3.new(20,12,42),Vector3.new(-18,12,75),Vector3.new(-105,12,18),Vector3.new(107,12,12)} do lampPost(root,p,false) end
	waypost(root,Vector3.new(20,12,-19),"SUNDRIFT HARBOR","Rod &amp; Reel / Main Pier")
	waypost(root,Vector3.new(-94,12,20),"PETALWIND GROVE","Blossom walks / Tideglass Cove",math.pi/2)
	waypost(root,Vector3.new(96,12,-10),"EVERGREEN REACH","Forest Pier / Starfall Lookout",-math.pi/2)
	waypost(root,Vector3.new(274,24,-67),"STARFALL LOOKOUT","Follow the rising bridge")
	waypost(root,Vector3.new(-261,28,-33),"TIDEGLASS COVE","Palm shade / Quiet water")
	spawn.Parent=root
	local preview=Fish.create(root,"PuffletPreview","pufflet")
	local display=CFrame.new(0,12,162)
	preview:PivotTo(display)
	preview:SetAttribute("DisplayOrigin",display)
	skyship(root)
	-- Distant cloud banks frame the playable islands rather than covering walkways.
	for i=1,14 do
		local a=i*math.pi/7
		Nature.cloud(root,Vector3.new(math.cos(a)*490,-72,math.sin(a)*390-40),Vector3.new(88,22,55),i*13)
	end
	local largeModels={}
	for _,region in regions do largeModels[region]=true end
	for _,model in root:GetDescendants() do
		if model:IsA("Model") and not largeModels[model] and model.Name~="SuspendedLagoon" then
			model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
		end
	end
	root.Parent=workspace
	assert(first,"Map needs a primary fishing spot")
	return first
end
function World.findCustom(): BasePart
	local folder=workspace:FindFirstChild("World")
	local spot=if folder then folder:FindFirstChild("FishingSpot") else nil
	assert(spot and spot:IsA("BasePart"),"Create an anchored Part at Workspace.World.FishingSpot.")
	return spot :: BasePart
end
return World
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000013">
      <Properties>
        <string name="Name">FishingLocations</string>
        <ProtectedString name="Source">--!strict
-- Pure location selection and attempt binding. Distances and world validity are
-- supplied by the server adapter; clients never choose their fishing location.
type Candidate = { location: any, distance: number }
type Binding = { attemptId: number, location: any }
local Locations = {}
Locations.__index = Locations
type Data = { bindings: { [number]: Binding } }
export type LocationState = typeof(setmetatable({} :: Data, Locations))

function Locations.nearest(candidates: { Candidate }, maxDistance: number): any?
	if maxDistance ~= maxDistance or maxDistance &lt; 0 or maxDistance == math.huge then return nil end
	local nearest, distance = nil, maxDistance
	for _, candidate in candidates do
		local d = candidate.distance
		if candidate.location ~= nil and d == d and d &gt;= 0 and d &lt; math.huge
			and d &lt;= maxDistance and (nearest == nil or d &lt; distance) then
			nearest, distance = candidate.location, d
		end
	end
	return nearest
end

function Locations.new(): LocationState
	return setmetatable({ bindings = {} }, Locations)
end

function Locations.forAttempt(self: LocationState, userId: number, attemptId: number?): any?
	local binding = self.bindings[userId]
	return if binding and binding.attemptId == attemptId then binding.location else nil
end

function Locations.last(self: LocationState, userId: number): any?
	local binding = self.bindings[userId]
	return if binding then binding.location else nil
end

function Locations.acceptStart(
	self: LocationState, userId: number, previousAttemptId: number?, packet: any, location: any
): boolean
	-- Commit only after the state machine accepts a new Start. Rejected requests,
	-- retries, cooldowns and completed casts must preserve the last visual target.
	if previousAttemptId ~= nil or location == nil or packet == nil or packet.phase ~= "Waiting"
		or type(packet.attemptId) ~= "number" or packet.attemptId ~= packet.attemptId
		or packet.attemptId &lt;= 0 or packet.attemptId == math.huge then return false end
	self.bindings[userId] = { attemptId = packet.attemptId, location = location }
	return true
end

function Locations.remove(self: LocationState, userId: number)
	self.bindings[userId] = nil
end

return Locations
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000014">
      <Properties>
        <string name="Name">FishingService</string>
        <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Config = require(Shared:WaitForChild("FishingConfig"))
local Rules = require(Shared:WaitForChild("FishingRules"))
local Catalog = require(Shared:WaitForChild("FishCatalog"))
local Engine = require(script.Parent:WaitForChild("FishingEngine"))
local Progression = require(script.Parent:WaitForChild("FishingProgression"))
local ProfileStore = require(script.Parent:WaitForChild("FishingProfileStore"))
local Locations = require(script.Parent:WaitForChild("FishingLocations"))
local World = require(script.Parent:WaitForChild("PrototypeWorld"))
local Service = {}
local started = false

function Service.start()
	assert(not started, "FishingService has already started")
	started = true
	local spot = if Config.CreatePrototypeWorld then World.create() else World.findCustom()
	local fishingSpots: { BasePart } = { spot }
	if Config.CreatePrototypeWorld then
		local world = workspace:FindFirstChild("MolnfiskarnaPrototype")
		local spots = if world then world:FindFirstChild("FishingSpots") else nil
		if spots then
			for _, child in spots:GetDescendants() do
				if child:IsA("BasePart") and child.Name == "FishingSpot" and child ~= spot then
					table.insert(fishingSpots, child)
				end
			end
		end
	end
	local locations = Locations.new()
	assert(not ReplicatedStorage:FindFirstChild("FishingRemotes"), "Install one fishing server only.")
	local remotes = Instance.new("Folder")
	remotes.Name = "FishingRemotes"
	local function remote(name: string): RemoteEvent
		local event = Instance.new("RemoteEvent")
		event.Name, event.Parent = name, remotes
		return event
	end
	local action, state, visual = remote("FishingAction"), remote("FishingState"), remote("FishingVisual")
	local random = Random.new()
	local progression = Progression.new(Catalog, function() return random:NextNumber() end)
	local engine = Engine.new(Config, Rules, progression)
	local saving = Config.EnableSaving and (not RunService:IsStudio() or Config.SaveInStudio)
	local store = if saving then ProfileStore.new(Catalog, progression, RunService:IsStudio()) else nil
	local sessions: { [Player]: any } = {}
	local loading: { [Player]: boolean } = {}
	local welcome: { [Player]: any } = {}
	local connections: { [Player]: RBXScriptConnection } = {}
	local lastVisual: { [Player]: string } = {}
	local activeAttempts: { [Player]: number } = {}
	local closing, pendingReleases = false, 0

	local function describeLocation(player: Player, fishingSpot: BasePart)
		local lane = (player.UserId % 4 - 1.5) * 2
		local target = (fishingSpot.CFrame * CFrame.new(lane, -1.2, -14)).Position
		local waterY = fishingSpot:GetAttribute("WaterY")
		if type(waterY) == "number" and waterY == waterY and math.abs(waterY) &lt; math.huge then
			target = Vector3.new(target.X, waterY + 0.2, target.Z)
		end
		local zoneId, zoneName = fishingSpot:GetAttribute("ZoneId"), fishingSpot:GetAttribute("ZoneName")
		return {
			spot = fishingSpot, target = target,
			zoneId = if type(zoneId) == "string" then zoneId else nil,
			zoneName = if type(zoneName) == "string" then zoneName else nil,
		}
	end
	local function decorate(player: Player, packet: any)
		local location = locations:last(player.UserId) or describeLocation(player, spot)
		packet.castTarget = location.target
		packet.zoneId, packet.zoneName = location.zoneId, location.zoneName
		return packet
	end
	local function publicVisual(player: Player, packet: any)
		local result = packet.result
		return decorate(player, {
			phase = packet.phase, catches = packet.catches, attemptId = packet.attemptId,
			readyAt = packet.readyAt, chargeAt = packet.chargeAt,
			rodLevel = if packet.profile then packet.profile.level else 0,
			result = if result then {
				species = result.species, speciesId = result.speciesId, quality = result.quality,
				rarity = result.rarity, newDiscovery = result.newDiscovery,
			} else nil,
		})
	end
	local function emit(player: Player, packet: any)
		activeAttempts[player] = packet.attemptId
		decorate(player, packet)
		local profile = packet.profile
		if profile then profile.persistent = saving; profile.offlineRate = profile.species * 0.25 end
		if welcome[player] then packet.offline = welcome[player]; welcome[player] = nil end
		state:FireClient(player, packet)
		local stats = player:FindFirstChild("leaderstats")
		local score = if stats then stats:FindFirstChild("Collection") else nil
		if score and score:IsA("IntValue") and profile then score.Value = profile.points end
		local key = packet.phase .. ":" .. tostring(packet.attemptId) .. ":" .. packet.catches
			.. ":" .. (if profile then profile.level else 0)
		if lastVisual[player] ~= key then
			lastVisual[player] = key
			visual:FireAllClients(player.UserId, publicVisual(player, packet))
		end
	end
	local function fishingPosition(player: Player): Vector3?
		local character = player.Character
		if not character then return nil end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		return if humanoid and humanoid.Health &gt; 0 and root and root:IsA("BasePart") then root.Position else nil
	end
	local function validSpot(fishingSpot: BasePart): boolean
		return fishingSpot.Anchored and fishingSpot:IsDescendantOf(workspace)
	end
	local function nearestLocation(player: Player)
		local position = fishingPosition(player)
		if not position then return nil end
		local candidates = {}
		for _, fishingSpot in fishingSpots do
			if validSpot(fishingSpot) then
				table.insert(candidates, {
					location = describeLocation(player, fishingSpot),
					distance = (position - fishingSpot.Position).Magnitude,
				})
			end
		end
		return Locations.nearest(candidates, Config.MaxDistance)
	end
	local function canFish(player: Player, location: any): boolean
		local position = fishingPosition(player)
		return position ~= nil and location ~= nil and validSpot(location.spot)
			and (position - location.spot.Position).Magnitude &lt;= Config.MaxDistance
	end
	local function release(session: any, profile: any)
		if not store or session.closed or session.releaseRequested then return end
		session.releaseRequested = true
		pendingReleases += 1
		task.spawn(function()
			local deadline = os.clock() + 20
			while session.busy and os.clock() &lt; deadline do task.wait(0.1) end
			local ok, reason = store.save(session, profile, true)
			if not ok then warn("Cloud Anglers: final save failed: " .. tostring(reason)) end
			pendingReleases -= 1
		end)
	end
	local function addPlayer(player: Player)
		if loading[player] or connections[player] then return end
		loading[player] = true
		task.spawn(function()
			local session, reason = nil, nil
			if store then session, reason = store.load(player.UserId) end
			loading[player] = nil
			if store and not session then
				warn("Cloud Anglers: profile load blocked: " .. tostring(reason))
				if player.Parent == Players then player:Kick("Your progress could not be loaded safely. Please rejoin in a moment.") end
				return
			end
			if player.Parent ~= Players or closing then
				if session then release(session, session.profile) end
				return
			end
			if session then sessions[player] = session; welcome[player] = session.offline end
			engine:addPlayer(player.UserId, workspace:GetServerTimeNow(), if session then session.profile else nil)
			local stats = player:FindFirstChild("leaderstats") or Instance.new("Folder")
			stats.Name, stats.Parent = "leaderstats", player
			if not stats:FindFirstChild("Collection") then
				local score = Instance.new("IntValue")
				score.Name, score.Parent = "Collection", stats
			end
			connections[player] = player.CharacterRemoving:Connect(function()
				local packet = engine:interrupt(player.UserId, workspace:GetServerTimeNow(), "Fishing stopped. Return to the dock after respawning.")
				if packet and player.Parent == Players then emit(player, packet) end
			end)
			-- The client asks for Sync after subscribing; it also retries while data loads.
		end)
	end
	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(function(player)
		local profile = engine:exportProfile(player.UserId)
		local session = sessions[player]
		if session and profile then release(session, profile) end
		local connection = connections[player]
		if connection then connection:Disconnect() end
		connections[player], sessions[player], welcome[player], lastVisual[player] = nil, nil, nil, nil
		activeAttempts[player] = nil
		locations:remove(player.UserId)
		engine:removePlayer(player.UserId)
	end)
	for _, player in Players:GetPlayers() do addPlayer(player) end
	action.OnServerEvent:Connect(function(player, verb, attemptId)
		if closing then return end
		local session = sessions[player]
		if session and os.time() &gt;= session.expires then return end
		-- All state transitions emit synchronously. Keep only the active attempt ID
		-- here, avoiding a full profile snapshot before a request is rate-limited.
		local previousAttemptId = activeAttempts[player]
		local location = locations:forAttempt(player.UserId, previousAttemptId)
		if verb == "Start" and connections[player] and previousAttemptId == nil then location = nearestLocation(player) end
		local packet = engine:command(player.UserId, verb, attemptId, workspace:GetServerTimeNow(), canFish(player, location))
		if packet then
			if verb == "Start" then locations:acceptStart(player.UserId, previousAttemptId, packet, location) end
			emit(player, packet)
			if verb == "Sync" then
				for _, other in Players:GetPlayers() do
					local otherPacket = engine:snapshot(other.UserId)
					if other ~= player and otherPacket and otherPacket.phase ~= "Idle" then
						visual:FireClient(player, other.UserId, publicVisual(other, otherPacket))
					end
				end
			end
		end
	end)
	local elapsed = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		if closing then return end
		elapsed += deltaTime
		if elapsed &lt; 0.1 then return end
		elapsed = 0
		local now = workspace:GetServerTimeNow()
		for _, player in Players:GetPlayers() do
			local packet = engine:tick(player.UserId, now, canFish(player, locations:last(player.UserId)))
			if packet then emit(player, packet) end
			local session = sessions[player]
			if session and not session.releaseRequested then
				if os.time() &gt;= session.expires then
					player:Kick("Saving connection was interrupted. Please rejoin to protect your progress.")
				elseif not session.busy and os.clock() - session.lastSave &gt;= 30 then
					local profile = engine:exportProfile(player.UserId)
					if profile then
						task.spawn(function()
							local ok, reason = store.save(session, profile, false)
							if not ok then
								warn("Cloud Anglers: autosave failed: " .. tostring(reason))
								-- Back off; do not exhaust DataStore budgets on every heartbeat.
								session.lastSave = os.clock()
								if reason == "lost_lease" or reason == "invalid_data" then
									player:Kick("Your save session changed. Please rejoin safely.")
								end
							end
						end)
					end
				end
			end
		end
	end)
	game:BindToClose(function()
		closing = true
		for player, session in sessions do
			local profile = engine:exportProfile(player.UserId)
			if profile then release(session, profile) end
		end
		local deadline = os.clock() + 25
		while (pendingReleases &gt; 0 or next(loading) ~= nil) and os.clock() &lt; deadline do task.wait(0.1) end
	end)
	remotes.Parent = ReplicatedStorage
	print("Cloud Anglers: ready. Saving " .. (if saving then "enabled." else "disabled in this Studio playtest."))
end
return Service
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000015">
      <Properties>
        <string name="Name">FishingProgression</string>
        <ProtectedString name="Source">--!strict
-- Session progression; no persistence is implied. All rewards are server-owned.
type Profile = {
	coins: number, level: number, catches: number, brilliant: number, goalIndex: number,
	best: { [string]: number }, duplicateCount: number,
}
local Progression = {}
local ranks = { Normal = 1, Fine = 2, Brilliant = 3 }

function Progression.new(catalog: any, randomRoll: () -&gt; number)
	local function create(): Profile
		return { coins = 0, level = 0, catches = 0, brilliant = 0, goalIndex = 1, best = {}, duplicateCount = 0 }
	end
	local function collection(profile: Profile): (number, number)
		local count, points = 0, 0
		for _, species in catalog.Species do
			local best = profile.best[species.Id]
			if best then count += 1; points += best end
		end
		return count, points
	end
	local function goalValue(profile: Profile, kind: string): number
		if kind == "Catches" then return profile.catches end
		if kind == "Rod" then return profile.level end
		if kind == "Brilliant" then return profile.brilliant end
		local count = collection(profile)
		return count
	end
	local function resolveGoals(profile: Profile): (number, { string })
		local reward = 0
		local names: { string } = {}
		while true do
			local goal = catalog.Goals[profile.goalIndex]
			if not goal or goalValue(profile, goal.Kind) &lt; goal.Target then break end
			reward += goal.Reward
			table.insert(names, goal.Title)
			profile.goalIndex += 1
		end
		profile.coins += reward
		return reward, names
	end
	local function snapshot(profile: Profile)
		local found, points = collection(profile)
		local goal = catalog.Goals[profile.goalIndex]
		local nextRod = catalog.Rods[profile.level + 2]
		local best: { [string]: number } = {}
		for id, quality in profile.best do best[id] = quality end
		return {
			coins = profile.coins, level = profile.level, species = found, points = points, best = best,
			rod = catalog.Rods[profile.level + 1].Name,
			nextUpgrade = if nextRod then {
				name = nextRod.Name, cost = nextRod.Cost, description = nextRod.Description,
			} else nil,
			goal = if goal then {
				title = goal.Title, progress = math.min(goalValue(profile, goal.Kind), goal.Target),
				target = goal.Target, reward = goal.Reward,
			} else { title = "Journal complete! Improve your catch grades.", progress = 1, target = 1, reward = 0 },
		}
	end
	local function catch(profile: Profile, quality: string)
		assert(ranks[quality], "Unknown catch quality")
		local available: { any } = {}
		local unseen: { any } = {}
		local totalWeight = 0
		for _, species in catalog.Species do
			if species.Level &lt;= profile.level then
				table.insert(available, species)
				totalWeight += species.Weight
				if not profile.best[species.Id] then table.insert(unseen, species) end
			end
		end
		local picked = available[1]
		-- Teach variety early; afterwards, at most two duplicates before an unseen unlocked fish.
		if #unseen &gt; 0 and (profile.catches &lt; 3 or profile.duplicateCount &gt;= 2) then
			picked = unseen[1]
		else
			local roll = math.clamp(randomRoll(), 0, 0.999999) * totalWeight
			for _, species in available do
				roll -= species.Weight
				if roll &lt; 0 then picked = species; break end
			end
		end
		local previous = profile.best[picked.Id]
		local discovery = previous == nil
		profile.best[picked.Id] = math.max(previous or 0, ranks[quality])
		profile.duplicateCount = if discovery then 0 else profile.duplicateCount + 1
		profile.catches += 1
		if quality == "Brilliant" then profile.brilliant += 1 end
		local multiplier = 1 + catalog.Rods[profile.level + 1].Bonus / 100
		local coins = math.floor(picked.Coins * multiplier * (if quality == "Brilliant" then 1.6 elseif quality == "Fine" then 1.25 else 1))
		profile.coins += coins
		local bonus, goals = resolveGoals(profile)
		return {
			species = picked.Name, speciesId = picked.Id, rarity = picked.Rarity, quality = quality,
			coins = coins, goalBonus = bonus, milestones = goals, newDiscovery = discovery,
			improved = previous ~= nil and ranks[quality] &gt; previous,
		}
	end
	local function upgrade(profile: Profile): { success: boolean, message: string, goalBonus: number?, milestones: { string }? }
		local nextRod = catalog.Rods[profile.level + 2]
		if not nextRod then return { success = false, message = "Your rod is fully upgraded." } end
		if profile.coins &lt; nextRod.Cost then
			return { success = false, message = "Catch more fish to afford " .. nextRod.Name .. "." }
		end
		profile.coins -= nextRod.Cost
		profile.level += 1
		local bonus, goals = resolveGoals(profile)
		return { success = true, message = nextRod.Name .. " equipped!", goalBonus = bonus, milestones = goals }
	end
	local function copy(profile: Profile): Profile
		local best: { [string]: number } = {}
		for id, rank in profile.best do best[id] = rank end
		return {
			coins = profile.coins, level = profile.level, catches = profile.catches, brilliant = profile.brilliant,
			goalIndex = profile.goalIndex, duplicateCount = profile.duplicateCount, best = best,
		}
	end
	return { create = create, snapshot = snapshot, catch = catch, upgrade = upgrade, copy = copy }
end

return Progression
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000016">
      <Properties>
        <string name="Name">FishingSaveRules</string>
        <ProtectedString name="Source">--!strict
-- Atomic record transitions. UpdateAsync may retry its callback; no side effects here.
local SaveRules = {}
SaveRules.LeaseSeconds = 120
SaveRules.MaxOfflineSeconds = 8 * 60 * 60
SaveRules.MaxOfflineCoins = 120

local function uint(value: any, maximum: number): boolean
	return type(value) == "number" and value == value and value &gt;= 0 and value &lt;= maximum and value % 1 == 0
end

function SaveRules.new(catalog: any, progression: any)
	local function validate(profile: any): boolean
		if type(profile) ~= "table" or type(profile.best) ~= "table" then return false end
		if not uint(profile.coins, 1000000000) or not uint(profile.level, #catalog.Rods - 1)
			or not uint(profile.catches, 1000000000) or not uint(profile.brilliant, profile.catches)
			or not uint(profile.duplicateCount, 1000000000) or not uint(profile.goalIndex, #catalog.Goals + 1)
			or profile.goalIndex &lt; 1 then return false end
		for id, rank in profile.best do
			local exists = false
			for _, species in catalog.Species do if species.Id == id then exists = true; break end end
			if not exists or not uint(rank, 3) or rank &lt; 1 then return false end
		end
		return true
	end
	local function recordValid(record: any): boolean
		if type(record) ~= "table" or record.version ~= 1 or not validate(record.profile)
			or not uint(record.lastSeen, 100000000000) then return false end
		local lease = record.lease
		local award = record.offlineAward
		if award ~= nil and (type(award) ~= "table" or type(award.leaseId) ~= "string"
			or not uint(award.coins, SaveRules.MaxOfflineCoins)
			or not uint(award.seconds, SaveRules.MaxOfflineSeconds)) then return false end
		return lease == nil or (type(lease) == "table" and type(lease.id) == "string"
			and uint(lease.expires, 100000000000))
	end
	local function acquire(old: any, leaseId: string, now: number): (any?, string?)
		if old == nil then
			return { version = 1, profile = progression.create(), lastSeen = now,
				lease = { id = leaseId, expires = now + SaveRules.LeaseSeconds } }, nil
		end
		if not recordValid(old) then return nil, "invalid_data" end
		if old.lease and old.lease.id == leaseId then
			return { version = 1, profile = progression.copy(old.profile), lastSeen = now,
				lease = { id = leaseId, expires = now + SaveRules.LeaseSeconds }, offlineAward = old.offlineAward }, nil
		end
		if old.lease and old.lease.expires &gt; now then return nil, "active_session" end
		local profile = progression.copy(old.profile)
		local found = 0
		for _ in profile.best do found += 1 end
		local lastActive = if old.lease then math.max(old.lastSeen, old.lease.expires) else old.lastSeen
		local elapsed = math.clamp(now - lastActive, 0, SaveRules.MaxOfflineSeconds)
		local earned = math.min(SaveRules.MaxOfflineCoins, 1000000000 - profile.coins,
			math.floor(elapsed / 60 * found * 0.25))
		profile.coins = math.min(1000000000, profile.coins + earned)
		return {
			version = 1, profile = profile, lastSeen = now,
			lease = { id = leaseId, expires = now + SaveRules.LeaseSeconds },
			offlineAward = { leaseId = leaseId, coins = earned, seconds = elapsed },
		}, nil
	end
	local function save(old: any, profile: any, leaseId: string, now: number, release: boolean): (any?, string?)
		if not recordValid(old) or not validate(profile) then return nil, "invalid_data" end
		if not old.lease or old.lease.id ~= leaseId then return nil, "lost_lease" end
		return {
			version = 1, profile = progression.copy(profile), lastSeen = now,
			lease = if release then nil else { id = leaseId, expires = now + SaveRules.LeaseSeconds },
		}, nil
	end
	return { acquire = acquire, save = save, validate = validate }
end
return SaveRules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000017">
      <Properties>
        <string name="Name">FishingProfileStore</string>
        <ProtectedString name="Source">--!strict
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local SaveRules = require(script.Parent:WaitForChild("FishingSaveRules"))
local Store = {}

function Store.new(catalog: any, progression: any, studio: boolean)
	-- Test saves never share the production namespace.
	local dataStore = DataStoreService:GetDataStore(if studio then "CloudAnglers_Test_v03" else "CloudAnglers_Player_v03")
	local rules = SaveRules.new(catalog, progression)
	local function update(key: string, transform: any): (any?, string?)
		local rejection: string? = nil
		for attempt = 1, 3 do
			local ok, value = pcall(function()
				return dataStore:UpdateAsync(key, function(old)
					local record, reason = transform(old)
					rejection = reason
					return record
				end)
			end)
			if ok then return value, rejection end
			if attempt &lt; 3 then task.wait(attempt) end
		end
		return nil, "unavailable"
	end
	local function load(userId: number): (any?, string?)
		local id = HttpService:GenerateGUID(false)
		local key = "player_" .. userId
		local record, reason = update(key, function(old) return rules.acquire(old, id, os.time()) end)
		for _ = 1, 3 do
			if reason ~= "active_session" then break end
			task.wait(2)
			record, reason = update(key, function(old) return rules.acquire(old, id, os.time()) end)
		end
		if not record or not record.lease or record.lease.id ~= id then return nil, reason or "lost_lease" end
		return {
			key = key, id = id, profile = record.profile, expires = record.lease.expires,
			lastSave = os.clock(), busy = false, closed = false, offline = record.offlineAward,
		}, nil
	end
	local function save(session: any, profile: any, release: boolean): (boolean, string?)
		if session.closed or session.busy then return false, "busy" end
		session.busy = true
		-- Keep a single snapshot across UpdateAsync retries.
		local copy = progression.copy(profile)
		local record, reason = update(session.key, function(old)
			return rules.save(old, copy, session.id, os.time(), release)
		end)
		session.busy = false
		if not record then return false, reason or "unavailable" end
		session.lastSave = os.clock()
		session.expires = if record.lease then record.lease.expires else 0
		if release then session.closed = true end
		return true, nil
	end
	return { load = load, save = save }
end
return Store
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00000018">
      <Properties>
        <string name="Name">FishingServer</string>
        <ProtectedString name="Source">--!strict
require(script.Parent:WaitForChild("FishingService")).start()
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00000005">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CameraMaxZoomDistance">38</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00000008">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX00000019">
        <Properties>
          <string name="Name">FishingClient</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Rules = require(Shared:WaitForChild("FishingRules"))
local audio = require(script.Parent:WaitForChild("FishingAudio")).new()
local presentation = require(script.Parent:WaitForChild("FishingPresentation")).new(audio)
local Interface = require(script.Parent:WaitForChild("FishingInterface"))
local remotes = ReplicatedStorage:WaitForChild("FishingRemotes")
local action = remotes:WaitForChild("FishingAction") :: RemoteEvent
local state = remotes:WaitForChild("FishingState") :: RemoteEvent
local visual = remotes:WaitForChild("FishingVisual") :: RemoteEvent
local player = Players.LocalPlayer
local packet: any = { phase = "Connecting", catches = 0, nextStart = 0 }
local ui: any = nil
local pendingSince: number? = nil
local heldInput: InputObject? = nil
local heldConnection: RBXScriptConnection? = nil
local releasedBeforeAck = false
local workshopVisible = false
local message = "Find the lantern-lit dock and cast your first line."
local keyHint = if UserInputService.TouchEnabled then "" else "  [E]"
local function now(): number return workspace:GetServerTimeNow() end
local function clearHeld()
	heldInput = nil
	if heldConnection then heldConnection:Disconnect() end
	heldConnection = nil
	if ui then TweenService:Create(ui.buttonScale, TweenInfo.new(0.12), { Scale = 1 }):Play() end
end
local function request(verb: string, argument: any?)
	pendingSince = now()
	action:FireServer(verb, if verb == "Upgrade" then argument else packet.attemptId)
end
local function cancel()
	clearHeld()
	releasedBeforeAck = false
	if packet.attemptId then request("Cancel") end
end
ui = Interface.new(player:WaitForChild("PlayerGui"), audio, {
	openJournal = function() cancel(); ui.hideResult() end,
	upgrade = function()
		if not packet.profile or pendingSince then return end
		request("Upgrade", packet.profile.level)
	end,
})
local function release()
	if not heldInput then return end
	clearHeld()
	if packet.phase == "Reeling" then request("Release") else releasedBeforeAck = true end
end
local function press(input: InputObject)
	if ui.isJournalOpen() then return end
	if ui.isResultOpen() then ui.hideResult(); return end
	if heldInput or pendingSince then return end
	if packet.phase == "Idle" and now() &gt;= packet.nextStart then
		ui.hideResult()
		message = "Casting into the clouds..."
		request("Start")
	elseif packet.phase == "Waiting" and now() &gt;= (packet.readyAt or math.huge) then
		heldInput, releasedBeforeAck = input, false
		TweenService:Create(ui.buttonScale, TweenInfo.new(0.1), { Scale = 0.95 }):Play()
		heldConnection = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.Cancel then cancel()
			elseif input.UserInputState == Enum.UserInputState.End then release() end
		end)
		request("Hold")
	end
end
ui.button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then press(input) end
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and not workshopVisible and input.KeyCode == Enum.KeyCode.E and not UserInputService:GetFocusedTextBox() then press(input) end
end)
UserInputService.InputEnded:Connect(function(input)
	local held = heldInput
	if not held then return end
	if input == held
		or (held.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
		or (held.KeyCode == Enum.KeyCode.E and input.KeyCode == Enum.KeyCode.E) then release() end
end)
UserInputService.WindowFocusReleased:Connect(cancel)
UserInputService.TextBoxFocused:Connect(cancel)
ProximityPromptService.PromptShown:Connect(function(prompt)
	if prompt.Name == "RodWorkshopPrompt" then workshopVisible = true end
end)
ProximityPromptService.PromptHidden:Connect(function(prompt)
	if prompt.Name == "RodWorkshopPrompt" then workshopVisible = false end
end)
ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
	if prompt.Name == "RodWorkshopPrompt" and who == player then ui.openJournal("Workshop") end
end)
visual.OnClientEvent:Connect(presentation.apply)
state.OnClientEvent:Connect(function(incoming)
	local previousId, previousCatches = packet.attemptId, packet.catches
	packet, pendingSince = incoming, nil
	ui.updateProfile(packet.profile)
	ui.setState(packet.phase)
	if packet.result and packet.catches &gt; previousCatches then
		local result = packet.result
		message = result.species .. " / " .. result.quality .. "! What will you discover next?"
		ui.showResult(result)
		if (result.goalBonus or 0) &gt; 0 then
			ui.notify("Adventure complete! +" .. result.goalBonus .. " bonus coins")
			task.delay(0.45, audio.goal)
		elseif result.newDiscovery then ui.notify("New journal entry: " .. result.species) end
	elseif packet.message then message = packet.message end
	if packet.purchase then
		if packet.purchase.success then audio.upgrade(); ui.notify(packet.purchase.message)
		else audio.ui(false); ui.notify(packet.purchase.message) end
	end
	if packet.offline and packet.offline.coins &gt; 0 then
		ui.notify("Welcome back! Your collection earned " .. packet.offline.coins .. " coins.")
		audio.coins()
	end
	if packet.phase == "Idle" or packet.attemptId ~= previousId then clearHeld(); releasedBeforeAck = false end
	if packet.phase == "Waiting" and packet.attemptId ~= previousId then ui.hideResult() end
	audio.setReeling(packet.phase == "Reeling")
	if ui.isJournalOpen() and packet.phase == "Waiting" then request("Cancel"); return end
	if packet.phase == "Reeling" then
		if releasedBeforeAck then releasedBeforeAck = false; request("Release")
		elseif not heldInput then request("Cancel") end
	end
end)
RunService.RenderStepped:Connect(function()
	local time = now()
	if pendingSince and time - pendingSince &gt; 3 then clearHeld(); releasedBeforeAck = false; request("Sync") end
	local camera = workspace.CurrentCamera
	if camera then ui.animate(time, camera.ViewportSize.X, camera.ViewportSize.Y) end
	ui.button.BackgroundColor3 = Color3.fromRGB(37, 119, 109)
	ui.legend.Text = "NORMAL  ·  FINE  ·  BRILLIANT"
	if packet.phase == "Waiting" then
		if time &lt; (packet.readyAt or math.huge) then
			ui.status.Text, ui.button.Text = "Watch your bobber...", "CASTING..."
		else
			ui.status.Text = "BITE! Hold, then release inside the zone."
			ui.button.Text = if pendingSince then "ONE MOMENT..." else "HOLD TO REEL" .. keyHint
		end
	elseif packet.phase == "Reeling" then
		local progress = math.clamp((time - (packet.chargeAt or time)) / (packet.duration or 1), 0, 1)
		ui.marker.Position = UDim2.fromScale(progress, 0)
		local quality = Rules.qualityAt(progress)
		ui.legend.Text = "NOW: " .. string.upper(quality or "OUTSIDE THE ZONE")
		ui.status.Text = if pendingSince then "Checking your catch..." else "Release in the zone. Aim for gold!"
		ui.button.Text = if pendingSince then "ONE MOMENT..." else "RELEASE!"
		ui.button.BackgroundColor3 = Color3.fromRGB(151, 105, 31)
	elseif packet.phase == "Idle" then
		ui.status.Text = message
		ui.button.Text = if pendingSince then "ONE MOMENT..." elseif time &lt; packet.nextStart then "GET READY..." else "CAST LINE" .. keyHint
	else
		ui.status.Text = "Loading your collection safely..."
		ui.button.Text = "CONNECTING..."
	end
end)
request("Sync")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001A">
        <Properties>
          <string name="Name">FishingAudio</string>
          <ProtectedString name="Source">--!strict
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Audio = {}
-- Same six shipped clips as v0.3. This release changes their mix, not the library.
local clips = {
	Cast = "rbxasset://sounds/action_jump.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Chime = "rbxasset://sounds/electronicpingshort.wav",
	Reel = "rbxasset://sounds/action_swim.mp3",
	Miss = "rbxasset://sounds/action_jump_land.mp3",
	Wind = "rbxasset://sounds/action_falling.mp3",
}
local trim = { Cast = 0.62, Splash = 0.65, Chime = 0.52, Reel = 0.5, Miss = 0.55, Wind = 0.5 }
function Audio.new()
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "CloudAnglersSounds", SoundService
	local group = Instance.new("SoundGroup")
	group.Name, group.Volume, group.Parent = "CloudAnglersMix", 0.75, SoundService
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name, eq.HighGain, eq.MidGain, eq.LowGain, eq.Parent = "SoftenUpperFrequencies", -7, -1, -2, group
	local compressor = Instance.new("CompressorSoundEffect")
	compressor.Name, compressor.Threshold, compressor.Ratio = "GentlePeakControl", -14, 3
	compressor.Attack, compressor.Release, compressor.GainMakeup, compressor.Parent = 0.02, 0.15, 0, group
	local templates: { [string]: Sound } = {}
	local preload: { Instance } = {}
	for name, path in clips do
		local sound = Instance.new("Sound")
		sound.Name, sound.SoundId, sound.SoundGroup = name, path, group
		sound.Volume, sound.RollOffMinDistance, sound.RollOffMaxDistance = 0.2, 7, 48
		sound.RollOffMode, sound.Parent = Enum.RollOffMode.InverseTapered, folder
		templates[name] = sound
		table.insert(preload, sound)
	end
	task.spawn(function()
		local ok, err = pcall(function() ContentProvider:PreloadAsync(preload) end)
		if not ok then warn("Cloud Anglers: sound preload failed: " .. tostring(err)) end
	end)
	local muted, reeling = false, false
	local reel: Sound? = nil
	local voices: { Sound } = {}
	local lastUi = -math.huge
	local melodyUntil = 0
	local rewardGeneration = 0
	local wind = templates.Wind:Clone()
	wind.Looped, wind.Volume, wind.PlaybackSpeed, wind.Parent = true, 0, 0.62, folder
	wind:Play()
	local windTween: Tween? = TweenService:Create(wind, TweenInfo.new(2), { Volume = 0.018 })
	windTween:Play()
	local function ambience(volume: number)
		if windTween then windTween:Cancel() end
		windTween = TweenService:Create(wind, TweenInfo.new(0.45), { Volume = volume })
		windTween:Play()
	end
	local function play(name: string, pitch: number?, parent: Instance?, volume: number?)
		local template = templates[name]
		if not template or muted then return end
		for i = #voices, 1, -1 do if not voices[i].Parent then table.remove(voices, i) end end
		-- Multiplayer casts cannot create an unlimited pile of overlapping sounds.
		if #voices &gt;= 10 then voices[1]:Destroy(); table.remove(voices, 1) end
		local sound = template:Clone()
		sound.PlaybackSpeed = math.clamp(pitch or 1, 0.7, 1.45)
		sound.Volume = math.clamp((volume or 0.25) * (trim[name] or 0.6), 0, 0.3)
		sound.Parent = parent or folder
		table.insert(voices, sound)
		sound.Ended:Once(function() sound:Destroy() end)
		sound:Play()
		Debris:AddItem(sound, 5)
	end
	local function setReeling(enabled: boolean)
		if reeling == enabled then return end
		reeling = enabled
		ambience(if enabled then 0.006 elseif os.clock() &lt; melodyUntil then 0.005 else 0.018)
		if enabled then
			local sound = templates.Reel:Clone()
			sound.Looped, sound.PlaybackSpeed, sound.Volume, sound.Parent = true, 1.08, 0, folder
			sound:Play()
			TweenService:Create(sound, TweenInfo.new(0.25), { Volume = 0.055 }):Play()
			reel = sound
		elseif reel then
			TweenService:Create(reel, TweenInfo.new(0.18), { Volume = 0 }):Play()
			Debris:AddItem(reel, 0.22)
			reel = nil
		end
	end
	-- One short reward phrase owns the foreground, so goals do not stack on catches.
	local function phrase(pitches: { number }, volume: number)
		rewardGeneration += 1
		local generation = rewardGeneration
		melodyUntil = os.clock() + 0.8
		ambience(0.005)
		for i, pitch in pitches do
			task.delay((i - 1) * 0.18, function()
				if generation == rewardGeneration then play("Chime", pitch, nil, volume * (1 - (i - 1) * 0.16)) end
			end)
		end
		task.delay(0.85, function()
			if generation == rewardGeneration then ambience(if reeling then 0.006 else 0.018) end
		end)
	end
	return {
		play = play, setReeling = setReeling,
		catch = function(quality: string, rarity: string?, _discovery: boolean?)
			local pitch = if rarity == "Epic" then 1.08 elseif quality == "Brilliant" then 1 else 0.88
			phrase({ pitch, pitch * 1.25 }, 0.36)
		end,
		ui = function(success: boolean?)
			if os.clock() - lastUi &lt; 0.14 then return end
			lastUi = os.clock()
			play(if success == false then "Miss" else "Chime", if success == false then 0.88 else 1.12, nil, 0.09)
		end,
		coins = function() phrase({ 1, 1.25 }, 0.24) end,
		goal = function()
			if os.clock() &lt; melodyUntil then return end
			phrase({ 0.94, 1.18 }, 0.26)
		end,
		upgrade = function() phrase({ 0.82, 1, 1.25 }, 0.34) end,
		toggle = function(): boolean
			muted = not muted
			group.Volume = if muted then 0 else 0.75
			return muted
		end,
	}
end
return Audio
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001B">
        <Properties>
          <string name="Name">FishingPresentation</string>
          <ProtectedString name="Source">--!strict
-- Local procedural animation, driven exclusively by server-approved state.
-- Every client renders the same casts; no animation asset uploads are required.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Config = require(Shared:WaitForChild("FishingConfig"))
local Fish = require(Shared:WaitForChild("FishModel"))
local Scenery = require(script.Parent:WaitForChild("WorldScenery"))
local Presentation = {}

type Actor = {
	player: Player, character: Model?, rig: Model?, tip: Attachment?,
	bobber: Part?, line: Beam?, state: any, landed: boolean, bite: boolean,
	lastCatches: number, castFrom: Vector3?, caughtFish: Model?, catchAt: number,
	catchFrom: Vector3, shoulder: Motor6D?, leftShoulder: Motor6D?, pitch: number, poseWeight: number,
}

local function visualPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cf
	object.Color = color
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.CastShadow = false
	object.Material = Enum.Material.SmoothPlastic
	object.Parent = parent
	return object
end

function Presentation.new(audio: any)
	Scenery.start()
	local folder = Instance.new("Folder")
	folder.Name = "CloudAnglersEffects"
	folder.Parent = workspace
	local actors: { [number]: Actor } = {}
	local random = Random.new()

	local function ripple(position: Vector3)
		local ring = visualPart(folder, "Ripple", Vector3.new(0.06, 0.8, 0.8),
			CFrame.new(position - Vector3.yAxis * 0.25) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(229, 251, 255))
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.45
		TweenService:Create(ring, TweenInfo.new(0.65, Enum.EasingStyle.Quad),
			{ Size = Vector3.new(0.04, 6, 6), Transparency = 1 }):Play()
		Debris:AddItem(ring, 0.7)
	end

	local function burst(position: Vector3, golden: boolean)
		for _ = 1, 12 do
			local size = random:NextNumber(0.12, 0.3)
			local bubble = visualPart(folder, "CatchSpark", Vector3.new(size, size, size), CFrame.new(position),
				if golden then Color3.fromRGB(255, 218, 120) else Color3.fromRGB(182, 239, 250))
			bubble.Shape = Enum.PartType.Ball
			bubble.Material = Enum.Material.Neon
			TweenService:Create(bubble, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = position + Vector3.new(random:NextNumber(-2, 2), random:NextNumber(1, 4), random:NextNumber(-2, 2)),
				Transparency = 1,
			}):Play()
			Debris:AddItem(bubble, 0.7)
		end
	end

	local function clearRig(actor: Actor)
		if actor.shoulder and actor.shoulder.Parent then actor.shoulder.Transform = CFrame.identity end
		if actor.leftShoulder and actor.leftShoulder.Parent then actor.leftShoulder.Transform = CFrame.identity end
		if actor.rig then actor.rig:Destroy() end
		if actor.bobber then actor.bobber:Destroy() end
		if actor.caughtFish then actor.caughtFish:Destroy() end
		actor.rig, actor.tip, actor.bobber, actor.line = nil, nil, nil, nil
		actor.shoulder, actor.leftShoulder, actor.caughtFish = nil, nil, nil
	end

	local function getActor(player: Player): Actor
		local existing = actors[player.UserId]
		if existing then return existing end
		local actor: Actor = {
			player = player, state = { phase = "Idle", catches = 0 }, landed = false, bite = false,
			lastCatches = 0, catchAt = 0, catchFrom = Vector3.zero, pitch = 0, poseWeight = 0,
		}
		actors[player.UserId] = actor
		return actor
	end

	local function ensureRig(actor: Actor): BasePart?
		local character = actor.player.Character
		if character ~= actor.character then
			clearRig(actor)
			if actor.character then actor.state = { phase = "Idle", catches = actor.lastCatches } end
			actor.character = character
		end
		if not character then return nil end
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
		if not hand or not hand:IsA("BasePart") then return nil end
		if not actor.rig then
			local rig = Instance.new("Model")
			rig.Name = "FishingRod_" .. actor.player.UserId
			local origin = visualPart(rig, "Grip", Vector3.new(0.28, 0.8, 0.28), CFrame.identity, Color3.fromRGB(101, 76, 66))
			rig.PrimaryPart = origin
			local shaft = visualPart(rig, "Rod", Vector3.new(0.12, 3.5, 0.12), CFrame.new(0, 2, 0), Color3.fromRGB(78, 174, 188))
			visualPart(rig, "Reel", Vector3.new(0.45, 0.45, 0.32), CFrame.new(0, 0.35, -0.25), Color3.fromRGB(243, 196, 107))
			local tip = Instance.new("Attachment")
			tip.Position = Vector3.new(0, 1.75, 0)
			tip.Parent = shaft
			rig.Parent = folder
			actor.rig, actor.tip = rig, tip
			local right = character:FindFirstChild("RightShoulder", true) or character:FindFirstChild("Right Shoulder", true)
			local left = character:FindFirstChild("LeftShoulder", true) or character:FindFirstChild("Left Shoulder", true)
			actor.shoulder = if right and right:IsA("Motor6D") then right else nil
			actor.leftShoulder = if left and left:IsA("Motor6D") then left else nil
		end
		return hand
	end

	local function createBobber(actor: Actor)
		if actor.bobber or not actor.tip or not actor.rig then return end
		local bobber = visualPart(folder, "Bobber_" .. actor.player.UserId, Vector3.new(0.65, 0.65, 0.65),
			CFrame.new(actor.castFrom or Vector3.zero), Color3.fromRGB(255, 129, 111))
		bobber.Shape = Enum.PartType.Ball
		bobber.Material = Enum.Material.Neon
		local anchor = Instance.new("Attachment")
		anchor.Parent = bobber
		local beam = Instance.new("Beam")
		beam.Attachment0 = actor.tip
		beam.Attachment1 = anchor
		beam.Width0, beam.Width1 = 0.045, 0.025
		beam.FaceCamera = true
		beam.Segments = 12
		beam.Color = ColorSequence.new(Color3.fromRGB(242, 248, 235))
		beam.Transparency = NumberSequence.new(0.12)
		beam.Parent = bobber
		actor.bobber, actor.line = bobber, beam
	end

	local function biteCue(actor: Actor)
		local bobber = actor.bobber
		if not bobber then return end
		actor.bite = true
		ripple(bobber.Position)
		audio.play("Chime", 1.1, bobber, 0.34)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(60, 72)
		gui.StudsOffset = Vector3.new(0, 2, 0)
		gui.AlwaysOnTop = true
		gui.Parent = bobber
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "!"
		label.Font = Enum.Font.GothamBlack
		label.TextSize = 52
		label.TextColor3 = Color3.fromRGB(255, 221, 115)
		label.TextStrokeTransparency = 0.2
		label.Parent = gui
		TweenService:Create(gui, TweenInfo.new(0.3, Enum.EasingStyle.Back), { StudsOffset = Vector3.new(0, 3, 0) }):Play()
		Debris:AddItem(gui, 0.85)
	end

	local function apply(userId: number, incoming: any)
		local player = Players:GetPlayerByUserId(userId)
		if not player then return end
		local actor = getActor(player)
		local previous = actor.state
		local changed = previous.phase ~= incoming.phase or previous.attemptId ~= incoming.attemptId
		local freshCatch = incoming.result ~= nil and incoming.catches &gt; actor.lastCatches
		local hand = ensureRig(actor)
		actor.state = incoming
		actor.lastCatches = incoming.catches
		if changed and incoming.phase == "Waiting" then
			actor.landed, actor.bite = false, false
			actor.castFrom = if hand then hand.Position + Vector3.new(0, 2, 0) else incoming.castTarget
			if actor.bobber then actor.bobber:Destroy() end
			actor.bobber, actor.line = nil, nil
			createBobber(actor)
			if hand then audio.play("Cast", 0.94, hand, 0.26) end
		end
		if incoming.phase == "Idle" then
			local position = if actor.bobber then actor.bobber.Position else incoming.castTarget
			if freshCatch and position then
				if actor.caughtFish then actor.caughtFish:Destroy() end
				actor.caughtFish = Fish.create(folder, "CaughtFish", incoming.result.speciesId)
				actor.catchAt = workspace:GetServerTimeNow()
				actor.catchFrom = position
				burst(position, true)
				ripple(position)
			elseif changed and previous.phase == "Reeling" and position then
				burst(position, false)
				if player == Players.LocalPlayer then audio.play("Miss", 0.8, nil, 0.16) end
			end
			if actor.bobber then actor.bobber:Destroy() end
			actor.bobber, actor.line = nil, nil
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		local actor = actors[player.UserId]
		if actor then clearRig(actor) end
		actors[player.UserId] = nil
	end)

	RunService.PreSimulation:Connect(function(deltaTime)
		-- Animator writes Transform before PreSimulation. This pass supplies the fishing pose.
		for _, actor in actors do
			local active = actor.state.phase == "Waiting" or actor.state.phase == "Reeling"
			local previousWeight = actor.poseWeight
			local target = if active then 1 else 0
			actor.poseWeight += (target - actor.poseWeight) * (1 - math.exp(-deltaTime * 14))
			if actor.poseWeight &lt; 0.001 then actor.poseWeight = 0 end
			if actor.poseWeight &gt; 0 then
				if actor.shoulder then
					actor.shoulder.Transform = CFrame.identity:Lerp(CFrame.Angles(1.05 + actor.pitch * 0.3, 0, -0.18), actor.poseWeight)
				end
				if actor.leftShoulder then
					actor.leftShoulder.Transform = CFrame.identity:Lerp(CFrame.Angles(0.7, 0.1, 0.4), actor.poseWeight)
				end
			elseif previousWeight &gt; 0 then
				if actor.shoulder then actor.shoulder.Transform = CFrame.identity end
				if actor.leftShoulder then actor.leftShoulder.Transform = CFrame.identity end
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		local time = workspace:GetServerTimeNow()
		for _, player in Players:GetPlayers() do getActor(player) end
		for _, actor in actors do
			local hand = ensureRig(actor)
			local root = if actor.character then actor.character:FindFirstChild("HumanoidRootPart") else nil
			if not hand or not root or not root:IsA("BasePart") or not actor.rig then continue end
			local packet = actor.state
			local active = packet.phase == "Waiting" or packet.phase == "Reeling"
			local target = packet.castTarget or (root.Position + root.CFrame.LookVector * 14)
			local flat = (target - root.Position) * Vector3.new(1, 0, 1)
			local forward = if flat.Magnitude &gt; 0.1 then flat.Unit else root.CFrame.LookVector
			local castT = if packet.readyAt then math.clamp((time - packet.readyAt + Config.PreparationTime) / 0.65, 0, 1) else 1
			local pitch = 0.95
			if packet.phase == "Waiting" then
				pitch = if castT &lt; 0.35 then 0.6 + castT / 0.35 else 1.6 - (castT - 0.35) / 0.65 * 1.1
			elseif packet.phase == "Reeling" then
				pitch = 0.65 + math.sin(time * 18) * 0.07
			end
			actor.pitch = pitch
			local direction = forward * math.cos(pitch) + Vector3.yAxis * math.sin(pitch)
			actor.rig:PivotTo(CFrame.lookAt(hand.Position, hand.Position + direction) * CFrame.Angles(-math.pi / 2, 0, 0))
			local shaft = actor.rig:FindFirstChild("Rod")
			if shaft and shaft:IsA("BasePart") then
				local level = packet.rodLevel or 0
				shaft.Color = if level &gt;= 3 then Color3.fromRGB(255, 211, 108)
					elseif level &gt;= 2 then Color3.fromRGB(187, 155, 243) else Color3.fromRGB(78, 174, 188)
			end
			if active then
				createBobber(actor)
				local bobber = actor.bobber
				if bobber then
					local from = actor.castFrom or hand.Position
					local arc = from:Lerp(target, castT) + Vector3.new(0, math.sin(castT * math.pi) * 5, 0)
					if castT &gt;= 1 then
						local bob = math.sin(time * (if packet.phase == "Reeling" then 22 else 3)) * 0.16
						arc = target + Vector3.new(0, bob - (if actor.bite then 0.25 else 0), 0)
						if not actor.landed then
							actor.landed = true
							ripple(target)
							audio.play("Splash", 0.95, bobber, 0.32)
						end
					end
					bobber.Position = arc
					if not actor.bite and time &gt;= packet.readyAt then biteCue(actor) end
					if actor.line then actor.line.CurveSize0 = if packet.phase == "Reeling" then 0 else 0.7 end
				end
			end
			if actor.caughtFish then
				local t = math.clamp((time - actor.catchAt) / 1.2, 0, 1)
				local destination = root.Position + Vector3.new(0, 3, 0)
				local position = actor.catchFrom:Lerp(destination, t) + Vector3.new(0, math.sin(t * math.pi) * 7, 0)
				actor.caughtFish:PivotTo(CFrame.new(position) * CFrame.Angles(0, t * math.pi * 4, math.sin(t * 8) * 0.25))
				Fish.animate(actor.caughtFish, time)
				if t &gt;= 1 then
					burst(destination, true)
					actor.caughtFish:Destroy()
					actor.caughtFish = nil
				end
			end
		end
	end)

	return { apply = apply }
end

return Presentation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001C">
        <Properties>
          <string name="Name">WorldScenery</string>
          <ProtectedString name="Source">--!strict
-- Small, streamed scenery actors are independent of fishing and never own gameplay state.
-- Track arrivals once; the animation pass only visits the currently streamed actors.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Fish = require(ReplicatedStorage:WaitForChild("FishingShared"):WaitForChild("FishModel"))

local Scenery = {}
local started = false
local WORLD_NAME = "MolnfiskarnaPrototype"
local STEP = 1 / 20

type Flow = { part: BasePart, origin: CFrame, phase: number, distance: number, speed: number }
type Motion = { model: Model, origin: CFrame, speed: number }
type Glint = { part: BasePart, phase: number, original: number, last: number }

local function finite(value: any): boolean
	return typeof(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

function Scenery.start()
	if started then return end
	started = true
	local world: Instance? = nil
	local flows: { [Instance]: Flow } = {}
	local drifters: { [Instance]: Motion } = {}
	local previews: { [Instance]: Motion } = {}
	local spinners: { [Instance]: Motion } = {}
	local glints: { [Instance]: Glint } = {}
	local surrenderedGlints: { [Instance]: boolean } = {}
	local listeners: { [Instance]: { RBXScriptConnection } } = {}
	local worldConnections: { RBXScriptConnection } = {}

	local function forget(instance: Instance)
		flows[instance], drifters[instance], previews[instance], spinners[instance] = nil, nil, nil, nil
		local glint = glints[instance]
		if glint and glint.part.Parent and math.abs(glint.part.Transparency - glint.last) &lt; 0.0001 then
			glint.part.Transparency = glint.original
		end
		glints[instance] = nil
		surrenderedGlints[instance] = nil
		local connections = listeners[instance]
		if connections then
			for _, connection in connections do connection:Disconnect() end
			listeners[instance] = nil
		end
	end

	local function refresh(instance: Instance)
		if not world or not instance:IsDescendantOf(world) then return end
		if instance:IsA("BasePart") then
			local origin, phase = instance:GetAttribute("FlowStart"), instance:GetAttribute("FlowPhase")
			if typeof(origin) == "CFrame" and finite(phase) then
				local distance, speed = instance:GetAttribute("FlowDistance"), instance:GetAttribute("FlowSpeed")
				flows[instance] = {
					part = instance, origin = origin, phase = phase,
					distance = if finite(distance) then math.clamp(distance, 1, 256) else 28,
					speed = if finite(speed) then math.clamp(speed, 0, 60) else 7,
				}
			else
				flows[instance] = nil
			end
			local glintPhase = instance:GetAttribute("GlintPhase")
			if finite(glintPhase) and not glints[instance] and not surrenderedGlints[instance] then
				glints[instance] = { part = instance, phase = glintPhase, original = instance.Transparency, last = instance.Transparency }
			elseif finite(glintPhase) and glints[instance] then
				glints[instance].phase = glintPhase
			elseif not finite(glintPhase) then
				local old = glints[instance]
				if old and math.abs(instance.Transparency - old.last) &lt; 0.0001 then instance.Transparency = old.original end
				glints[instance] = nil
			end
		elseif instance:IsA("Model") then
			-- Models can replicate before their attributes and body parts. Keep their listeners
			-- until removal so either arrival order can make the actor ready.
			if not instance:FindFirstChildWhichIsA("BasePart", true) then return end
			if instance.Name == "SkySail" then
				local origin = instance:GetAttribute("DriftOrigin")
				local previous = drifters[instance]
				drifters[instance] = {
					model = instance,
					origin = if typeof(origin) == "CFrame" then origin elseif previous then previous.origin else instance:GetPivot(),
					speed = 0,
				}
			end
			if instance.Name == "PuffletPreview" then
				local origin = instance:GetAttribute("DisplayOrigin")
				if typeof(origin) == "CFrame" then previews[instance] = { model = instance, origin = origin, speed = 0 } end
			end
			local rate, origin = instance:GetAttribute("SpinRate"), instance:GetAttribute("SpinOrigin")
			if finite(rate) and typeof(origin) == "CFrame" then
				spinners[instance] = { model = instance, origin = origin, speed = math.clamp(rate, -3, 3) }
			else
				spinners[instance] = nil
			end
		end
	end

	local function discover(instance: Instance)
		if listeners[instance] then refresh(instance); return end
		local candidate = instance:IsA("Model")
		if instance:IsA("BasePart") then
			-- Restrict readiness listeners to named effect parts, rather than every stone,
			-- plank and leaf in a large map. Attributes already present are also accepted.
			candidate = string.find(instance.Name, "FlowStreak", 1, true) ~= nil
				or string.find(instance.Name, "WaterfallStreak", 1, true) ~= nil
				or string.find(instance.Name, "WaterGlint", 1, true) ~= nil
				or instance:GetAttribute("FlowStart") ~= nil or instance:GetAttribute("GlintPhase") ~= nil
		end
		if candidate then
			listeners[instance] = { instance.AttributeChanged:Connect(function() refresh(instance) end) }
			refresh(instance)
		end
		-- The part may have arrived after the model itself. Refresh animated ancestors,
		-- including a rotor nested inside a larger streamed neighborhood model.
		if instance:IsA("BasePart") then
			local ancestor = instance.Parent
			while ancestor and ancestor ~= world do
				if ancestor:IsA("Model") then refresh(ancestor) end
				ancestor = ancestor.Parent
			end
		end
	end

	local function unbind()
		for _, connection in worldConnections do connection:Disconnect() end
		table.clear(worldConnections)
		local tracked = {}
		for instance in listeners do table.insert(tracked, instance) end
		for _, instance in tracked do forget(instance) end
		world = nil
	end

	local function bind(candidate: Instance)
		if candidate.Name ~= WORLD_NAME or candidate.Parent ~= workspace or candidate == world then return end
		unbind()
		world = candidate
		table.insert(worldConnections, candidate.DescendantAdded:Connect(discover))
		table.insert(worldConnections, candidate.DescendantRemoving:Connect(function(instance)
			forget(instance)
			-- A whole atomic model may leave in one streaming operation.
			if instance:IsA("Model") then
				for _, child in instance:GetDescendants() do forget(child) end
			end
		end))
		table.insert(worldConnections, candidate.AncestryChanged:Connect(function()
			if candidate.Parent ~= workspace and world == candidate then unbind() end
		end))
		for _, instance in candidate:GetDescendants() do discover(instance) end
	end

	workspace.ChildAdded:Connect(bind)
	local existing = workspace:FindFirstChild(WORLD_NAME)
	if existing then bind(existing) end
	local accumulator = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator &lt; STEP then return end
		accumulator %= STEP
		local time = workspace:GetServerTimeNow()
		for _, flow in flows do
			flow.part.CFrame = flow.origin + Vector3.new(0, flow.distance / 2 - ((time * flow.speed + flow.phase * 13) % flow.distance), 0)
		end
		for _, drift in drifters do
			drift.model:PivotTo(drift.origin * CFrame.new(math.sin(time * 0.09) * 5, math.sin(time * 0.35) * 1.1, 0)
				* CFrame.Angles(0, 0, math.sin(time * 0.23) * 0.025))
		end
		for _, preview in previews do
			preview.model:PivotTo(preview.origin * CFrame.new(0, math.sin(time * 1.8) * 0.4, 0)
				* CFrame.Angles(0, math.sin(time) * 0.3, math.sin(time * 2) * 0.08))
			Fish.animate(preview.model, time)
		end
		for _, spin in spinners do
			spin.model:PivotTo(spin.origin * CFrame.Angles(0, 0, time * spin.speed))
		end
		for instance, glint in glints do
			-- Stop touching transparency if another client system takes ownership.
			if math.abs(glint.part.Transparency - glint.last) &gt; 0.0001 then
				glints[instance] = nil
				surrenderedGlints[instance] = true
			else
				glint.last = math.clamp(glint.original + math.sin(time * 0.8 + glint.phase) * 0.045, 0, 1)
				glint.part.Transparency = glint.last
			end
		end
	end)
end

return Scenery
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001D">
        <Properties>
          <string name="Name">InterfaceLayout</string>
          <ProtectedString name="Source">--!strict
-- Pure layout arithmetic: measured in the ScreenGui's inset-safe canvas.
local Layout = {}
function Layout.measure(width: number, height: number)
	local w, h = math.max(280, width), math.max(240, height)
	local compact = h &lt; 480
	local narrow = w &lt; 660
	local portrait = narrow and not compact
	local panelWidth = if compact then math.min(340, math.max(220, w - 320)) else math.min(360, w - 32)
	return {
		width = w, height = h, narrow = narrow, compact = compact,
		panelWidth = panelWidth, panelBottom = if portrait then 152 else 20,
		goalWidth = if narrow then w - 32 else 264,
		goalHeight = if compact then 0 else 64,
		journalY = if compact then 66 elseif narrow then 140 else 150,
		bookWidth = math.min(900, w - 24), bookHeight = math.min(590, h - 24),
		columns = if narrow then 2 else 3,
		cardHeight = if compact then 124 elseif narrow then 150 else 174,
		workshopVertical = narrow and not compact,
		revealScale = math.min(1, (w - 24) / 360, (h - 32) / 370),
	}
end
return Layout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001E">
        <Properties>
          <string name="Name">UITheme</string>
          <ProtectedString name="Source">--!strict
local TweenService = game:GetService("TweenService")
local Theme = {
	Ink = Color3.fromRGB(31, 63, 66), Panel = Color3.fromRGB(255, 250, 237),
	Text = Color3.fromRGB(36, 66, 66), Muted = Color3.fromRGB(90, 111, 106),
	Teal = Color3.fromRGB(37, 119, 109), Gold = Color3.fromRGB(246, 190, 81),
	Purple = Color3.fromRGB(118, 87, 166), Blue = Color3.fromRGB(44, 113, 156),
	Line = Color3.fromRGB(226, 227, 209), Soft = Color3.fromRGB(239, 241, 224),
}
function Theme.round(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end
function Theme.frame(parent: Instance, name: string, size: UDim2, position: UDim2, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size, frame.Position = size, position
	frame.BackgroundColor3 = color or Theme.Panel
	frame.BorderSizePixel = 0
	frame.Parent = parent
	Theme.round(frame, 18)
	return frame
end
function Theme.stroke(frame: GuiObject, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Theme.Line
	stroke.Thickness = thickness or 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame
	return stroke
end
function Theme.surface(frame: GuiObject, _accent: Color3?)
	frame.BackgroundColor3 = Theme.Panel
	Theme.stroke(frame)
end
function Theme.text(parent: Instance, value: string, size: UDim2, position: UDim2, fontSize: number, color: Color3?, bold: boolean?): TextLabel
	local label = Instance.new("TextLabel")
	label.Size, label.Position = size, position
	label.BackgroundTransparency = 1
	label.Text = value
	label.TextSize = fontSize
	label.Font = if bold then Enum.Font.GothamBold else Enum.Font.Gotham
	label.TextColor3 = color or Theme.Text
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.AutoLocalize = false
	label.Parent = parent
	return label
end
function Theme.button(parent: Instance, value: string, size: UDim2, position: UDim2, color: Color3?): TextButton
	local button = Instance.new("TextButton")
	button.Size, button.Position = size, position
	button.BackgroundColor3 = color or Theme.Teal
	button.TextColor3 = Color3.fromRGB(255, 253, 243)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 14
	button.Text = value
	button.AutoLocalize = false
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Parent = parent
	Theme.round(button, 14)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.14), { BackgroundTransparency = 0.12 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.14), { BackgroundTransparency = 0 }):Play()
	end)
	return button
end
-- Drawn locally: no icon asset IDs or image permissions required.
function Theme.coin(parent: Instance, position: UDim2, diameter: number)
	local disc = Theme.frame(parent, "CoinIcon", UDim2.fromOffset(diameter, diameter), position, Theme.Gold)
	Theme.round(disc, diameter)
	local inset = Theme.frame(disc, "Emboss", UDim2.new(1, -8, 1, -8), UDim2.fromOffset(4, 4), Theme.Gold)
	Theme.stroke(inset, Color3.fromRGB(201, 143, 45), 1.5)
	local mark = Theme.text(disc, "+", UDim2.fromScale(1, 1), UDim2.fromOffset(0, -1), diameter * 0.65, Color3.fromRGB(157, 105, 32), true)
	mark.TextXAlignment = Enum.TextXAlignment.Center
end
function Theme.rarity(name: string): Color3
	return if name == "Epic" then Theme.Purple elseif name == "Rare" then Theme.Blue
		elseif name == "Uncommon" then Theme.Teal else Color3.fromRGB(132, 94, 34)
end
return Theme
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001F">
        <Properties>
          <string name="Name">FishingInterface</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Catalog = require(Shared:WaitForChild("FishCatalog"))
local Rules = require(Shared:WaitForChild("FishingRules"))
local Fish = require(Shared:WaitForChild("FishModel"))
local Theme = require(script.Parent:WaitForChild("UITheme"))
local Layout = require(script.Parent:WaitForChild("InterfaceLayout"))
local Interface = {}

local function centered(label: TextLabel): TextLabel
	label.TextXAlignment = Enum.TextXAlignment.Center
	return label
end
local function viewport(parent: Instance, name: string, size: UDim2, position: UDim2)
	local view = Instance.new("ViewportFrame")
	view.Name, view.Size, view.Position = name, size, position
	view.BackgroundTransparency = 1
	view.Ambient = Color3.fromRGB(185, 204, 204)
	view.LightColor = Color3.fromRGB(255, 240, 213)
	view.LightDirection = Vector3.new(-1, -1, -2)
	view.Parent = parent
	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.lookAt(Vector3.new(0, 0.4, -6.5), Vector3.zero)
	camera.FieldOfView = 36
	camera.Parent = view
	view.CurrentCamera = camera
	local world = Instance.new("WorldModel")
	world.Parent = view
	return view, world, camera
end

function Interface.new(playerGui: Instance, audio: any, handlers: any)
	assert(not playerGui:FindFirstChild("MolnfiskarnaFishing"), "Install one fishing interface only.")
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn = "MolnfiskarnaFishing", false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	-- A small location label leaves the landscape visible, with one wallet chip.
	local location = Theme.frame(gui, "Location", UDim2.fromOffset(208, 48), UDim2.fromOffset(16, 12))
	location.BackgroundTransparency = 0.08
	local locationName = Theme.text(location, "CLOUD ANGLERS", UDim2.new(1, -24, 0, 21), UDim2.fromOffset(12, 5), 14, Theme.Ink, true)
	local locationSub = Theme.text(location, "SUNDRIFT HARBOR", UDim2.new(1, -24, 0, 14), UDim2.fromOffset(12, 28), 9, Theme.Muted, true)
	local coins = Theme.frame(gui, "Wallet", UDim2.fromOffset(122, 48), UDim2.new(1, -138, 0, 12))
	Theme.surface(coins)
	Theme.coin(coins, UDim2.fromOffset(10, 10), 28)
	local coinText = Theme.text(coins, "0", UDim2.new(1, -50, 1, 0), UDim2.fromOffset(46, 0), 19, Theme.Ink, true)
	local coinValue = Instance.new("NumberValue")
	coinValue.Parent = gui
	coinValue.Changed:Connect(function(value)
		local amount = math.floor(value + 0.5)
		coinText.Text = if amount &gt;= 1000000 then string.format("%.1fm", amount / 1000000)
			elseif amount &gt;= 10000 then string.format("%.1fk", amount / 1000) else tostring(amount)
	end)
	local coinTween: Tween? = nil
	local soundButton = Theme.button(gui, "SFX", UDim2.fromOffset(44, 48), UDim2.new(1, -190, 0, 12), Theme.Panel)
	soundButton.TextColor3, soundButton.TextSize = Theme.Teal, 11
	soundButton.Activated:Connect(function()
		local muted = audio.toggle()
		soundButton.Text = if muted then "OFF" else "SFX"
		if not muted then audio.ui() end
	end)
	local goalCard = Theme.frame(gui, "Adventure", UDim2.fromOffset(264, 64), UDim2.fromOffset(16, 72))
	Theme.surface(goalCard)
	local goalKicker = Theme.text(goalCard, "NEXT ADVENTURE", UDim2.new(1, -70, 0, 13), UDim2.fromOffset(14, 9), 9, Theme.Teal, true)
	local goalTitle = Theme.text(goalCard, "Land your first fish", UDim2.new(1, -70, 0, 25), UDim2.fromOffset(14, 25), 13, nil, true)
	local goalReward = Theme.text(goalCard, "+10", UDim2.fromOffset(42, 35), UDim2.new(1, -52, 0, 12), 15, Theme.rarity("Common"), true)
	goalReward.TextXAlignment = Enum.TextXAlignment.Right
	local goalTrack = Theme.frame(goalCard, "Progress", UDim2.new(1, -28, 0, 3), UDim2.fromOffset(14, 55), Theme.Line)
	goalTrack.ClipsDescendants = true
	local goalFill = Theme.frame(goalTrack, "Fill", UDim2.fromScale(0, 1), UDim2.fromOffset(0, 0), Theme.Teal)
	local journalButton = Theme.button(gui, "COLLECTION  0/6", UDim2.fromOffset(156, 48), UDim2.fromOffset(16, 150), Theme.Ink)
	journalButton.TextSize = 12

	local panel = Theme.frame(gui, "CastCard", UDim2.fromOffset(360, 122), UDim2.new(0.5, 0, 1, -20))
	panel.AnchorPoint = Vector2.new(0.5, 1)
	Theme.surface(panel)
	local status = centered(Theme.text(panel, "Find the lantern-lit dock to begin.", UDim2.new(1, -32, 0, 34), UDim2.fromOffset(16, 8), 12, Theme.Muted))
	local meter = Theme.frame(panel, "TimingTrack", UDim2.new(1, -40, 0, 20), UDim2.fromOffset(20, 52), Theme.Ink)
	meter.ClipsDescendants = true
	for _, zone in {
		{"Normal", Rules.NormalMin, Rules.NormalMax, Color3.fromRGB(151, 186, 147)},
		{"Fine", Rules.FineMin, Rules.FineMax, Color3.fromRGB(74, 166, 151)},
		{"Brilliant", Rules.BrilliantMin, Rules.BrilliantMax, Theme.Gold},
	} do
		local area = Instance.new("Frame")
		area.Name, area.Position = zone[1], UDim2.fromScale(zone[2], 0)
		area.Size, area.BackgroundColor3 = UDim2.fromScale(zone[3] - zone[2], 1), zone[4]
		area.BorderSizePixel, area.Parent = 0, meter
	end
	local marker = Instance.new("Frame")
	marker.Name, marker.Size = "Needle", UDim2.new(0, 4, 1, 0)
	marker.AnchorPoint, marker.BackgroundColor3 = Vector2.new(0.5, 0), Color3.new(1, 1, 1)
	marker.BorderSizePixel, marker.ZIndex, marker.Parent = 0, 2, meter
	local legend = centered(Theme.text(panel, "AIM FOR GOLD", UDim2.new(1, -32, 0, 18), UDim2.fromOffset(16, 78), 10, Theme.Teal, true))
	local button = Theme.button(panel, "CONNECTING...", UDim2.new(1, -24, 0, 52), UDim2.new(0.5, 0, 0, 46))
	button.AnchorPoint, button.TextSize = Vector2.new(0.5, 0), 16
	local buttonScale = Instance.new("UIScale")
	buttonScale.Parent = button
	local sessionText = centered(Theme.text(panel, "YOUR FIRST DISCOVERY IS WAITING", UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, 101), 9, Theme.Muted))

	local toast = Theme.frame(gui, "Notice", UDim2.fromOffset(340, 54), UDim2.new(0.5, 0, 0, 12), Theme.Ink)
	toast.AnchorPoint, toast.ZIndex, toast.Visible = Vector2.new(0.5, 0), 30, false
	local toastText = centered(Theme.text(toast, "", UDim2.new(1, -28, 1, 0), UDim2.fromOffset(14, 0), 13, Theme.Panel, true))
	local toastGeneration = 0
	local function notify(text: string)
		toastGeneration += 1
		local generation = toastGeneration
		toastText.Text, toast.Visible = text, true
		task.delay(3, function() if toastGeneration == generation then toast.Visible = false end end)
	end
	-- The collection is a gallery, with a separate workshop rather than squeezed controls.
	local modal = Instance.new("Frame")
	modal.Name, modal.Size = "CollectionOverlay", UDim2.fromScale(1, 1)
	modal.BackgroundColor3, modal.BackgroundTransparency = Theme.Ink, 0.26
	modal.BorderSizePixel, modal.ZIndex, modal.Visible, modal.Parent = 0, 10, false, gui
	modal.Active = true
	local book = Theme.frame(modal, "CollectionBook", UDim2.fromOffset(900, 590), UDim2.fromScale(0.5, 0.5))
	book.AnchorPoint, book.ClipsDescendants = Vector2.new(0.5, 0.5), true
	Theme.surface(book)
	local title = Theme.text(book, "The fish collection", UDim2.new(1, -84, 0, 32), UDim2.fromOffset(22, 16), 25, Theme.Ink, true)
	local bookStats = Theme.text(book, "0 of 6 discovered", UDim2.new(1, -44, 0, 20), UDim2.fromOffset(22, 50), 12, Theme.Muted)
	local close = Theme.button(book, "×", UDim2.fromOffset(44, 44), UDim2.new(1, -58, 0, 14), Theme.Soft)
	close.TextColor3, close.TextSize = Theme.Ink, 25
	local collectionTab = Theme.button(book, "Collection", UDim2.new(0.5, -26, 0, 44), UDim2.fromOffset(18, 80), Theme.Ink)
	local workshopTab = Theme.button(book, "Rod workshop", UDim2.new(0.5, -26, 0, 44), UDim2.new(0.5, 8, 0, 80), Theme.Soft)
	workshopTab.TextColor3 = Theme.Ink
	local function scrollFrame(name: string): ScrollingFrame
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name, scroll.Position = name, UDim2.fromOffset(18, 136)
		scroll.Size = UDim2.new(1, -36, 1, -182)
		scroll.BackgroundTransparency, scroll.BorderSizePixel = 1, 0
		scroll.ScrollBarThickness, scroll.ScrollBarImageColor3 = 3, Theme.Teal
		scroll.CanvasSize, scroll.AutomaticCanvasSize = UDim2.fromOffset(0, 0), Enum.AutomaticSize.Y
		scroll.Parent = book
		return scroll
	end
	local collection = scrollFrame("FishGallery")
	local grid = Instance.new("UIGridLayout")
	grid.CellSize, grid.CellPadding = UDim2.new(1 / 3, -8, 0, 174), UDim2.fromOffset(10, 10)
	grid.SortOrder, grid.Parent = Enum.SortOrder.LayoutOrder, collection
	local entries: { [string]: any } = {}
	local selectedId = Catalog.Species[1].Id
	local hint = Theme.text(book, "Select a fish to explore its entry.", UDim2.new(1, -44, 0, 34), UDim2.new(0, 22, 1, -40), 12, Theme.Muted)
	local currentProfile: any = nil
	local function selectSpecies(id: string)
		selectedId = id
		for fishId, entry in entries do
			entry.stroke.Color = if fishId == id then Theme.Teal else Theme.Line
			entry.stroke.Thickness = if fishId == id then 2 else 1
		end
		local species = Catalog.get(id)
		hint.Text = species.Name .. " · " .. species.Hint
	end
	for index, species in Catalog.Species do
		local card = Theme.button(collection, "", UDim2.fromOffset(200, 174), UDim2.fromOffset(0, 0), Theme.Soft)
		card.Name, card.LayoutOrder = species.Id, index
		local stroke = Theme.stroke(card)
		local view, world = viewport(card, "Portrait", UDim2.new(1, -8, 1, -56), UDim2.fromOffset(4, 0))
		view.Active = false
		local fish = Fish.create(world, nil, species.Id)
		fish:PivotTo(CFrame.Angles(0, -0.24, 0))
		local badge = Theme.frame(card, "RarityDot", UDim2.fromOffset(7, 7), UDim2.fromOffset(12, 12), Theme.rarity(species.Rarity))
		local name = Theme.text(card, species.Name, UDim2.new(1, -20, 0, 23), UDim2.new(0, 10, 1, -51), 14, Theme.Ink, true)
		local best = Theme.text(card, "Undiscovered", UDim2.new(1, -20, 0, 18), UDim2.new(0, 10, 1, -27), 11, Theme.Muted)
		entries[species.Id] = { view = view, model = fish, status = best, name = name, badge = badge, stroke = stroke, species = species }
		card.Activated:Connect(function() selectSpecies(species.Id); audio.ui() end)
	end
	selectSpecies(selectedId)
	local workshop = scrollFrame("WorkshopPage")
	workshop.Visible = false
	local shopBody = Theme.frame(workshop, "WorkshopContent", UDim2.new(1, -6, 0, 362), UDim2.fromOffset(0, 0), Theme.Panel)
	shopBody.BackgroundTransparency = 1
	local rodStage = Theme.frame(shopBody, "RodStage", UDim2.new(0.4, -12, 0, 230), UDim2.fromOffset(0, 0), Theme.Soft)
	local rodView, rodWorld, rodCamera = viewport(rodStage, "RodPreview", UDim2.fromScale(1, 1), UDim2.fromOffset(0, 0))
	rodCamera.CFrame = CFrame.lookAt(Vector3.new(0, 0, -11), Vector3.zero)
	local rod = Instance.new("Model")
	local function rodPart(name: string, size: Vector3, cf: CFrame, color: Color3)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
		p.Anchored, p.CanCollide, p.Material, p.Parent = true, false, Enum.Material.SmoothPlastic, rod
		return p
	end
	local grip = rodPart("Grip", Vector3.new(0.28, 1.5, 0.28), CFrame.new(0, -1.7, 0), Color3.fromRGB(133, 91, 59))
	rod.PrimaryPart = grip
	rodPart("Shaft", Vector3.new(0.1, 4.6, 0.1), CFrame.new(0, 1.1, 0), Theme.Teal)
	local reelPart = rodPart("Reel", Vector3.new(0.7, 0.7, 0.34), CFrame.new(0.32, -1.4, -0.1), Theme.Gold)
	reelPart.Shape = Enum.PartType.Cylinder
	for y = -1, 3, 0.8 do rodPart("Binding", Vector3.new(0.16, 0.08, 0.16), CFrame.new(0, y, 0), Theme.Gold) end
	-- Set a central model pivot before rotating it as a unit.
	rod.PrimaryPart = nil
	rod.WorldPivot = CFrame.identity
	rod.Parent = rodWorld
	rod:PivotTo(CFrame.Angles(0, 0, -0.4))
	local equipped = centered(Theme.text(rodStage, "EQUIPPED · DRIFTWOOD", UDim2.new(1, -16, 0, 26), UDim2.new(0, 8, 1, -32), 10, Theme.Teal, true))
	local shopInfo = Theme.frame(shopBody, "UpgradeDetails", UDim2.new(0.6, -8, 0, 230), UDim2.new(0.4, 8, 0, 0), Theme.Panel)
	shopInfo.BackgroundTransparency = 1
	Theme.text(shopInfo, "YOUR NEXT UPGRADE", UDim2.new(1, 0, 0, 20), UDim2.fromOffset(0, 8), 10, Theme.Teal, true)
	local upgradeName = Theme.text(shopInfo, "Breeze Rod", UDim2.new(1, 0, 0, 38), UDim2.fromOffset(0, 30), 27, Theme.Ink, true)
	local upgradeDesc = Theme.text(shopInfo, "Unlock more fish and earn extra coins.", UDim2.new(1, 0, 0, 58), UDim2.fromOffset(0, 75), 14, Theme.Muted)
	local upgradeButton = Theme.button(book, "Upgrade · 32 coins", UDim2.new(1, -36, 0, 48), UDim2.new(0, 18, 1, -62))
	upgradeButton.Visible = false
	upgradeButton.Activated:Connect(function()
		local nextRod = if currentProfile then currentProfile.nextUpgrade else nil
		if not nextRod then return end
		if currentProfile.coins &lt; nextRod.cost then
			audio.ui(false)
			notify("Just " .. (nextRod.cost - currentProfile.coins) .. " more coins to go!")
			return
		end
		handlers.upgrade()
	end)
	local income = Theme.frame(shopBody, "OfflineIncome", UDim2.new(1, 0, 0, 100), UDim2.fromOffset(0, 248), Theme.Soft)
	Theme.text(income, "A little gift for your next visit", UDim2.new(1, -32, 0, 27), UDim2.fromOffset(16, 10), 15, Theme.Teal, true)
	local incomeText = Theme.text(income, "Discover fish to earn coins while you are away.", UDim2.new(1, -32, 0, 52), UDim2.fromOffset(16, 40), 12, Theme.Muted)
	local tab = "Collection"
	local function setTab(nextTab: string)
		tab = nextTab
		collection.Visible, workshop.Visible = tab == "Collection", tab == "Workshop"
		collectionTab.BackgroundColor3 = if collection.Visible then Theme.Ink else Theme.Soft
		collectionTab.TextColor3 = if collection.Visible then Theme.Panel else Theme.Ink
		workshopTab.BackgroundColor3 = if workshop.Visible then Theme.Ink else Theme.Soft
		workshopTab.TextColor3 = if workshop.Visible then Theme.Panel else Theme.Ink
		hint.Visible = collection.Visible
		upgradeButton.Visible = workshop.Visible
		title.Text = if collection.Visible then "The fish collection" else "Rod &amp; Reel"
	end
	collectionTab.Activated:Connect(function() setTab("Collection"); audio.ui() end)
	workshopTab.Activated:Connect(function() setTab("Workshop"); audio.ui() end)
	local function openJournal(target: string?)
		setTab(if target == "Workshop" then "Workshop" else "Collection")
		handlers.openJournal()
		audio.ui()
		modal.Visible, panel.Visible = true, false
	end
	journalButton.Activated:Connect(function() openJournal("Collection") end)
	close.Activated:Connect(function() audio.ui(); modal.Visible, panel.Visible = false, true end)

	local reveal = Theme.frame(gui, "DiscoveryCard", UDim2.fromOffset(360, 370), UDim2.fromScale(0.5, 0.46))
	reveal.AnchorPoint, reveal.ZIndex, reveal.Visible = Vector2.new(0.5, 0.5), 5, false
	Theme.surface(reveal)
	local revealScale = Instance.new("UIScale")
	revealScale.Parent = reveal
	local revealTitle = centered(Theme.text(reveal, "A FRESH CATCH", UDim2.new(1, -64, 0, 22), UDim2.fromOffset(32, 18), 11, Theme.Teal, true))
	local halo = Theme.frame(reveal, "PortraitHalo", UDim2.fromOffset(176, 176), UDim2.new(0.5, -88, 0, 53), Theme.Soft)
	Theme.round(halo, 100)
	local view, fishWorld = viewport(reveal, "CatchPortrait", UDim2.new(1, 0, 0, 192), UDim2.fromOffset(0, 43))
	local revealFish: Model? = nil
	local revealName = centered(Theme.text(reveal, "Pufflet", UDim2.new(1, -32, 0, 36), UDim2.fromOffset(16, 232), 28, Theme.Ink, true))
	local revealQuality = centered(Theme.text(reveal, "Common · Normal", UDim2.new(1, -32, 0, 22), UDim2.fromOffset(16, 270), 13, Theme.Muted))
	local earnings = Theme.frame(reveal, "Earnings", UDim2.new(1, -40, 0, 48), UDim2.fromOffset(20, 309), Theme.Soft)
	Theme.coin(earnings, UDim2.fromOffset(14, 10), 28)
	local revealCoins = centered(Theme.text(earnings, "+8 coins", UDim2.new(1, -58, 1, 0), UDim2.fromOffset(46, 0), 16, Theme.Ink, true))
	local closeReveal = Theme.button(reveal, "×", UDim2.fromOffset(44, 44), UDim2.new(1, -48, 0, 3), Theme.Panel)
	closeReveal.TextColor3, closeReveal.TextSize = Theme.Muted, 23
	local revealGeneration, revealBaseScale = 0, 1
	local revealTween: Tween? = nil
	local function hideResult()
		revealGeneration += 1
		if revealTween then revealTween:Cancel() end
		reveal.Visible, panel.Visible = false, not modal.Visible
	end
	closeReveal.Activated:Connect(hideResult)
	local lastPhase = ""
	local panelWidth = 360
	local panelTween: Tween? = nil
	local function setState(phase: string)
		if phase == lastPhase then return end
		lastPhase = phase
		local reeling = phase == "Reeling"
		meter.Visible, legend.Visible, marker.Visible = reeling, reeling, reeling
		button.Position = UDim2.new(0.5, 0, 0, if reeling then 104 else 46)
		sessionText.Position = UDim2.fromOffset(12, if reeling then 159 else 101)
		if panelTween then panelTween:Cancel() end
		panelTween = TweenService:Create(panel, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(panelWidth, if reeling then 180 else 122) })
		panelTween:Play()
	end
	local function updateProfile(profile: any)
		if not profile then return end
		if not currentProfile or profile.coins ~= currentProfile.coins then
			if coinTween then coinTween:Cancel() end
			coinTween = TweenService:Create(coinValue, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Value = profile.coins })
			coinTween:Play()
		end
		currentProfile = profile
		journalButton.Text = "COLLECTION  " .. profile.species .. "/6"
		sessionText.Text = profile.species .. "/6 DISCOVERED  ·  " .. profile.points .. " COLLECTION POINTS"
		bookStats.Text = profile.species .. " / 6 fish found   ·   " .. profile.points .. " / 18 points"
		equipped.Text = "EQUIPPED · " .. string.upper(profile.rod)
		incomeText.Text = if profile.persistent then "Your fish earn " .. profile.offlineRate .. " coins/min while you are away. Up to 120 coins over 8 hours. Progress saves automatically."
			else "Offline earnings start in the published game. This Studio playtest uses temporary progress."
		goalTitle.Text = profile.goal.title
		goalKicker.Text = "NEXT ADVENTURE  ·  " .. profile.goal.progress .. "/" .. profile.goal.target
		goalReward.Text = "+" .. profile.goal.reward
		TweenService:Create(goalFill, TweenInfo.new(0.35), { Size = UDim2.fromScale(math.clamp(profile.goal.progress / math.max(1, profile.goal.target), 0, 1), 1) }):Play()
		for id, entry in entries do
			local best = profile.best[id]
			entry.view.ImageColor3 = if best then Color3.new(1, 1, 1) else Color3.fromRGB(83, 112, 108)
			entry.view.ImageTransparency = if best then 0 else 0.45
			entry.name.Text = if best then entry.species.Name else "???"
			entry.status.Text = if best then entry.species.Rarity .. " · " .. ({"Normal", "Fine", "Brilliant"})[best]
				elseif entry.species.Level &gt; profile.level then "Rod level " .. entry.species.Level else "Waiting to be found"
		end
		local nextRod = profile.nextUpgrade
		upgradeName.Text = if nextRod then nextRod.name else "Beautifully equipped"
		upgradeDesc.Text = if nextRod then nextRod.description else "Your rod is fully upgraded. Find every fish and chase Brilliant catches."
		upgradeButton.Text = if nextRod then "Upgrade · " .. nextRod.cost .. " coins" else "Fully upgraded"
		upgradeButton.BackgroundColor3 = if nextRod and profile.coins &gt;= nextRod.cost then Theme.Teal else Theme.Muted
	end
	local function showResult(result: any)
		revealGeneration += 1
		local generation = revealGeneration
		audio.catch(result.quality, result.rarity, result.newDiscovery)
		task.delay(0.65, function()
			if generation ~= revealGeneration or modal.Visible then return end
			if revealFish then revealFish:Destroy() end
			revealFish = Fish.create(fishWorld, nil, result.speciesId)
			revealTitle.Text = if result.newDiscovery then "A NEW DISCOVERY" elseif result.improved then "YOUR NEW PERSONAL BEST" else "A FRESH CATCH"
			revealTitle.TextColor3 = Theme.rarity(result.rarity or "Common")
			halo.BackgroundColor3 = Theme.rarity(result.rarity or "Common"):Lerp(Theme.Panel, 0.86)
			revealName.Text, revealQuality.Text = result.species, (result.rarity or "Common") .. " · " .. result.quality
			revealCoins.Text = "+" .. (result.coins or 0) .. " coins" .. (if (result.goalBonus or 0) &gt; 0 then "  +" .. result.goalBonus .. " bonus" else "")
			panel.Visible, reveal.Visible = false, true
			revealScale.Scale = revealBaseScale * 0.85
			if revealTween then revealTween:Cancel() end
			revealTween = TweenService:Create(revealScale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = revealBaseScale })
			revealTween:Play()
			task.delay(2.8, function() if generation == revealGeneration then hideResult() end end)
		end)
	end
	local lastWidth, lastHeight = 0, 0
	local function animate(time: number, width: number, height: number)
		if reveal.Visible and revealFish then
			revealFish:PivotTo(CFrame.Angles(0, math.sin(time * 1.3) * 0.24, math.sin(time * 2) * 0.035))
			Fish.animate(revealFish, time)
		end
		if modal.Visible and collection.Visible then
			local entry = entries[selectedId]
			entry.model:PivotTo(CFrame.Angles(0, -0.24 + math.sin(time) * 0.18, math.sin(time * 1.5) * 0.035))
			Fish.animate(entry.model, time)
		end
		local canvas = gui.AbsoluteSize
		local safeWidth = if canvas.X &gt; 0 then canvas.X else width
		local safeHeight = if canvas.Y &gt; 0 then canvas.Y else height
		if safeWidth == lastWidth and safeHeight == lastHeight then return end
		lastWidth, lastHeight = safeWidth, safeHeight
		if panelTween then panelTween:Cancel() end
		if revealTween then revealTween:Cancel() end
		local layout = Layout.measure(safeWidth, safeHeight)
		location.Size = UDim2.fromOffset(math.min(208, layout.width - 218), 48)
		locationName.Text = if layout.narrow then "ANGLERS" else "CLOUD ANGLERS"
		locationName.TextSize = if layout.narrow then 11 else 14
		locationSub.Text = if layout.narrow then "SUNDRIFT" else "SUNDRIFT HARBOR"
		locationSub.TextSize = if layout.narrow then 8 else 9
		goalCard.Size, goalCard.Visible = UDim2.fromOffset(layout.goalWidth, 64), not layout.compact
		journalButton.Position = UDim2.fromOffset(16, layout.journalY)
		journalButton.Size = UDim2.fromOffset(if layout.narrow then 144 else 156, 48)
		panelWidth = layout.panelWidth
		panel.Size = UDim2.fromOffset(panelWidth, if lastPhase == "Reeling" then 180 else 122)
		panel.Position = UDim2.new(0.5, 0, 1, -layout.panelBottom)
		book.Size = UDim2.fromOffset(layout.bookWidth, layout.bookHeight)
		title.TextSize = if layout.narrow or layout.compact then 20 else 25
		bookStats.Visible = not layout.compact
		collectionTab.Position = UDim2.fromOffset(18, if layout.compact then 50 else 80)
		workshopTab.Position = UDim2.new(0.5, 8, 0, if layout.compact then 50 else 80)
		local contentY = if layout.compact then 108 else 136
		collection.Position, collection.Size = UDim2.fromOffset(18, contentY), UDim2.new(1, -36, 1, -contentY - 46)
		workshop.Position, workshop.Size = UDim2.fromOffset(18, contentY), UDim2.new(1, -36, 1, -contentY - 78)
		upgradeButton.Size = UDim2.fromOffset(if layout.narrow or layout.compact then layout.bookWidth - 36 else 244, 48)
		upgradeButton.Position = UDim2.new(1, -18, 1, -62)
		upgradeButton.AnchorPoint = Vector2.new(1, 0)
		grid.CellSize = UDim2.new(1 / layout.columns, -7, 0, layout.cardHeight)
		toast.Size = UDim2.fromOffset(math.min(340, layout.width - 32), 54)
		toast.Position = UDim2.new(0.5, 0, 0, if layout.compact then 64 else 72)
		revealBaseScale = layout.revealScale
		revealScale.Scale = revealBaseScale
		closeReveal.Size = UDim2.fromOffset(44 / revealBaseScale, 44 / revealBaseScale)
		closeReveal.Position = UDim2.new(1, -4 - 44 / revealBaseScale, 0, 3)
		upgradeName.TextSize = if layout.compact then 23 else 27
		upgradeName.Position = UDim2.fromOffset(0, if layout.compact then 22 else 30)
		upgradeDesc.Position = UDim2.fromOffset(0, if layout.compact then 62 else 75)
		upgradeDesc.TextSize = if layout.compact then 12 else 14
		local vertical = layout.workshopVertical
		rodStage.Size = if vertical then UDim2.new(1, 0, 0, 180) else UDim2.new(0.4, -12, 0, 230)
		shopInfo.Size = if vertical then UDim2.new(1, 0, 0, 148) else UDim2.new(0.6, -8, 0, 230)
		shopInfo.Position = if vertical then UDim2.fromOffset(0, 196) else UDim2.new(0.4, 8, 0, 0)
		shopBody.Size = UDim2.new(1, -6, 0, if vertical then 462 else 362)
		income.Position = UDim2.fromOffset(0, if vertical then 356 else 248)
	end
	setState("Connecting")
	return {
		button = button, status = status, marker = marker, legend = legend, buttonScale = buttonScale,
		hideResult = hideResult, showResult = showResult, updateProfile = updateProfile,
		notify = notify, setState = setState, animate = animate, openJournal = openJournal,
		isJournalOpen = function() return modal.Visible end,
		isResultOpen = function() return reveal.Visible end,
	}
end
return Interface
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBX00000006">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
</roblox>