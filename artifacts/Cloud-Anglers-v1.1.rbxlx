      <Item class="ModuleScript" referent="RBX00000009">
        <Properties>
          <string name="Name">FishingConfig</string>
          <ProtectedString name="Source">--!strict
-- Shared presentation/tuning values. The server still owns every attempt.
return table.freeze({
	PreparationTime = 0.8,
	BiteTimeout = 12,
	ChargeLeadTime = 0.3,
	ChargeDuration = 2.8,
	DynamicTiming = true,
	StartCooldown = 0.6,
	MaxDistance = 16,
	RequestCapacity = 12,
	RequestsPerSecond = 5,
	SpeciesName = "Pufflet",
	CreatePrototypeWorld = true,
	EnableSaving = true,
	SaveInStudio = false,
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000A">
        <Properties>
          <string name="Name">FishingRules</string>
          <ProtectedString name="Source">--!strict
-- Pure rules: usable in Roblox and the standalone Luau test runner.
local Rules = {
	NormalMin = 0.22,
	NormalMax = 0.95,
	FineMin = 0.48,
	FineMax = 0.84,
	BrilliantMin = 0.61,
	BrilliantMax = 0.75,
}

-- The gold target changes between casts, keeping timing readable rather than
-- turning every fish into the same memorized hold. Both sides use this center.
function Rules.centerFor(attemptId: number): number
	local centers = { 0.68, 0.52, 0.75, 0.60, 0.70 }
	return centers[(attemptId - 1) % #centers + 1]
end

function Rules.qualityAt(progress: number, center: number?): string?
	if progress ~= progress or progress &lt; Rules.NormalMin or progress &gt; Rules.NormalMax then
		return nil
	end
	local brilliantMin, brilliantMax, fineMin, fineMax = Rules.BrilliantMin, Rules.BrilliantMax, Rules.FineMin, Rules.FineMax
	if center and center == center and center &gt;= 0.45 and center &lt;= 0.8 then
		brilliantMin, brilliantMax, fineMin, fineMax = center - 0.07, center + 0.07, center - 0.20, center + 0.16
	end
	if progress &gt;= brilliantMin and progress &lt;= brilliantMax then
		return "Brilliant"
	end
	if progress &gt;= fineMin and progress &lt;= fineMax then
		return "Fine"
	end
	return "Normal"
end

return table.freeze(Rules)
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000B">
        <Properties>
          <string name="Name">FishModel</string>
          <ProtectedString name="Source">--!strict
-- Original stylized fish. Tapered fins, forked tails and small surface markings
-- provide the silhouettes; no uploaded meshes or animation assets are needed.
local Catalog = require(script.Parent:WaitForChild("FishCatalog"))
local Fish = {}

local function shape(parent: Model, name: string, size: Vector3, position: Vector3, color: Color3, tapered: boolean?): BasePart
	local part: BasePart = if tapered then Instance.new("WedgePart") else Instance.new("Part")
	if part:IsA("Part") then part.Shape = Enum.PartType.Ball end
	part.Name, part.Size, part.Position = name, size, position
	part.Color, part.Material = color, Enum.Material.SmoothPlastic
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.LeftSurface, part.RightSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.FrontSurface, part.BackSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
	part.Parent = parent
	return part
end

function Fish.create(parent: Instance, name: string?, speciesId: string?): Model
	local species = Catalog.get(speciesId)
	local bodyColor, finColor = Color3.fromRGB(table.unpack(species.Body)), Color3.fromRGB(table.unpack(species.Fin))
	local model = Instance.new("Model")
	model.Name = name or species.Name
	model:SetAttribute("SpeciesId", species.Id)
	local kind = species.Shape
	local size = if kind == "Ray" then Vector3.new(1.65, 0.64, 2.45)
		elseif kind == "Whale" then Vector3.new(2.35, 1.7, 2.9)
		elseif kind == "Squid" then Vector3.new(1.7, 2.25, 1.6)
		elseif kind == "Turtle" then Vector3.new(2.05, .72, 2.15)
		elseif kind == "Long" then Vector3.new(1.3, 1.12, 2.95)
		elseif kind == "Ribbon" then Vector3.new(1.5, 1.2, 2.75)
		elseif kind == "Lure" then Vector3.new(2.15, 1.55, 2.5)
		elseif kind == "Wings" then Vector3.new(1.1, 1.05, 2.2)
		elseif kind == "Whiskers" then Vector3.new(1.85, 1.4, 2.75)
		elseif kind == "Spiky" or kind == "Crown" then Vector3.new(1.9, 1.4, 2.65)
		elseif species.Id == "petalperch" then Vector3.new(2.05, 1.45, 2.45)
		else Vector3.new(2.35, 1.72, 2.1)
	local body = shape(model, "Body", size, Vector3.zero, bodyColor)
	model.PrimaryPart = body
	-- This thin inset follows the body's underside rather than becoming a second
	-- ball attached to it. The stock gives ordinary tails a continuous narrow root.
	shape(model, "Belly", size * Vector3.new(0.74, 0.35, 0.79), Vector3.new(0, -size.Y * 0.34, -0.05), bodyColor:Lerp(Color3.new(1, 1, 1), 0.62))
	if kind ~= "Squid" and kind ~= "Turtle" then
		shape(model, "TailStock", Vector3.new(size.X * 0.27, size.Y * 0.30, 0.78), Vector3.new(0, -0.04, size.Z * 0.43), bodyColor)
	end
	local front = if kind == "Turtle" then -1.52 else -size.Z * 0.44
	local eyeX = math.min(0.48, size.X * 0.28)
	local eyeY = if kind == "Ray" then 0.25 else size.Y * 0.11
	local cheek = finColor:Lerp(bodyColor, 0.4)
	if kind == "Turtle" then
		shape(model, "TurtleHead", Vector3.new(.85,.56,.9), Vector3.new(0,-.03,-1.15), bodyColor)
	end
	for _, side in { -1, 1 } do
		if kind ~= "Turtle" then
			local span = if kind == "Ray" then 1.9 elseif kind == "Wings" then 1.75 elseif kind == "Ribbon" then 1.1 elseif kind == "Whale" then .85 else .8
			local length = if kind == "Ray" then 2.25 elseif kind == "Wings" then 1.75 elseif kind == "Ribbon" then 1.8 else 1.15
			local x = if kind == "Ray" then 1.0 elseif kind == "Wings" then .9 else size.X * .47 + .16
			local fin = shape(model, "Fin", Vector3.new(.14,span,length), Vector3.new(side*x,-.12,.28), finColor,true)
			fin.CFrame *= CFrame.Angles(0,side*-.2,side*math.pi/2)
			fin:SetAttribute("Side",side)
		end
		if kind ~= "Squid" and kind ~= "Turtle" and kind ~= "Ray" then
			-- Two opposed triangular lobes make a true fork, not a pair of beads.
			local horizontal = kind == "Whale" or kind == "Wings"
			local tail = shape(model,"Tail",Vector3.new(.14,if kind == "Ribbon" then .92 else .72,if kind == "Ribbon" then 1.15 else .82),
				Vector3.new(if horizontal then side*.37 else 0,if horizontal then -.05 else side*.32,size.Z*.56+.3),finColor,true)
			tail.CFrame *= if horizontal then CFrame.Angles(0,side*-.15,side*math.pi/2) else CFrame.Angles(0,0,if side == 1 then 0 else math.pi)
			tail:SetAttribute("Side",side)
		end
		-- Eyes are inset, almost flat ovals. Tiny glints read as paint rather than
		-- another stack of spheres attached to a spherical head.
		shape(model,"EyeWhite",Vector3.new(.40,.44,.13),Vector3.new(side*eyeX,eyeY,front),Color3.new(1,1,1))
		shape(model,"Pupil",Vector3.new(.18,.25,.07),Vector3.new(side*eyeX,eyeY+.015,front-.075),Color3.fromRGB(25,44,63))
		shape(model,"EyeGlint",Vector3.new(.055,.075,.025),Vector3.new(side*eyeX-.035,eyeY+.075,front-.12),Color3.new(1,1,1))
		shape(model,"Cheek",Vector3.new(.28,.09,.035),Vector3.new(side*(eyeX+.17),eyeY-.27,front+.02),Color3.fromRGB(223,149,146))
		if kind ~= "Turtle" and kind ~= "Squid" and kind ~= "Ray" then
			for stroke=0,1 do
				local z=-size.Z*.12+stroke*.18
				local x=size.X*.5*math.sqrt(1-(z/(size.Z*.5))^2)+.006
				local gill=shape(model,"GillLine",Vector3.new(.025,.34,.065),Vector3.new(side*x,-.01,z),finColor:Lerp(bodyColor,.45))
				gill.CFrame *= CFrame.Angles(.18,0,side*-.14)
			end
		end
		if kind == "Whiskers" then
			for branch=0,1 do
				local whisker=shape(model,"Whisker",Vector3.new(.95,.055,.065),Vector3.new(side*.93,-.10-branch*.18,front-.04),finColor)
				whisker.CFrame*=CFrame.Angles(0,side*-.3,side*(.1+branch*.2))
			end
		elseif kind == "Wings" then
			local lower=shape(model,"WingTip",Vector3.new(.10,1.05,1.0),Vector3.new(side*.9,-.18,1.05),finColor:Lerp(bodyColor,.3),true)
			lower.CFrame*=CFrame.Angles(0,side*.3,side*math.pi/2)
			local antenna=shape(model,"Antenna",Vector3.new(.055,.8,.07),Vector3.new(side*.26,.78,front+.12),finColor)
			antenna.CFrame*=CFrame.Angles(-.25,0,side*-.28)
		elseif kind == "Turtle" then
			for z=-1,1,2 do
				local flipper=shape(model,"Fin",Vector3.new(.12,.85,.95),Vector3.new(side*1.12,-.26,z*.64),finColor,true)
				flipper.CFrame*=CFrame.Angles(0,side*z*.22,side*math.pi/2)
				flipper:SetAttribute("Side",side)
			end
		elseif kind == "Ribbon" then
			local patch=shape(model,"KoiPatch",Vector3.new(.035,.65,.8),Vector3.new(side*.745,.12,-.2),finColor)
			patch.CFrame*=CFrame.Angles(.35,0,0)
		elseif kind == "Whale" then
			for stripe=0,1 do
				shape(model,"WhalePleat",Vector3.new(.035,.035,.95),Vector3.new(side*(.16+stripe*.23),-.72,-.42),finColor:Lerp(bodyColor,.5))
			end
		end
	end
	shape(model,"Mouth",Vector3.new(.25,.065,.045),Vector3.new(0,eyeY-.22,if kind=="Turtle" then -1.615 else -size.Z*.5-.012),Color3.fromRGB(81,59,61))
	if kind == "Turtle" then
		shape(model,"MossShell",Vector3.new(2.2,.94,1.95),Vector3.new(0,.22,.12),finColor:Lerp(bodyColor,.65))
		for index=-1,1 do
			shape(model,"ShellSeam",Vector3.new(.035,.04,1.28),Vector3.new(index*.46,.69-math.abs(index)*.045,.12),finColor:Lerp(bodyColor,.3))
		end
	elseif kind == "Squid" then
		for index=0,5 do
			local angle=index*math.pi/3
			local tentacle=shape(model,"Tentacle",Vector3.new(.18,1.24,.22),Vector3.new(math.cos(angle)*.57,-1.32,math.sin(angle)*.46),finColor)
			tentacle.CFrame*=CFrame.Angles(.13*math.sin(angle),0,-.23*math.cos(angle))
			tentacle:SetAttribute("Side",index)
			local tip=shape(model,"TentacleTip",Vector3.new(.13,.57,.15),Vector3.zero,finColor:Lerp(bodyColor,.25))
			tip.CFrame=tentacle.CFrame*CFrame.new(0,-.73,0)*CFrame.Angles(.2*math.sin(angle),0,-.22*math.cos(angle))
			tip:SetAttribute("Side",index)
		end
	elseif kind == "Crown" or kind == "Whale" then
		for index=-1,1 do
			local x=index*.38
			local height=.58-math.abs(index)*.12
			for _,half in {-1,1} do
				local crown=shape(model,"Crown",Vector3.new(.13,height,.20),Vector3.new(x+half*.10,size.Y*.5+.16,.04),finColor,true)
				crown.CFrame*=CFrame.Angles(0,-half*math.pi/2,0)
			end
		end
	elseif kind == "Spiky" or kind == "Whiskers" or kind == "Long" or species.Id == "petalperch" then
		for index=0,2 do
			local dorsal=shape(model,"DorsalFin",Vector3.new(.12,.53-index*.08,.48),Vector3.new(0,size.Y*.43+.1,-.38+index*.37),finColor,true)
			dorsal.CFrame*=CFrame.Angles(0,math.pi,0)
		end
	elseif kind == "Lure" then
		for step=0,2 do
			local stem=shape(model,"LureStem",Vector3.new(.065,.45,.075),Vector3.new(0,.8+step*.25,front+.22-step*.11),finColor)
			stem.CFrame*=CFrame.Angles(-.35,0,0)
		end
		shape(model,"LurePearl",Vector3.new(.32,.37,.26),Vector3.new(0,1.45,front-.1),finColor)
	elseif kind == "Ray" then
		local tail=shape(model,"Tail",Vector3.new(.11,.12,1.7),Vector3.new(0,-.03,1.72),finColor)
		tail:SetAttribute("Side",1)
	elseif kind == "Round" then
		for _,x in {-.55,0,.55} do
			local y=size.Y*.5*math.sqrt(1-(x/(size.X*.5))^2-(-.14/(size.Z*.5))^2)+.008
			shape(model,"PuffletSpot",Vector3.new(.2,.035,.28),Vector3.new(x,y,-.14),cheek)
		end
	end
	-- Immutable rest geometry supports repeatable appearance changes at any pivot.
	for index, part in model:GetChildren() do
		if not part:IsA("BasePart") then continue end
		part:SetAttribute("FishRestCFrame", part.CFrame)
		part:SetAttribute("FishRestSize", part.Size)
		part:SetAttribute("FishBaseColor", part.Color)
		part:SetAttribute("FishColorIndex", index)
		if part.Name == "Fin" or part.Name == "Tail" or part.Name == "Tentacle" or part.Name == "TentacleTip" then part:SetAttribute("FinRest", part.CFrame) end
	end
	model.Parent = parent
	return model
end

function Fish.applyAppearance(model: Model, variant: string?, weightKg: number?, displayScale: number?)
	local species = Catalog.get(model:GetAttribute("SpeciesId"))
	local scale = 1
	if type(weightKg) == "number" and weightKg == weightKg and weightKg &gt; 0 and weightKg &lt; math.huge then
		local ratio = math.clamp((weightKg - species.WeightMin) / math.max(0.01, species.WeightMax - species.WeightMin), 0, 1)
		scale = 0.86 + ratio * 0.32
	end
	-- Tank models use a bounded presentation scale; the recorded weight stays real.
	if type(displayScale) == "number" and displayScale == displayScale and displayScale &gt; 0 and displayScale &lt; math.huge then
		scale *= math.clamp(displayScale, 0.5, 1)
	end
	local palette = { Color3.fromRGB(166, 132, 207), Color3.fromRGB(86, 178, 181), Color3.fromRGB(215, 145, 174), Color3.fromRGB(221, 188, 117) }
	local pivot = model:GetPivot()
	for _, part in model:GetChildren() do
		if not part:IsA("BasePart") then continue end
		local rest = part:GetAttribute("FishRestCFrame") :: CFrame?
		local restSize = part:GetAttribute("FishRestSize") :: Vector3?
		local color = part:GetAttribute("FishBaseColor") :: Color3?
		if not rest or not restSize or not color then continue end
		local scaledRest = CFrame.new(rest.Position * scale) * (rest - rest.Position)
		part.Size, part.CFrame, part.Color = restSize * scale, pivot * scaledRest, color
		if part:GetAttribute("FinRest") then part:SetAttribute("FinRest", scaledRest) end
		if part.Name == "EyeWhite" or part.Name == "Pupil" or part.Name == "EyeGlint" or part.Name == "Mouth" then continue end
		if variant == "Golden" then part.Color = color:Lerp(Color3.fromRGB(226, 187, 79), 0.8)
		elseif variant == "Prismatic" then
			local index = part:GetAttribute("FishColorIndex") :: number
			part.Color = color:Lerp(palette[index % #palette + 1], 0.82)
		end
	end
	model:SetAttribute("Variant", variant or "Normal")
end

function Fish.animate(model: Model, time: number)
	local pivot = model:GetPivot()
	for _, child in model:GetChildren() do
		if not child:IsA("BasePart") then continue end
		local rest = child:GetAttribute("FinRest")
		local side = child:GetAttribute("Side")
		if typeof(rest) ~= "CFrame" or typeof(side) ~= "number" then continue end
		if child.Name == "Fin" then
			child.CFrame = pivot * rest * CFrame.Angles(0, 0, math.sin(time * 5 + side * 0.3) * 0.18 * side)
		elseif child.Name == "Tail" then
			child.CFrame = pivot * rest * CFrame.Angles(0, math.sin(time * 6) * 0.17, 0)
		elseif child.Name == "Tentacle" or child.Name == "TentacleTip" then
			child.CFrame = pivot * rest * CFrame.Angles(math.sin(time * 3 + side) * 0.14, 0, math.cos(time * 3 + side) * 0.1)
		end
	end
end

return Fish
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000C">
        <Properties>
          <string name="Name">FishCatalog</string>
          <ProtectedString name="Source">--!strict
-- Plain data. Every island has its own catches; all islands are free to visit.
export type Species = {
	Id: string, Name: string, Rarity: string, Level: number, Weight: number,
	Coins: number, Body: { number }, Fin: { number }, Shape: string, Hint: string,
	Zone: string, WeightMin: number, WeightMax: number,
}
local Catalog = {}
Catalog.Zones = {
	{ Id = "harbor", Name = "Sundrift Harbor", Hint = "Sunny starter fish and your first aquarium." },
	{ Id = "blossom", Name = "Petalwind Grove", Hint = "Petal-colored fish beneath the blossom trees." },
	{ Id = "forest", Name = "Evergreen Reach", Hint = "Woodland swimmers and the elusive Moonray." },
	{ Id = "cove", Name = "Tideglass Cove", Hint = "Tropical oddballs in a sheltered lagoon." },
	{ Id = "summit", Name = "Starfall Lookout", Hint = "Sky fish and a legendary Crownwhale." },
}
-- The original six IDs remain valid in existing saves.
Catalog.Species = {
	{ Id = "pufflet", Name = "Pufflet", Rarity = "Common", Level = 0, Weight = 40, Coins = 8, Zone = "harbor", WeightMin = .4, WeightMax = 2.2,
		Body = {255, 206, 99}, Fin = {247, 146, 107}, Shape = "Round", Hint = "Sundrift Harbor · A sunny little cloud drifter." },
	{ Id = "mintfin", Name = "Mintfin", Rarity = "Common", Level = 0, Weight = 35, Coins = 9, Zone = "harbor", WeightMin = .6, WeightMax = 3.4,
		Body = {96, 221, 192}, Fin = {54, 157, 163}, Shape = "Long", Hint = "Sundrift Harbor · Follows the coolest cloud currents." },
	{ Id = "emberfin", Name = "Emberfin", Rarity = "Uncommon", Level = 0, Weight = 25, Coins = 12, Zone = "harbor", WeightMin = .8, WeightMax = 4.2,
		Body = {255, 139, 123}, Fin = {255, 212, 120}, Shape = "Spiky", Hint = "Sundrift Harbor · A warm glow beneath the mist." },
	{ Id = "starwhisker", Name = "Starwhisker", Rarity = "Rare", Level = 1, Weight = 13, Coins = 22, Zone = "blossom", WeightMin = 1.2, WeightMax = 6.5,
		Body = {182, 164, 249}, Fin = {255, 220, 139}, Shape = "Whiskers", Hint = "Petalwind Grove · Breeze Rod · A shy stargazer." },
	{ Id = "moonray", Name = "Moonray", Rarity = "Rare", Level = 1, Weight = 11, Coins = 24, Zone = "forest", WeightMin = 2, WeightMax = 9,
		Body = {124, 184, 249}, Fin = {192, 223, 255}, Shape = "Ray", Hint = "Evergreen Reach · Breeze Rod · A quiet woodland glider." },
	{ Id = "aurorafin", Name = "Aurorafin", Rarity = "Epic", Level = 2, Weight = 7, Coins = 38, Zone = "summit", WeightMin = 2.5, WeightMax = 12,
		Body = {218, 146, 245}, Fin = {110, 241, 226}, Shape = "Lure", Hint = "Starfall Lookout · Nimbus Rod · A living aurora." },
	{ Id = "petalperch", Name = "Petalperch", Rarity = "Common", Level = 0, Weight = 43, Coins = 10, Zone = "blossom", WeightMin = .3, WeightMax = 2.5,
		Body = {232, 157, 183}, Fin = {171, 104, 159}, Shape = "Round", Hint = "Petalwind Grove · Its fins look like floating petals." },
	{ Id = "ribbonkoi", Name = "Ribbon Koi", Rarity = "Uncommon", Level = 0, Weight = 29, Coins = 14, Zone = "blossom", WeightMin = 1, WeightMax = 5.2,
		Body = {239, 223, 187}, Fin = {222, 117, 104}, Shape = "Ribbon", Hint = "Petalwind Grove · Dances through fallen blossoms." },
	{ Id = "mossback", Name = "Mossback", Rarity = "Common", Level = 0, Weight = 43, Coins = 11, Zone = "forest", WeightMin = .8, WeightMax = 4.8,
		Body = {121, 164, 99}, Fin = {219, 192, 116}, Shape = "Turtle", Hint = "Evergreen Reach · A little floating forest of its own." },
	{ Id = "pinepike", Name = "Pinepike", Rarity = "Uncommon", Level = 0, Weight = 28, Coins = 15, Zone = "forest", WeightMin = 1.5, WeightMax = 7.4,
		Body = {85, 152, 135}, Fin = {174, 209, 141}, Shape = "Long", Hint = "Evergreen Reach · A quick shadow under the pines." },
	{ Id = "bubblesquid", Name = "Bubble Squid", Rarity = "Common", Level = 0, Weight = 42, Coins = 11, Zone = "cove", WeightMin = .3, WeightMax = 3.2,
		Body = {132, 197, 224}, Fin = {208, 179, 226}, Shape = "Squid", Hint = "Tideglass Cove · Thinks every bubble is a new friend." },
	{ Id = "sunskipper", Name = "Sunskipper", Rarity = "Uncommon", Level = 0, Weight = 28, Coins = 16, Zone = "cove", WeightMin = .6, WeightMax = 4.7,
		Body = {229, 180, 89}, Fin = {103, 184, 192}, Shape = "Wings", Hint = "Tideglass Cove · Skips across the warm lagoon." },
	{ Id = "coralcrown", Name = "Coralcrown", Rarity = "Epic", Level = 2, Weight = 8, Coins = 34, Zone = "cove", WeightMin = 1.3, WeightMax = 8.6,
		Body = {221, 133, 130}, Fin = {229, 196, 149}, Shape = "Crown", Hint = "Tideglass Cove · Nimbus Rod · Wears its own coral reef." },
	{ Id = "cloudmoth", Name = "Cloudmoth", Rarity = "Uncommon", Level = 0, Weight = 47, Coins = 14, Zone = "summit", WeightMin = .2, WeightMax = 2.9,
		Body = {211, 219, 232}, Fin = {152, 173, 210}, Shape = "Wings", Hint = "Starfall Lookout · A tiny sky traveler with enormous fins." },
	{ Id = "crownwhale", Name = "Crownwhale", Rarity = "Legendary", Level = 3, Weight = 3, Coins = 65, Zone = "summit", WeightMin = 8, WeightMax = 28,
		Body = {119, 148, 207}, Fin = {222, 190, 108}, Shape = "Whale", Hint = "Starfall Lookout · Aurora Rod · The gentle king of the sky." },
} :: { Species }
Catalog.Rods = {
	{ Name = "Driftwood Rod", Cost = 0, Bonus = 0, Description = "Catch starter species on all five islands." },
	{ Name = "Breeze Rod", Cost = 32, Bonus = 15, Description = "Find Starwhisker and Moonray. Earn 15% more coins." },
	{ Name = "Nimbus Rod", Cost = 90, Bonus = 30, Description = "Find Aurorafin and Coralcrown. Earn 30% more coins." },
	{ Name = "Aurora Rod", Cost = 160, Bonus = 45, Description = "Seek the legendary Crownwhale. Earn 45% more coins." },
}
-- Preserve the first five goal positions so older saves keep their earned milestones.
Catalog.Goals = {
	{ Title = "Land your first fish", Kind = "Catches", Target = 1, Reward = 10 },
	{ Title = "Discover 3 different species", Kind = "Species", Target = 3, Reward = 20 },
	{ Title = "Upgrade to the Breeze Rod", Kind = "Rod", Target = 1, Reward = 20 },
	{ Title = "Land a Brilliant catch", Kind = "Brilliant", Target = 1, Reward = 25 },
	{ Title = "Discover 6 different species", Kind = "Species", Target = 6, Reward = 50 },
	{ Title = "Catch fish on all 5 islands", Kind = "Zones", Target = 5, Reward = 75 },
	{ Title = "Upgrade to the Nimbus Rod", Kind = "Rod", Target = 2, Reward = 40 },
	{ Title = "Discover 10 different species", Kind = "Species", Target = 10, Reward = 80 },
	{ Title = "Find the legendary Crownwhale", Kind = "Crownwhale", Target = 1, Reward = 100 },
	{ Title = "Complete your field journal", Kind = "Species", Target = 15, Reward = 150 },
}
Catalog.AquariumStyles = {
	{ Id = "lagoon", Name = "Lagoon", Cost = 0, Colors = { Base = {75, 134, 143}, Trim = {204, 188, 139}, Accent = {106, 187, 191} } },
	{ Id = "blossom", Name = "Blossom Garden", Cost = 65, Colors = { Base = {157, 112, 139}, Trim = {220, 193, 173}, Accent = {216, 155, 183} } },
	{ Id = "observatory", Name = "Star Observatory", Cost = 140, Colors = { Base = {91, 109, 157}, Trim = {211, 182, 111}, Accent = {148, 167, 220} } },
	{ Id = "coral", Name = "Coral Reef", Cost = 110, Colors = { Base = {163, 116, 92}, Trim = {225, 200, 142}, Accent = {212, 136, 124} } },
}

function Catalog.get(id: string?): Species
	for _, species in Catalog.Species do
		if species.Id == id then return species end
	end
	return Catalog.Species[1]
end

function Catalog.zone(id: string?): any?
	for _, zone in Catalog.Zones do if zone.Id == id then return zone end end
	return nil
end

function Catalog.style(id: string?): any?
	for _, style in Catalog.AquariumStyles do if style.Id == id then return style end end
	return nil
end

return Catalog
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000000D">
        <Properties>
          <string name="Name">IslandTravelRules</string>
          <ProtectedString name="Source">--!strict
-- Pure authorization state. Positions and living character checks belong to the server.
local Rules = {}
Rules.Destinations = table.freeze({
	table.freeze({ Id = "harbor", Name = "Sundrift Harbor", Detail = "Town &amp; fishing pier" }),
	table.freeze({ Id = "blossom", Name = "Petalwind Grove", Detail = "Blossom pond" }),
	table.freeze({ Id = "forest", Name = "Evergreen Reach", Detail = "Forest fishing" }),
	table.freeze({ Id = "cove", Name = "Tideglass Cove", Detail = "Beach &amp; lagoon" }),
	table.freeze({ Id = "summit", Name = "Starfall Lookout", Detail = "Mountaintop pond" }),
})
Rules.MaxDistance = 18
Rules.MenuLifetime = 30
Rules.Cooldown = 1.5
local destinationIds: { [string]: boolean } = {}
for _, destination in Rules.Destinations do destinationIds[destination.Id] = true end

export type Ticket = { source: string, destination: string }
type Menu = { source: string, expiresAt: number }
type Data = {
	menus: { [number]: Menu }, pending: { [number]: Ticket },
	lastOpen: { [number]: number }, lastRequest: { [number]: number },
}
Rules.__index = Rules
export type TravelState = typeof(setmetatable({} :: Data, Rules))

local function finite(value: number): boolean
	return value == value and math.abs(value) &lt; math.huge
end

function Rules.isDestination(value: any): boolean
	return type(value) == "string" and #value &lt;= 16 and destinationIds[value] == true
end

local function near(distance: number): boolean
	return finite(distance) and distance &gt;= 0 and distance &lt;= Rules.MaxDistance
end

function Rules.new(): TravelState
	return setmetatable({ menus = {}, pending = {}, lastOpen = {}, lastRequest = {} }, Rules)
end

function Rules.open(self: TravelState, userId: number, source: string, now: number, distance: number): boolean
	if not Rules.isDestination(source) or not finite(now) or not near(distance) or self.pending[userId] then return false end
	local previous = self.lastOpen[userId]
	if previous and now - previous &lt; 0.4 then return false end
	local lastRequest = self.lastRequest[userId]
	if lastRequest and now - lastRequest &lt; Rules.Cooldown then return false end
	self.lastOpen[userId] = now
	self.menus[userId] = { source = source, expiresAt = now + Rules.MenuLifetime }
	return true
end

function Rules.source(self: TravelState, userId: number): string?
	local menu = self.menus[userId]
	return if menu then menu.source else nil
end

function Rules.take(self: TravelState, userId: number, destination: any, now: number, distance: number): Ticket?
	local menu = self.menus[userId]
	if not menu or self.pending[userId] or not Rules.isDestination(destination) or destination == menu.source
		or not finite(now) or now &gt;= menu.expiresAt or not near(distance) then return nil end
	local previous = self.lastRequest[userId]
	if previous and now - previous &lt; Rules.Cooldown then return nil end
	local ticket = { source = menu.source, destination = destination :: string }
	self.menus[userId], self.pending[userId], self.lastRequest[userId] = nil, ticket, now
	return ticket
end

function Rules.isPending(self: TravelState, userId: number, ticket: Ticket): boolean
	return self.pending[userId] == ticket
end

function Rules.finish(self: TravelState, userId: number, ticket: Ticket): boolean
	if self.pending[userId] ~= ticket then return false end
	self.pending[userId] = nil
	return true
end

function Rules.remove(self: TravelState, userId: number)
	self.menus[userId], self.pending[userId], self.lastOpen[userId], self.lastRequest[userId] = nil, nil, nil, nil
end

return Rules
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX00000004">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX0000000E">
      <Properties>
        <string name="Name">FishingEngine</string>
        <ProtectedString name="Source">--!strict
-- Pure server state machine. Roblox services are kept in FishingService.
type Config = {
	read PreparationTime: number, read BiteTimeout: number, read ChargeLeadTime: number,
	read ChargeDuration: number, read StartCooldown: number, read RequestCapacity: number,
	read RequestsPerSecond: number, read SpeciesName: string,
	read DynamicTiming: boolean?,
}
type Attempt = {
	id: number, phase: string, readyAt: number, expiresAt: number, chargeAt: number?, zoneId: string?, timingCenter: number?,
}
type Session = {
	attempt: Attempt?, catches: number, nextStart: number, tokens: number,
	tokenTime: number,
	profile: any?,
}
type Packet = { [string]: any }
local Engine = {}
Engine.__index = Engine
type EngineData = {
	config: Config,
	rules: { read qualityAt: (number, number?) -&gt; string?, read centerFor: ((number) -&gt; number)? },
	sessions: { [number]: Session },
	sequence: number,
	progression: any?,
}
export type FishingEngine = typeof(setmetatable({} :: EngineData, Engine))

function Engine.new(config: Config, rules: { read qualityAt: (number, number?) -&gt; string?, read centerFor: ((number) -&gt; number)? }, progression: any?): FishingEngine
	return setmetatable({ config = config, rules = rules, sessions = {}, sequence = 0, progression = progression }, Engine)
end

function Engine.addPlayer(self: FishingEngine, userId: number, now: number, initialProfile: any?)
	if self.sessions[userId] then return end
	self.sessions[userId] = {
		attempt = nil, catches = 0, nextStart = now,
		tokens = self.config.RequestCapacity, tokenTime = now,
		profile = if self.progression then (if initialProfile then self.progression.copy(initialProfile) else self.progression.create()) else nil,
	}
	if initialProfile then self.sessions[userId].catches = initialProfile.catches end
end

function Engine.exportProfile(self: FishingEngine, userId: number): any?
	local session = self.sessions[userId]
	return if session and session.profile and self.progression then self.progression.copy(session.profile) else nil
end

function Engine.removePlayer(self: FishingEngine, userId: number)
	self.sessions[userId] = nil
end

function Engine.snapshot(self: FishingEngine, userId: number): Packet?
	local session = self.sessions[userId]
	if not session then return nil end
	local packet: Packet = { phase = "Idle", catches = session.catches, nextStart = session.nextStart }
	if self.progression and session.profile then packet.profile = self.progression.snapshot(session.profile) end
	local attempt = session.attempt
	if attempt then
		packet.phase = attempt.phase
		packet.attemptId = attempt.id
		packet.readyAt = attempt.readyAt
		packet.expiresAt = attempt.expiresAt
		packet.chargeAt = attempt.chargeAt
		packet.duration = self.config.ChargeDuration
		packet.timingCenter = attempt.timingCenter
	end
	return packet
end

function Engine.finish(self: FishingEngine, userId: number, now: number, message: string): Packet
	local session = self.sessions[userId]
	local miss = if self.progression then self.progression.miss else nil
	if session.profile and type(miss) == "function" then miss(session.profile) end
	session.attempt = nil
	session.nextStart = now + self.config.StartCooldown
	local packet = self:snapshot(userId) :: Packet
	packet.message = message
	return packet
end

function Engine.interrupt(self: FishingEngine, userId: number, now: number, message: string): Packet?
	local session = self.sessions[userId]
	if not session or not session.attempt then return nil end
	return self:finish(userId, now, message)
end

function Engine.tick(self: FishingEngine, userId: number, now: number, canFish: boolean): Packet?
	local session = self.sessions[userId]
	local attempt = if session then session.attempt else nil
	if not attempt then return nil end
	if not canFish then
		return self:finish(userId, now, "Fishing stopped. Return to the glowing spot on the dock.")
	end
	if now &gt; attempt.expiresAt then
		return self:finish(userId, now, "It swam away. Cast again!")
	end
	return nil
end

function Engine.command(
	self: FishingEngine, userId: number, action: any, attemptId: any, now: number, canFish: boolean, zoneId: string?
): Packet?
	local session = self.sessions[userId]
	if not session then return nil end
	-- Rate-limit all requests, including malformed and unknown actions.
	session.tokens = math.min(self.config.RequestCapacity,
		session.tokens + math.max(0, now - session.tokenTime) * self.config.RequestsPerSecond)
	session.tokenTime = now
	if session.tokens &lt; 1 then return nil end
	session.tokens -= 1
	if type(action) ~= "string" then return nil end
	if action == "Sync" then return self:snapshot(userId) end
	local aborted = self:tick(userId, now, canFish)
	if aborted then return aborted end
	if (action == "Display" or action == "Style") and self.progression and session.profile then
		local packet = self:snapshot(userId) :: Packet
		if session.attempt then packet.message = "Finish your cast before changing your aquarium."; return packet end
		local result
		if action == "Display" and type(attemptId) == "table" then
			result = self.progression.display(session.profile, attemptId.id, attemptId.slot)
		elseif action == "Style" then result = self.progression.style(session.profile, attemptId) end
		if not result then return nil end
		packet = self:snapshot(userId) :: Packet
		packet.purchase, packet.message = result, result.message
		return packet
	end
	if action == "Upgrade" and self.progression and session.profile then
		local packet = self:snapshot(userId) :: Packet
		if session.attempt then
			packet.message = "Finish your cast before changing rods."
			return packet
		end
		if type(attemptId) ~= "number" or attemptId ~= session.profile.level then
			packet.message = "Your rod changed. Check the workshop again."
			return packet
		end
		local purchase = self.progression.upgrade(session.profile)
		packet = self:snapshot(userId) :: Packet
		packet.purchase = purchase
		packet.message = purchase.message
		return packet
	end
	if action == "Start" then
		if session.attempt or now &lt; session.nextStart then return self:snapshot(userId) end
		if not canFish then
			local packet = self:snapshot(userId) :: Packet
			packet.message = "Walk to the glowing spot at the end of the dock."
			return packet
		end
		self.sequence += 1
		local readyAt = now + self.config.PreparationTime
		session.attempt = {
			id = self.sequence, phase = "Waiting", readyAt = readyAt,
			expiresAt = readyAt + self.config.BiteTimeout,
			zoneId = zoneId,
			timingCenter = if self.config.DynamicTiming and self.rules.centerFor then self.rules.centerFor(self.sequence) else nil,
		}
		return self:snapshot(userId)
	end
	local attempt = session.attempt
	if not attempt or type(attemptId) ~= "number" or attemptId ~= attempt.id then return nil end
	if action == "Cancel" then
		return self:finish(userId, now, "Cast cancelled. Ready when you are.")
	elseif action == "Hold" then
		if attempt.phase ~= "Waiting" or now &lt; attempt.readyAt then return self:snapshot(userId) end
		attempt.phase = "Reeling"
		local chargeAt = now + self.config.ChargeLeadTime
		attempt.chargeAt = chargeAt
		attempt.expiresAt = chargeAt + self.config.ChargeDuration
		return self:snapshot(userId)
	elseif action == "Release" and attempt.phase == "Reeling" then
		-- No client-supplied quality, timestamp, species or reward is trusted.
		local progress = (now - (attempt.chargeAt :: number)) / self.config.ChargeDuration
		local quality = self.rules.qualityAt(progress, attempt.timingCenter)
		if not quality then return self:finish(userId, now, "It got away! Release inside the colored zone.") end
		session.catches += 1
		local reward = if self.progression and session.profile then self.progression.catch(session.profile, quality, attempt.zoneId)
			else { species = self.config.SpeciesName, quality = quality }
		-- A successful catch ends its attempt without resetting the quality chain.
		session.attempt = nil
		session.nextStart = now + self.config.StartCooldown
		local packet = self:snapshot(userId) :: Packet
		packet.message = "You caught a " .. reward.species .. "!"
		packet.result = reward
		return packet
	end
	return nil
end

return Engine
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000000F">
      <Properties>
        <string name="Name">WorldPrimitives</string>
        <ProtectedString name="Source">--!strict
-- Original modular scenery. Cylinders in Roblox run along their local X axis.
local Kit = {}

export type Options = {
	material: Enum.Material?, collidable: boolean?, shadow: boolean?,
	transparency: number?, reflectance: number?, studded: boolean?,
}

Kit.palette = table.freeze({
	-- Keep the reference's green-and-blue brick identity, with quieter broad
	-- surfaces so paving, ponds and sky do not compete at full brightness.
	Grass = Color3.fromRGB(35, 163, 60), Moss = Color3.fromRGB(18, 116, 43),
	Leaf = Color3.fromRGB(23, 139, 52), Lime = Color3.fromRGB(105, 181, 64),
	Pine = Color3.fromRGB(20, 126, 50), PineLight = Color3.fromRGB(57, 159, 64),
	Blossom = Color3.fromRGB(199, 117, 155), BlossomLight = Color3.fromRGB(224, 164, 188),
	Stone = Color3.fromRGB(98, 126, 139), DeepStone = Color3.fromRGB(70, 97, 111),
	Cliff = Color3.fromRGB(89, 117, 132), Limestone = Color3.fromRGB(220, 213, 169),
	Sand = Color3.fromRGB(225, 217, 172), Wood = Color3.fromRGB(145, 108, 65),
	Bark = Color3.fromRGB(118, 83, 45), BarkLight = Color3.fromRGB(156, 112, 62),
	Plank = Color3.fromRGB(207, 191, 140), Cream = Color3.fromRGB(226, 220, 183),
	Teal = Color3.fromRGB(43, 129, 185), Water = Color3.fromRGB(45, 149, 184),
	Cloud = Color3.fromRGB(219, 229, 235), Coral = Color3.fromRGB(223, 116, 65),
	Brass = Color3.fromRGB(216, 179, 59), Iron = Color3.fromRGB(60, 83, 97),
	Lavender = Color3.fromRGB(110, 130, 179), Gold = Color3.fromRGB(226, 188, 31),
})

local function finish(p: BasePart, parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, options: Options?)
	local opts = options or {}
	p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
	p.Anchored = true
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.CanCollide = opts.collidable == true
	-- Scenery never needs touch events. Solid architecture remains queryable for cameras.
	p.CanTouch, p.CanQuery = false, opts.collidable == true
	p.CastShadow = opts.shadow ~= false
	p.Transparency, p.Reflectance = opts.transparency or 0, opts.reflectance or 0
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	if opts.studded then
		-- Native surface details repeat without adding individual stud Parts,
		-- textures to upload, touch events or physical joints.
		p.Material = Enum.Material.Plastic
		p.TopSurface,p.BottomSurface=Enum.SurfaceType.Studs,Enum.SurfaceType.Studs
		p.LeftSurface,p.RightSurface=Enum.SurfaceType.Studs,Enum.SurfaceType.Studs
		p.FrontSurface,p.BackSurface=Enum.SurfaceType.Studs,Enum.SurfaceType.Studs
	end
	p.Parent = parent
end

function Kit.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, options: Options?): Part
	local p = Instance.new("Part")
	finish(p, parent, name, size, cf, color, options)
	return p
end

function Kit.ball(parent: Instance, name: string, size: Vector3, pos: Vector3, color: Color3, options: Options?): Part
	local p = Kit.part(parent, name, size, CFrame.new(pos), color, options)
	p.Shape = Enum.PartType.Ball
	return p
end

function Kit.disk(parent: Instance, name: string, width: number, depth: number, thickness: number, pos: Vector3, color: Color3, options: Options?): Part
	local p = Kit.part(parent, name, Vector3.new(thickness, width, depth),
		CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color, options)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Kit.beam(parent: Instance, name: string, a: Vector3, b: Vector3, width: number, color: Color3, options: Options?): Part
	local length = (b - a).Magnitude
	assert(length &gt; 0.001, "A scenery beam needs two distinct endpoints")
	local p = Kit.part(parent, name, Vector3.new(length, width, width),
		CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0), color, options)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Kit.wedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, options: Options?): WedgePart
	local p = Instance.new("WedgePart")
	finish(p, parent, name, size, cf, color, options)
	return p
end

function Kit.model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name, model.Parent = name, parent
	return model
end

function Kit.sign(parent: BasePart, title: string, subtitle: string, color: Color3?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name, gui.Face = "PaintedSign", Enum.NormalId.Front
	gui.SizingMode, gui.CanvasSize = Enum.SurfaceGuiSizingMode.FixedSize, Vector2.new(900, 280)
	gui.LightInfluence, gui.Brightness, gui.AlwaysOnTop = 0.7, 1, false
	gui.Parent = parent
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name, titleLabel.BackgroundTransparency = "Title", 1
	titleLabel.Size, titleLabel.Position = UDim2.fromScale(0.9, 0.5), UDim2.fromScale(0.05, 0.1)
	titleLabel.Font, titleLabel.TextSize, titleLabel.Text = Enum.Font.GothamBold, 61, title
	titleLabel.TextColor3, titleLabel.AutoLocalize = color or Kit.palette.Cream, false
	titleLabel.TextScaled, titleLabel.TextWrapped, titleLabel.Parent = true, true, gui
	local sub = titleLabel:Clone()
	sub.Name, sub.Text, sub.Font = "Caption", subtitle, Enum.Font.Gotham
	sub.Size, sub.Position, sub.Parent = UDim2.fromScale(0.88, 0.23), UDim2.fromScale(0.06, 0.65), gui
	return gui
end

function Kit.lantern(parent: Instance, pos: Vector3, scale: number?, shadowLight: boolean?): Model
	local s, c = scale or 1, Kit.palette
	local model = Kit.model(parent, "HarborLantern")
	local metal = { material = Enum.Material.Metal }
	Kit.beam(model, "HangingStem", pos + Vector3.new(0, 0.9, 0) * s, pos + Vector3.new(0, 1.6, 0) * s, 0.1 * s, c.Iron, metal)
	Kit.disk(model, "HangingEye", 0.38 * s, 0.38 * s, 0.09 * s, pos + Vector3.yAxis * 1.32 * s, c.Brass, metal)
	local glass = Kit.part(model, "AmberGlass", Vector3.new(0.82, 1.08, 0.82) * s, CFrame.new(pos),
		Color3.fromRGB(255, 222, 163), { material = Enum.Material.Glass, transparency = 0.38, shadow = false })
	Kit.part(model, "CandleGlow", Vector3.new(0.24, 0.7, 0.24) * s, CFrame.new(pos), c.Cream,
		{ material = Enum.Material.Neon, shadow = false })
	for _, y in { -0.64, 0.64 } do
		Kit.part(model, "LanternRim", Vector3.new(1.12, 0.16, 1.12) * s,
			CFrame.new(pos + Vector3.yAxis * y * s), c.Iron, metal)
	end
	for _, x in { -0.46, 0.46 } do
		for _, z in { -0.46, 0.46 } do
			Kit.beam(model, "CornerBrass", pos + Vector3.new(x, -0.61, z) * s,
				pos + Vector3.new(x, 0.61, z) * s, 0.075 * s, c.Brass, metal)
		end
	end
	for _, side in { -1, 1 } do
		Kit.wedge(model, "PitchedHood", Vector3.new(1.24, 0.34, 0.64) * s,
			CFrame.new(pos + Vector3.new(0, 0.87, side * 0.3) * s) * CFrame.Angles(0, if side == 1 then math.pi else 0, 0), c.Teal, metal)
	end
	local light = Instance.new("PointLight")
	light.Name, light.Color = "WarmPool", Color3.fromRGB(255, 216, 150)
	light.Brightness, light.Range, light.Shadows = 0.65, 13 * s, shadowLight == true
	light.Parent = glass
	return model
end

return Kit
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000010">
      <Properties>
        <string name="Name">WorldNature</string>
        <ProtectedString name="Source">--!strict
-- Sculpted scenery: pointed foliage, branching trunks and irregular stone facets.
-- Positions are ground height except cloud (center) and islandUnderside (meadow top).
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local C = Kit.palette
local Nature = {}

-- Large natural forms have their own surface character. Tiny foliage stays
-- quiet so distant crowns do not turn into noisy, repeating grass textures.
local foliage = { material = Enum.Material.SmoothPlastic }
local bark = { material = Enum.Material.Wood }
local stone = { material = Enum.Material.Slate }
local detail = { material = Enum.Material.SmoothPlastic, shadow = false }
local mossSurface = { material = Enum.Material.Grass, shadow = false }
local collider = { material = Enum.Material.Plastic, collidable = true, transparency = 1, shadow = false }

-- Two thin mirrored wedges form a single tapered leaf, with its tip at b.
local function leaf(parent: Instance, name: string, a: Vector3, b: Vector3, width: number, tint: Color3, options: any?)
	local frame = CFrame.lookAt((a+b)/2,b)
	for _, side in {-1,1} do
		Kit.wedge(parent,name,Vector3.new(.09,width/2,(b-a).Magnitude),
			frame*CFrame.new(side*width/4,0,0)*CFrame.Angles(0,0,-side*math.pi/2),tint,options or foliage)
	end
end

-- Radial sloping panels overlap into one cohesive crown, rather than separate cubes.
local function crown(parent: Instance, center: Vector3, radius: number, height: number, tint: Color3, turn: number, name: string)
	for face=0,5 do
		local angle=turn+face*math.pi/3
		local frame=CFrame.new(center)*CFrame.Angles(0,angle,0)*CFrame.new(0,0,-radius/2)
		Kit.wedge(parent,name,Vector3.new(radius*1.05,height,radius),frame,
			tint:Lerp(C.Lime,face%3*.025),foliage)
	end
end

local function swaying(parent: Instance, name: string, pos: Vector3, amplitude: number): Model
	local model = Kit.model(parent, name)
	model.WorldPivot = CFrame.new(pos)
	model:SetAttribute("SwayOrigin", CFrame.new(pos))
	model:SetAttribute("SwayAmplitude", amplitude)
	return model
end

local function broadleaf(parent: Instance, pos: Vector3, scale: number, blossom: boolean, random: Random)
	local top = pos + Vector3.new(.6, 10.8, -.6) * scale
	local bend = pos + Vector3.new(-.5, 5.3, .2) * scale
	local foot = pos - Vector3.yAxis * .12 * scale
	-- Established invisible collision cores stay in exactly the same positions.
	Kit.beam(parent, "LowerTrunk", foot, bend, 1.8 * scale, C.Bark, collider)
	Kit.beam(parent, "UpperTrunk", bend, top, 1.25 * scale, C.BarkLight, collider)
	Kit.beam(parent,"SculptedLowerTrunk",foot,bend,1.81*scale,C.Bark,bark)
	Kit.beam(parent,"TaperedUpperTrunk",bend,top,1.26*scale,C.Bark,bark)
	local canopy=swaying(parent,"BreezyBroadleafCanopy",top,.018)
	local tint=if blossom then C.Blossom else C.Leaf
	local light=if blossom then C.BlossomLight else C.Lime
	local turn=random:NextNumber(0,math.pi*2)
	local basis=CFrame.new(pos)*CFrame.Angles(0,turn,0)
	for index=0,2 do
		local angle=turn+index*math.pi*2/3
		local branchStart=pos+Vector3.yAxis*(6.4+index*.6)*scale
		local branchEnd=pos+Vector3.new(math.cos(angle)*3.9,10.1+index*.5,math.sin(angle)*3.9)*scale
		Kit.beam(parent,"TaperedCrownBranch",branchStart,branchEnd,(.64-index*.1)*scale,C.BarkLight,bark)
	end
	crown(canopy,basis:PointToWorldSpace(Vector3.new(0,12.2,0)*scale),6.7*scale,4.3*scale,tint,turn,"FacetedLeafCrown")
	crown(canopy,basis:PointToWorldSpace(Vector3.new(-2.8,10.6,1.4)*scale),4.2*scale,3.2*scale,tint:Lerp(light,.18),turn+.35,"LeafShoulder")
	for index=0,2 do
		local angle=turn+index*math.pi*2/3
		local start=pos+Vector3.new(math.cos(angle)*4.5,12.4,math.sin(angle)*4.5)*scale
		local tip=pos+Vector3.new(math.cos(angle)*7.1,11.6,math.sin(angle)*7.1)*scale
		leaf(canopy,"PointedCanopyLeaf",start,tip,1.9*scale,tint:Lerp(light,.24))
	end
end

local function pine(parent: Instance, pos: Vector3, scale: number, random: Random)
	local top = pos + Vector3.yAxis * 22.8 * scale
	Kit.beam(parent,"PineTrunk",pos,top,1.15*scale,C.Bark,collider)
	Kit.beam(parent,"TaperedPineTrunk",pos,top,1.16*scale,C.Bark,bark)
	local needles=swaying(parent,"BreezyNeedleCanopy",pos,.009)
	local turn=random:NextNumber(0,math.pi*2)
	for tier=0,2 do
		local radius=(7.3-tier*2.1)*scale
		local center=pos+Vector3.yAxis*(9.2+tier*5)*scale
		crown(needles,center,radius,(8.8-tier*.8)*scale,C.Pine:Lerp(C.PineLight,tier*.13),turn+tier*.27,"EvergreenBough")
	end
	-- A slender terminal shoot closes the crown above the preserved trunk core.
	crown(needles,pos+Vector3.yAxis*22.75*scale,.65*scale,3.4*scale,
		C.Pine:Lerp(C.PineLight,.28),turn+.54,"PineNeedleTip")
	for branch=0,1 do
		local angle=turn+branch*math.pi
		Kit.beam(parent,"ExposedPineBranch",pos+Vector3.yAxis*5.7*scale,
			pos+Vector3.new(math.cos(angle)*2.8,6.7,math.sin(angle)*2.8)*scale,.35*scale,C.BarkLight,bark)
	end
end

local function palm(parent: Instance, pos: Vector3, scale: number, random: Random)
	local curve = Vector3.new(random:NextNumber(1.8, 3.8), 0, random:NextNumber(-2.2, 2.2)) * scale
	local previous = pos
	for segment = 1, 6 do
		local t = segment / 6
		local nextPos = pos + Vector3.yAxis * 16.8 * t * scale + curve * t * t
		local width = (1.1 - t * .45) * scale
		local tint = if segment % 2 == 0 then C.BarkLight else C.Wood
		Kit.beam(parent,"CurvedPalmTrunk",previous,nextPos,width,tint,collider)
		Kit.beam(parent,"SculptedPalmTrunk",previous,nextPos,width*1.01,tint,bark)
		previous=nextPos
	end
	local fronds=swaying(parent,"BreezyPalmCanopy",previous,.022)
	for frond=1,6 do
		local angle=frond*math.pi/3
		local direction=Vector3.new(math.cos(angle),0,math.sin(angle))
		local elbow=previous+direction*4.5*scale+Vector3.yAxis*1.7*scale
		local finish=previous+direction*9.5*scale-Vector3.yAxis*1.3*scale
		local tint=C.PineLight:Lerp(C.Lime,frond%3*.07)
		leaf(fronds,"TaperedPalmFrond",previous,elbow,2.9*scale,tint)
		leaf(fronds,"TaperedPalmTip",elbow-direction*.8*scale,finish,1.9*scale,tint:Lerp(C.Leaf,.1))
	end
	for nut=1,2 do
		local angle=nut*math.pi
		Kit.ball(fronds,"Coconut",Vector3.new(.76,1,.7)*scale,
			previous+Vector3.new(math.cos(angle)*.65,-.6,math.sin(angle)*.65)*scale,C.Bark,bark)
	end
end

function Nature.tree(parent: Instance, pos: Vector3, scale: number, kind: string, seed: number): Model
	local model = Kit.model(parent, kind .. "Tree")
	local random = Random.new(seed)
	if kind == "Pine" then pine(model, pos, scale, random)
	elseif kind == "Palm" then palm(model, pos, scale, random)
	else broadleaf(model, pos, scale, kind == "Blossom", random) end
	return model
end

function Nature.rock(parent: Instance, pos: Vector3, size: Vector3, seed: number, moss: boolean?): Model
	local model=Kit.model(parent,"FacetedShoreRock")
	local random=Random.new(seed)
	local yaw=random:NextNumber(0,math.pi)
	local oldFrame=CFrame.new(pos+Vector3.yAxis*size.Y*.34)*CFrame.Angles(.05,yaw,-.06)
	local tint=C.Stone:Lerp(C.DeepStone,random:NextNumber(0,.24))
	if size.Y&gt;=3 then
		Kit.part(model,"RockCore",size*Vector3.new(.7,.7,.7),oldFrame,tint,collider)
	end
	Kit.wedge(model,"SlopingStoneFace",size*Vector3.new(.95,.76,.88),oldFrame,tint,stone)
	Kit.wedge(model,"BrokenStoneCrown",size*Vector3.new(.78,.66,.78),
		oldFrame*CFrame.new(-size.X*.06,size.Y*.09,size.Z*.04)*CFrame.Angles(0,math.pi,0),tint:Lerp(C.Cliff,.2),stone)
	Kit.wedge(model,"ChippedRockShoulder",size*Vector3.new(.56,.48,.7),
		oldFrame*CFrame.new(size.X*.24,-size.Y*.05,-size.Z*.03)*CFrame.Angles(0,math.pi/2,.12),tint:Lerp(C.DeepStone,.16),stone)
	if moss then
		Kit.wedge(model,"SlopingMossPatch",size*Vector3.new(.48,.025,.48),
			oldFrame*CFrame.new(-size.X*.1,size.Y*.425,size.Z*.12)*CFrame.Angles(.12,.2,0),C.Moss,mossSurface)
	end
	return model
end

function Nature.garden(parent: Instance, center: Vector3, radius: Vector2, count: number, seed: number, kind: string?): Model
	local model=Kit.model(parent,(kind or "Meadow").."Garden")
	local random=Random.new(seed)
	local limit=math.clamp(math.floor(count),1,if kind=="Lavender" then 10 else 24)
	for index=1,limit do
		local a,distance=random:NextNumber(0,math.pi*2),math.sqrt(random:NextNumber())
		local pos=center+Vector3.new(math.cos(a)*radius.X*distance,0,math.sin(a)*radius.Y*distance)
		local yaw=random:NextNumber(0,math.pi*2)
		local height=random:NextNumber(.65,1.3)
		if kind=="Reeds" then
			for stem=1,2 do
				local h=height*(1.8+stem*.35)
				local bottom=pos+Vector3.new((stem-1.5)*.3,0,0)
				Kit.beam(model,"ReedStem",bottom,bottom+Vector3.yAxis*h,.12,C.Moss,detail)
				Kit.beam(model,"ReedSeedHead",bottom+Vector3.yAxis*h,bottom+Vector3.yAxis*(h+.48),.22,C.Wood,detail)
			end
		elseif kind=="Lavender" then
			Kit.beam(model,"LavenderStem",pos,pos+Vector3.yAxis*height,.09,C.Moss,detail)
			for flower=0,2 do
				local frame=CFrame.new(pos+Vector3.yAxis*(height+flower*.19))*CFrame.Angles(0,yaw+flower*1.2,0)
				Kit.wedge(model,"LavenderPetalSpike",Vector3.new(.38,.4,.3),frame,C.Lavender,detail)
			end
		else
			local frame=CFrame.new(pos+Vector3.yAxis*height/2)*CFrame.Angles(0,yaw,0)
			Kit.wedge(model,"PointedGrassBlade",Vector3.new(.07,height,.4),frame*CFrame.Angles(0,0,-.15),C.Leaf,detail)
			Kit.wedge(model,"LeaningGrassBlade",Vector3.new(.07,height*.65,.35),frame*CFrame.new(.24,-height*.175,0)*CFrame.Angles(0,.9,.28),C.Moss,detail)
			if kind~="Grass" and index%3==0 then
				local point=pos+Vector3.yAxis*(height+.2)
				local tint=if index%2==0 then C.Cream else C.Gold
				for petal=0,4 do
					local angle=yaw+petal*math.pi*2/5
					local petalFrame=CFrame.new(point)*CFrame.Angles(0,angle,0)*CFrame.new(0,0,-.29)*CFrame.Angles(0,0,math.pi/2)
					Kit.wedge(model,"WildflowerPetal",Vector3.new(.1,.29,.55),petalFrame,tint,detail)
				end
				Kit.disk(model,"WildflowerHeart",.22,.22,.12,point+Vector3.yAxis*.07,C.Gold,detail)
			end
		end
	end
	return model
end

function Nature.cloud(parent: Instance, pos: Vector3, size: Vector3, seed: number): Model
	local model=Kit.model(parent,"DriftingCloud")
	local random=Random.new(seed)
	-- Long overlapping volumes read as a single cloud bank rather than bead clusters.
	for bank=-1,1 do
		local center=pos+Vector3.new(bank*size.X*.21,random:NextNumber(-.08,.08)*size.Y,bank*size.Z*.08)
		Kit.ball(model,"CloudBank",size*Vector3.new(if bank==0 then .92 else .65,if bank==0 then .8 else .58,.8),
			center,C.Cloud,{shadow=false,transparency=.035})
	end
	return model
end

function Nature.islandUnderside(parent: Instance, center: Vector3, width: number, depth: number, seed: number): Model
	local model=Kit.model(parent,"FacetedFloatingCliffs")
	local height=math.min(width*.31,53)
	for face=0,7 do
		local angle=(face+.5)*math.pi/4
		local radius=1/math.sqrt(math.sin(angle)^2/(width*.47)^2+math.cos(angle)^2/(depth*.47)^2)
		local h=height*(.9+math.sin(seed+face*1.7)*.08)
		local frame=CFrame.new(center)*CFrame.Angles(0,angle,0)*CFrame.new(0,-h*.49,-radius/2)*CFrame.Angles(0,0,math.pi)
		Kit.wedge(model,"DescendingIslandFacet",Vector3.new(radius*.88,h,radius),frame,C.Cliff:Lerp(C.DeepStone,(face%3)*.06),stone)
	end
	return model
end

return Nature
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000011">
      <Properties>
        <string name="Name">WorldArchitecture</string>
        <ProtectedString name="Source">--!strict
-- Original, explorable harbor with painted plaster, fitted slate and shaped trim;
-- fishing piers open onto side portal bays while bridges retain their railings.
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))

local Architecture = {}
local C = {
	Timber = Color3.fromRGB(143, 102, 61),
	Wood = Color3.fromRGB(169, 122, 71),
	Plank = Color3.fromRGB(207, 187, 133),
	Dark = Color3.fromRGB(59, 83, 99),
	Cream = Color3.fromRGB(222, 215, 175),
	Stone = Color3.fromRGB(89, 117, 132),
	Moss = Color3.fromRGB(28, 140, 47),
	Glass = Color3.fromRGB(94, 171, 202),
	Gold = Color3.fromRGB(221, 180, 47),
	Rope = Color3.fromRGB(204, 187, 138),
	Roof = Color3.fromRGB(42, 128, 183),
	Coral = Color3.fromRGB(204, 89, 62),
	Sky = Color3.fromRGB(42, 128, 183),
}
local PLASTIC = Enum.Material.Plastic
local SMOOTH = Enum.Material.SmoothPlastic
-- Authored material groups keep grain, plaster, slate and canvas consistent.
-- Individual planks use Wood: WoodPlanks would draw a second set of boards
-- inside every already-modelled plank. No legacy studs cover these textures.
local MATERIALS = {}
local function use(material, names)
	for _, name in names do MATERIALS[name] = material end
end
use(Enum.Material.Wood, {
	"CrateBody", "Binding", "CornerBinding", "DiagonalBrace", "StaveSeam", "LidCrossbar",
	"DoorJamb", "ExposedCornerTimber", "LowerWallTimber", "PaintedSideWainscot", "PaintedRearWainscot", "RearWainscotCap",
	"WindowJamb", "WindowLintel", "WindowMullion", "WindowTransom", "ShapedWindowCrown", "DeepWindowSill", "PaintedShutter",
	"WindowFlowerBox", "CarvedGableTrim", "EaveTimber", "GableLattice", "GableCrossbeam", "PorchFrontRiser", "PorchPost", "PorchKneeBrace",
	"PaintedShopSign", "RearDisplayShelf", "BackCounter", "CounterTop", "CafeServingCounter", "CreamCounterMoulding", "CafeHatchCountertop",
	"WorkshopFishPlaque", "OutdoorRodRack", "DisplayFishingRod", "WorkshopJournalStand", "WorkshopRod",
	"PorchBenchSeat", "PorchBenchBack", "BenchLeg", "WeatheredDeckPlank", "LongitudinalStringer", "DeepTimberPile", "PileWaterlineBand",
	"RopeRailPost", "PostCap", "PortalEntrancePost", "PortalEntranceCap", "SpiralStairTread", "CentralStairMast",
	"BrassTelescopeTripod", "MarketCounter", "CounterEdge", "StallAwningPost", "AwningBrace", "ProduceTray",
	"PicnicTableTop", "PicnicBench", "BenchSupport", "TableTrestle", "RestingFishingRod",
})
use(Enum.Material.WoodPlanks, { "RaisedTimberFloor", "PorchFloor" })
use(Enum.Material.Plaster, {
	"RearWall", "SideWall", "FrontWallBay", "DoorwayHeadWall", "DoorwayUpperWall", "WindowLowerWall", "WindowUpperWall",
	"LimewashedTowerWall", "MarinerBlueBand",
})
use(Enum.Material.Limestone, {
	"FoundationStones", "TowerStoneFooting", "AccessibleLookoutBalcony", "ColumnPedestal", "RadialArchVoussoir", "ObservatoryBench", "BenchStoneLeg",
})
use(Enum.Material.Slate, { "RoofUnderlay", "IndividualSlateShingle", "ChimneyCap", "BrokenMasonry" })
use(Enum.Material.Brick, { "ChimneyStack" })
use(Enum.Material.Fabric, {
	"PorchCanopy", "PaintedCanvasStripe", "WovenInteriorRug", "CafeHatchCanvas", "CafeHatchStripe", "StripedCanvasAwning",
	"SaggingHempRail", "CoiledMooringRope",
})
use(Enum.Material.Metal, {
	"ShutterHinge", "IronDeckNail", "RidgeCap", "HatchCanopyBracket", "InnerStairBaluster", "LookoutRailingPost", "ContinuousBalconyHandrail",
	"BalconyLowerRail", "LanternRoomUpright", "CopperDomeRib", "LensPedestal", "WeatherVaneMast", "WeatherVaneArrow",
	"ArchKeystoneCarving", "TelescopeBrassBody", "TelescopeObjectiveRim", "TelescopeEyepiece", "PailHandle",
})

local function surface(name, fallback)
	if fallback == Enum.Material.Glass or fallback == Enum.Material.Neon then return fallback end
	return MATERIALS[name] or fallback or SMOOTH
end

local function p(parent, name, size, cf, color, material, collidable)
	return Kit.part(parent, name, size, cf, color, {
		material = surface(name, material),
		collidable = collidable == true,
	})
end

local function beam(parent, name, a, b, thickness, color, material)
	return Kit.beam(parent, name, a, b, thickness, color, { material = surface(name, material) })
end

local function localBeam(parent, cf, name, a, b, thickness, color, material)
	return beam(parent, name, cf:PointToWorldSpace(a), cf:PointToWorldSpace(b), thickness, color, material)
end

local function localBall(parent, cf, name, size, position, color, material)
	return Kit.ball(parent, name, size, cf:PointToWorldSpace(position), color, {
		material = material or SMOOTH,
	})
end

local function canvasHem(parent, cf, width, height, color)
	-- Two tapered halves make a little hanging cloth point in the front plane.
	for _, side in { -1, 1 } do
		Kit.wedge(parent, "DrapedCanvasHem", Vector3.new(0.12, height, width / 2),
			cf * CFrame.new(side * width / 4, 0, 0) * CFrame.Angles(0, side * math.pi / 2, 0)
				* CFrame.Angles(math.pi, 0, 0), color, { material = Enum.Material.Fabric })
	end
end

local function barrel(parent, cf, scale)
	local model = Kit.model(parent, "CooperedBarrel")
	local s = scale or 1
	local center = cf * CFrame.new(0, 1.1 * s, 0)
	Kit.disk(model, "OakStaves", 1.9 * s, 1.9 * s, 2.2 * s, center.Position, C.Wood, { material = Enum.Material.Wood })
	for _, y in { 0.25, 0.65, 1.75, 2.05 } do
		Kit.disk(model, "IronHoop", 1.99 * s, 1.99 * s, 0.11 * s, (cf * CFrame.new(0, y * s, 0)).Position, C.Dark, { material = Enum.Material.Metal })
	end
	for i = 0, 7 do
		local angle = i * math.pi / 4
		p(model, "StaveSeam", Vector3.new(0.035 * s, 1.85 * s, 0.035 * s),
			cf * CFrame.new(math.sin(angle) * 0.94 * s, 1.1 * s, math.cos(angle) * 0.94 * s),
			C.Timber, PLASTIC)
	end
	p(model, "LidCrossbar", Vector3.new(1.5 * s, 0.1 * s, 0.18 * s), cf * CFrame.new(0, 2.24 * s, 0), C.Timber)
	return model
end

local function crate(parent, cf, size)
	local model = Kit.model(parent, "SlattedCrate")
	p(model, "CrateBody", size, cf * CFrame.new(0, size.Y / 2, 0), C.Wood)
	for _, side in { -1, 1 } do
		for _, y in { 0.18, size.Y - 0.18 } do
			p(model, "Binding", Vector3.new(size.X + 0.1, 0.16, 0.12), cf * CFrame.new(0, y, side * size.Z / 2), C.Plank)
		end
		p(model, "CornerBinding", Vector3.new(0.13, size.Y, size.Z + 0.12), cf * CFrame.new(side * (size.X / 2 - 0.13), size.Y / 2, 0), C.Plank)
	end
	local diagonal = math.atan2(size.Y, size.X)
	p(model, "DiagonalBrace", Vector3.new(math.sqrt(size.X ^ 2 + size.Y ^ 2) - 0.1, 0.2, 0.14),
		cf * CFrame.new(0, size.Y / 2, -size.Z / 2 - 0.08) * CFrame.Angles(0, 0, diagonal), C.Timber)
	return model
end

local function ropeCoil(parent, cf, radius)
	for ring = 0, 1 do
		local r = radius - ring * 0.17
		for i = 0, 9 do
			local a = i * math.pi / 5
			local b = (i + 1) * math.pi / 5
			localBeam(parent, cf, "CoiledMooringRope",
				Vector3.new(math.sin(a) * r, 0.12 + ring * 0.07, math.cos(a) * r),
				Vector3.new(math.sin(b) * r, 0.12 + ring * 0.07, math.cos(b) * r), 0.12, C.Rope)
		end
	end
end

local function window(parent, cf, width, height, shutters)
	p(parent, "RecessedWindow", Vector3.new(width, height, 0.1), cf, C.Dark)
	Kit.part(parent, "WindowGlass", Vector3.new(width - 0.3, height - 0.3, 0.11), cf * CFrame.new(0, 0, -0.08), C.Glass,
		{ material = Enum.Material.Glass, transparency = 0.22, reflectance = 0.04 })
	for _, side in { -1, 1 } do
		p(parent, "WindowJamb", Vector3.new(0.16, height + 0.25, 0.24), cf * CFrame.new(side * width / 2, 0, -0.08), C.Cream)
		if shutters then
			p(parent, "PaintedShutter", Vector3.new(width * 0.26, height, 0.14), cf * CFrame.new(side * width * 0.7, 0, -0.02), C.Roof, PLASTIC)
			p(parent, "ShutterHinge", Vector3.new(width * 0.26, 0.12, 0.12), cf * CFrame.new(side * width * 0.7, -height * 0.29, -0.12), C.Dark, SMOOTH)
		end
	end
	-- Clipped shoulders and a raised crown soften the rectangular opening without
	-- changing the wall or placing any geometry inside the room's walking space.
	local shoulder = math.min(0.42, width * 0.18)
	local arch = {
		Vector3.new(-width / 2, height / 2 - 0.2, -0.08),
		Vector3.new(-width / 2 + shoulder, height / 2 + 0.12, -0.08),
		Vector3.new(width / 2 - shoulder, height / 2 + 0.12, -0.08),
		Vector3.new(width / 2, height / 2 - 0.2, -0.08),
	}
	for index = 1, 3 do localBeam(parent, cf, "ShapedWindowCrown", arch[index], arch[index + 1], 0.2, C.Cream) end
	p(parent, "WindowLintel", Vector3.new(width + 0.3, 0.16, 0.24), cf * CFrame.new(0, -height / 2, -0.08), C.Cream)
	p(parent, "WindowMullion", Vector3.new(0.1, height, 0.2), cf * CFrame.new(0, 0, -0.15), C.Cream)
	p(parent, "WindowTransom", Vector3.new(width, 0.1, 0.2), cf * CFrame.new(0, 0.05, -0.15), C.Cream)
	p(parent, "DeepWindowSill", Vector3.new(width + 0.65, 0.2, 0.65), cf * CFrame.new(0, -height / 2 - 0.08, -0.2), C.Timber)
end

local function flowerBox(parent, cf, width, tint)
	p(parent, "WindowFlowerBox", Vector3.new(width - 0.4, 0.65, 0.7), cf, C.Wood, SMOOTH)
	for _, side in { -1, 1 } do
		Kit.wedge(parent, "TaperedPlanterEnd", Vector3.new(0.7, 0.65, 0.24),
			cf * CFrame.new(side * (width / 2 - 0.12), 0, 0) * CFrame.Angles(0, side * math.pi / 2, 0), C.Wood,
			{ material = Enum.Material.Wood })
	end
	p(parent, "Soil", Vector3.new(width - 0.16, 0.08, 0.54), cf * CFrame.new(0, 0.32, 0), C.Timber, Enum.Material.Ground)
	for i = -1, 1 do
		local x = i * width / 3.5
		Kit.wedge(parent, "PointedWindowLeaf", Vector3.new(0.1, 0.45, 0.65),
			cf * CFrame.new(x - 0.1, 0.56, -0.09) * CFrame.Angles(0, i * 0.4 + 0.25, math.rad(24)), C.Moss,
			{ material = SMOOTH })
		Kit.disk(parent, "WindowRosette", 0.45, 0.45, 0.1, cf:PointToWorldSpace(Vector3.new(x + 0.05, 0.75, -0.12)), tint, { material = SMOOTH })
		Kit.disk(parent, "FlowerHeart", 0.12, 0.12, 0.08, cf:PointToWorldSpace(Vector3.new(x + 0.05, 0.83, -0.12)), C.Gold, { material = SMOOTH })
	end
end

function Architecture.cottage(parent, cf, width, depth, tint, kind)
	local buildingKind = kind or "Cottage"
	local model = Kit.model(parent, buildingKind .. "House")
	local w, d = math.max(width, 16), math.max(depth, 12)
	local h = 9.2
	local half, front = w / 2, -d / 2
	local roofColor = buildingKind == "Workshop" and C.Roof
		or (buildingKind == "Cafe" and C.Coral or C.Sky)
	-- A shared pale brick keeps buildings readable beside the vivid grass and
	-- blue-gray cliffs. Roof color identifies the workshop and cafe.
	tint = C.Cream
	-- Block footings and a continuous floor keep the porch explorable.
	p(model, "RaisedTimberFloor", Vector3.new(w, 0.4, d), cf * CFrame.new(0, 0, 0), C.Plank, PLASTIC, true)
	p(model, "RearWall", Vector3.new(w, h, 0.5), cf * CFrame.new(0, h / 2, d / 2), tint, Enum.Material.SmoothPlastic, true)
	for _, side in { -1, 1 } do
		p(model, "SideWall", Vector3.new(0.5, h, d), cf * CFrame.new(side * half, h / 2, 0), tint, Enum.Material.SmoothPlastic, true)
		local bay = (w - 3.8) / 2
		p(model, "FrontWallBay", Vector3.new(bay, h, 0.5), cf * CFrame.new(side * (1.9 + bay / 2), h / 2, front), tint, Enum.Material.SmoothPlastic, true)
		p(model, "DoorJamb", Vector3.new(0.24, 7.2, 0.7), cf * CFrame.new(side * 1.94, 3.6, front - 0.12), C.Timber)
		for _, z in { front, d / 2 } do
			p(model, "ExposedCornerTimber", Vector3.new(0.34, h + 0.1, 0.65), cf * CFrame.new(side * (half - 0.1), h / 2, z), C.Timber)
		end
		p(model, "FoundationStones", Vector3.new(1.5, 0.9, d + 0.5), cf * CFrame.new(side * (half - 0.7), -0.45, 0), C.Stone, PLASTIC)
		p(model, "LowerWallTimber", Vector3.new(0.28, 0.3, d), cf * CFrame.new(side * (half + 0.15), 0.8, 0), C.Cream)
		p(model, "PaintedSideWainscot", Vector3.new(0.09, 2.05, d - 0.8), cf * CFrame.new(side * (half + 0.29), 1.85, 0), roofColor, PLASTIC)
		window(model, cf * CFrame.new(side * w * 0.3, 4.8, front - 0.31), math.min(3.2, w * 0.16), 3.3, true)
		flowerBox(model, cf * CFrame.new(side * w * 0.3, 2.65, front - 0.72), math.min(3.7, w * 0.18),
			buildingKind == "Cafe" and C.Gold or C.Coral)
		window(model, cf * CFrame.new(side * (half + 0.31), 4.8, d * 0.12) * CFrame.Angles(0, -side * math.pi / 2, 0),
			math.min(5.5, d * 0.25), 3.3, buildingKind == "Workshop" or buildingKind == "Cafe")
	end
	-- The spawn path first sees these back walls. A broad shuttered window and
	-- layered paint replace the former blank rectangle without closing a route.
	local rear = d / 2 + 0.32
	p(model, "PaintedRearWainscot", Vector3.new(w - 0.7, 2.05, 0.09), cf * CFrame.new(0, 1.85, rear), roofColor, PLASTIC)
	p(model, "RearWainscotCap", Vector3.new(w - 0.6, 0.18, 0.23), cf * CFrame.new(0, 2.95, rear + 0.04), C.Cream)
	window(model, cf * CFrame.new(0, 5.45, rear) * CFrame.Angles(0, math.pi, 0), w * 0.37, 3.25, true)
	p(model, "DoorLintel", Vector3.new(4.2, 0.3, 0.7), cf * CFrame.new(0, 7.15, front - 0.12), C.Timber)
	p(model, "DoorwayHeadWall", Vector3.new(3.8, h - 7.25, 0.5), cf * CFrame.new(0, (h + 7.25) / 2, front), tint, Enum.Material.SmoothPlastic, true)
	-- Fitted painted slate follows the existing roof slope.
	local overhang, rise = 1.25, 4.3
	local roofHalf = half + overhang
	local pitch = math.atan2(rise, roofHalf)
	local slope = math.sqrt(roofHalf ^ 2 + rise ^ 2)
	local roofDepth = d + 2.6
	local cols = math.max(4, math.floor(roofDepth / 2.5))
	for _, side in { -1, 1 } do
		local roofCf = cf * CFrame.new(side * roofHalf / 2, h + rise / 2, 0) * CFrame.Angles(0, 0, -side * pitch)
		p(model, "RoofUnderlay", Vector3.new(slope + 0.2, 0.35, roofDepth), roofCf, roofColor, Enum.Material.SmoothPlastic, true)
		for row = 0, 3 do
			for col = 0, cols - 1 do
				local shift = (row % 2 == 1 and 0.12 or -0.12)
				local tileCf = roofCf * CFrame.new(-slope / 2 + (row + 0.5) * slope / 4, 0.24 + row * 0.008,
					-roofDepth / 2 + (col + 0.5) * roofDepth / cols + shift)
				local shade = ((row * 7 + col * 3) % 5) * 0.012
				p(model, "IndividualSlateShingle", Vector3.new(slope / 4 + 0.12, 0.12, roofDepth / cols - 0.09), tileCf,
					roofColor:Lerp(C.Cream, shade), Enum.Material.SmoothPlastic)
			end
		end
		for _, z in { -roofDepth / 2, roofDepth / 2 } do
			localBeam(model, cf, "CarvedGableTrim", Vector3.new(side * roofHalf, h, z), Vector3.new(0, h + rise, z), 0.27, C.Cream)
		end
		p(model, "EaveTimber", Vector3.new(0.24, 0.28, roofDepth + 0.3), cf * CFrame.new(side * roofHalf, h, 0), C.Timber)
	end
	localBeam(model, cf, "RidgeCap", Vector3.new(0, h + rise + 0.13, -roofDepth / 2 - 0.1),
		Vector3.new(0, h + rise + 0.13, roofDepth / 2 + 0.1), 0.48, C.Dark, SMOOTH)
	-- Two fitted triangular panels fill each gable cleanly. The former staircase
	-- of narrow blocks left dark notches under the sloping roof.
	for _, z in { -d / 2 - 0.08, d / 2 + 0.08 } do
		for _, side in { -1, 1 } do
			Kit.wedge(model, "FittedPlasterGable", Vector3.new(0.18, rise, roofHalf),
				cf * CFrame.new(side * roofHalf / 2, h + rise / 2, z) * CFrame.Angles(0, -side * math.pi / 2, 0),
				tint, { material = Enum.Material.Plaster })
		end
		for i = -3, 3 do
			local x = i * half / 4
			local beamHeight = rise * (1 - math.abs(x) / roofHalf)
			p(model, "GableLattice", Vector3.new(0.19, beamHeight, 0.2), cf * CFrame.new(x, h + beamHeight / 2, z), C.Timber)
		end
		p(model, "GableCrossbeam", Vector3.new(w + 0.5, 0.26, 0.4), cf * CFrame.new(0, h, z), C.Timber)
		local outside = z &lt; 0 and -0.2 or 0.2
		local ring = Kit.disk(model, "RoundAtticWindowFrame", 2.1, 2.1, 0.2, (cf * CFrame.new(0, h + 1.75, z + outside)).Position, C.Cream, { material = Enum.Material.Wood })
		ring.CFrame = cf * CFrame.new(0, h + 1.75, z + outside) * CFrame.Angles(0, math.pi / 2, 0)
		local glass = Kit.disk(model, "RoundAtticWindow", 1.65, 1.65, 0.22, ring.Position, C.Glass, { material = Enum.Material.Glass, reflectance = 0.02 })
		glass.CFrame = ring.CFrame
	end
	-- The sheltered porch is a visual landmark and a usable place to stand.
	local porchZ = front - 2.5
	p(model, "PorchFloor", Vector3.new(w + 1.4, 0.35, 5), cf * CFrame.new(0, -0.025, porchZ), C.Plank, PLASTIC, true)
	p(model, "PorchFrontRiser", Vector3.new(w + 1.4, 0.65, 0.3), cf * CFrame.new(0, -0.3, front - 5), C.Timber)
	for _, side in { -1, 1 } do
		p(model, "PorchPost", Vector3.new(0.38, 7.3, 0.38), cf * CFrame.new(side * half, 3.5, front - 4.5), C.Timber)
		localBeam(model, cf, "PorchKneeBrace", Vector3.new(side * half, 5.6, front - 4.5), Vector3.new(side * (half - 1.4), 7, front - 4.5), 0.23, C.Cream)
		localBeam(model, cf, "PorchKneeBrace", Vector3.new(side * half, 5.6, front - 4.5), Vector3.new(side * half, 7, front - 3.1), 0.23, C.Cream)
	end
	local canopyCf = cf * CFrame.new(0, 7.5, front - 2.6) * CFrame.Angles(math.rad(7), 0, 0)
	p(model, "PorchCanopy", Vector3.new(w + 2, 0.27, 5.4), canopyCf, C.Cream, SMOOTH)
	for stripe = 0, 2 do
		p(model, "PaintedCanvasStripe", Vector3.new((w + 2) / 6, 0.03, 5.39),
			canopyCf * CFrame.new(-(w + 2) / 2 + (stripe * 2 + 0.5) * (w + 2) / 6, 0.15, 0), roofColor, SMOOTH)
	end
	-- Alternating shallow folds give the fabric a draped hem rather than a beam.
	for fold = 0, 3 do
		local hemColor = if fold % 2 == 0 then roofColor else C.Cream
		canvasHem(model, cf * CFrame.new(-(w + 2) / 2 + (fold + 0.5) * (w + 2) / 4, 7.06, front - 5.2),
			(w + 2) / 4 - 0.035, 0.46, hemColor)
	end
	local label = buildingKind == "Workshop" and "THE ROD WORKSHOP" or (buildingKind == "Cafe" and "THE TIDE TABLE" or "HARBOR COTTAGE")
	local subtitle = buildingKind == "Workshop" and "A better rod. A bigger adventure." or (buildingKind == "Cafe" and "Fresh bakes. Good company." or "A little home above the clouds")
	local sign = p(model, "PaintedShopSign", Vector3.new(math.min(11, w - 3), 1.55, 0.22), cf * CFrame.new(0, 6.45, front - 5.28), roofColor)
	Kit.sign(sign, label, subtitle, C.Cream)
	Kit.lantern(model, cf:PointToWorldSpace(Vector3.new(half - 0.8, 5.4, front - 4.5)), 0.7, false)
	-- A quiet interior, visible through the open door, rewards looking around.
	p(model, "WovenInteriorRug", Vector3.new(w * 0.53, 0.035, d * 0.55), cf * CFrame.new(0, 0.23, 0), roofColor:Lerp(C.Cream, 0.22), SMOOTH)
	p(model, "RearDisplayShelf", Vector3.new(w - 3, 0.22, 1.2), cf * CFrame.new(0, 4.6, d / 2 - 0.8), C.Timber)
	p(model, "BackCounter", Vector3.new(w - 4, 2.8, 1.7), cf * CFrame.new(0, 1.6, d / 2 - 1.25), tint:Lerp(C.Timber, 0.3), PLASTIC, true)
	p(model, "CounterTop", Vector3.new(w - 3.5, 0.2, 2.1), cf * CFrame.new(0, 3.1, d / 2 - 1.25), C.Plank)
	for i = -1, 1 do
		local x = i * (w - 4) / 3
		local potColor = if i == 0 then C.Gold else C.Roof
		Kit.disk(model, "GlazedStoragePot", 0.72, 0.72, 0.85, cf:PointToWorldSpace(Vector3.new(x, 5.15, d / 2 - 0.8)), potColor, { material = SMOOTH })
		if i ~= 0 then
			Kit.disk(model, "PotteryLip", 0.85, 0.85, 0.12, cf:PointToWorldSpace(Vector3.new(x, 5.58, d / 2 - 0.8)), potColor:Lerp(C.Cream, 0.2), { material = SMOOTH })
		end
	end
	local rearCf = cf * CFrame.new(0, 0, rear) * CFrame.Angles(0, math.pi, 0)
	if buildingKind == "Cafe" then
		-- A small take-away hatch faces the arrival path. Cups and fresh bakes
		-- tell a story at walking distance rather than relying on floating text.
		p(model, "CafeServingCounter", Vector3.new(10.7, 2.65, 1.35), rearCf * CFrame.new(0, 1.7, -1.05), C.Coral, PLASTIC)
		p(model, "CreamCounterMoulding", Vector3.new(10.9, 0.18, 1.45), rearCf * CFrame.new(0, 2.65, -1.05), C.Cream)
		p(model, "CafeHatchCountertop", Vector3.new(11.3, 0.2, 1.8), rearCf * CFrame.new(0, 3.15, -1.15), C.Plank)
		local hatchCanopy = rearCf * CFrame.new(0, 7.65, -1.25) * CFrame.Angles(math.rad(8), 0, 0)
		p(model, "CafeHatchCanvas", Vector3.new(12, 0.12, 3), hatchCanopy, C.Cream, SMOOTH)
		for stripe = 0, 2 do
			p(model, "CafeHatchStripe", Vector3.new(2, 0.025, 2.99), hatchCanopy * CFrame.new(-5 + stripe * 4, 0.075, 0), C.Coral, SMOOTH)
		end
		for _, side in { -1, 1 } do
			localBeam(model, rearCf, "HatchCanopyBracket", Vector3.new(side * 5.4, 6.3, -0.2), Vector3.new(side * 5.4, 7.35, -2.45), 0.12, C.Gold, SMOOTH)
			local cupCf = rearCf * CFrame.new(side * 2.8, 3.53, -1.15)
			Kit.disk(model, "CafeCup", 0.57, 0.57, 0.57, cupCf.Position, side == -1 and C.Roof or C.Cream, { material = Enum.Material.SmoothPlastic })
			Kit.disk(model, "FreshCoffee", 0.45, 0.45, 0.025, (cupCf * CFrame.new(0, 0.29, 0)).Position, C.Timber, { material = Enum.Material.SmoothPlastic })
		end
		Kit.disk(model, "BakeryServingPlate", 2.1, 1.2, 0.065, (rearCf * CFrame.new(0, 3.3, -1.15)).Position, C.Cream, { material = Enum.Material.SmoothPlastic })
		for i = -1, 1 do
			localBall(model, rearCf, "GoldenBakedRoll", Vector3.new(0.62, 0.35, 0.78), Vector3.new(i * 0.57, 3.49, -1.15), C.Gold, Enum.Material.SmoothPlastic)
		end
	elseif buildingKind == "Workshop" then
		-- The fish silhouette and full-size rods read from the spawn route even
		-- when the shop's front porch is on the far side of the building.
		local emblemCf = rearCf * CFrame.new(-w * 0.34, 5.2, -0.17)
		p(model, "WorkshopFishPlaque", Vector3.new(3.9, 2.65, 0.25), emblemCf, C.Roof)
		localBall(model, emblemCf, "WorkshopGoldenFish", Vector3.new(2.1, 1.12, 0.18), Vector3.new(-0.15, 0, -0.2), C.Gold, Enum.Material.SmoothPlastic)
		for _, side in { -1, 1 } do
			p(model, "FishTailEmblem", Vector3.new(0.9, 0.38, 0.16), emblemCf * CFrame.new(1.04, side * 0.21, -0.2) * CFrame.Angles(0, 0, side * math.rad(32)), C.Gold, Enum.Material.SmoothPlastic)
		end
		localBall(model, emblemCf, "FishEmblemEye", Vector3.new(0.19, 0.19, 0.08), Vector3.new(-0.68, 0.14, -0.32), C.Dark, Enum.Material.SmoothPlastic)
		for _, y in { 1.8, 5.6 } do
			p(model, "OutdoorRodRack", Vector3.new(3.3, 0.24, 0.5), rearCf * CFrame.new(w * 0.34, y, -0.4), C.Cream)
		end
		for i = -1, 1 do
			local x = w * 0.34 + i * 0.82
			localBeam(model, rearCf, "DisplayFishingRod", Vector3.new(x, 0.7, -0.71), Vector3.new(x + 0.16, 6.5, -0.71), 0.11, i == 0 and C.Gold or C.Roof)
			local reel = Kit.disk(model, "DisplayRodReel", 0.48, 0.48, 0.17, (rearCf * CFrame.new(x, 1.65, -0.9)).Position, C.Gold, { material = Enum.Material.Metal })
			reel.CFrame = rearCf * CFrame.new(x, 1.65, -0.9) * CFrame.Angles(0, math.pi / 2, 0)
		end
	end
	if buildingKind == "Workshop" then
		local trigger = p(model, "WorkshopJournalStand", Vector3.new(2.3, 2.5, 1.1), cf * CFrame.new(half - 3, 1.4, front - 2.6), C.Roof, PLASTIC, true)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "RodWorkshopPrompt"
		prompt.ActionText = "Open journal"
		prompt.ObjectText = "Rod Workshop"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = trigger
		for i = 0, 3 do
			local x = -half + 2 + i * 0.72
			localBeam(model, cf, "WorkshopRod", Vector3.new(x, 0.4, d / 2 - 2), Vector3.new(x + 0.3, 6.5, d / 2 - 2), 0.09, i % 2 == 0 and C.Gold or C.Dark)
		end
	else
		p(model, "PorchBenchSeat", Vector3.new(4, 0.24, 1.3), cf * CFrame.new(-half + 3.1, 1.4, porchZ), C.Plank, PLASTIC, true)
		p(model, "PorchBenchBack", Vector3.new(4, 1.3, 0.18), cf * CFrame.new(-half + 3.1, 2.1, porchZ + 0.55), C.Timber)
		for _, x in { -half + 1.8, -half + 4.4 } do
			p(model, "BenchLeg", Vector3.new(0.3, 1.4, 1.1), cf * CFrame.new(x, 0.65, porchZ), C.Timber)
		end
	end
	local chimneyCf = cf * CFrame.new(half * 0.52, h + 3.1, d * 0.23)
	p(model, "ChimneyStack", Vector3.new(1.4, 4, 1.5), chimneyCf, C.Coral:Lerp(C.Cream, 0.16), PLASTIC)
	p(model, "ChimneyCap", Vector3.new(1.8, 0.28, 1.9), chimneyCf * CFrame.new(0, 2, 0), C.Stone, PLASTIC)
	p(model, "ChimneyOpening", Vector3.new(0.9, 0.03, 1), chimneyCf * CFrame.new(0, 2.15, 0), C.Dark, PLASTIC)
	return model
end

function Architecture.dock(parent, a, b, width, name, rails, portalOpening)
	local model = Kit.model(parent, name or "HarborBoardwalk")
	local length = (b - a).Magnitude
	if length &lt; 0.1 then return model end
	local basis = CFrame.lookAt((a + b) / 2, b)
	local up = basis.UpVector
	-- Fishing piers have a side entrance onto the portal bay. Bridges retain both rails.
	local gapMin, gapMax = 0, 0
	if portalOpening then
		local center = length / 2 - portalOpening
		gapMin, gapMax = center - 6, center + 6
	end
	local function inOpening(side, z)
		return portalOpening ~= nil and side == 1 and z &gt; gapMin - 0.3 and z &lt; gapMax + 0.3
	end
	-- One uninterrupted collider keeps small gaps between visible planks harmless.
	local floor = p(model, "ContinuousWalkSurface", Vector3.new(width, 0.42, length), basis - up * 0.21, C.Timber, PLASTIC, true)
	floor.Transparency = 1
	local count = math.min(48, math.max(2, math.ceil(length / 2.25)))
	for i = 0, count - 1 do
		local plankCf = basis * CFrame.new(0, -0.02, -length / 2 + (i + 0.5) * length / count)
		p(model, "WeatheredDeckPlank", Vector3.new(width, 0.16, length / count - 0.045), plankCf,
			C.Plank:Lerp(C.Timber, (i % 4) * 0.055), PLASTIC)
		if i % 4 == 0 then
			for _, side in { -1, 1 } do
				p(model, "IronDeckNail", Vector3.new(0.08, 0.018, 0.08), plankCf * CFrame.new(side * (width / 2 - 0.4), 0.09, 0), C.Dark, SMOOTH)
			end
		end
	end
	for _, side in { -1, 1 } do
		p(model, "LongitudinalStringer", Vector3.new(0.55, 0.9, length + 0.6), basis * CFrame.new(side * (width / 2 - 0.8), -0.75, 0), C.Timber)
	end
	local bays = math.min(4, math.max(1, math.ceil(length / 17)))
	for i = 0, bays do
		local z = -length / 2 + i * length / bays
		for _, side in { -1, 1 } do
			local postCf = basis * CFrame.new(side * (width / 2 - 0.25), 0, z)
			if i % 2 == 0 or i == bays then
				p(model, "DeepTimberPile", Vector3.new(0.8, 7, 0.8), postCf * CFrame.new(0, -3.5, 0), C.Timber)
				p(model, "PileWaterlineBand", Vector3.new(0.83, 0.35, 0.83), postCf * CFrame.new(0, -2.7, 0), C.Dark, SMOOTH)
			end
			if rails ~= false and not inOpening(side, z) then
				p(model, "RopeRailPost", Vector3.new(0.45, 3.5, 0.45), postCf * CFrame.new(0, 1.7, 0), C.Timber, PLASTIC, true)
				p(model, "PostCap", Vector3.new(0.6, 0.16, 0.6), postCf * CFrame.new(0, 3.5, 0), C.Plank)
			end
		end
		if i &lt; bays and rails ~= false then
			for _, side in { -1, 1 } do
				local x = side * (width / 2 - 0.25)
				local nextZ = z + length / bays
				local spans = { { z, nextZ } }
				if portalOpening and side == 1 then
					spans = { { z, math.min(nextZ, gapMin) }, { math.max(z, gapMax), nextZ } }
				end
				for _, span in spans do
					local first, last = span[1], span[2]
					if last - first &lt; 0.05 then continue end
					for _, h in { 1.4, 3.1 } do
						local start = Vector3.new(x, h, first)
						local middle = Vector3.new(x, h - 0.3, (first + last) / 2)
						local finish = Vector3.new(x, h, last)
						localBeam(model, basis, "SaggingHempRail", start, middle, 0.14, C.Rope)
						localBeam(model, basis, "SaggingHempRail", middle, finish, 0.14, C.Rope)
					end
					p(model, "SafeRailCollider", Vector3.new(0.12, 2.5, last - first), basis * CFrame.new(x, 1.75, (first + last) / 2), C.Timber, PLASTIC, true).Transparency = 1
				end
			end
		end
	end
	if portalOpening and rails ~= false then
		for _, z in { gapMin, gapMax } do
			local frame = basis * CFrame.new(width / 2 - 0.25, 0, z)
			p(model, "PortalEntrancePost", Vector3.new(0.45, 3.5, 0.45), frame * CFrame.new(0, 1.7, 0), C.Timber, PLASTIC, true)
			p(model, "PortalEntranceCap", Vector3.new(0.6, 0.16, 0.6), frame * CFrame.new(0, 3.5, 0), C.Plank)
		end
	end
	if length &gt;= 25 then
		Kit.lantern(model, (basis * CFrame.new((if portalOpening then -1 else 1) * (width / 2 - 0.25), 3.9, -length * 0.28)).Position, 0.65, false)
	end
	return model
end

function Architecture.lighthouse(parent, cf)
	local model = Kit.model(parent, "WayfarerLighthouse")
	local n, r = 12, 6
	local tangentWidth = 2 * r * math.tan(math.pi / n) + 0.04
	Kit.disk(model, "OctagonalFoundation", 16, 16, 0.7, cf:PointToWorldSpace(Vector3.new(0, -0.35, 0)), C.Stone, { material = Enum.Material.Limestone, collidable = true })
	for i = 0, n - 1 do
		local angle = i * math.pi * 2 / n
		local face = cf * CFrame.Angles(0, -angle, 0) * CFrame.new(0, 0, -r)
		if i == 0 then
			p(model, "DoorwayUpperWall", Vector3.new(tangentWidth, 17.4, 0.6), face * CFrame.new(0, 16.7, 0), C.Cream, Enum.Material.SmoothPlastic, true)
		elseif i == 3 or i == 9 then
			p(model, "WindowLowerWall", Vector3.new(tangentWidth, 11, 0.6), face * CFrame.new(0, 5.5, 0), C.Cream, Enum.Material.SmoothPlastic, true)
			p(model, "WindowUpperWall", Vector3.new(tangentWidth, 10.9, 0.6), face * CFrame.new(0, 19.95, 0), C.Cream, Enum.Material.SmoothPlastic, true)
			window(model, face * CFrame.new(0, 12.75, -0.32), tangentWidth - 0.3, 3.5, false)
		else
			p(model, "LimewashedTowerWall", Vector3.new(tangentWidth, 25.4, 0.6), face * CFrame.new(0, 12.7, 0), C.Cream, Enum.Material.SmoothPlastic, true)
		end
		-- Painted banding and footings make the silhouette readable from other islands.
		if i ~= 0 then
			p(model, "TowerStoneFooting", Vector3.new(tangentWidth + 0.12, 1.2, 0.82), face * CFrame.new(0, 0.6, 0), C.Stone, PLASTIC, true)
		end
		for _, y in { 9.3, 23.7 } do
			p(model, "MarinerBlueBand", Vector3.new(tangentWidth + 0.12, 1, 0.76), face * CFrame.new(0, y, -0.08), C.Roof, Enum.Material.SmoothPlastic)
		end
	end
	-- 7.8 studs of rise per revolution leave enough headroom for a standard R15
	-- avatar. The final 26.65-stud tread meets the 27-stud lookout deck.
	for i = 0, 40 do
		local angle = i * math.pi / 6
		local stepCf = cf * CFrame.Angles(0, -angle, 0) * CFrame.new(0, i * 0.65 + 0.325, -3.05)
		p(model, "SpiralStairTread", Vector3.new(2.2, 0.65, 3.6), stepCf, C.Plank, PLASTIC, true)
		if i % 3 == 0 then
			p(model, "InnerStairBaluster", Vector3.new(0.12, 2.7, 0.12), stepCf * CFrame.new(0, 1.6, 1.68), C.Dark, SMOOTH)
		end
	end
	p(model, "CentralStairMast", Vector3.new(0.65, 29, 0.65), cf * CFrame.new(0, 14.5, 0), C.Timber)
	for i = 0, n - 1 do
		local angle = i * math.pi * 2 / n
		local ring = cf * CFrame.Angles(0, -angle, 0)
		p(model, "AccessibleLookoutBalcony", Vector3.new(4.2, 0.45, 3), ring * CFrame.new(0, 26.775, -6.2), C.Stone, PLASTIC, true)
		p(model, "LookoutRailingPost", Vector3.new(0.16, 3.2, 0.16), ring * CFrame.new(0, 28.6, -7.55), C.Dark, SMOOTH)
		local barrier = p(model, "LookoutRailingCollider", Vector3.new(4.2, 2.8, 0.15), ring * CFrame.new(0, 28.4, -7.55), C.Dark, SMOOTH, true)
		barrier.Transparency = 1
		local a = Vector3.new(math.sin(angle) * 7.55, 30.15, -math.cos(angle) * 7.55)
		local nextAngle = angle + math.pi * 2 / n
		local b = Vector3.new(math.sin(nextAngle) * 7.55, 30.15, -math.cos(nextAngle) * 7.55)
		localBeam(model, cf, "ContinuousBalconyHandrail", a, b, 0.15, C.Dark, SMOOTH)
		localBeam(model, cf, "BalconyLowerRail", a - Vector3.new(0, 1.5, 0), b - Vector3.new(0, 1.5, 0), 0.1, C.Dark, SMOOTH)
		if i ~= 0 then
			Kit.part(model, "LanternRoomGlazing", Vector3.new(2.4, 5.8, 0.12), ring * CFrame.new(0, 31.6, -4.45), C.Glass,
				{ material = Enum.Material.Glass, transparency = 0.58, reflectance = 0.02 })
		end
		p(model, "LanternRoomUpright", Vector3.new(0.14, 6.3, 0.14), ring * CFrame.new(0, 31.6, -4.5), C.Dark, SMOOTH)
		localBeam(model, cf, "CopperDomeRib", Vector3.new(math.sin(angle) * 5.3, 34.5, -math.cos(angle) * 5.3), Vector3.new(0, 37.7, 0), 0.14, C.Dark, SMOOTH)
	end
	Kit.disk(model, "LanternRoomCornice", 10.5, 10.5, 0.36, cf:PointToWorldSpace(Vector3.new(0, 34.5, 0)), C.Dark, { material = SMOOTH })
	localBall(model, cf, "VerdigrisDome", Vector3.new(10.4, 5.1, 10.4), Vector3.new(0, 35.3, 0), C.Roof, SMOOTH)
	localBall(model, cf, "LighthouseLens", Vector3.new(2.6, 3.4, 2.6), Vector3.new(0, 31.4, 0), C.Gold, Enum.Material.Neon)
	local lampMount = p(model, "LensPedestal", Vector3.new(1.1, 1.8, 1.1), cf * CFrame.new(0, 28.7, 0), C.Dark, SMOOTH)
	local light = Instance.new("PointLight")
	light.Name = "WarmNavigationLight"
	light.Color = Color3.fromRGB(255, 220, 158)
	light.Brightness = 1.5
	light.Range = 32
	light.Shadows = false
	light.Parent = lampMount
	p(model, "WeatherVaneMast", Vector3.new(0.14, 3.8, 0.14), cf * CFrame.new(0, 39, 0), C.Dark, SMOOTH)
	p(model, "WeatherVaneArrow", Vector3.new(3.2, 0.16, 0.16), cf * CFrame.new(0, 40, 0), C.Gold, SMOOTH)
	Kit.wedge(model, "WeatherVanePennant", Vector3.new(0.08, 0.9, 1.5), cf * CFrame.new(1.2, 39.8, 0) * CFrame.Angles(0, math.pi / 2, 0), C.Gold, { material = SMOOTH })
	local sign = p(model, "LighthousePlaque", Vector3.new(4.2, 1, 0.15), cf * CFrame.new(0, 7.4, -6.4), C.Dark)
	Kit.sign(sign, "WAYFARER LIGHT", "Climb to the harbor lookout", C.Cream)
	return model
end

function Architecture.ruins(parent, cf)
	local model = Kit.model(parent, "OldCloudObservatory")
	Kit.disk(model, "WeatheredObservatoryFloor", 29, 25, 0.45, cf:PointToWorldSpace(Vector3.new(0, -0.165, 0)), C.Stone,
		{ material = Enum.Material.Limestone, collidable = true })
	for _, side in { -1, 1 } do
		local x = side * 6.4
		p(model, "ColumnPedestal", Vector3.new(3.5, 0.8, 3.5), cf * CFrame.new(x, 0.4, -1), C.Stone, PLASTIC, true)
		for segment = 0, 2 do
			Kit.disk(model, "AgedColumnDrum", 2.45 - segment * 0.08, 2.45 - segment * 0.08, 2.2,
				cf:PointToWorldSpace(Vector3.new(x + (segment == 1 and side * 0.08 or 0), 1.9 + segment * 2.2, -1)), C.Stone:Lerp(C.Cream, segment * 0.04),
				{ material = Enum.Material.Limestone, collidable = true })
		end
		Kit.disk(model, "ColumnCapital", 3, 3, 0.55, cf:PointToWorldSpace(Vector3.new(x, 7.55, -1)), C.Stone, { material = Enum.Material.Limestone })
		localBall(model, cf, "MossOnCapital", Vector3.new(2.2, 0.15, 1.4), Vector3.new(x, 7.87, -1.4), C.Moss, Enum.Material.SmoothPlastic)
	end
	for i = 0, 10 do
		local angle = (i + 0.5) / 11 * math.pi
		local center = Vector3.new(math.cos(angle) * 6.4, 7.5 + math.sin(angle) * 6.4, -1)
		p(model, "RadialArchVoussoir", Vector3.new(2.03, 2.2, 2.6), cf * CFrame.new(center) * CFrame.Angles(0, 0, angle - math.pi / 2),
			i == 5 and C.Cream or C.Stone, PLASTIC, true)
	end
	p(model, "ArchKeystoneCarving", Vector3.new(0.6, 1.25, 0.1), cf * CFrame.new(0, 13.75, -2.36), C.Gold, SMOOTH)
	-- A legible, original telescope silhouette points above the clouds.
	local pivot = Vector3.new(0, 4.3, 4.2)
	for i = 0, 2 do
		local a = i * math.pi * 2 / 3
		localBeam(model, cf, "BrassTelescopeTripod", Vector3.new(math.sin(a) * 2.5, 0.1, 4.2 + math.cos(a) * 2.5), pivot, 0.25, C.Timber)
	end
	local start, finish = Vector3.new(0, 3.6, 6.4), Vector3.new(0, 6.2, 0.6)
	localBeam(model, cf, "TelescopeBrassBody", start, finish, 1.1, C.Gold, SMOOTH)
	local direction = (finish - start).Unit
	localBeam(model, cf, "TelescopeObjectiveRim", finish - direction * 0.15, finish + direction * 0.2, 1.45, C.Dark, SMOOTH)
	localBeam(model, cf, "TelescopeBlueLens", finish + direction * 0.21, finish + direction * 0.24, 1.21, C.Glass, Enum.Material.Glass)
	localBeam(model, cf, "TelescopeEyepiece", start - direction * 0.55, start, 0.45, C.Dark, SMOOTH)
	for i = 0, 5 do
		local angle = i * math.pi / 3
		p(model, "BrokenMasonry", Vector3.new(1.8 + i % 2, 0.7 + (i % 3) * 0.35, 1.5),
			cf * CFrame.new(math.sin(angle) * 10.7, 0.5, 3 + math.cos(angle) * 7.6) * CFrame.Angles(0, angle, math.rad(5 * (i % 2))),
			C.Stone, PLASTIC)
	end
	for _, side in { -1, 1 } do
		p(model, "ObservatoryBench", Vector3.new(5.5, 0.5, 1.6), cf * CFrame.new(side * 9, 1.4, 4), C.Stone, PLASTIC, true)
		for _, z in { 2.9, 5.1 } do
			p(model, "BenchStoneLeg", Vector3.new(1.2, 1.3, 0.8), cf * CFrame.new(side * 9, 0.65, z), C.Stone, PLASTIC)
		end
	end
	local sign = p(model, "ObservatoryPlaque", Vector3.new(5.4, 1.2, 0.2), cf * CFrame.new(-9.4, 2.2, -5.5) * CFrame.Angles(math.rad(12), 0, 0), C.Dark)
	Kit.sign(sign, "THE OLD OBSERVATORY", "A quiet place to watch the cloud tides", C.Cream)
	return model
end

function Architecture.props(parent, cf, kind)
	local model = Kit.model(parent, (kind or "Fishing") .. "Details")
	if kind == "Market" then
		p(model, "MarketCounter", Vector3.new(7.8, 2.7, 3.1), cf * CFrame.new(0, 1.35, 0), C.Wood, PLASTIC, true)
		p(model, "CounterEdge", Vector3.new(8.2, 0.22, 3.5), cf * CFrame.new(0, 2.8, 0), C.Plank)
		for _, side in { -1, 1 } do
			p(model, "StallAwningPost", Vector3.new(0.3, 7.3, 0.3), cf * CFrame.new(side * 3.75, 3.65, 1.25), C.Timber)
			localBeam(model, cf, "AwningBrace", Vector3.new(side * 3.75, 5.2, 1.25), Vector3.new(side * 2.65, 6.9, 1.25), 0.18, C.Timber)
		end
		for i = 0, 7 do
			local color = i % 2 == 0 and C.Cream or C.Roof
			local awningCf = cf * CFrame.new(-3.5 + i, 6.7, -0.2) * CFrame.Angles(math.rad(9), 0, 0)
			p(model, "StripedCanvasAwning", Vector3.new(0.97, 0.14, 5.2), awningCf, color, SMOOTH)
			canvasHem(model, cf * CFrame.new(-3.5 + i, 6.06, -2.77), 0.97, 0.5, color)
		end
		for _, x in { -2.3, 0, 2.3 } do
			p(model, "ProduceTray", Vector3.new(1.9, 0.35, 2.2), cf * CFrame.new(x, 3.05, 0), C.Timber, PLASTIC)
			for i = 0, 2 do
				localBall(model, cf, "SeaGlassFloat", Vector3.new(0.7, 0.6, 0.7), Vector3.new(x + (i - 1) * 0.5, 3.5, 0.1 * (i % 2)),
					i == 1 and C.Gold or C.Glass, Enum.Material.Glass)
			end
		end
		local sign = p(model, "MarketPaintedSign", Vector3.new(5.2, 1, 0.15), cf * CFrame.new(0, 1.6, -1.64), C.Dark)
		Kit.sign(sign, "HARBOR SUPPLIES", "Made for a slower afternoon", C.Cream)
		barrel(model, cf * CFrame.new(5.1, 0, 0.6), 0.9)
	elseif kind == "Picnic" then
		p(model, "PicnicTableTop", Vector3.new(5.4, 0.3, 3), cf * CFrame.new(0, 2.3, 0), C.Plank, PLASTIC, true)
		for _, side in { -1, 1 } do
			p(model, "PicnicBench", Vector3.new(6, 0.22, 1.2), cf * CFrame.new(0, 1.25, side * 2.5), C.Plank, PLASTIC, true)
			for _, x in { -1.8, 1.8 } do
				p(model, "BenchSupport", Vector3.new(0.25, 1.25, 1), cf * CFrame.new(x, 0.6, side * 2.5), C.Timber)
			end
			p(model, "TableTrestle", Vector3.new(0.28, 2.2, 2.8), cf * CFrame.new(side * 1.8, 1.1, 0) * CFrame.Angles(0, 0, side * math.rad(9)), C.Timber)
		end
		Kit.disk(model, "PicnicPlate", 0.9, 0.9, 0.05, cf:PointToWorldSpace(Vector3.new(1.4, 2.5, 0.2)), C.Cream, { material = Enum.Material.SmoothPlastic })
		localBall(model, cf, "GlazedTeapot", Vector3.new(0.75, 0.65, 0.75), Vector3.new(-0.8, 2.77, 0), C.Roof, Enum.Material.SmoothPlastic)
		localBeam(model, cf, "TeapotSpout", Vector3.new(-0.5, 2.7, 0), Vector3.new(-0.2, 2.95, 0), 0.13, C.Roof)
		Kit.lantern(model, cf:PointToWorldSpace(Vector3.new(0, 2.65, 0)), 0.5, false)
	else
		crate(model, cf * CFrame.new(-1.5, 0, 0), Vector3.new(2.5, 1.9, 2.1))
		crate(model, cf * CFrame.new(-1.3, 1.94, 0.1) * CFrame.Angles(0, math.rad(12), 0), Vector3.new(2, 1.3, 1.7))
		barrel(model, cf * CFrame.new(1.6, 0, 0.6), 0.9)
		ropeCoil(model, cf * CFrame.new(0.7, 0, -1.6), 0.75)
		Kit.disk(model, "BaitPail", 1, 1, 1.15, cf:PointToWorldSpace(Vector3.new(2.9, 0.58, -1.1)), C.Dark, { material = Enum.Material.Metal })
		Kit.disk(model, "PailOpenTop", 0.83, 0.83, 0.035, cf:PointToWorldSpace(Vector3.new(2.9, 1.16, -1.1)), C.Timber, { material = SMOOTH })
		localBeam(model, cf, "PailHandle", Vector3.new(2.42, 0.9, -1.1), Vector3.new(2.9, 1.8, -1.1), 0.065, C.Dark, SMOOTH)
		localBeam(model, cf, "PailHandle", Vector3.new(2.9, 1.8, -1.1), Vector3.new(3.38, 0.9, -1.1), 0.065, C.Dark, SMOOTH)
		localBeam(model, cf, "RestingFishingRod", Vector3.new(-2, 0.2, 1), Vector3.new(-0.7, 5.1, 1.1), 0.08, C.Gold)
	end
	return model
end

return Architecture
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000012">
      <Properties>
        <string name="Name">WorldLandscaping</string>
        <ProtectedString name="Source">--!strict
-- Authored planting and little everyday scenes, rather than scatter over walkways.
-- All scenery here is anchored, non-solid and excluded from camera/raycast queries.
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Nature = require(script.Parent:WaitForChild("WorldNature"))
local Layout = require(script.Parent:WaitForChild("WorldLayout"))
local C = Kit.palette
local Landscaping = {}
local TAU = math.pi * 2
local foliage = { material = Enum.Material.SmoothPlastic }
local detail = { material = Enum.Material.Plastic, shadow = false }
local wood = { material = Enum.Material.Wood }
local cloth = { material = Enum.Material.Fabric, shadow = false }
local flowerTints = {
	C.Gold, C.Coral, C.Cream, C.Teal,
}

local function group(parent: Instance, name: string): Model
	local model = Kit.model(parent, name)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	return model
end
local function clearRoutes(zone: string, pos: Vector3, radius: number): boolean
	for _, route in Layout.Paths do
		if route.Island == zone then
			for i = 1, #route.Points - 1 do
				local a, b = route.Points[i], route.Points[i + 1]
				local dx, dz = b[1] - a[1], b[3] - a[3]
				local t = math.clamp(((pos.X - a[1]) * dx + (pos.Z - a[3]) * dz) / (dx * dx + dz * dz), 0, 1)
				if Vector2.new(pos.X - a[1] - dx * t, pos.Z - a[3] - dz * t).Magnitude &lt; route.Width / 2 + radius + 1.25 then
					return false
				end
			end
		end
	end
	return true
end

local function flower(parent: Instance, pos: Vector3, height: number, tint: Color3, angle: number)
	local top = pos + Vector3.yAxis * height
	Kit.beam(parent, "FlowerStem", pos, top, .12, C.Moss, detail)
	Kit.wedge(parent, "PointedFlowerLeaf", Vector3.new(.08,.42,.95),
		CFrame.new(pos + Vector3.new(.3, height * .46, 0)) * CFrame.Angles(0,angle,math.pi/2), C.Leaf, detail)
	for petal=0,3 do
		local cf=CFrame.new(top)*CFrame.Angles(0,angle+petal*math.pi/2,0)*CFrame.new(0,0,-.38)
		Kit.wedge(parent,"SculptedFlowerPetal",Vector3.new(.65,.12,.85),cf,tint,detail)
	end
	Kit.disk(parent, "PollenHeart", .35, .35, .16, top+Vector3.yAxis*.12, C.Gold, detail)
end

local function planting(parent: Instance, pos: Vector3, scale: number, tint: Color3, seed: number): Model
	local model = group(parent, "FloweringIslandBorder")
	local random = Random.new(seed)
	-- A shallow planted patch belongs to the ground, rather than sitting on it
	-- as a stack of green disks. The flowers and their leaves provide the volume.
	Kit.disk(model, "TendedGardenSoil", 6.8*scale, 4.2*scale, .07*scale,
		pos+Vector3.yAxis*.04*scale, C.Bark:Lerp(C.Moss,.4), {shadow=false})
	for i = 0, 2 do
		local a = .35 + i * TAU / 3
		flower(model, pos + Vector3.new(math.cos(a) * 2.1, .065, math.sin(a) * 1.4) * scale,
			(1.75 + i * .22) * scale, tint:Lerp(C.Cream, i * .12), random:NextNumber(0, TAU))
	end
	return model
end

local function hedge(parent: Instance, center: Vector3, length: number, yaw: number, tint: Color3)
	local model = group(parent, "BrickGardenHedge")
	local cf = CFrame.new(center) * CFrame.Angles(0, yaw, 0)
	for i = 0, 2 do
		local pos = cf:PointToWorldSpace(Vector3.new((i - 1) * length / 3, .95 + i % 2 * .2, 0))
		for _,side in {-1,1} do
			Kit.wedge(model, "TaperedGardenHedge", Vector3.new(length/3+.12,1.8,2),
				CFrame.new(pos)*CFrame.Angles(0,yaw,0)*CFrame.new(0,0,side*.75)*CFrame.Angles(0,if side==1 then math.pi else 0,0),
				C.Leaf:Lerp(C.Lime,i*.03), foliage)
		end
		if i ~= 1 then
			Kit.disk(model, "HedgeRosette", .75,.75,.13,pos+Vector3.new(0,1,-.85),tint,detail)
		end
	end
	return model
end

local function fern(parent: Instance, pos: Vector3, scale: number, yaw: number)
	for i = 0, 3 do
		local a = yaw + i * TAU / 4
		local tip = pos + Vector3.new(math.cos(a) * 2.5, .8 + i % 2 * .35, math.sin(a) * 2.5) * scale
		local frond = Kit.wedge(parent, "TaperedFernFrond", Vector3.new(.8, .18, 3.25) * scale,
			CFrame.lookAt((pos + tip) / 2, tip) * CFrame.Angles(.1, 0, 0), C.Leaf:Lerp(C.Lime, i % 3 * .12), detail)
		frond.CFrame *= CFrame.new(0, .3 * scale, 0)
	end
end

local function forestFloor(parent: Instance, pos: Vector3, seed: number)
	local model = group(parent, "FernAndToadstoolNook")
	local random = Random.new(seed)
	for i = 0, 1 do fern(model, pos + Vector3.new((i - .5) * 4, 0, 0), .9 + i * .15, random:NextNumber(0, TAU)) end
	for i = 1, 3 do
		local base = pos + Vector3.new(i - 2, 0, 2.7 + i % 2 * .6)
		local height = .6 + i * .18
		Kit.part(model, "IvoryMushroomStalk", Vector3.new(.26,height,.26), CFrame.new(base+Vector3.yAxis*height/2), C.Cream, detail)
		Kit.ball(model, "MushroomDome", Vector3.new(1.25, .48, 1.25), base + Vector3.yAxis * height,
			if i == 2 then flowerTints[1] else flowerTints[2], detail)
		Kit.part(model, "MushroomCapSpot", Vector3.new(.29, .05, .3), CFrame.new(base + Vector3.new(.2, height + .24, -.12)), C.Cream, detail)
	end
	return model
end

local function blossomDrift(parent: Instance, pos: Vector3, seed: number)
	local model = group(parent, "PetalwindFallenBlossoms")
	local random = Random.new(seed)
	for i = 1, 12 do
		local a = random:NextNumber(0, TAU)
		local radius = random:NextNumber(1.4, 6)
		local petal = Kit.wedge(model, "FallenBlossomPetal", Vector3.new(.55, .035, 1),
			CFrame.new(pos + Vector3.new(math.cos(a) * radius, .07, math.sin(a) * radius * .65)),
			C.Blossom:Lerp(C.BlossomLight, i % 3 * .3), detail)
		petal.CFrame *= CFrame.Angles(0, random:NextNumber(0, TAU), 0)
	end
	return model
end

local function triangle(parent: Instance, a: Vector3, b: Vector3, c: Vector3, tint: Color3)
	local ab, ac, bc = b - a, c - a, c - b
	if ab:Dot(ab) &gt; ac:Dot(ac) and ab:Dot(ab) &gt; bc:Dot(bc) then c, a = a, c
	elseif ac:Dot(ac) &gt; bc:Dot(bc) then a, b = b, a end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab).Unit
	local back = bc.Unit
	local up = bc:Cross(right).Unit
	local height = math.abs(ab:Dot(up))
	Kit.wedge(parent, "StripedUmbrellaPanel", Vector3.new(.065, height, math.abs(ab:Dot(back))), CFrame.fromMatrix((a+b)/2, right, up, back), tint, cloth)
	Kit.wedge(parent, "StripedUmbrellaPanel", Vector3.new(.065, height, math.abs(ac:Dot(back))), CFrame.fromMatrix((a+c)/2, -right, up, -back), tint, cloth)
end

local function umbrella(parent: Instance, pos: Vector3, tint: Color3, yaw: number)
	local model = group(parent, "StripedParasolSeating")
	Kit.disk(model, "ParasolFoot", 2.2, 2.2, .22, pos + Vector3.yAxis * .11, C.Limestone, { material = Enum.Material.Limestone })
	Kit.beam(model, "ParasolMast", pos, pos + Vector3.yAxis * 8.3, .2, C.Cream, wood)
	local canvas=Kit.model(model,"BreezyParasolCanvas")
	local canvasOrigin=CFrame.new(pos+Vector3.yAxis*8.4)
	canvas.WorldPivot=canvasOrigin
	Kit.ball(canvas, "BrassParasolFinial", Vector3.one * .4, pos + Vector3.yAxis * 8.55, C.Brass)
	for i = 0, 7 do
		local a, b = yaw + i * TAU / 8, yaw + (i + 1) * TAU / 8
		local left = pos + Vector3.new(math.cos(a) * 6, 6.55, math.sin(a) * 6)
		local right = pos + Vector3.new(math.cos(b) * 6, 6.55, math.sin(b) * 6)
		triangle(canvas, pos + Vector3.yAxis * 8.4, left, right, if i % 2 == 0 then tint else C.Cream)
	end
	canvas:SetAttribute("SwayOrigin",canvasOrigin)
	canvas:SetAttribute("SwayAmplitude",.007)
	Kit.disk(model, "CafeRoundTable", 4.4, 4.4, .25, pos + Vector3.yAxis * 2.6, C.Plank, wood)
	Kit.beam(model, "CafeTableLeg", pos + Vector3.yAxis * .2, pos + Vector3.yAxis * 2.5, .5, C.Wood, wood)
	for _, x in {-3.8, 3.8} do
		local chair = pos + Vector3.new(x, 0, 0)
		Kit.disk(model, "RoundCafeStool", 2.2, 2.2, .3, chair + Vector3.yAxis * 1.65, tint, cloth)
		Kit.beam(model, "CafeStoolSupport", chair, chair + Vector3.yAxis * 1.6, .45, C.Wood, wood)
	end
	return model
end

local function produce(parent: Instance, cf: CFrame)
	local model = group(parent, "FreshHarborProduce")
	for crate = 0, 1 do
		local base = cf * CFrame.new(crate * 3.8, 0, 0)
		Kit.part(model, "ProduceCrateFloor", Vector3.new(3.4, .2, 3), base * CFrame.new(0, .2, 0), C.Plank, wood)
		for _, side in {-1, 1} do
			Kit.part(model, "SlattedCrateSide", Vector3.new(3.5, .9, .2), base * CFrame.new(0, .7, side * 1.45), C.Wood, wood)
			Kit.part(model, "CrateEnd", Vector3.new(.2, .9, 2.8), base * CFrame.new(side * 1.65, .7, 0), C.Plank, wood)
		end
		for fruit = 0, 5 do
			local pos = base:PointToWorldSpace(Vector3.new((fruit % 3 - 1) * .87, .85, (math.floor(fruit / 3) - .5) * 1.08))
			Kit.ball(model, if crate == 0 then "SunPear" else "CoralApple", Vector3.new(.83, if crate == 0 then 1.05 else .8, .83), pos,
				if crate == 0 then flowerTints[1] else flowerTints[2], detail)
		end
	end
	Kit.part(model, "FoldedMarketCloth", Vector3.new(2, .15, 1.5), cf * CFrame.new(-2.9, .2, .6) * CFrame.Angles(0, .2, 0), C.Teal, cloth)
	return model
end

local function skiff(parent: Instance)
	local model = group(parent, "SundriftPaintedSkiff")
	local cf = CFrame.new(22, 8.2, 144) * CFrame.Angles(0, -.22, 0)
	model.WorldPivot=cf
	Kit.part(model, "SkiffFloor", Vector3.new(4.6, .4, 12), cf * CFrame.new(0, .65, 0), C.Plank, wood)
	for _, x in {-2.5, 2.5} do
		local side = if x &lt; 0 then -1 else 1
		Kit.part(model, "PaintedHull", Vector3.new(.45, 1.8, 12), cf * CFrame.new(x, 1.1, 0) * CFrame.Angles(0, 0, side * .13), C.Teal, wood)
		Kit.part(model, "CreamGunwale", Vector3.new(.53, .18, 12.3), cf * CFrame.new(x + side * .12, 2, 0), C.Cream, wood)
		Kit.beam(model, "PointedBowSide", cf:PointToWorldSpace(Vector3.new(x, 1.1, -6)), cf:PointToWorldSpace(Vector3.new(0, 1.1, -8.4)), .55, C.Teal, wood)
		Kit.beam(model, "PointedBowRim", cf:PointToWorldSpace(Vector3.new(x, 2, -6)), cf:PointToWorldSpace(Vector3.new(0, 2, -8.4)), .21, C.Cream, wood)
	end
	Kit.wedge(model, "BowFloor", Vector3.new(4.4, .25, 2.6), cf * CFrame.new(0, .55, -6), C.Wood, wood)
	Kit.part(model, "Transom", Vector3.new(5.3, 1.8, .45), cf * CFrame.new(0, 1.1, 6), C.Teal, wood)
	for _, z in {-3.7, .7, 4} do Kit.part(model, "RowingBench", Vector3.new(4.7, .27, 1.25), cf * CFrame.new(0, 1.6, z), C.Plank, wood) end
	for _, side in {-1, 1} do
		local a = cf:PointToWorldSpace(Vector3.new(side * .7, 1.95, -2.3))
		local b = cf:PointToWorldSpace(Vector3.new(side * 3.5, 2.1, 4.6))
		Kit.beam(model, "AshRowingOar", a, b, .15, C.Cream, wood)
		Kit.part(model, "OarBlade", Vector3.new(.85, .12, 2.5), CFrame.lookAt(b, a), C.Plank, wood)
	end
	-- The dock end stays on the dock while the boat bobs. A rigid rope parented
	-- to the boat made its landward anchor drift through the pier.
	local dockAnchor=Kit.part(parent,"SkiffDockMooring",Vector3.one*.08,CFrame.new(11.3,12,132),C.Cream,
		{transparency=1,shadow=false})
	local bowAnchor=Kit.part(model,"SkiffBowMooring",Vector3.one*.08,cf*CFrame.new(0,2,-8),C.Cream,
		{transparency=1,shadow=false})
	local dockEye, bowEye=Instance.new("Attachment"),Instance.new("Attachment")
	dockEye.Axis,bowEye.Axis=Vector3.yAxis,Vector3.yAxis
	dockEye.Name,dockEye.Parent="DockEye",dockAnchor
	bowEye.Name,bowEye.Parent="BowEye",bowAnchor
	local mooring=Instance.new("Beam")
	mooring.Name,mooring.Attachment0,mooring.Attachment1="SkiffMooringLine",dockEye,bowEye
	mooring.Color,mooring.Transparency=ColorSequence.new(C.Cream),NumberSequence.new(.12)
	mooring.Width0,mooring.Width1,mooring.Segments=.09,.09,10
	mooring.CurveSize0,mooring.CurveSize1,mooring.FaceCamera=-1.1,1.1,true
	mooring.LightInfluence,mooring.Parent=1,bowAnchor
	model:SetAttribute("SceneryMotion", "Boat")
	model:SetAttribute("DriftOrigin", cf)
	return model
end

local function beach(parent: Instance)
	local model = group(parent, "TideglassBeachDay")
	local cf = CFrame.new(-205, 4.05, -222) * CFrame.Angles(0, -.32, 0)
	for towel = 0, 1 do
		local base = cf * CFrame.new(towel * 5.5, 0, towel * 2)
		local tint = if towel == 0 then C.Coral else C.Teal
		Kit.part(model, "BeachTowel", Vector3.new(3.4, .07, 6.5), base, C.Cream, cloth)
		for stripe = 0, 3 do Kit.part(model, "WovenTowelStripe", Vector3.new(3.4, .015, .55), base * CFrame.new(0, .045, (stripe - 1.5) * 1.6), tint, cloth) end
		Kit.beam(model, "RolledTowelPillow", base:PointToWorldSpace(Vector3.new(-1.5, .35, -2.65)), base:PointToWorldSpace(Vector3.new(1.5, .35, -2.65)), .6, tint, cloth)
	end
	Kit.part(model, "BeachCooler", Vector3.new(2.2, 1.75, 1.8), cf * CFrame.new(3, .9, -4), C.Teal)
	Kit.part(model, "CoolerCreamLid", Vector3.new(2.35, .25, 1.95), cf * CFrame.new(3, 1.9, -4), C.Cream)
	for i = 1, 5 do
		local p = Vector3.new(-267 + i * 3.1, 4.14, -230 + math.sin(i) * 3)
		Kit.ball(model, "PearlShell", Vector3.new(.75, .21, .65), p, C.Cream:Lerp(C.Coral, i % 3 * .14), detail)
		for ridge = -1, 1 do Kit.beam(model, "ShellRidge", p + Vector3.new(0, .12, -.25), p + Vector3.new(ridge * .2, .12, .2), .045, C.Coral:Lerp(C.Cream, .65), detail) end
	end
	-- Navigation beacon is a physical landmark rather than a non-functional prompt.
	local b = Vector3.new(-274, 4, -200)
	Kit.beam(model, "CoveSignalPole", b, b + Vector3.yAxis * 8, .25, C.Wood, wood)
	local pennants=Kit.model(model,"CoveWindPennants")
	local pennantOrigin=CFrame.new(b+Vector3.yAxis*6.5)
	pennants.WorldPivot=pennantOrigin
	for _, side in {-1, 1} do
		Kit.wedge(pennants, "CoralWindPennant", Vector3.new(.055, 1.3, 2.6), CFrame.new(b + Vector3.new(0, 6.5 + side * .7, 1)) * CFrame.Angles(0, math.pi / 2, 0),
			if side == 1 then C.Coral else C.Cream, cloth)
	end
	pennants:SetAttribute("SwayOrigin",pennantOrigin)
	pennants:SetAttribute("SwayAmplitude",.038)
	return model
end

local function skyPicnic(parent: Instance, cf: CFrame, name: string, tint: Color3)
	local model = group(parent, name)
	Kit.part(model, "WovenPicnicBlanket", Vector3.new(8, .06, 6.4), cf * CFrame.new(0, .05, 0), C.Cream, cloth)
	for i = -2, 2 do
		Kit.part(model, "BlanketWovenStripe", Vector3.new(.5, .015, 6.4), cf * CFrame.new(i * 1.4, .09, 0), tint, cloth)
	end
	for _, x in {-2.6, 2.6} do
		Kit.ball(model, "LinenCushion", Vector3.new(1.9, .65, 1.8), cf:PointToWorldSpace(Vector3.new(x, .4, .7)), tint, cloth)
	end
	Kit.part(model, "PicnicHamper", Vector3.new(2, 1.2, 1.6), cf * CFrame.new(.3, .65, -2), C.Plank, wood)
	Kit.part(model, "HamperLid", Vector3.new(2.12, .15, 1.7), cf * CFrame.new(.3, 1.32, -2), C.Wood, wood)
	for _, x in {-.3, .9} do
		Kit.disk(model, "GlazedTeaCup", .45, .45, .55, cf:PointToWorldSpace(Vector3.new(x, .4, -.5)), C.Cream)
	end
	Kit.disk(model, "PicnicFruitPlate", 1.5, 1.5, .1, cf:PointToWorldSpace(Vector3.new(.2, .2, .8)), C.Coral)
	for i = 0, 2 do Kit.ball(model, "PicnicApricot", Vector3.one * .42, cf:PointToWorldSpace(Vector3.new(i * .35 - .15, .5, .8)), C.Gold, detail) end
	return model
end

function Landscaping.populate(_root: Instance, regions: {[string]: Model})
	local borders: {{any}} = {
		-- The same six harbor beds now frame the cafe, workshop and seating.
		{"harbor",-72,12,-7,1.35,2}, {"harbor",72,12,-6,1.25,1},
		{"harbor",-58,12,22,1.45,3}, {"harbor",57,12,17,1.25,2},
		{"harbor",-75,12,68,1.4,1}, {"harbor",44,12,82,1.3,4},
		{"blossom",-226,28,-33,1.2,4}, {"blossom",-267,28,-10,1.35,3},
		{"blossom",-270,28,65,1.4,2}, {"blossom",-194,28,-8,1.2,3},
		{"forest",292,24,11,1.25,1}, {"forest",245,24,61,1.25,4},
		{"summit",277,60,-278,1.15,4}, {"summit",277,60,-202,1.15,3},
		{"cove",-244,4,-169,1.05,2}, {"cove",-257,4,-232,1.15,1},
	}
	for i, data in borders do
		local pos = Vector3.new(data[2], data[3], data[4])
		if clearRoutes(data[1], pos, 4.1 * data[5]) then
			planting(regions[data[1]], pos, data[5], flowerTints[data[6]], i * 81)
		end
	end
	local hedges: {{any}} = {
		{"harbor",-17,12,-80,11,-.2}, {"harbor",26,12,-37,12,.05},
		{"harbor",-21,12,46,11,-.3}, {"harbor",26,12,60,12,.2},
		{"blossom",-217,28,26,10,.3}, {"blossom",-270,28,-24,12,-.2},
		{"forest",291,24,36,11,.3}, {"summit",275,60,-262,9,0},
	}
	for i, data in hedges do
		local pos = Vector3.new(data[2], data[3], data[4])
		if clearRoutes(data[1], pos, data[5] * .5) then hedge(regions[data[1]], pos, data[5], data[6], flowerTints[(i - 1) % 4 + 1]) end
	end
	-- Young, grouped trees fill the middle distance beneath the existing hero trees.
	local saplings: {{any}} = {
		{"harbor",-73,12,58,.73,"Oak"}, {"harbor",93,12,52,.7,"Oak"},
		{"blossom",-299,28,-7,.72,"Blossom"}, {"blossom",-215,28,-46,.7,"Blossom"},
		{"forest",215,24,10,.68,"Oak"}, {"forest",307,24,51,.65,"Oak"},
	}
	for i, data in saplings do
		local pos = Vector3.new(data[2], data[3], data[4])
		if clearRoutes(data[1], pos, 5.5) then
			local tree = Nature.tree(regions[data[1]], pos, data[5], data[6], 600 + i)
			tree.Name = "Young" .. data[6] .. "Cluster"
			for _, part in tree:GetDescendants() do
				if part:IsA("BasePart") then part.CanCollide, part.CanQuery = false, false end
			end
		end
	end
	-- Woodland groundcover belongs under the existing pine/oak crowns.
	for i, p in {Vector3.new(239,24,-35), Vector3.new(302,24,23), Vector3.new(222,24,54), Vector3.new(289,24,-61)} do
		if clearRoutes("forest", p, 4.5) then forestFloor(regions.forest, p, i * 39) end
	end
	blossomDrift(regions.blossom, Vector3.new(-282,28,-19), 718)
	blossomDrift(regions.blossom, Vector3.new(-224,28,57), 719)
	produce(regions.harbor, CFrame.new(-80,12,44) * CFrame.Angles(0,-.3,0))
	umbrella(regions.harbor, Vector3.new(32,12,79), C.Teal, .2)
	umbrella(regions.cove, Vector3.new(-212,4,-225), C.Coral, -.4)
	skiff(regions.harbor)
	beach(regions.cove)
	skyPicnic(regions.blossom, CFrame.new(-207,28,26) * CFrame.Angles(0,.4,0), "PetalwindTeaPicnic", C.Blossom)
	skyPicnic(regions.summit, CFrame.new(286,60,-208) * CFrame.Angles(0,-.45,0), "LookoutStargazerPicnic", C.Lavender)
end
return Landscaping
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000013">
      <Properties>
        <string name="Name">WorldResidents</string>
        <ProtectedString name="Source">--!strict
-- Original, lightweight block-toy townsfolk. Their movement is cosmetic and
-- runs locally; no Humanoids, pathfinding, avatar requests or server simulation.
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Residents = {}

local COLORS = {
	Ink = Color3.fromRGB(34, 47, 66), White = Color3.fromRGB(255, 250, 234),
	Peach = Color3.fromRGB(255, 202, 154), Tan = Color3.fromRGB(197, 128, 78),
	Brown = Color3.fromRGB(117, 74, 45), Pink = Color3.fromRGB(255, 150, 145),
	Gold = Color3.fromRGB(255, 215, 42), Teal = Color3.fromRGB(0, 163, 147),
	Blue = Color3.fromRGB(31, 139, 235), Coral = Color3.fromRGB(245, 93, 58),
	Lilac = Color3.fromRGB(105, 145, 222), Green = Color3.fromRGB(35, 185, 75),
	Hair = Color3.fromRGB(75, 47, 34), Blonde = Color3.fromRGB(245, 197, 68),
}

local BODY_SHADOWS = {
	CheerfulFace = true, LinenShirt = true, TrouserLeg = true, RoundedBoot = true,
	SoftHair = true, SunHatCrown = true, CanvasCap = true, KnittedCap = true,
	CanvasBackpack = true,
}
local CLOTH = {
	LinenShirt=true, TrouserLeg=true, RolledSleeve=true, ApronBib=true, ApronStrap=true,
	CanvasBackpack=true, BackpackPocket=true, CanvasCap=true, KnittedCap=true,
	WovenSunBrim=true, SunHatCrown=true, HatRibbon=true,
}

local function ball(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3): Part
	return Kit.ball(parent, name, size, position, color, { shadow = BODY_SHADOWS[name] == true })
end

local function block(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	return Kit.part(parent, name, size, cf, color, {
		material=if CLOTH[name] then Enum.Material.Fabric else Enum.Material.SmoothPlastic,
		shadow = BODY_SHADOWS[name] == true,
	})
end

local function brick(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3): Part
	return block(parent, name, size, CFrame.new(position), color)
end

local function pivot(parent: Model, name: string, position: Vector3): Model
	local joint = Kit.model(parent, name)
	local anchor = Kit.part(joint, "PosePivot", Vector3.new(0.08, 0.08, 0.08), CFrame.new(position), COLORS.Ink,
		{ shadow = false, transparency = 1 })
	joint.PrimaryPart = anchor
	joint:SetAttribute("AmbientRest", CFrame.new(position))
	return joint
end

local function limb(actor: Model, name: string, x: number, shirt: Color3, skin: Color3, leg: boolean): Model
	local position = Vector3.new(x, if leg then 1.6 else 3.16, 0)
	local joint = pivot(actor, name, position)
	if leg then
		brick(joint, "TrouserLeg", Vector3.new(0.57, 1.18, 0.61), position + Vector3.new(0, -0.52, 0), shirt)
		brick(joint, "RoundedBoot", Vector3.new(0.65, 0.48, 0.94), position + Vector3.new(0, -1.34, -0.13), COLORS.Ink)
	else
		brick(joint, "RolledSleeve", Vector3.new(0.61, 0.91, 0.66), position + Vector3.new(0, -0.34, 0), shirt)
		brick(joint, "MittenHand", Vector3.new(0.48, 0.57, 0.48), position + Vector3.new(0, -1.0, 0), skin)
	end
	return joint
end

local function face(actor: Model, skin: Color3, hair: Color3, hat: string, accent: Color3): Model
	local head = pivot(actor, "HeadPose", Vector3.new(0, 3.8, 0))
	local at = Vector3.new(0, 3.8, 0)
	brick(head, "CheerfulFace", Vector3.new(2.04, 2.08, 1.72), at + Vector3.new(0, 0.36, 0), skin)
	brick(head, "SoftHair", Vector3.new(2.09, 1.0, 1.58), at + Vector3.new(0, 1.0, 0.19), hair)
	for _, side in { -1, 1 } do
		local eye = ball(head, "Eye", Vector3.new(0.17, 0.24, 0.1), at + Vector3.new(side * 0.35, 0.51, -0.91), COLORS.Ink)
		eye:SetAttribute("AmbientEyeSize", eye.Size)
		local spark = ball(head, "EyeSpark", Vector3.new(0.055, 0.065, 0.035), at + Vector3.new(side * 0.35 - 0.025, 0.56, -0.965), COLORS.White)
		spark:SetAttribute("AmbientEyeSize", spark.Size)
		ball(head, "Blush", Vector3.new(0.27, 0.13, 0.055), at + Vector3.new(side * 0.61, 0.27, -0.895), COLORS.Pink)
		block(head, "Eyebrow", Vector3.new(0.27, 0.07, 0.075), CFrame.new(at + Vector3.new(side * 0.35, 0.80, -0.91))
			* CFrame.Angles(0, 0, side * -0.12), hair)
		block(head, "SmileCorner", Vector3.new(0.08, 0.12, 0.06), CFrame.new(at + Vector3.new(side * 0.13, 0.09, -0.91))
			* CFrame.Angles(0, 0, side * -0.45), COLORS.Brown)
	end
	ball(head, "Smile", Vector3.new(0.24, 0.08, 0.065), at + Vector3.new(0, 0.035, -0.92), COLORS.Brown)
	if hat == "Straw" then
		brick(head, "WovenSunBrim", Vector3.new(3.0, 0.14, 2.7), at + Vector3.new(0, 1.29, 0.04), COLORS.Gold)
		brick(head, "SunHatCrown", Vector3.new(1.9, 0.94, 1.65), at + Vector3.new(0, 1.54, 0.08), COLORS.Gold)
		brick(head, "HatRibbon", Vector3.new(1.94, 0.18, 1.70), at + Vector3.new(0, 1.37, 0.08), accent)
	elseif hat == "Beanie" then
		brick(head, "KnittedCap", Vector3.new(2.1, 0.95, 1.82), at + Vector3.new(0, 1.24, 0.04), accent)
		ball(head, "CapPompom", Vector3.new(0.49, 0.47, 0.47), at + Vector3.new(0, 1.83, 0.08), COLORS.White)
	else
		brick(head, "CanvasCap", Vector3.new(2.1, 0.8, 1.8), at + Vector3.new(0, 1.29, 0.08), accent)
		brick(head, "CapVisor", Vector3.new(1.71, 0.14, 1.11), at + Vector3.new(0, 1.12, -0.81), accent)
		brick(head, "CapBadge", Vector3.new(0.28, 0.25, 0.08), at + Vector3.new(0, 1.45, -0.87), COLORS.White)
	end
	return head
end

local function resident(parent: Model, data: any): Model
	local actor = Instance.new("Model")
	actor.Name, actor.ModelStreamingMode = "Resident_" .. data.name, Enum.ModelStreamingMode.Atomic
	local root = Kit.part(actor, "ResidentRoot", Vector3.new(0.12, 0.12, 0.12), CFrame.identity, COLORS.Ink,
		{ transparency = 1, shadow = false })
	actor.PrimaryPart = root
	brick(actor, "LinenShirt", Vector3.new(1.75, 1.88, 1.13), Vector3.new(0, 2.57, 0), data.shirt)
	block(actor, "ApronBib", Vector3.new(1.02, 1.09, 0.16), CFrame.new(0, 2.30, -0.56), data.apron)
	for _, x in { -0.38, 0.38 } do
		block(actor, "ApronStrap", Vector3.new(0.15, 0.81, 0.12), CFrame.new(x, 3.02, -0.51), data.apron)
		ball(actor, "BrassButton", Vector3.new(0.12, 0.12, 0.07), Vector3.new(x, 2.73, -0.66), COLORS.Gold)
	end
	limb(actor, "ArmLeft", -0.97, data.shirt, data.skin, false)
	local right = limb(actor, "ArmRight", 0.97, data.shirt, data.skin, false)
	limb(actor, "LegLeft", -0.40, data.apron, data.skin, true)
	limb(actor, "LegRight", 0.40, data.apron, data.skin, true)
	face(actor, data.skin, data.hair or COLORS.Hair, data.hat, data.accent)
	if data.style == "Repair" then
		Kit.beam(right, "RepairBrush", Vector3.new(0.97, 2.14, -0.25), Vector3.new(0.97, 2.18, -1), 0.12, COLORS.Gold, { shadow = false })
		ball(right, "BrushBristles", Vector3.new(0.28, 0.13, 0.30), Vector3.new(0.97, 2.16, -1.10), COLORS.White)
	elseif data.style == "Fish" then
		local handle = Vector3.new(0.97, 2.12, -0.18)
		local tip = Vector3.new(0.97, 4.35, -4.3)
		Kit.beam(right, "BambooFishingRod", handle, tip, 0.075, COLORS.Gold, { shadow = false })
		ball(right, "Reel", Vector3.new(0.35, 0.35, 0.25), Vector3.new(0.97, 2.46, -0.52), COLORS.Teal)
		local lineEnd = Vector3.new(0.97, -3.8, -10)
		-- The line lives outside the animated arm, so its bobber stays on real
		-- water while the rod tip and free hand move independently.
		Kit.beam(actor, "FineFishingLine", tip, lineEnd, 0.025, COLORS.White,
			{ shadow = false, transparency = 0.35 })
		ball(actor, "ResidentBobber", Vector3.new(.18,.23,.18), lineEnd, COLORS.Coral)
		actor:SetAttribute("AmbientLineEnd", data.cf:PointToWorldSpace(lineEnd))
	elseif data.style == "Serve" then
		Kit.disk(right, "LemonadeTray", 1.7, 1.1, 0.12, Vector3.new(0.97, 1.94, -0.32), COLORS.White, { shadow = false })
		for _, x in { 0.59, 1.33 } do
			Kit.disk(right, "LemonadeCup", .37, .37, .49, Vector3.new(x, 2.22, -0.32), COLORS.Gold, {shadow=false})
		end
	elseif data.style == "Garden" then
		ball(right, "WateringCan", Vector3.new(0.88, 0.76, 0.72), Vector3.new(1.0, 1.99, -0.2), COLORS.Teal)
		Kit.beam(right, "WateringSpout", Vector3.new(1.0, 2.03, -0.2), Vector3.new(1.0, 2.15, -1.06), 0.19, COLORS.Teal, { shadow = false })
		actor:SetAttribute("AmbientWaterTarget", data.cf:PointToWorldSpace(Vector3.new(1,.48,-1.65)))
		for index=1,3 do
			local drop=ball(actor,"WateringDrop"..index,Vector3.new(.055,.14,.055),Vector3.new(1,1.6-index*.3,-1.4),COLORS.Lilac)
			drop.Transparency=.35
		end
	elseif data.style == "Lookout" then
		brick(actor, "CanvasBackpack", Vector3.new(1.27, 1.48, 0.71), Vector3.new(0, 2.67, 0.70), COLORS.Gold)
		block(actor, "BackpackPocket", Vector3.new(0.86, 0.61, 0.18), CFrame.new(0, 2.4, 1.05), data.accent)
	end
	actor:SetAttribute("AmbientKind", "Resident")
	actor:SetAttribute("AmbientOrigin", data.cf)
	actor:SetAttribute("AmbientStyle", data.style)
	actor:SetAttribute("AmbientPhase", data.phase)
	actor:SetAttribute("AmbientPeriod", data.period or 35)
	if data.travel then
		actor:SetAttribute("AmbientTravel", data.travel)
		actor:SetAttribute("AmbientRouteWidth", 3.8)
	end
	actor:PivotTo(data.cf)
	actor.Parent = parent
	return actor
end

local function workspaces(parent: Instance, cast: {any})
	local folder=Instance.new("Folder")
	folder.Name,folder.Parent="ResidentWorkspaces",parent
	for _,data in cast do
		if data.style~="Repair" and data.style~="Garden" then continue end
		local scene=Kit.model(folder,data.name.."Workspace")
		scene.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
		local function part(name: string,size: Vector3,pos: Vector3,tint: Color3): Part
			return Kit.part(scene,name,size,data.cf*CFrame.new(pos),tint,{material=Enum.Material.Wood,shadow=false})
		end
		if data.style=="Repair" then
			part("RepairWorktop",Vector3.new(2.8,.16,1.2),Vector3.new(.7,2.08,-1.3),COLORS.Brown)
			for _,x in {-.45,1.85} do
				part("WorkbenchTrestle",Vector3.new(.18,2,.8),Vector3.new(x,1,-1.3),COLORS.Brown)
			end
			Kit.wedge(scene,"HalfPaintedHull",Vector3.new(1.8,.25,.65),data.cf*CFrame.new(.75,2.25,-1.12),COLORS.Teal,{material=Enum.Material.Wood,shadow=false})
			Kit.disk(scene,"OpenPaintPot",.34,.34,.3,data.cf:PointToWorldSpace(Vector3.new(-.3,2.31,-1.35)),COLORS.Coral,{shadow=false})
		else
			Kit.disk(scene,"TendedSoilPatch",2.2,1.7,.12,data.cf:PointToWorldSpace(Vector3.new(1,.08,-1.65)),COLORS.Brown,{material=Enum.Material.Ground,shadow=false})
			for index=-1,1 do
				local x=1+index*.65
				Kit.beam(scene,"TendedFlowerStem",data.cf:PointToWorldSpace(Vector3.new(x,.16,-1.65)),
					data.cf:PointToWorldSpace(Vector3.new(x,.7+index%2*.15,-1.65)),.07,COLORS.Green,{shadow=false})
				Kit.wedge(scene,"TendedFlowerLeaf",Vector3.new(.12,.3,.6),data.cf*CFrame.new(x,.4,-1.65)*CFrame.Angles(0,index*.6,math.pi/2),COLORS.Green,{shadow=false})
				Kit.disk(scene,"TendedFlowerBloom",.38,.38,.09,data.cf:PointToWorldSpace(Vector3.new(x,.74+index%2*.15,-1.65)),COLORS.Pink,{shadow=false})
			end
		end
	end
end

local function gull(parent: Model, index: number, origin: Vector3, radius: Vector3, phase: number)
	local model = Instance.new("Model")
	model.Name, model.ModelStreamingMode = "IslandGull_" .. index, Enum.ModelStreamingMode.Atomic
	local body = ball(model, "GullBody", Vector3.new(0.72, 0.65, 1.45), Vector3.zero, COLORS.White)
	model.PrimaryPart = body
	ball(model, "GullHead", Vector3.new(0.56, 0.55, 0.62), Vector3.new(0, 0.30, -0.60), COLORS.White)
	ball(model, "GoldenBeak", Vector3.new(0.17, 0.17, 0.45), Vector3.new(0, 0.24, -1.0), COLORS.Gold)
	for _, side in { -1, 1 } do
		local wing = pivot(model, if side &lt; 0 then "WingLeft" else "WingRight", Vector3.new(side * 0.26, 0.11, 0))
		ball(wing, "SweptWing", Vector3.new(1.75, 0.15, 0.77), Vector3.new(side * 1.05, 0.11, 0.11), COLORS.White)
		ball(wing, "InkWingtip", Vector3.new(0.47, 0.13, 0.62), Vector3.new(side * 1.78, 0.11, 0.20), COLORS.Ink)
	end
	local cf = CFrame.new(origin)
	model:SetAttribute("AmbientKind", "Gull")
	model:SetAttribute("AmbientOrigin", cf)
	model:SetAttribute("AmbientRadius", radius)
	model:SetAttribute("AmbientPeriod", 22 + index * 1.6)
	model:SetAttribute("AmbientPhase", phase)
	model:PivotTo(cf)
	model.Parent = parent
end

local function butterfly(parent: Model, index: number, origin: Vector3, color: Color3)
	local model = Instance.new("Model")
	model.Name, model.ModelStreamingMode = "GardenButterfly_" .. index, Enum.ModelStreamingMode.Atomic
	local body = ball(model, "ButterflyBody", Vector3.new(0.12, 0.44, 0.13), Vector3.zero, COLORS.Ink)
	model.PrimaryPart = body
	for _, side in { -1, 1 } do
		local wing = pivot(model, if side &lt; 0 then "WingLeft" else "WingRight", Vector3.new(side * 0.05, 0, 0))
		ball(wing, "ButterflyWing", Vector3.new(0.76, 0.81, 0.075), Vector3.new(side * 0.36, 0.06, 0), color)
	end
	local cf = CFrame.new(origin)
	model:SetAttribute("AmbientKind", "Butterfly")
	model:SetAttribute("AmbientOrigin", cf)
	model:SetAttribute("AmbientRadius", Vector3.new(2.5, 0.7, 2.1))
	model:SetAttribute("AmbientPeriod", 7.5 + index * 0.7)
	model:SetAttribute("AmbientPhase", index * 1.73)
	model:PivotTo(cf)
	model.Parent = parent
end

local function fishSchool(parent: Model, index: number, origin: Vector3)
	local model = Instance.new("Model")
	model.Name, model.ModelStreamingMode = "LagoonFishSchool_" .. index, Enum.ModelStreamingMode.Atomic
	local root = Kit.part(model, "SchoolOrigin", Vector3.new(0.08, 0.08, 0.08), CFrame.identity, COLORS.Teal,
		{ transparency = 1, shadow = false })
	model.PrimaryPart = root
	for number = 1, 3 do
		local fish = Kit.model(model, "LagoonFish_" .. number)
		local position = Vector3.new((number - 2) * 1.35, (number % 2) * 0.2, number * 1.3)
		local color = if number == 1 then COLORS.Gold elseif number == 2 then COLORS.Coral else COLORS.Teal
		fish.PrimaryPart = ball(fish, "FishBody", Vector3.new(0.66, 0.47, 1.19), position, color)
		for _, side in { -1, 1 } do
			local tail = ball(fish, "TailFan", Vector3.new(0.43, 0.11, 0.59), position + Vector3.new(side * 0.16, 0, 0.77), color)
			tail.CFrame *= CFrame.Angles(0, side * -0.65, 0)
			ball(fish, "FishEye", Vector3.new(0.09, 0.10, 0.10), position + Vector3.new(side * 0.27, 0.09, -0.35), COLORS.Ink)
		end
	end
	local cf = CFrame.new(origin)
	model:SetAttribute("AmbientKind", "FishSchool")
	model:SetAttribute("AmbientOrigin", cf)
	model:SetAttribute("AmbientRadius", Vector3.new(9, 0.24, 6))
	model:SetAttribute("AmbientPeriod", 24 + index * 2)
	model:SetAttribute("AmbientPhase", index * 2.17)
	model:PivotTo(cf)
	model.Parent = parent
end

function Residents.populate(parent: Instance): Model
	local group = Instance.new("Model")
	group.Name = "IslandResidents"
	local cast = {
		{ name = "Milo", cf = CFrame.new(45, 12.15, -6) * CFrame.Angles(0, 0.35, 0), shirt = COLORS.White,
			apron = COLORS.Teal, skin = COLORS.Tan, hat = "Cap", accent = COLORS.Coral, style = "Repair", phase = 0.2 },
		{ name = "Juniper", cf = CFrame.new(-45, 12.15, -5.1) * CFrame.Angles(0, math.pi + .35, 0), shirt = COLORS.Coral,
			apron = COLORS.White, skin = COLORS.Peach, hat = "Beanie", accent = COLORS.Lilac, style = "Serve", phase = 1.7 },
		{ name = "CaptainPip", cf = CFrame.new(8, 12, 127) * CFrame.Angles(0, -math.pi / 2, 0), shirt = COLORS.White,
			apron = COLORS.Blue, skin = COLORS.Brown, hat = "Cap", accent = COLORS.Gold, style = "Fish", phase = 3.5 },
		{ name = "Sunny", cf = CFrame.new(-13, 12, 40), shirt = COLORS.Gold, apron = COLORS.Lilac,
			skin = COLORS.Peach, hat = "Cap", accent = COLORS.Teal, style = "Walk", phase = 0.6,
			travel = Vector3.new(0, 0, 24), period = 35 },
		{ name = "Petal", cf = CFrame.new(-229, 28, 30) * CFrame.Angles(0, math.pi / 2, 0), shirt = COLORS.Lilac,
			apron = COLORS.White, skin = COLORS.Tan, hat = "Straw", accent = COLORS.Coral, style = "Garden", phase = 2.2 },
		{ name = "Rowan", cf = CFrame.new(252, 24, 22) * CFrame.Angles(0, -math.pi / 2, 0), shirt = COLORS.Green,
			apron = COLORS.White, skin = COLORS.Brown, hat = "Cap", accent = COLORS.Gold, style = "Wave", phase = 4.1 },
		{ name = "Scout", cf = CFrame.new(-270, 4, -198) * CFrame.Angles(0, math.pi, 0), shirt = COLORS.Teal,
			apron = COLORS.Coral, skin = COLORS.Peach, hat = "Straw", hair = COLORS.Blonde, accent = COLORS.Blue,
			style = "Lookout", phase = 5.4 },
	}
	workspaces(parent,cast)
	for _, data in cast do resident(group, data) end
	local flock = {
		{ Vector3.new(4, 31, 122), Vector3.new(20, 2.0, 13) },
		{ Vector3.new(-14, 35, 165), Vector3.new(18, 2.0, 12) },
		{ Vector3.new(27, 30, 142), Vector3.new(16, 1.5, 12) },
		{ Vector3.new(-241, 47, 113), Vector3.new(17, 1.4, 12) },
		{ Vector3.new(268, 44, 101), Vector3.new(18, 1.4, 13) },
		{ Vector3.new(-287, 24, -204), Vector3.new(15, 1.5, 11) },
	}
	for index, data in flock do gull(group, index, data[1], data[2], index * 1.6) end
	for index, position in {
		Vector3.new(-27, 15.5, 16), Vector3.new(-32, 15.0, 18), Vector3.new(32, 15.5, 34),
		Vector3.new(-229, 31.5, 34), Vector3.new(-234, 32, 36), Vector3.new(249, 27.5, 27),
	} do
		butterfly(group, index, position, if index % 2 == 0 then COLORS.Gold else COLORS.Coral)
	end
	fishSchool(group, 1, Vector3.new(-14, 6.5, 147))
	fishSchool(group, 2, Vector3.new(-342, -1.5, -211))
	group.Parent = parent
	return group
end

return Residents
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000014">
      <Properties>
        <string name="Name">WorldPondBackdrops</string>
        <ProtectedString name="Source">--!strict
-- Low, individual shorelines frame each existing pond. Visible rock owns collision;
-- there are no taller, invisible copies of the scenery to run into.
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Layout = require(script.Parent:WaitForChild("WorldLayout"))
local Backdrops = {}
local C = Kit.palette
local WATER = Color3.fromRGB(56,153,181)
local FOAM = Color3.fromRGB(160,199,208)
local BASE = -5.4
local ROCK = {material=Enum.Material.Slate,collidable=true}

-- Low gaps preserve a view beyond the water. Different heights, widths and
-- setbacks give every island its own silhouette without extra land or props.
local SHORES: {[string]: any} = {
 harbor={x={-.86,-.56,-.26,.05,.36,.65,.90},h={15,23,19,11,17,26,14},
  w={.34,.37,.36,.33,.36,.34,.29},d={1,3,-1,1,0,3,-1},falls={2,6},warmth=.07},
 blossom={x={-.87,-.55,-.23,.12,.46,.78},h={14,22,16,11,24,17},
  w={.36,.37,.39,.39,.36,.35},d={0,2,0,3,-1,1},falls={2,5},warmth=.15},
 forest={x={-.88,-.57,-.24,.09,.43,.77},h={18,26,21,13,29,17},
  w={.35,.37,.39,.39,.37,.35},d={2,-1,3,0,2,0},falls={3,5},warmth=.02},
 cove={x={-.89,-.56,-.23,.13,.46,.79},h={9,18,13,8,15,10},
  w={.37,.40,.39,.39,.37,.35},d={0,2,0,3,-1,1},falls={2},warmth=.23},
 summit={x={-.84,-.43,.01,.43,.84},h={10,21,13,24,12},
  w={.42,.46,.46,.45,.41},d={1,3,0,2,0},falls={2,4},warmth=.04},
}

local function waterfall(parent: Model,frame: CFrame,x: number,z: number,width: number,top: number,phase: number)
 -- The lip overlaps its rock crown. Water crosses the ledge to its actual edge.
 Kit.part(parent,"WaterfallSourceLip",Vector3.new(width+.7,.5,5.8),
  frame*CFrame.new(x,top-.25,z+5.1),C.Stone,ROCK)
 local channel=Kit.part(parent,"WaterfallSourceChannel",Vector3.new(width,.055,5.7),
  frame*CFrame.new(x,top+.03,z+5.1),WATER,
  {material=Enum.Material.SmoothPlastic,transparency=.34,shadow=false})
 channel:SetAttribute("GlintPhase",phase)
 local height=top-.12
 local curtain=Kit.part(parent,"PondWaterfallCurtain",Vector3.new(width,height,.19),
  frame*CFrame.new(x,.12+height/2,z+8),WATER,
  {material=Enum.Material.SmoothPlastic,transparency=.42,shadow=false})
 for index=1,3 do
  local streak=Kit.part(parent,"PondWaterfallStreak",Vector3.new(.10,3.6,.07),
   curtain.CFrame*CFrame.new((index-2)*width*.29,0,.14),FOAM,
   {material=Enum.Material.SmoothPlastic,transparency=.48,shadow=false})
  streak:SetAttribute("FlowStart",streak.CFrame)
  streak:SetAttribute("FlowPhase",phase+index*.29)
  streak:SetAttribute("FlowDistance",height-streak.Size.Y)
  streak:SetAttribute("FlowSpeed",9+index*.7)
 end
 for index=1,3 do
  local foam=Kit.wedge(parent,"PondWaterfallFoam",Vector3.new(width*.45,.12,1.65),
   frame*CFrame.new(x+(index-2)*width*.3,.15,z+8.55+index%2*.6)*CFrame.Angles(0,(index-2)*.16,0),FOAM,
   {material=Enum.Material.SmoothPlastic,transparency=.45,shadow=false})
  foam:SetAttribute("GlintPhase",phase+index*.43)
 end
end

function Backdrops.populate(parent: Instance)
 for _,water in Layout.Waters do
  local shore=SHORES[water.Id]
  local yaw=0
  for _,dock in Layout.Docks do if dock.Id==water.Id then yaw=dock.Yaw;break end end
  local model=Kit.model(parent,water.Id.."PondTerraces")
  model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
  model:SetAttribute("ShoreZoneId",water.Id)
  local frame=CFrame.new(table.unpack(water.Center))*CFrame.Angles(0,yaw,0)
  local sideways=math.abs(math.sin(yaw))&gt;.5
  local radiusX=if sideways then water.Radius[2] else water.Radius[1]
  local radiusZ=if sideways then water.Radius[1] else water.Radius[2]
  for index,offset in shore.x do
   local x=offset*radiusX
   local width,height=radiusX*shore.w[index],shore.h[index]
   local isFall=table.find(shore.falls,index)~=nil
   -- Keep the entire cascade inside the elliptical water surface, including
   -- its outer edge; a centered check alone leaves the sides falling onto land.
   local outerX=if isFall then math.min(.99,math.abs(offset)+width*.31*.55/radiusX) else math.abs(offset)
   local setback=if isFall then math.min(.4,shore.d[index]) else shore.d[index]
   local z=-(radiusZ*math.sqrt(1-outerX*outerX)+6+setback)
   local ledge=height*(.44+index%3*.045)
   local lowerTint=C.Cliff:Lerp(C.DeepStone,.08+index%3*.035)
   local upperTint=C.Stone:Lerp(C.Limestone,shore.warmth+index%3*.018)
   -- Physical cores and their sloped shoulders match the visible coastline.
   Kit.part(model,"LowerShoreRockFace",Vector3.new(width*.72,ledge-BASE,15.2),
    frame*CFrame.new(x,(ledge+BASE)/2,z),lowerTint,ROCK)
   Kit.part(model,"UpperShoreRockFace",Vector3.new(width*.70,height-ledge+.08,10),
    frame*CFrame.new(x,(height+ledge)/2,z-2),upperTint,ROCK)
   for _,side in {-1,1} do
    Kit.wedge(model,"TaperedShoreButtress",Vector3.new(15.2,ledge-BASE,width*.24),
     frame*CFrame.new(x+side*width*.47,(ledge+BASE)/2,z)*CFrame.Angles(0,-side*math.pi/2,0),lowerTint,ROCK)
    Kit.wedge(model,"UpperShoreRockFacet",Vector3.new(10,height-ledge+.08,width*.24),
     frame*CFrame.new(x+side*width*.46,(height+ledge)/2,z-2)*CFrame.Angles(0,-side*math.pi/2,0),upperTint,ROCK)
   end
   if index==2 or index==#shore.x-1 then
    for leaf=1,2 do
     Kit.wedge(model,"ShoreLedgeLeaf",Vector3.new(.12,.65,1.1),
      frame*CFrame.new(x+(leaf-1.5)*.65,ledge+.32,z+5.1)*CFrame.Angles(0,leaf*.8,.15),C.Leaf,{shadow=false})
    end
   end
   for _,fallIndex in shore.falls do
    if fallIndex==index then waterfall(model,frame,x,z,width*.31,height,index*.17) end
   end
  end
 end
end

return Backdrops
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000015">
      <Properties>
        <string name="Name">WorldDockDetails</string>
        <ProtectedString name="Source">--!strict
-- Small, authored fishing scenes live on the outside edges of the piers.
-- They add no prompts, touch events, camera obstacles or gameplay state.
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Layout = require(script.Parent:WaitForChild("WorldLayout"))
local C = Kit.palette
local Details = {}

-- A handful of readable surface families; tiny painted/ceramic objects stay
-- smooth rather than receiving the same coarse pattern as the timber pier.
local WOOD = {
	PaintedTackleBox=true, CreamTackleLid=true, OpenLureTray=true, CreelBottom=true,
	RodRackPost=true, RodRackCrosspiece=true, RestingSpareRod=true, PaintedPierNameplate=true,
	PicnicTeaTray=true, NeatlyStackedFirewood=true, FirewoodCutEnd=true,
	FoundShellTray=true, BeachPennantPole=true,
}
local METAL = {
	TackleBoxHinge=true, BrassTackleLatch=true, TackleCarryingHandle=true,
	BucketCarryHandle=true, MooringCleatFoot=true, MooringCleatHorn=true, SafetyRingHanger=true,
	ExplorerCompassCase=true, CompassRedNeedle=true, WeatherVaneMast=true,
	WeatherVaneEastWest=true, WeatherVaneNorthSouth=true, StarVaneGoldCore=true,
	StarVaneLongArms=true, StarVaneCrossArms=true,
}
local function material(name: string): Enum.Material
	if WOOD[name] then return Enum.Material.Wood end
	if METAL[name] then return Enum.Material.Metal end
	if name=="PaintedRoundCreel" or name=="SegmentedLifeBuoy" then return Enum.Material.Fabric end
	if name=="WeatherVaneFoot" or name=="CoralShellRidge" then return Enum.Material.Limestone end
	return Enum.Material.SmoothPlastic
end

local LABELS = {
	harbor = "SUNDRIFT HARBOR", blossom = "PETALWIND GROVE", forest = "EVERGREEN REACH",
	cove = "TIDEGLASS COVE", summit = "STARFALL LOOKOUT",
}

local function part(parent: Model, name: string, size: Vector3, cf: CFrame, color: Color3, _studded: boolean?): Part
	return Kit.part(parent, name, size, cf, color, {
		material = material(name),
		shadow = math.max(size.X, size.Y, size.Z) &gt;= 1.2,
	})
end

local function beam(parent: Model, name: string, cf: CFrame, a: Vector3, b: Vector3, width: number, color: Color3)
	Kit.beam(parent, name, cf:PointToWorldSpace(a), cf:PointToWorldSpace(b), width, color,
		{ material = material(name), shadow = (b-a).Magnitude &gt;= 1.2 })
end

local function cylinder(parent: Model, name: string, diameter: number, depth: number, height: number, cf: CFrame, color: Color3): Part
	local value = part(parent, name, Vector3.new(height, diameter, depth), cf * CFrame.Angles(0, 0, math.pi / 2), color)
	value.Shape = Enum.PartType.Cylinder
	return value
end

local function tackle(parent: Model, cf: CFrame, accent: Color3)
	part(parent, "PaintedTackleBox", Vector3.new(1.8, .85, 1.25), cf*CFrame.new(0,.49,0), accent, true)
	part(parent, "CreamTackleLid", Vector3.new(1.94,.16,1.37), cf*CFrame.new(0,.995,0), C.Cream, true)
	for _, x in {-.56,.56} do
		part(parent, "TackleBoxHinge", Vector3.new(.24,.15,.18), cf*CFrame.new(x,.93,.66), C.Brass)
	end
	part(parent, "BrassTackleLatch", Vector3.new(.28,.33,.1), cf*CFrame.new(0,.86,-.68), C.Brass)
	beam(parent, "TackleCarryingHandle", cf, Vector3.new(-.45,1.13,0), Vector3.new(.45,1.13,0), .12, C.Iron)
	part(parent, "OpenLureTray", Vector3.new(1.8,.12,.78), cf*CFrame.new(0,.1,-1.22), C.Wood)
	for index, tint in {C.Coral,C.Gold} do
		local x = (index-1.5)*.68
		Kit.wedge(parent, "PaintedFishingLure", Vector3.new(.22,.18,.54),
			cf*CFrame.new(x,.28,-1.22)*CFrame.Angles(0,math.pi/2,0), tint, {shadow=false})
		Kit.wedge(parent, "LureSilverTail", Vector3.new(.08,.18,.24),
			cf*CFrame.new(x+.28,.25,-1.22)*CFrame.Angles(0,-math.pi/2,0), C.Cream, {material=Enum.Material.Metal,shadow=false})
	end
end

local function bucket(parent: Model, cf: CFrame, accent: Color3)
	cylinder(parent, "CreelBottom", 1.12, 1.12, .12, cf*CFrame.new(0,.1,0), C.Wood)
	cylinder(parent, "PaintedRoundCreel", 1.05, 1.05, 1, cf*CFrame.new(0,.65,0), accent)
	cylinder(parent, "CreelOpenInterior", .86, .86, .025, cf*CFrame.new(0,1.158,0), C.DeepStone)
	beam(parent, "BucketCarryHandle", cf, Vector3.new(-.39,1.04,.28), Vector3.new(-.28,1.55,.28), .085, C.Iron)
	beam(parent, "BucketCarryHandle", cf, Vector3.new(-.28,1.55,.28), Vector3.new(.28,1.55,.28), .085, C.Iron)
	beam(parent, "BucketCarryHandle", cf, Vector3.new(.28,1.55,.28), Vector3.new(.39,1.04,.28), .085, C.Iron)
	cylinder(parent, "CreamFishingFloat", .28, .28, .72, cf*CFrame.new(.17,.91,-.03)*CFrame.Angles(.18,0,-.22), C.Cream)
	cylinder(parent, "CoralFloatTip", .29, .29, .23, cf*CFrame.new(.23,1.17,-.08)*CFrame.Angles(.18,0,-.22), C.Coral)
end

local function rodRack(parent: Model, cf: CFrame)
	for _, z in {-.65,.65} do
		part(parent, "RodRackPost", Vector3.new(.18,1.65,.18), cf*CFrame.new(0,.88,z), C.Wood)
	end
	part(parent, "RodRackCrosspiece", Vector3.new(.23,.23,1.7), cf*CFrame.new(0,1.55,0), C.Plank)
	beam(parent, "RestingSpareRod", cf, Vector3.new(.12,.18,-.46), Vector3.new(-.17,3.72,.43), .07, C.Gold)
	local reel=Kit.disk(parent, "SpareRodReel", .29,.29,.16, cf:PointToWorldSpace(Vector3.new(.1,.76,-.31)), C.Teal,
		{ material = Enum.Material.Metal, shadow = false })
	reel.CFrame=cf*CFrame.new(.1,.76,-.31)
end

local function railTrim(parent: Model, basis: CFrame, width: number, length: number, index: number, name: string)
	for _, x in {-width/2+.25,width/2-.25} do
		for _, z in {-.5,-length+.5} do
			cylinder(parent, "CreamPierCornerBumper", .75, .75, 1.65, basis*CFrame.new(x,1.3,z), C.Cream)
		end
		part(parent, "MooringCleatFoot", Vector3.new(.64,.13,1.1), basis*CFrame.new(x,.19,-11), C.Iron)
		part(parent, "MooringCleatHorn", Vector3.new(.23,.18,1.43), basis*CFrame.new(x,.33,-11), C.Brass)
	end
	-- Front normal faces inward from the left rail; arriving anglers can read it.
	local plaque = part(parent, "PaintedPierNameplate", Vector3.new(4.7,1.35,.13),
		basis*CFrame.new(width/2-.17,2.25,-13)*CFrame.Angles(0,math.pi/2,0), C.Teal)
	Kit.sign(plaque,name,string.format("PIER %02d  /  CAST · COLLECT · EXPLORE",index),C.Cream)
end

local function lifeRing(parent: Model, cf: CFrame)
	-- Twelve short round sections make a recognizable open lifebuoy rather
	-- than a square outline. Its rope stays attached to the pier edge.
	for index=0,11 do
		local a, b = index*math.pi/6, (index+1)*math.pi/6
		beam(parent,"SegmentedLifeBuoy",cf,
			Vector3.new(math.cos(a)*.9,1.65+math.sin(a)*.9,0),
			Vector3.new(math.cos(b)*.9,1.65+math.sin(b)*.9,0),.3,
			if index%3==0 then C.Coral else C.Cream)
	end
	beam(parent,"SafetyRingHanger",cf,Vector3.new(-.38,2.7,.12),Vector3.new(.38,2.7,.12),.1,C.Iron)
end

local function teaBreak(parent: Model, cf: CFrame)
	part(parent,"PicnicTeaTray",Vector3.new(1.65,.14,1.45),cf*CFrame.new(0,.13,0),C.Plank,true)
	cylinder(parent,"BlueTeaFlask",.59,.59,1.35,cf*CFrame.new(-.42,.86,.03),C.Teal)
	cylinder(parent,"FlaskCreamLid",.65,.65,.2,cf*CFrame.new(-.42,1.63,.03),C.Cream)
	cylinder(parent,"TeaFlaskStripe",.61,.61,.16,cf*CFrame.new(-.42,.77,.03),C.Gold)
	for _, z in {-.38,.38} do
		cylinder(parent,"GlazedTeaCup",.43,.43,.4,cf*CFrame.new(.43,.41,z),C.Cream)
		cylinder(parent,"WarmTeaSurface",.3,.3,.025,cf*CFrame.new(.43,.615,z),C.Bark)
		beam(parent,"TeaCupHandle",cf,Vector3.new(.61,.54,z),Vector3.new(.78,.5,z),.075,C.Gold)
		beam(parent,"TeaCupHandle",cf,Vector3.new(.78,.5,z),Vector3.new(.78,.36,z),.075,C.Gold)
		beam(parent,"TeaCupHandle",cf,Vector3.new(.78,.36,z),Vector3.new(.61,.31,z),.075,C.Gold)
	end
end

local function forestKeepsake(parent: Model, cf: CFrame)
	for index=0,2 do
		beam(parent,"NeatlyStackedFirewood",cf,Vector3.new((index-1)*.61,.34,-.9),Vector3.new((index-1)*.61,.34,.9),.57,C.Bark)
		cylinder(parent,"FirewoodCutEnd",.47,.43,.025,cf*CFrame.new((index-1)*.61,.34,-.915)*CFrame.Angles(math.pi/2,0,0),C.Plank)
	end
	part(parent,"ExplorerCompassCase",Vector3.new(.9,.16,.9),cf*CFrame.new(0,.71,.1),C.Brass)
	part(parent,"CompassIvoryDial",Vector3.new(.73,.025,.73),cf*CFrame.new(0,.805,.1),C.Cream)
	part(parent,"CompassRedNeedle",Vector3.new(.07,.04,.54),cf*CFrame.new(0,.84,.1)*CFrame.Angles(0,.45,0),C.Coral)
end

local function beachKeepsake(parent: Model, cf: CFrame)
	part(parent,"FoundShellTray",Vector3.new(1.7,.1,1.2),cf*CFrame.new(0,.12,0),C.Plank,true)
	for index=0,2 do
		local x=(index-1)*.48
		local shell=cf*CFrame.new(x,.265,(index%2)*.25-.1)*CFrame.Angles(0,index*.5,0)
		Kit.wedge(parent,"TaperedBeachShell",Vector3.new(.43,.19,.56),shell,C.Cream,{shadow=false})
		part(parent,"CoralShellRidge",Vector3.new(.055,.045,.48),shell*CFrame.new(0,.025,0)
			*CFrame.Angles(-math.atan2(.19,.56),0,0),C.Coral)
	end
	beam(parent,"BeachPennantPole",cf,Vector3.new(.88,0,.4),Vector3.new(.88,2.85,.4),.09,C.Wood)
	Kit.wedge(parent,"BlueBeachPennant",Vector3.new(.05,.62,.95),cf*CFrame.new(.88,2.4,-.1),C.Teal,{material=Enum.Material.Fabric,shadow=false})
	Kit.wedge(parent,"GoldPennantTip",Vector3.new(.06,.25,.31),cf*CFrame.new(.88,2.55,-.66),C.Gold,{material=Enum.Material.Fabric,shadow=false})
end

local function skyKeepsake(parent: Model, cf: CFrame)
	part(parent,"WeatherVaneFoot",Vector3.new(1.3,.23,1.3),cf*CFrame.new(0,.18,0),C.Stone,true)
	beam(parent,"WeatherVaneMast",cf,Vector3.new(0,.28,0),Vector3.new(0,3.8,0),.13,C.Brass)
	beam(parent,"WeatherVaneEastWest",cf,Vector3.new(-.88,2.53,0),Vector3.new(.88,2.53,0),.075,C.Brass)
	beam(parent,"WeatherVaneNorthSouth",cf,Vector3.new(0,2.53,-.85),Vector3.new(0,2.53,.85),.075,C.Brass)
	for _, x in {-.9,.9} do
		part(parent,"BlueDirectionTab",Vector3.new(.35,.29,.12),cf*CFrame.new(x,2.53,0),C.Teal)
	end
	part(parent,"StarVaneGoldCore",Vector3.new(.54,.54,.16),cf*CFrame.new(0,3.8,0)*CFrame.Angles(0,0,math.pi/4),C.Gold)
	part(parent,"StarVaneLongArms",Vector3.new(.2,1.04,.17),cf*CFrame.new(0,3.8,0),C.Gold)
	part(parent,"StarVaneCrossArms",Vector3.new(1.04,.2,.17),cf*CFrame.new(0,3.8,0),C.Gold)
end

function Details.populate(root: Instance)
	for index,dock in Layout.Docks do
		local model=Kit.model(root,dock.Id.."DockDetails")
		model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
		local basis=CFrame.new(table.unpack(dock.A))*CFrame.Angles(0,dock.Yaw,0)
		local edge=-dock.Width/2+1.35
		local accent=if dock.Id=="blossom" then C.Blossom elseif dock.Id=="cove" then C.Coral else C.Teal
		tackle(model,basis*CFrame.new(edge,0,-2.8),accent)
		bucket(model,basis*CFrame.new(edge-.15,0,-5.4),accent)
		rodRack(model,basis*CFrame.new(edge-.4,0,-8))
		local a,b=dock.A,dock.B
		local length=math.sqrt((a[1]-b[1])^2+(a[2]-b[2])^2+(a[3]-b[3])^2)
		railTrim(model,basis,dock.Width,length,index,LABELS[dock.Id])
		local keepsake=basis*CFrame.new(edge-.35,0,-16)
		if dock.Id=="harbor" then
			-- The hanger's .12-stud depth reaches the actual rail upright.
			lifeRing(model,basis*CFrame.new(-dock.Width/2+.13,0,-16)*CFrame.Angles(0,math.pi/2,0))
		elseif dock.Id=="blossom" then teaBreak(model,keepsake)
		elseif dock.Id=="forest" then forestKeepsake(model,keepsake)
		elseif dock.Id=="cove" then beachKeepsake(model,keepsake)
		else skyKeepsake(model,keepsake) end
	end
end

return Details
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000016">
      <Properties>
        <string name="Name">WorldTrailDetails</string>
        <ProtectedString name="Source">--!strict
-- Five small, authored rest stops beside the trails. These are scenery rather
-- than interaction points; the walking routes and their collisions stay clear.
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Layout = require(script.Parent:WaitForChild("WorldLayout"))
local C = Kit.palette
local Details = {}

local WOOD_PARTS = {
	BenchBackSupport = true, BenchTrestleFoot = true, BenchArmrest = true,
	PaintedPierDirection = true,
}
local PLANK_PARTS = { WornBenchSeat = true, BenchBackSlat = true }
local CLOTH_PARTS = { HarborGuideCover = true, GoldenGuideBookmark = true }

local function part(parent: Instance, cf: CFrame, name: string, size: Vector3, offset: Vector3, tint: Color3, tiny: boolean?): Part
	local material = if PLANK_PARTS[name] then Enum.Material.WoodPlanks
		elseif WOOD_PARTS[name] then Enum.Material.Wood
		elseif CLOTH_PARTS[name] then Enum.Material.Fabric
		elseif name == "CompassNorthNeedle" then Enum.Material.Metal
		else Enum.Material.SmoothPlastic
	return Kit.part(parent, name, size, cf * CFrame.new(offset), tint,
		{ material = material, shadow = tiny ~= true })
end

local function clearTrail(region: string, center: Vector3)
	-- The entire scene fits inside this radius, including the projecting sign.
	-- Keep it beyond the full authored path edge, not only its center line.
	for _, route in Layout.Paths do
		if route.Island ~= region then continue end
		for i = 1, #route.Points - 1 do
			local a, b = route.Points[i], route.Points[i + 1]
			local dx, dz = b[1] - a[1], b[3] - a[3]
			local t = math.clamp(((center.X-a[1])*dx+(center.Z-a[3])*dz)/(dx*dx+dz*dz), 0, 1)
			local distance = Vector2.new(center.X-a[1]-dx*t, center.Z-a[3]-dz*t).Magnitude
			assert(distance &gt;= route.Width/2 + 8.75, region .. " rest stop crosses its trail")
		end
	end
end

local function bench(parent: Instance, cf: CFrame)
	part(parent, cf, "WornBenchSeat", Vector3.new(7.6, .32, 2.1), Vector3.new(0, 1.68, 0), C.Plank)
	for _, y in {2.55, 3.16} do
		part(parent, cf, "BenchBackSlat", Vector3.new(7.6, .38, .2), Vector3.new(0, y, .83), C.Plank)
	end
	for _, side in {-1, 1} do
		-- Rear uprights meet both back slats and the cantilevered armrests.
		part(parent, cf, "BenchBackSupport", Vector3.new(.3, 3.35, .3), Vector3.new(side * 3.65, 1.675, .76), C.Wood)
		part(parent, cf, "BenchTrestleFoot", Vector3.new(.36, 1.52, 1.8), Vector3.new(side * 2.8, .76, 0), C.Bark)
	end
	for _, x in {-3.65, 3.65} do
		part(parent, cf, "BenchArmrest", Vector3.new(.35, .22, 2.2), Vector3.new(x, 2.22, 0), C.Wood)
	end
end

local function flowerpot(parent: Instance, cf: CFrame, x: number, accent: Color3)
	local base = cf * CFrame.new(x, 0, .45)
	local smooth = { material = Enum.Material.SmoothPlastic, shadow = false }
	Kit.disk(parent, "GlazedTrailFlowerpot", 1.65, 1.65, .74, (base*CFrame.new(0,.37,0)).Position, accent,
		{ material = Enum.Material.SmoothPlastic, reflectance = .025 })
	Kit.disk(parent, "FlowerpotSoil", 1.38, 1.38, .06, (base*CFrame.new(0,.75,0)).Position, C.Bark,
		{ material = Enum.Material.Ground, shadow = false })
	Kit.beam(parent, "FlowerStem", (base*CFrame.new(0,.77,0)).Position,
		(base*CFrame.new(0,1.91,0)).Position, .09, C.Moss, smooth)
	Kit.wedge(parent, "PointedPottedLeaf", Vector3.new(.08,.54,.9),
		base*CFrame.new(.25,1.2,.05)*CFrame.Angles(-.25,.6,math.pi/2),C.Leaf,smooth)
	for petal=0,2 do
		local rosette=base*CFrame.new(0,1.91,0)*CFrame.Angles(0,petal*math.pi*2/3,0)*CFrame.new(0,0,-.24)
		Kit.wedge(parent,"PottedRosettePetal",Vector3.new(.51,.1,.63),rosette,accent:Lerp(C.Cream,.22),smooth)
	end
	Kit.disk(parent, "PollenHeart", .24, .24, .12, (base*CFrame.new(0,2.01,0)).Position, C.Gold, smooth)
end

local function waymarker(parent: Instance, cf: CFrame, zone: string, title: string, accent: Color3)
	local direction = 1
	for _, dock in Layout.Docks do
		if dock.Id == zone then
			local toward = Vector3.new(dock.A[1], dock.A[2], dock.A[3]) - cf.Position
			direction = if cf.RightVector:Dot(toward) &gt;= 0 then 1 else -1
			break
		end
	end
	Kit.beam(parent,"TrailMarkerPost",(cf*CFrame.new(5.8,0,-1.25)).Position,
		(cf*CFrame.new(5.8,3.8,-1.25)).Position,.24,C.Bark,{ material=Enum.Material.Wood })
	local board = part(parent, cf, "PaintedPierDirection", Vector3.new(2.9, 1.15, .18), Vector3.new(5.8, 3.3, -1.25), accent)
	local brightBoard = zone == "blossom" or zone == "cove" or zone == "summit"
	local ink = if brightBoard then C.Iron:Lerp(Color3.new(0, 0, 0), .35) else C.Cream
	Kit.sign(board, title, "Follow the trail", ink)
	Kit.wedge(parent, "TrailArrowPoint", Vector3.new(.15, .75, .85),
		cf * CFrame.new(5.8 + direction * 1.85, 3.3, -1.25) * CFrame.Angles(0, -direction * math.pi/2, 0),
		accent, { material = Enum.Material.Wood, shadow = false })
end

local function motif(parent: Instance, cf: CFrame, zone: string)
	if zone == "harbor" then
		-- A little closed trail guide rests on the bench; it is not a fake button.
		part(parent, cf, "HarborGuidePages", Vector3.new(.86, .07, 1.03), Vector3.new(-1.8, 1.875, -.1), C.Cream, true)
		part(parent, cf, "HarborGuideCover", Vector3.new(.95, .055, 1.15), Vector3.new(-1.8, 1.936, -.1), C.Teal, true)
		part(parent, cf, "GoldenGuideBookmark", Vector3.new(.09, .025, .7), Vector3.new(-1.62, 1.976, -.1), C.Gold, true)
	elseif zone == "blossom" then
		for i = 1, 3 do
			local petal = part(parent, cf, "FallenTrailBlossom", Vector3.new(.82, .055, .48),
				Vector3.new((i-2)*1.2, .07, -1.8-(i%2)*.4), C.Blossom:Lerp(C.BlossomLight, i*.13), true)
			petal.CFrame *= CFrame.Angles(0, i*.65, 0)
		end
	elseif zone == "forest" then
		Kit.ball(parent,"FallenPinecone",Vector3.new(.6,.85,.58),(cf*CFrame.new(2.3,.43,-2.1)).Position,C.Bark,
			{material=Enum.Material.Wood,shadow=false})
		Kit.wedge(parent,"PineconeScale",Vector3.new(.58,.48,.55),
			cf*CFrame.new(2.3,.45,-2.1)*CFrame.Angles(.15,.7,.15),C.Wood,{material=Enum.Material.Wood,shadow=false})
	elseif zone == "cove" then
		for _, x in {-1.2, 1.2} do
			Kit.wedge(parent, "TideglassTrailShell", Vector3.new(.85, .3, 1.05),
				cf * CFrame.new(x, .18, -2.05) * CFrame.Angles(0, x*.7, 0), C.Cream,
				{ material = Enum.Material.Limestone, shadow = false })
		end
		Kit.ball(parent, "SmallTrailPearl", Vector3.one*.22, (cf*CFrame.new(-.45, .13, -1.75)).Position, C.Cloud, { shadow = false })
	else
		Kit.disk(parent,"LookoutCompassStone",2,2,.17,(cf*CFrame.new(1.8,.1,-2.1)).Position,C.Stone,
			{material=Enum.Material.Slate,shadow=false})
		local dial=CFrame.new((cf*CFrame.new(1.8,.21,-2.1)).Position)
		part(parent, dial, "CompassNorthNeedle", Vector3.new(.13, .04, 1.65), Vector3.zero, C.Gold, true)
		part(parent, dial, "CompassCrossNeedle", Vector3.new(1.65, .04, .13), Vector3.zero, C.Cream, true)
	end
end

function Details.populate(_root: Instance, regions: {[string]: Model})
	local stops = {
		{ id="harbor", name="HarborTrailRest", pos=Vector3.new(31,12,-13), yaw=math.pi/2, title="MAIN PIER", accent=C.Teal },
		{ id="blossom", name="PetalwindTrailRest", pos=Vector3.new(-260,28,11), yaw=-math.pi/2, title="GROVE PIER", accent=C.Blossom },
		{ id="forest", name="EvergreenTrailRest", pos=Vector3.new(248,24,-24), yaw=-math.pi/2, title="FOREST PIER", accent=C.Leaf },
		{ id="cove", name="TideglassTrailRest", pos=Vector3.new(-255,4,-196), yaw=math.pi/2, title="COVE PIER", accent=C.Coral },
		{ id="summit", name="StarfallTrailRest", pos=Vector3.new(269,60,-230), yaw=-math.pi/2, title="LOOKOUT PIER", accent=C.Gold },
	}
	for _, stop in stops do
		clearTrail(stop.id, stop.pos)
		local model = Kit.model(regions[stop.id], stop.name)
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		model:SetAttribute("TrailRegion", stop.id)
		local cf = CFrame.new(stop.pos) * CFrame.Angles(0, stop.yaw, 0)
		bench(model, cf)
		flowerpot(model, cf, -5.5, stop.accent)
		flowerpot(model, cf, 5.5, stop.accent)
		waymarker(model, cf, stop.id, stop.title, stop.accent)
		motif(model, cf, stop.id)
	end
end

return Details
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000017">
      <Properties>
        <string name="Name">WorldLayout</string>
        <ProtectedString name="Source">--!strict
-- Inset-free world coordinates. Heights are walking surfaces; water sits below decks.
local Layout = {}
Layout.Islands = {
	{ Id = "harbor", Name = "Sundrift Harbor", Center = {0, 12, 0}, Radius = {130, 105}, Seed = 14, Kind = "Harbor" },
	{ Id = "blossom", Name = "Petalwind Grove", Center = {-246, 28, 15}, Radius = {84, 79}, Seed = 21, Kind = "Blossom" },
	{ Id = "forest", Name = "Evergreen Reach", Center = {262, 24, -10}, Radius = {88, 92}, Seed = 35, Kind = "Forest" },
	{ Id = "cove", Name = "Tideglass Cove", Center = {-228, 4, -211}, Radius = {79, 77}, Seed = 46, Kind = "Cove" },
	{ Id = "summit", Name = "Starfall Lookout", Center = {252, 60, -244}, Radius = {72, 76}, Seed = 51, Kind = "Summit" },
}
Layout.Bridges = {
	{ Id = "petal_bridge", From = "harbor", To = "blossom", A = {-105, 12, 10}, B = {-183, 28, 12}, Width = 16 },
	{ Id = "evergreen_bridge", From = "harbor", To = "forest", A = {107, 12, 4}, B = {194, 24, -5}, Width = 16 },
	{ Id = "cove_bridge", From = "blossom", To = "cove", A = {-247, 28, -47}, B = {-232, 4, -150}, Width = 14 },
	{ Id = "summit_bridge", From = "forest", To = "summit", A = {264, 24, -83}, B = {253, 60, -189}, Width = 16 },
}
Layout.Waters = {
	{ Id = "harbor", Center = {0, 8, 166}, Radius = {65, 55} },
	{ Id = "blossom", Center = {-242, 24, 147}, Radius = {49, 47} },
	{ Id = "forest", Center = {270, 20, 144}, Radius = {48, 46} },
	{ Id = "cove", Center = {-355, 0, -211}, Radius = {48, 45} },
	{ Id = "summit", Center = {367, 56, -244}, Radius = {46, 47} },
}
Layout.Docks = {
	{ Id = "harbor", A = {0, 12, 88}, B = {0, 12, 135}, Width = 23, Spot = {0, 12.1, 126}, Yaw = math.pi },
	{ Id = "blossom", A = {-242, 28, 77}, B = {-242, 28, 123}, Width = 17, Spot = {-242, 28.1, 115}, Yaw = math.pi },
	{ Id = "forest", A = {270, 24, 69}, B = {270, 24, 119}, Width = 18, Spot = {270, 24.1, 111}, Yaw = math.pi },
	{ Id = "cove", A = {-289, 4, -211}, B = {-333, 4, -211}, Width = 18, Spot = {-325, 4.1, -211}, Yaw = math.pi / 2 },
	{ Id = "summit", A = {310, 60, -244}, B = {345, 60, -244}, Width = 17, Spot = {337, 60.1, -244}, Yaw = -math.pi / 2 },
}
Layout.Paths = {
	{ Island = "harbor", Width = 13, Points = {{0,12,-62},{5,12,-40},{4,12,-25},{4,12,3},{0,12,29},{7,12,52},{0,12,72},{0,12,90}} },
	{ Island = "harbor", Width = 11, Points = {{-106,12,10},{-77,12,9},{-36,12,7},{0,12,4},{34,12,4},{68,12,0},{108,12,4}} },
	{ Island = "harbor", Width = 8, Points = {{0,12,-30},{-20,12,-47},{-37,12,-73},{-48,12,-69}} },
	{ Island = "harbor", Width = 6, Points = {{0,12,80},{-8,12,78},{-16,12,80}} },
	{ Island = "blossom", Width = 10, Points = {{-182,28,12},{-218,28,8},{-246,28,15},{-242,28,45},{-242,28,79}} },
	{ Island = "blossom", Width = 9, Points = {{-246,28,15},{-247,28,-16},{-247,28,-48}} },
	{ Island = "forest", Width = 10, Points = {{193,24,-5},{224,24,-5},{264,24,-8},{270,24,30},{270,24,70}} },
	{ Island = "forest", Width = 10, Points = {{264,24,-8},{264,24,-44},{264,24,-84}} },
	{ Island = "cove", Width = 10, Points = {{-232,4,-149},{-229,4,-181},{-236,4,-211},{-266,4,-211},{-290,4,-211}} },
	{ Island = "summit", Width = 10, Points = {{253,60,-188},{253,60,-216},{253,60,-244},{286,60,-244},{311,60,-244}} },
}
-- The play loop starts beside the water; the town remains optional exploration.
Layout.Spawn = {0, 12, 104}
Layout.WalkSpeed = 22
Layout.RodStand = {-20, 12, 82}

function Layout.outline(island: any): {{ number }}
	local points = {}
	for i = 1, 20 do
		local a = (i - 1) * math.pi / 10
		local variation = 1 + math.sin(a * 3 + island.Seed) * 0.055 + math.cos(a * 5 + island.Seed) * 0.025
		table.insert(points, {island.Center[1] + math.cos(a) * island.Radius[1] * variation,
			island.Center[2], island.Center[3] + math.sin(a) * island.Radius[2] * variation})
	end
	return points
end
-- Keep a level landing over each coast. The rise occurs over open air, so a
-- sloping boardwalk cannot disappear under the higher island's solid floor.
function Layout.bridgePoints(bridge: any): {{number}}
	local from, to = nil, nil
	for _, data in Layout.Islands do
		if data.Id==bridge.From then from=data end
		if data.Id==bridge.To then to=data end
	end
	assert(from and to,"Bridge references missing islands")
	local function contains(polygon: {{number}},x: number,z: number): boolean
		local inside=false
		for i,a in polygon do
			local b=polygon[i%#polygon+1]
			if (a[3]&gt;z)~=(b[3]&gt;z) and x&lt;(b[1]-a[1])*(z-a[3])/(b[3]-a[3])+a[1] then inside=not inside end
		end
		return inside
	end
	local a,b=bridge.A,bridge.B
	local dx,dz=b[1]-a[1],b[3]-a[3]
	local distance=math.sqrt(dx*dx+dz*dz)
	local lastFrom,firstTo=0,1
	local fromPoly,toPoly=Layout.outline(from),Layout.outline(to)
	for i=0,400 do
		local t=i/400
		for _,offset in {-bridge.Width/2,0,bridge.Width/2} do
			local x,z=a[1]+dx*t-dz/distance*offset,a[3]+dz*t+dx/distance*offset
			if contains(fromPoly,x,z) then lastFrom=math.max(lastFrom,t) end
			if contains(toPoly,x,z) then firstTo=math.min(firstTo,t) end
		end
	end
	local start=lastFrom+2/distance
	local finish=firstTo-2/distance
	assert(start&lt;finish,"Bridge needs an open span between its islands")
	return {a,{a[1]+dx*start,a[2],a[3]+dz*start},{a[1]+dx*finish,b[2],a[3]+dz*finish},b}
end
return Layout
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000018">
      <Properties>
        <string name="Name">IslandTravel</string>
        <ProtectedString name="Source">--!strict
-- Free travel inside this experience. Clients select an ID; the server owns every position.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Rules = require(Shared:WaitForChild("IslandTravelRules"))
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Layout = require(script.Parent:WaitForChild("WorldLayout"))
local Travel = {}
local startedWorld: Instance? = nil
local BLUE = Color3.fromRGB(62, 128, 158)
local GOLD = Color3.fromRGB(185, 159, 83)
local CREAM = Color3.fromRGB(207, 203, 176)
local INK = Color3.fromRGB(43, 65, 78)
local STONE = Color3.fromRGB(91, 114, 125)

local function spotBasis(dock: any): CFrame
	return CFrame.new(table.unpack(dock.Spot)) * CFrame.Angles(0, dock.Yaw, 0)
end

function Travel.create(world: Instance): Folder
	local existing = world:FindFirstChild("IslandTravelStations")
	if existing and existing:IsA("Folder") then return existing end
	local stations = Instance.new("Folder")
	stations.Name = "IslandTravelStations"
	-- Persistent plates cover the whole side bay: arriving players always have a
	-- floor even while an Atomic portal and its neighboring pier finish streaming.
	local supports = Instance.new("Model")
	supports.Name, supports.ModelStreamingMode = "TravelArrivalSupports", Enum.ModelStreamingMode.Persistent
	for _, dock in Layout.Docks do
		local basis = spotBasis(dock)
		local bayX = dock.Width / 2 + 4.5
		local gate = basis * CFrame.new(bayX, 0, 8) * CFrame.Angles(0, math.pi / 2, 0)
		Kit.part(supports, dock.Id .. "ArrivalFloor", Vector3.new(13, 0.2, 12),
			basis * CFrame.new(bayX, -0.2, 8), CREAM,
			{ collidable = true, transparency = 1, shadow = false })
		local station = Instance.new("Model")
		station.Name, station.ModelStreamingMode = dock.Id, Enum.ModelStreamingMode.Atomic
		station:SetAttribute("TravelSourceId", dock.Id)
		-- The entry plane and landing are authored once and consumed by the server.
		-- The landing faces back toward the pier, clear of the entry volume.
		station:SetAttribute("PortalEntryCFrame", gate * CFrame.new(0, 3.3, 0))
		station:SetAttribute("TravelArrivalCFrame", basis * CFrame.new(dock.Width / 2 + 0.5, 3.3, 5.4)
			* CFrame.Angles(0, math.pi / 2, 0))
		local function block(name: string, size: Vector3, x: number, y: number, z: number, color: Color3, options: any?): Part
			return Kit.part(station, name, size, gate * CFrame.new(x, y, z), color, options)
		end
		-- Muted framing and transparent color identify a portal without a bright
		-- light source, neon surface, flash, or effects obscuring the fishing view.
		block("PortalBayDeck", Vector3.new(12, 0.16, 13), 0, -0.18, 0, CREAM, { material = Enum.Material.WoodPlanks })
		for _, side in { -1, 1 } do
			block("PortalStoneFoot", Vector3.new(1.6, 0.65, 2.1), side * 4.1, 0.225, 0, STONE, { material = Enum.Material.Limestone })
			block("PortalUpright", Vector3.new(1, 8.9, 1.2), side * 4.1, 4.45, 0, STONE, { material = Enum.Material.Limestone })
			block("PortalInsetStripe", Vector3.new(0.16, 7.3, 0.12), side * 3.53, 4.6, -0.67, BLUE)
			for _, height in { 1.1, 8.4 } do
				block("PortalBrassCollar", Vector3.new(1.15, 0.22, 1.34), side * 4.1, height, 0, GOLD)
			end
			block("PortalThresholdMarker", Vector3.new(0.4, 0.04, 2.4), side * 2.5, -0.075, -2.6, BLUE)
		end
		block("PortalLintel", Vector3.new(9.6, 1.1, 1.5), 0, 9.25, 0, STONE, { material = Enum.Material.Limestone })
		block("PortalCrown", Vector3.new(6.2, 0.25, 1.65), 0, 9.94, 0, GOLD)
		block("PortalVeil", Vector3.new(6.8, 8.6, 0.08), 0, 4.3, 0, BLUE,
			{ transparency = 0.83, shadow = false })
		local header = block("PortalHeader", Vector3.new(6.8, 1.1, 0.16), 0, 9.27, -0.84, CREAM)
		Kit.sign(header, "POND PORTAL", "STEP IN  /  FREE TRAVEL", INK)
		-- A slow segmented orbit reuses the existing distance-limited scenery
		-- animator; it has no collision, sound, lighting, or per-frame world scan.
		local orbit = Kit.model(station, "PortalOrbit")
		local orbitOrigin = gate * CFrame.new(0, 4.6, -0.12)
		orbit.WorldPivot = orbitOrigin
		for index = 0, 11 do
			local angle = index * math.pi / 6
			local cf = orbitOrigin * CFrame.Angles(0, 0, angle) * CFrame.new(0, 3.05, 0)
			Kit.part(orbit, "OrbitRune", Vector3.new(0.63, 0.15, 0.12), cf,
				if index % 3 == 0 then GOLD else BLUE, { transparency = 0.25, shadow = false })
		end
		orbit:SetAttribute("SpinOrigin", orbitOrigin)
		orbit:SetAttribute("SpinRate", 0.18)
		-- The pedestal is beyond the edge of the ordinary casting corridor.
		local pedestal = basis * CFrame.new(bayX, 0, 12.5) * CFrame.Angles(0, math.pi / 2, 0)
		Kit.part(station, "PortalPedestalBase", Vector3.new(1.5, 0.35, 1.5), pedestal * CFrame.new(0, 0.075, 0), STONE)
		Kit.part(station, "PortalPedestalStem", Vector3.new(0.8, 1.9, 0.8), pedestal * CFrame.new(0, 1.1, 0), STONE)
		local body = Kit.part(station, "PortalSelector", Vector3.new(1.9, 0.6, 1.3),
			pedestal * CFrame.new(0, 2.4, 0), BLUE)
		Kit.part(station, "PortalSelectorInset", Vector3.new(1.5, 0.08, 0.9), pedestal * CFrame.new(0, 2.74, 0), CREAM)
		for index = -1, 1 do
			Kit.part(station, "PortalDestinationKey", Vector3.new(0.22, 0.09, 0.35),
				pedestal * CFrame.new(index * 0.4, 2.82, 0), GOLD)
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name, prompt.ActionText, prompt.ObjectText = "IslandTravelPrompt", "Choose a pond", "Pond portal · Free travel"
		prompt.KeyboardKeyCode, prompt.GamepadKeyCode = Enum.KeyCode.E, Enum.KeyCode.ButtonX
		prompt.HoldDuration, prompt.MaxActivationDistance, prompt.RequiresLineOfSight = 0, 5, false
		prompt.Parent, station.PrimaryPart = body, body
		station.Parent = stations
	end
	supports.Parent, stations.Parent = world, world
	return stations
end

local function livingCharacter(player: Player): (Model?, BasePart?)
	local character = player.Character
	if not character then return nil, nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health &gt; 0 and root and root:IsA("BasePart") and not root.Anchored then
		return character, root
	end
	return nil, nil
end

function Travel.start(world: Instance, beforeTravel: ((Player) -&gt; boolean)?, galleryArrival: ((Player) -&gt; CFrame?)?)
	if startedWorld == world then return end
	assert(startedWorld == nil, "Install one island travel server only")
	startedWorld = world
	local stations = Travel.create(world)
	assert(not ReplicatedStorage:FindFirstChild("FishingTravelRemotes"), "Install one island travel server only")
	local remotes = Instance.new("Folder")
	remotes.Name = "FishingTravelRemotes"
	local event = Instance.new("RemoteEvent")
	event.Name, event.Parent = "Travel", remotes
	local state = Rules.new()
	local lastPacket: { [number]: number } = {}
	local lastGallery: { [number]: number } = {}
	local galleryPending: { [number]: {} } = {}
	local sources: { [string]: BasePart } = {}
	local destinations: { [string]: CFrame } = {}
	local entries: { [string]: CFrame } = {}
	local entryState: { [number]: { character: Model, source: string?, opened: boolean } } = {}
	local function distanceFrom(player: Player, source: string): number
		local _, root = livingCharacter(player)
		local stand = sources[source]
		return if root and stand and stand:IsDescendantOf(world) then (root.Position - stand.Position).Magnitude else math.huge
	end
	local function respond(player: Player, status: string, message: string?)
		if player.Parent == Players then event:FireClient(player, status, message) end
	end
	local function openPortal(player: Player, source: string): boolean
		if player.Parent == Players and player:GetAttribute("IslandTravelBusy") ~= true and world:IsDescendantOf(workspace)
			and state:open(player.UserId, source, os.clock(), distanceFrom(player, source)) then
			event:FireClient(player, "Open", source)
			return true
		end
		return false
	end
	for _, station in stations:GetChildren() do
		if not station:IsA("Model") then continue end
		local source = station:GetAttribute("TravelSourceId")
		local stand = station.PrimaryPart
		local prompt = station:FindFirstChild("IslandTravelPrompt", true)
		if type(source) ~= "string" or not stand or not prompt or not prompt:IsA("ProximityPrompt") then continue end
		local arrival, entry = station:GetAttribute("TravelArrivalCFrame"), station:GetAttribute("PortalEntryCFrame")
		if typeof(arrival) ~= "CFrame" or typeof(entry) ~= "CFrame" then continue end
		sources[source], destinations[source], entries[source] = stand, arrival, entry
		prompt.Triggered:Connect(function(player) openPortal(player, source) end)
	end
	local elapsed = 0
	RunService.Heartbeat:Connect(function(deltaTime: number)
		elapsed += deltaTime
		if elapsed &lt; 0.1 then return end
		elapsed %= 0.1
		if not world:IsDescendantOf(workspace) then return end
		for _, player in Players:GetPlayers() do
			local character, root = livingCharacter(player)
			if not character or not root then entryState[player.UserId] = nil; continue end
			local inside: string? = nil
			for source, entry in entries do
				local point = entry:PointToObjectSpace(root.Position)
				if math.abs(point.X) &lt;= 3 and math.abs(point.Y) &lt;= 3.5 and math.abs(point.Z) &lt;= 1.3 then
					inside = source
					break
				end
			end
			local previous = entryState[player.UserId]
			local opened = previous ~= nil and previous.character == character and previous.source == inside and previous.opened
			-- A quick return can reach the gate during the short request cooldown.
			-- Retry until its first successful open; after that, closing the menu
			-- while standing inside never reopens it. Leaving or respawning resets.
			if inside and not opened then opened = openPortal(player, inside) end
			entryState[player.UserId] = { character = character, source = inside, opened = opened }
		end
	end)
	local function performTravel(
		player: Player, character: Model, root: BasePart, target: CFrame,
		stillPending: () -&gt; boolean, nearSource: () -&gt; boolean, finish: () -&gt; boolean, gallery: boolean
	)
		player:SetAttribute("IslandTravelBusy", true)
		local function complete()
			if finish() and player.Parent == Players then player:SetAttribute("IslandTravelBusy", false) end
		end
		if beforeTravel then
			local callbackOk, permitted = pcall(beforeTravel, player)
			if not callbackOk or permitted ~= true then
				complete()
				respond(player, "Rejected", "Your character is not ready to travel. Please try again in a moment.")
				return
			end
		end
		respond(player, "Loading", if gallery then "Getting your aquarium ready..." else "Getting your next pond ready...")
		task.spawn(function()
			-- Streaming may yield. A departed, replaced or dead avatar is never moved.
			local ok = pcall(function() player:RequestStreamAroundAsync(target.Position, 3) end)
			local currentCharacter, currentRoot = livingCharacter(player)
			local valid = ok and player.Parent == Players and stillPending()
				and character == currentCharacter and root == currentRoot and world:IsDescendantOf(workspace)
				and nearSource()
			if valid then
				local success = pcall(function()
					local lane = if gallery then 0 else (player.UserId % 3 - 1) * 0.8
					local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid
					local clearance = math.max(3.3, humanoid.HipHeight + root.Size.Y * 0.5 + 0.3)
					local desiredRoot = target * CFrame.new(lane, clearance - 3.3, 0)
					-- Custom character pivots need not coincide with their root part.
					character:PivotTo(desiredRoot * root.CFrame:ToObjectSpace(character:GetPivot()))
					root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
				end)
				if success then respond(player, "Arrived", if gallery then "Your collection is on display!" else "Ready to fish!")
				else respond(player, "Rejected", "Travel could not finish. Please try again.") end
			else respond(player, "Rejected", "Travel cancelled. Stay still and try again.") end
			complete()
		end)
	end
	event.OnServerEvent:Connect(function(player: Player, destination: any)
		local now = os.clock()
		local previous = lastPacket[player.UserId]
		if previous and now - previous &lt; 0.15 then return end
		lastPacket[player.UserId] = now
		if player.Parent ~= Players or not world:IsDescendantOf(workspace) or player:GetAttribute("IslandTravelBusy") == true then return end
		if destination == "gallery" then
			-- An explicit gallery shortcut is allowed anywhere. Its callback owns
			-- the player's plot and landing; no client coordinates are accepted.
			local character, root = livingCharacter(player)
			local previousGallery = lastGallery[player.UserId]
			if not galleryArrival or not character or not root or (previousGallery and now - previousGallery &lt; 1.5) then
				respond(player, "Rejected", "Your aquarium is not ready yet. Please try again in a moment.")
				return
			end
			local ok, target = pcall(galleryArrival, player)
			if not ok or typeof(target) ~= "CFrame" then
				respond(player, "Rejected", "Your aquarium is not ready yet. Please try again in a moment.")
				return
			end
			local ticket, source = {}, root.Position
			galleryPending[player.UserId], lastGallery[player.UserId] = ticket, now
			performTravel(player, character, root, target, function()
				return galleryPending[player.UserId] == ticket
			end, function()
				return (root.Position - source).Magnitude &lt;= Rules.MaxDistance
			end, function()
				if galleryPending[player.UserId] ~= ticket then return false end
				galleryPending[player.UserId] = nil
				return true
			end, true)
			return
		end
		local source = state:source(player.UserId)
		if not source or player.Parent ~= Players or not world:IsDescendantOf(workspace) then return end
		local ticket = state:take(player.UserId, destination, now, distanceFrom(player, source))
		if not ticket then respond(player, "Rejected", "Step closer to the portal and try again."); return end
		local character, root = livingCharacter(player)
		local target = destinations[ticket.destination]
		if not character or not root or not target then state:finish(player.UserId, ticket); return end
		performTravel(player, character, root, target, function()
			return state:isPending(player.UserId, ticket)
		end, function()
			return distanceFrom(player, ticket.source) &lt;= Rules.MaxDistance
		end, function()
			return state:finish(player.UserId, ticket)
		end, false)
	end)
	Players.PlayerRemoving:Connect(function(player)
		state:remove(player.UserId)
		lastPacket[player.UserId], entryState[player.UserId] = nil, nil
		lastGallery[player.UserId], galleryPending[player.UserId] = nil, nil
	end)
	remotes.Parent = ReplicatedStorage
end

return Travel
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000019">
      <Properties>
        <string name="Name">AquariumService</string>
        <ProtectedString name="Source">--!strict
-- Public player-owned displays. Progression and saving remain in FishingService;
-- this adapter only builds the presentation of already validated selections.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Catalog = require(Shared:WaitForChild("FishCatalog"))
local Fish = require(Shared:WaitForChild("FishModel"))
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Aquarium = {}
local C = Kit.palette
local COLUMNS, TILE_WIDTH, TILE_DEPTH = 3, 28, 24
local FIRST_X, FIRST_Z, GROUND = -92, 88, 12
local SURFACES = {
	DisplayPedestal=Enum.Material.Wood, PaintedTankBack=Enum.Material.Wood,
	AquariumSandBed=Enum.Material.Sand, OwnerPlaque=Enum.Material.Wood,
	GalleryNameboard=Enum.Material.Wood, AquariumEditor=Enum.Material.Wood,
	TinyGardenBridge=Enum.Material.Wood, GardenBridgeFoot=Enum.Material.Wood,
	SunkenObservatoryColumn=Enum.Material.Limestone, SunkenObservatoryLintel=Enum.Material.Limestone,
	StarChartTile=Enum.Material.Slate, LittleLagoonArch=Enum.Material.Slate,
	LittleLagoonArchTop=Enum.Material.Slate,
}

local function styleData(id: any): any
	for _, style in Catalog.AquariumStyles do if style.Id == id then return style end end
	return Catalog.AquariumStyles[1]
end

local function rgb(value: {number}): Color3
	return Color3.fromRGB(table.unpack(value))
end

local function variantFor(profile: any, id: string): string
	local variants = if profile.variants then profile.variants[id] else nil
	if variants and variants.Prismatic then return "Prismatic" end
	if variants and variants.Golden then return "Golden" end
	return "Normal"
end

function Aquarium.start(world: Instance, callbacks: any)
	assert(not world:FindFirstChild("AquariumGallery"), "Install one aquarium gallery only")
	local gallery = Instance.new("Folder")
	gallery.Name, gallery.Parent = "AquariumGallery", world
	-- Only the thin walking plates persist, not glass, cases, plants or fish.
	local floors = Instance.new("Model")
	floors.Name, floors.ModelStreamingMode, floors.Parent = "GallerySafetyFloors", Enum.ModelStreamingMode.Persistent, gallery
	local scenery = Instance.new("Folder")
	scenery.Name, scenery.Parent = "GalleryArchitecture", gallery
	local rowCount = 0
	local plots: {[number]: any} = {}
	local occupied: {[number]: number} = {}
	local function floor(name: string, size: Vector3, position: Vector3)
		Kit.part(floors, name, size, CFrame.new(position), C.Plank,
			{collidable=true, transparency=1, shadow=false})
	end
	local decking = { material = Enum.Material.WoodPlanks }
	local timber = { material = Enum.Material.Wood }
	-- Broad level access from existing harbor ground; clear of the main fishing route.
	floor("GalleryAccessSafetyFloor", Vector3.new(36,.4,14), Vector3.new(-66,GROUND-.2,80))
	Kit.part(scenery,"GalleryAccessDeck",Vector3.new(36,.16,14),CFrame.new(-66,GROUND-.1,80),C.Plank,decking)
	for _, side in {-1,1} do
		Kit.part(scenery,"AccessEdge",Vector3.new(36,.65,.35),CFrame.new(-66,GROUND-.3,80+side*6.8),C.Wood,timber)
		-- A support meets each fascia directly; no decorative brace hangs free.
		Kit.beam(scenery,"GalleryAccessPile",Vector3.new(-82,GROUND-5.4,80+side*6.8),
			Vector3.new(-82,GROUND-.4,80+side*6.8),.55,C.Wood,timber)
	end
	local sign = Kit.part(scenery,"GalleryWelcome",Vector3.new(15,3,.3),CFrame.new(-82,GROUND+5,71.5),C.Cream,timber)
	Kit.sign(sign,"THE AQUARIUM WALK","YOUR FISH. YOUR LITTLE WORLD.",C.Iron)
	for _, side in {-1,1} do
		Kit.beam(scenery,"GalleryWelcomePost",Vector3.new(-82+side*6.8,GROUND,71.7),
			Vector3.new(-82+side*6.8,GROUND+6.15,71.7),.3,C.Wood,timber)
	end
	gallery:SetAttribute("GalleryArrivalCFrame",CFrame.new(-82,GROUND+3.3,80)*CFrame.Angles(0,-math.pi/2,0))
	local function ensureRow(row: number)
		while rowCount &lt;= row do
			local index = rowCount
			local centerZ = FIRST_Z + index*TILE_DEPTH
			floor("GalleryRow"..index,Vector3.new(COLUMNS*TILE_WIDTH,.4,TILE_DEPTH),Vector3.new(FIRST_X-TILE_WIDTH,GROUND-.2,centerZ))
			local deck=Kit.model(scenery,"GalleryRow"..index)
			deck.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
			for column=0,COLUMNS-1 do
				local x=FIRST_X-column*TILE_WIDTH
				-- Broad native plank surfaces supply grain and seams without adding a
				-- separate Part for every board. The lighter half is the walking lane.
				Kit.part(deck,"GalleryPromenadeDeck",Vector3.new(TILE_WIDTH,.16,TILE_DEPTH/2),
					CFrame.new(x,GROUND-.1,centerZ-TILE_DEPTH/4),C.Plank,decking)
				Kit.part(deck,"GalleryDisplayApron",Vector3.new(TILE_WIDTH,.16,TILE_DEPTH/2),
					CFrame.new(x,GROUND-.1,centerZ+TILE_DEPTH/4),C.Plank:Lerp(C.Wood,.23),decking)
				Kit.beam(deck,"GalleryTimberPile",Vector3.new(x,GROUND-7.4,centerZ+6),
					Vector3.new(x,GROUND-.4,centerZ+6),.65,C.Wood,timber)
			end
			-- Low outer curbs mark the edge without a wall across the promenade.
			for _, x in {FIRST_X+TILE_WIDTH/2-.2,FIRST_X-(COLUMNS-.5)*TILE_WIDTH+.2} do
				Kit.part(deck,"GalleryOuterCurb",Vector3.new(.4,.3,TILE_DEPTH),CFrame.new(x,GROUND+.05,centerZ),C.Wood,timber)
			end
			for _, side in {-1,1} do
				Kit.part(deck,"GalleryRowFascia",Vector3.new(COLUMNS*TILE_WIDTH,.6,.35),
					CFrame.new(FIRST_X-TILE_WIDTH,GROUND-.28,centerZ+side*(TILE_DEPTH/2-.18)),C.Wood,timber)
			end
			Kit.part(deck,"GalleryUnderdeckBearer",Vector3.new(COLUMNS*TILE_WIDTH,.6,.7),
				CFrame.new(FIRST_X-TILE_WIDTH,GROUND-.7,centerZ+6),C.Wood,timber)
			rowCount+=1
		end
	end
	ensureRow(0)
	local function createPlot(player: Player): any
		local index=1
		while occupied[index] do index+=1 end
		occupied[index]=player.UserId
		local row=math.floor((index-1)/COLUMNS)
		local column=(index-1)%COLUMNS
		ensureRow(row)
		local origin=CFrame.new(FIRST_X-column*TILE_WIDTH,GROUND,FIRST_Z+row*TILE_DEPTH)
		local plot={index=index,origin=origin,model=nil,signature=""}
		plots[player.UserId]=plot
		return plot
	end
	local function update(player: Player, profile: any)
		if player.Parent~=Players or not profile then return end
		local plot=plots[player.UserId] or createPlot(player)
		local style=styleData(profile.equippedStyle)
		local pieces={style.Id,player.DisplayName}
		for slot=1,3 do
			local id=profile.display and profile.display[slot] or ""
			table.insert(pieces,id..":"..variantFor(profile,id)..":"..tostring(profile.records and profile.records[id] or 0))
		end
		local signature=table.concat(pieces,"|")
		if signature==plot.signature then return end
		local old=plot.model
		local model=Instance.new("Model")
		model.Name="Aquarium_"..player.UserId
		model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
		model:SetAttribute("OwnerUserId",player.UserId)
		model:SetAttribute("AquariumPlot",true)
		local base,trim,accent=rgb(style.Colors.Base),rgb(style.Colors.Trim),rgb(style.Colors.Accent)
		local cf=plot.origin
		local function part(name: string,size: Vector3,x: number,y: number,z: number,color: Color3,options: any?): Part
			local finish=table.clone(options or {})
			if not finish.material then finish.material=SURFACES[name] end
			return Kit.part(model,name,size,cf*CFrame.new(x,y,z),color,finish)
		end
		-- An elliptical-ended plinth, round mullions and an open arched crown
		-- make a glass exhibit rather than a pile of solid rectangular blocks.
		part("DisplayPedestal",Vector3.new(16.4,1.4,9),0,.7,5,base)
		for _,x in {-8.2,8.2} do
			Kit.disk(model,"RoundedPedestalEnd",2.6,9,1.4,(cf*CFrame.new(x,.7,5)).Position,base,{material=Enum.Material.Wood})
		end
		part("TankSafetyCollider",Vector3.new(19,8.6,9),0,4.3,5,base,{collidable=true,transparency=1,shadow=false})
		part("AquariumSandBed",Vector3.new(17.5,.3,7.5),0,1.55,5,C.Sand)
		part("PaintedTankBack",Vector3.new(18,7.1,.22),0,5,8.9,base)
		part("TankWater",Vector3.new(17.7,6.5,7.6),0,4.8,5,accent,{transparency=.94,shadow=false})
		for _,x in {-9,9} do
			for _,z in {1.05,8.95} do
				Kit.beam(model,"RoundTankMullion",cf*Vector3.new(x,1.35,z),cf*Vector3.new(x,8.65,z),.25,trim,{material=Enum.Material.Metal})
			end
			part("TankSideGlass",Vector3.new(.12,6.8,7.7),x,4.9,5,accent,{material=Enum.Material.Glass,transparency=.87,shadow=false})
		end
		for _,y in {1.4,8.6} do
			for _,z in {1.05,8.95} do
				Kit.beam(model,"OpenTankFrame",cf*Vector3.new(-9,y,z),cf*Vector3.new(9,y,z),.24,trim,{material=Enum.Material.Metal})
			end
			for _,x in {-9,9} do
				Kit.beam(model,"OpenTankFrame",cf*Vector3.new(x,y,1.05),cf*Vector3.new(x,y,8.95),.24,trim,{material=Enum.Material.Metal})
			end
		end
		local arch={{-9,8.6},{-5,9.18},{0,9.45},{5,9.18},{9,8.6}}
		for _,z in {1.05,8.95} do
			for index=1,#arch-1 do
				local a,b=arch[index],arch[index+1]
				Kit.beam(model,"ArchedExhibitCrown",cf*Vector3.new(a[1],a[2],z),cf*Vector3.new(b[1],b[2],z),.17,trim,{material=Enum.Material.Metal})
			end
		end
		part("TankFrontGlass",Vector3.new(17.8,6.8,.1),0,4.9,1.06,accent,{material=Enum.Material.Glass,transparency=.91,shadow=false})
		for index=-1,1 do
			local x=index*5.8
			Kit.wedge(model,"AquariumRock",Vector3.new(1.4,.65,1.3),cf*CFrame.new(x,1.95,7.3)*CFrame.Angles(0,index*.6,0),C.Stone,{material=Enum.Material.Slate})
			for branch=0,2 do
				Kit.wedge(model,"AquariumSeagrass",Vector3.new(.08,1.1+branch*.25,.38),
					cf*CFrame.new(x+.4+branch*.28,2.2+branch*.125,7.2)*CFrame.Angles(0,branch*.7,(branch-1)*.18),accent,{shadow=false})
			end
		end
		-- Themes change the little habitat as well as its frame color. All pieces
		-- remain below the swimming lane, so decorations never hide a favorite fish.
		if style.Id=="blossom" then
			Kit.beam(model,"MiniatureBonsaiTrunk",cf*Vector3.new(-3.2,1.6,7),cf*Vector3.new(-3.05,2.85,7),.24,trim,{material=Enum.Material.Wood})
			for index=-1,1 do
				local crown=cf*CFrame.new(-3.2+index*.58,2.95-math.abs(index)*.2,7)*CFrame.Angles(0,index*.5,0)
				for _,side in {-1,1} do
					Kit.wedge(model,"MiniatureBlossomLeaf",Vector3.new(1.18,.4,.62),crown*CFrame.new(0,0,side*.25)*CFrame.Angles(0,if side==1 then math.pi else 0,0),accent)
				end
			end
			part("TinyGardenBridge",Vector3.new(2.5,.2,.8),3.1,2.4,7,trim)
			for _,x in {2.1,4.1} do part("GardenBridgeFoot",Vector3.new(.28,.65,.65),x,2.02,7,base) end
		elseif style.Id=="observatory" then
			for _,x in {-3.9,-2.5} do
				part("SunkenObservatoryColumn",Vector3.new(.36,1.15,.45),x,2.2,7,trim)
			end
			part("SunkenObservatoryLintel",Vector3.new(2.2,.35,.7),-3.2,2.95,7,trim)
			for index=-1,1 do
				part("StarChartTile",Vector3.new(.55,.12,.55),3.1+index*.65,1.85,6.8+math.abs(index)*.3,trim)
			end
		elseif style.Id=="coral" then
			for index=-1,1 do
				local x=index*3.2
				Kit.beam(model,"CoralStem",cf*Vector3.new(x,1.65,6.9),cf*Vector3.new(x,2.75,6.9),.2,accent)
				for side=-1,1,2 do
					Kit.beam(model,"CoralBranch",cf*Vector3.new(x,2.1,6.9),cf*Vector3.new(x+side*.5,2.85,6.9),.15,trim)
				end
			end
		else
			for _,x in {-3.9,-2.5} do part("LittleLagoonArch",Vector3.new(.45,.85,.7),x,2,7,C.Stone) end
			part("LittleLagoonArchTop",Vector3.new(2,.35,.8),-3.2,2.65,7,C.Stone)
		end
		local plaque=part("OwnerPlaque",Vector3.new(18,1.25,.2),0,.75,.37,C.Cream)
		Kit.sign(plaque,player.DisplayName.."'s Aquarium",style.Name.."  /  COLLECTED WITH CARE",C.Iron)
		local top=part("GalleryNameboard",Vector3.new(17,1.5,.2),0,10,6.5,base)
		Kit.sign(top,player.DisplayName.."'s collection","THREE FAVORITES FROM FIVE ISLANDS",C.Cream)
		local fishCount=0
		for slot=1,3 do
			local id=profile.display and profile.display[slot]
			if type(id)=="string" and profile.best and profile.best[id] then
				local species=Catalog.get(id)
				if species.Id==id then
					fishCount+=1
					local fish=Fish.create(model,"AquariumFish_"..slot,id)
					local variant=variantFor(profile,id)
					local weight=profile.records and profile.records[id]
					if Fish.applyAppearance then Fish.applyAppearance(fish,variant,weight,.82) end
					local swim=cf*CFrame.new((slot-2)*5.5,4.5+(slot%2)*.4,5)*CFrame.Angles(0,.65+(slot-2)*.15,0)
					fish:PivotTo(swim)
					fish:SetAttribute("AquariumSwimOrigin",swim)
					fish:SetAttribute("AquariumSwimPhase",slot*2.1+plot.index)
					local label=part("FishPlaque",Vector3.new(5.4,.8,.12),(slot-2)*5.8,1.8,.8,C.Cream)
					local description=(if variant~="Normal" then variant.."  /  " else "")..(if weight then string.format("BEST %.2f kg",weight) else species.Rarity)
					Kit.sign(label,species.Name,description,C.Iron)
				end
			end
		end
		if fishCount==0 then
			local welcome=part("EmptyTankWelcome",Vector3.new(12,2,.15),0,4.7,2.5,C.Cream)
			Kit.sign(welcome,"YOUR FIRST FISH BELONGS HERE","CAST A LINE. START A COLLECTION.",C.Teal)
		end
		local promptPart=part("AquariumEditor",Vector3.new(1.4,2.7,1.2),10.6,1.35,1,trim)
		local prompt=Instance.new("ProximityPrompt")
		prompt.Name,prompt.ActionText,prompt.ObjectText="AquariumPrompt","Edit my display","Aquarium gallery"
		prompt.KeyboardKeyCode,prompt.GamepadKeyCode=Enum.KeyCode.E,Enum.KeyCode.ButtonX
		prompt.MaxActivationDistance,prompt.HoldDuration,prompt.RequiresLineOfSight=6,0,false
		prompt.Parent=promptPart
		model.Parent=gallery
		plot.signature,plot.model=signature,model
		if old then old:Destroy() end
	end
	local function remove(player: Player)
		local plot=plots[player.UserId]
		if not plot then return end
		if plot.model then plot.model:Destroy() end
		occupied[plot.index],plots[player.UserId]=nil,nil
	end
	local function arrival(player: Player): CFrame?
		local plot=plots[player.UserId]
		return if plot then plot.origin*CFrame.new(0,3.3,-4)*CFrame.Angles(0,math.pi,0) else nil
	end
	-- FishingService calls update after each authoritative profile mutation and remove
	-- on departure. No heartbeat, duplicated economy, networking or save loop lives here.
	for _,player in Players:GetPlayers() do
		local profile=callbacks.profile(player)
		if profile then update(player,profile) end
	end
	return {update=update,remove=remove,arrival=arrival,folder=gallery}
end

return Aquarium
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000001A">
      <Properties>
        <string name="Name">PrototypeWorld</string>
        <ProtectedString name="Source">--!strict
-- Five original, connected sky islands. World generation never changes a custom map.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Fish = require(Shared:WaitForChild("FishModel"))
local Kit = require(script.Parent:WaitForChild("WorldPrimitives"))
local Nature = require(script.Parent:WaitForChild("WorldNature"))
local Architecture = require(script.Parent:WaitForChild("WorldArchitecture"))
local Layout = require(script.Parent:WaitForChild("WorldLayout"))
local Landscaping = require(script.Parent:WaitForChild("WorldLandscaping"))
local Residents = require(script.Parent:WaitForChild("WorldResidents"))
local PondBackdrops = require(script.Parent:WaitForChild("WorldPondBackdrops"))
local DockDetails = require(script.Parent:WaitForChild("WorldDockDetails"))
local TrailDetails = require(script.Parent:WaitForChild("WorldTrailDetails"))
local C = Kit.palette
local World = {}
local function v(p: {number}): Vector3 return Vector3.new(p[1], p[2], p[3]) end

-- Two thin solid wedges form an exact triangle, including irregular coastlines.
local function triangle(parent: Instance, name: string, a: Vector3, b: Vector3, c: Vector3, color: Color3, material: Enum.Material, solid: boolean, shadow: boolean?, studded: boolean?)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd &gt; acd and abd &gt; bcd then c, a = a, c
	elseif acd &gt; bcd and acd &gt; abd then a, b = b, a end
	ab, ac, bc = b - a, c - a, c - b
	if ac:Cross(ab).Magnitude &lt; 0.001 then return end
	local right = ac:Cross(ab).Unit
	local back = bc.Unit
	local up = bc:Cross(right).Unit
	local height = math.abs(ab:Dot(up))
	local options = {material = material, collidable = solid, shadow = shadow ~= false,studded=studded==true}
	local thickness = if solid then 0.7 else 0.45
	local l1, l2 = math.abs(ab:Dot(back)), math.abs(ac:Dot(back))
	if l1 &gt; 0.01 then Kit.wedge(parent, name, Vector3.new(thickness, height, l1), CFrame.fromMatrix((a+b)/2, right, up, back), color, options) end
	if l2 &gt; 0.01 then Kit.wedge(parent, name, Vector3.new(thickness, height, l2), CFrame.fromMatrix((a+c)/2, -right, up, -back), color, options) end
end
local function island(parent: Instance, data: any, color: Color3, material: Enum.Material): Model
	local model = Kit.model(parent, data.Name)
	model:SetAttribute("ZoneId", data.Id)
	local center = v(data.Center)
	local edge = Layout.outline(data)
	local n = #edge
	for i = 1, n do
		local j = i % n + 1
		-- Triangle center is half the floor thickness below the declared walking surface.
		triangle(model, "WalkableMeadow", center - Vector3.yAxis * 0.35, v(edge[i]) - Vector3.yAxis * 0.35,
			v(edge[j]) - Vector3.yAxis * 0.35, color, material, true,true,false)
		local bottomY=if data.Basin then -18 else -34
		-- A tapered, faceted underside gives each floating island a rock silhouette
		-- instead of a straight rectangular retaining wall. Walking floors stay level.
		local tiers = { {1,-.75},{1,-2},{.42,bottomY},{0,bottomY-6} }
		for tier = 1, #tiers - 1 do
			local top, bottom = tiers[tier], tiers[tier+1]
			local function ring(k: number, t: {number}): Vector3
				local offset = (v(edge[k]) - center) * t[1]
				return center + offset + Vector3.yAxis * t[2]
			end
			local a,b,c,d = ring(i,top),ring(j,top),ring(i,bottom),ring(j,bottom)
			local tint = if tier == 1 then color else (if (i+tier)%3 == 0 then C.Stone else C.Cliff)
			if top[1]==bottom[1] then
				-- A straight collar needs one panel, rather than four hidden wedge faces.
				Kit.part(model,"StratifiedCliff",Vector3.new((b-a).Magnitude,math.abs(top[2]-bottom[2]),.65),
					CFrame.lookAt((a+b+c+d)/4,b+(c-a)/2)*CFrame.Angles(0,math.pi/2,0),tint,{material=Enum.Material.Slate})
			elseif bottom[1]==0 then
				triangle(model,"StratifiedCliff",a,b,c,tint,Enum.Material.Slate,false)
			else
				triangle(model,"StratifiedCliff",a,b,c,tint,Enum.Material.Slate,false,true,false)
				triangle(model,"StratifiedCliff",b,d,c,tint,Enum.Material.Slate,false,true,false)
			end
		end
	end
	return model
end
local function path(parent: Instance, points: {{number}}, width: number, material: Enum.Material?, tint: Color3?, lift: number?)
	-- A joined miter strip avoids coplanar disks/rectangles flickering at every bend.
	local left,right={},{}
	for i,p in points do
		local before=v(points[math.max(1,i-1)])
		local after=v(points[math.min(#points,i+1)])
		local direction=(after-before).Unit
		local normal=Vector3.new(-direction.Z,0,direction.X)
		local point=v(p)+Vector3.yAxis*(-.135+(lift or 0))
		left[i],right[i]=point+normal*width/2,point-normal*width/2
	end
	for i=1,#points-1 do
		triangle(parent,"WornFootpath",left[i],right[i],left[i+1],tint or C.Sand,material or Enum.Material.Sand,false,false,false)
		triangle(parent,"WornFootpath",right[i],right[i+1],left[i+1],tint or C.Sand,material or Enum.Material.Sand,false,false,false)
	end
end
local function waypost(parent: Instance, pos: Vector3, title: string, subtitle: string, yaw: number?)
	Kit.beam(parent,"Waypost",pos,pos+Vector3.yAxis*6,0.35,C.Wood,{material=Enum.Material.Wood})
	local board = Kit.part(parent,"TrailSign",Vector3.new(8,2.1,0.3),CFrame.new(pos+Vector3.yAxis*5.3)*CFrame.Angles(0,yaw or 0,0),C.Teal)
	Kit.sign(board,title,subtitle)
end
local function lampPost(parent: Instance, pos: Vector3, lightShadow: boolean?)
	Kit.beam(parent,"TurnedLampPost",pos,pos+Vector3.yAxis*7.6,0.3,C.Iron,{material=Enum.Material.Metal})
	Kit.beam(parent,"CurvedLampArm",pos+Vector3.yAxis*7.6,pos+Vector3.new(1.2,7.6,0),0.2,C.Iron)
	Kit.lantern(parent,pos+Vector3.new(1.2,6,0),0.9,lightShadow)
end
local function water(parent: Instance, data: any)
	local center = v(data.Center)
	-- Native Terrain water supplies Roblox's own wave and reflection shader.
	local min = center - Vector3.new(data.Radius[1]+4, 8, data.Radius[2]+4)
	local max = center + Vector3.new(data.Radius[1]+4, 0, data.Radius[2]+4)
	local region = Region3.new(min,max):ExpandToGrid(4)
	local size = region.Size / 4
	local origin = region.CFrame.Position - region.Size / 2
	local materials, occupancy = {}, {}
	for x = 1, size.X do
		materials[x], occupancy[x] = {}, {}
		for y = 1, size.Y do
			materials[x][y], occupancy[x][y] = {}, {}
			for z = 1, size.Z do
				local p = origin + Vector3.new((x-.5)*4,(y-.5)*4,(z-.5)*4)
				local inside = ((p.X-center.X)/data.Radius[1])^2+((p.Z-center.Z)/data.Radius[2])^2 &lt; 1
				materials[x][y][z] = if inside then Enum.Material.Water else Enum.Material.Air
				occupancy[x][y][z] = if inside then 1 else 0
			end
		end
	end
	workspace.Terrain:WriteVoxels(region,4,materials,occupancy)
	-- Lower basin, exposed stone collar, reeds and a small cascade over the rim.
	local basin = {Id=data.Id.."_lagoon",Name="SuspendedLagoon",Center={center.X,center.Y-5,center.Z},Radius={data.Radius[1]+5,data.Radius[2]+5},Seed=13,Basin=true}
	local model = island(parent,basin,C.Sand,Enum.Material.Sand)
	for i = 1, 12 do
		local a=i*math.pi/6
		local p=center+Vector3.new(math.cos(a)*(data.Radius[1]+2),-.8,math.sin(a)*(data.Radius[2]+2))
		Nature.rock(model,p,Vector3.new(5.5,2.8,4.6),i*11,true)
	end
	for i = 1, 9 do
		local a = i*2.4
		local glint = Kit.beam(model,"WaterGlint",center+Vector3.new(math.cos(a)*data.Radius[1]*.65,.16,math.sin(a)*data.Radius[2]*.65),
			center+Vector3.new(math.cos(a)*data.Radius[1]*.65+2.5,.16,math.sin(a)*data.Radius[2]*.65),.045,C.Cream,{shadow=false,transparency=.78})
		glint:SetAttribute("GlintPhase",i)
	end
	local fallPos = center + Vector3.new(data.Radius[1]*.45,0,data.Radius[2]*.89)
	for i = -1,1 do
		Kit.part(model,"WaterfallCurtain",Vector3.new(2.8,55,0.2),CFrame.new(fallPos+Vector3.new(i*2.6,-27.5,0)),C.Water,
			{material=Enum.Material.Glass,transparency=.33,shadow=false})
		local streak=Kit.part(model,"FlowStreak",Vector3.new(.14,8,0.1),CFrame.new(fallPos+Vector3.new(i*2.5,-27.5,0.2)),C.Cream,{shadow=false,transparency=.58})
		streak:SetAttribute("FlowStart",streak.CFrame)
		streak:SetAttribute("FlowPhase",i*.27)
		streak:SetAttribute("FlowDistance",47)
		streak:SetAttribute("FlowSpeed",12)
	end
	Nature.cloud(model,fallPos-Vector3.yAxis*55,Vector3.new(21,8,14),83)
end
local function plaza(parent: Instance)
	Kit.disk(parent,"TownSquare",45,45,.2,Vector3.new(-8,12.11,-2),C.Limestone,{material=Enum.Material.Limestone})
	-- Small koi fountain: clear routes pass either side, not through its bowl.
	local f=Kit.model(parent,"CloudKoiFountain")
	Kit.disk(f,"FountainBase",11,11,.4,Vector3.new(-17,12.4,-14),C.Stone,{material=Enum.Material.Marble,collidable=true})
	Kit.disk(f,"Basin",9.6,9.6,.65,Vector3.new(-17,13,-14),C.Limestone,{material=Enum.Material.Marble,collidable=true})
	Kit.disk(f,"FountainWater",8.8,8.8,.08,Vector3.new(-17,13.37,-14),C.Water,{material=Enum.Material.Glass,transparency=.22,shadow=false})
	Kit.disk(f,"Pedestal",2.7,2.7,2,Vector3.new(-17,14,-14),C.Stone,{material=Enum.Material.Marble})
	local koi=Fish.create(f,"GoldenKoi","pufflet")
	koi:PivotTo(CFrame.new(-17,16,-14)*CFrame.Angles(0,.4,.2))
	for _,p in koi:GetChildren() do if p:IsA("BasePart") then p.Material=Enum.Material.Metal; p.Color=C.Brass; p.CastShadow=true end end
end
local function dockWorkshop(parent: Instance)
	local model=Kit.model(parent,"PierRodWorkshop")
	local pos=v(Layout.RodStand)
	local cf=CFrame.lookAt(pos,pos+Vector3.xAxis)
	local wood={material=Enum.Material.Wood}
	-- A working upgrade stop in the fishing loop; the larger town workshop stays open.
	Kit.part(model,"RodCounter",Vector3.new(7,2.6,2),cf*CFrame.new(0,1.3,-1.4),C.Wood,wood)
	Kit.part(model,"CounterTop",Vector3.new(7.5,.25,2.4),cf*CFrame.new(0,2.75,-1.4),C.Plank,wood)
	for _,x in {-3.5,3.5} do
		Kit.beam(model,"WorkshopCanopyPost",cf:PointToWorldSpace(Vector3.new(x,0,1.5)),cf:PointToWorldSpace(Vector3.new(x,7,1.5)),.22,C.Wood,wood)
	end
	Kit.part(model,"SunnyCanopy",Vector3.new(8,.3,5),cf*CFrame.new(0,7,0),C.Gold,{material=Enum.Material.Fabric})
	for _,x in {-2,0,2} do
		Kit.part(model,"CreamCanopyStripe",Vector3.new(.85,.02,5),cf*CFrame.new(x,7.16,0),C.Cream,{material=Enum.Material.Fabric,shadow=false})
	end
	local board=Kit.part(model,"RodWorkshopSign",Vector3.new(7,1.2,.16),cf*CFrame.new(0,5.7,-2),C.Teal)
	Kit.sign(board,"ROD UPGRADES","Fish · upgrade · cast again")
	for i=0,2 do
		local a=cf:PointToWorldSpace(Vector3.new(-2.2+i*1.9,2.9,.25))
		local b=a+Vector3.new(.2,2.6,0)
		Kit.beam(model,"DisplayRod",a,b,.09,if i==2 then C.Gold else C.Bark,wood)
		Kit.ball(model,"RodReel",Vector3.one*.3,a+Vector3.yAxis*.4,C.Cream,{shadow=false})
	end
	local prompt=Instance.new("ProximityPrompt")
	prompt.Name,prompt.ActionText,prompt.ObjectText="RodWorkshopPrompt","Upgrade rods","Dockside workshop"
	prompt.HoldDuration,prompt.MaxActivationDistance,prompt.RequiresLineOfSight=0,8,false
	prompt.Parent=board
end
local function windmill(parent: Instance, pos: Vector3)
	local model=Kit.model(parent,"PetalwindMill")
	Kit.disk(model,"StonePlinth",12,12,.5,pos+Vector3.yAxis*.25,C.Limestone,{material=Enum.Material.Cobblestone,collidable=true})
	for i=0,7 do
		local a=i*math.pi/4
		Kit.part(model,"MillWall",Vector3.new(4.2,18,.5),CFrame.new(pos+Vector3.new(math.sin(a)*4.6,9,math.cos(a)*4.6))*CFrame.Angles(0,a,0),C.Cream,{material=Enum.Material.Plaster,collidable=true})
	end
	for i=0,7 do
		local a=i*math.pi/4
		Kit.wedge(model,"MillRoof",Vector3.new(4.4,5,6),CFrame.new(pos+Vector3.new(math.sin(a)*2,20,math.cos(a)*2))*CFrame.Angles(0,a,0),C.Teal,{material=Enum.Material.Slate})
	end
	local origin=CFrame.new(pos+Vector3.new(0,15,-6))
	local rotor=Kit.model(model,"MillBlades")
	rotor.WorldPivot=origin
	for i=0,3 do
		local cf=origin*CFrame.Angles(0,0,i*math.pi/2)
		Kit.part(rotor,"SailSpar",Vector3.new(.35,15,.35),cf*CFrame.new(0,7,0),C.Wood,{material=Enum.Material.Wood})
		Kit.part(rotor,"CanvasSail",Vector3.new(2.5,10,.16),cf*CFrame.new(1.2,8.5,0),C.Cream,{material=Enum.Material.Fabric})
		for n=1,4 do Kit.part(rotor,"SailBatten",Vector3.new(2.7,.13,.2),cf*CFrame.new(1.2,4+n*2,0),C.Wood) end
	end
	Kit.ball(rotor,"Hub",Vector3.new(2,2,1),origin.Position,C.Brass,{material=Enum.Material.Metal})
	rotor:SetAttribute("SpinOrigin",origin)
	rotor:SetAttribute("SpinRate",.13)
end
local function hill(parent: Instance, pos: Vector3, width: number, depth: number, height: number)
	local peak=pos+Vector3.yAxis*height
	for i=1,10 do
		local a,b=i*math.pi/5,(i+1)*math.pi/5
		triangle(parent,"GrassyKnoll",peak,pos+Vector3.new(math.cos(a)*width/2,.04,math.sin(a)*depth/2),
			pos+Vector3.new(math.cos(b)*width/2,.04,math.sin(b)*depth/2),C.Grass,Enum.Material.Grass,true,true,false)
	end
end
local function townDetails(parent: Instance)
	-- Waist-high planters frame the square without blocking either main route.
	for i,pos in {Vector3.new(-34,12,-9),Vector3.new(21,12,19),Vector3.new(-18,12,31)} do
		local model=Kit.model(parent,"SquarePlanter")
		Kit.part(model,"LimestoneBox",Vector3.new(9,.9,4),CFrame.new(pos+Vector3.yAxis*.45),C.Limestone,{material=Enum.Material.Limestone,collidable=true})
		Kit.part(model,"DarkSoil",Vector3.new(8.3,.12,3.3),CFrame.new(pos+Vector3.yAxis*.96),C.Wood,{material=Enum.Material.Ground,shadow=false})
		Nature.garden(model,pos+Vector3.yAxis*1.05,Vector2.new(3.4,1.2),8,i*71,"Lavender")
	end
	Architecture.props(parent,CFrame.new(-26,12,23)*CFrame.Angles(0,math.pi/2,0),"Picnic")
	Architecture.props(parent,CFrame.new(30,12,53)*CFrame.Angles(0,-.4,0),"Picnic")
	-- A generous casting entrance: beam and lights sit above avatar head height.
	local gate=Kit.model(parent,"SundriftPierGateway")
	for _,x in {-13,13} do
		Kit.beam(gate,"TurnedPierPost",Vector3.new(x,12,84),Vector3.new(x,23,84),.8,C.Wood,{material=Enum.Material.Wood,collidable=true})
		Kit.beam(gate,"GatewayBrace",Vector3.new(x,20,84),Vector3.new(x*.7,23,84),.4,C.Wood)
		Kit.lantern(gate,Vector3.new(x*.85,20.4,84),1,false)
	end
	Kit.part(gate,"CarvedLintel",Vector3.new(28,.7,1),CFrame.new(0,23,84),C.Wood,{material=Enum.Material.Wood})
	local sign=Kit.part(gate,"PierName",Vector3.new(13,2.7,.28),CFrame.new(0,21.3,83.7),C.Teal)
	Kit.sign(sign,"SUNDRIFT PIER","A new discovery is one cast away")
	for _,x in {-9,9} do
		local banner=Kit.part(gate,"LinenPennant",Vector3.new(1.3,3.1,.06),CFrame.new(x,21,84),C.Coral,{material=Enum.Material.Fabric})
		banner.CanCollide=false
	end
	hill(parent,Vector3.new(76,12,64),33,30,5)
	Nature.tree(parent,Vector3.new(76,17,64),.9,"Oak",233)
	hill(parent,Vector3.new(-102,12,-31),28,33,4)
	Nature.tree(parent,Vector3.new(-102,16,-31),.85,"Oak",237)
end
local function grotto(parent: Instance, cf: CFrame)
	local model=Kit.model(parent,"TideglassGrotto")
	for _,side in {-1,1} do
		Kit.wedge(model,"WeatheredArchPillar",Vector3.new(8,13,12),cf*CFrame.new(side*8,6.5,0)*CFrame.Angles(0,side*math.pi/2,0),C.DeepStone,{material=Enum.Material.Slate,collidable=true})
		Kit.part(model,"PillarCore",Vector3.new(5,12,8),cf*CFrame.new(side*8,6,-1),C.Cliff,{material=Enum.Material.Slate,collidable=true})
	end
	Kit.part(model,"ShadedCaveRoof",Vector3.new(24,5,13),cf*CFrame.new(0,14,0),C.Cliff,{material=Enum.Material.Slate,collidable=true})
	Kit.part(model,"CaveBackWall",Vector3.new(24,12,1),cf*CFrame.new(0,6,5.5),C.DeepStone,{material=Enum.Material.Slate,collidable=true})
	Nature.rock(model,cf:PointToWorldSpace(Vector3.new(-3,16.3,1)),Vector3.new(19,5,12),607,true)
	for i=1,6 do
		local x=(i-3.5)*1.4
		local crystal=Kit.wedge(model,"TideglassCrystal",Vector3.new(.8,2+i%3,1),cf*CFrame.new(x,1.1,3.6)*CFrame.Angles(0,i*.6,-.12+x*.03),
			if i%2==0 then C.Water else C.Lavender,{material=Enum.Material.Glass,shadow=false})
		crystal.Transparency=.12
	end
	local sign=Kit.part(model,"GrottoPlaque",Vector3.new(5.4,1.6,.2),cf*CFrame.new(9,2,-6.3),C.Teal)
	Kit.sign(sign,"TIDEGLASS GROTTO","A little shade beneath the palms")
end
local function skyship(parent: Instance)
	local model=Kit.model(parent,"SkySail")
	local o=Vector3.new(15,91,266)
	model.WorldPivot=CFrame.new(o)
	Kit.ball(model,"LinenEnvelope",Vector3.new(25,19,48),o,C.Cream,{material=Enum.Material.Fabric})
	for _,z in {-12,0,12} do
		Kit.ball(model,"EnvelopeBand",Vector3.new(25.25,19.25,2.6),o+Vector3.new(0,0,z),C.Coral,{material=Enum.Material.Fabric})
	end
	Kit.part(model,"BoatCabin",Vector3.new(9,5,16),CFrame.new(o+Vector3.new(0,-17,0)),C.Wood,{material=Enum.Material.WoodPlanks})
	for _,x in {-4.6,4.6} do
		for _,z in {-7,7} do Kit.beam(model,"AirshipRigging",o+Vector3.new(x,-15,z),o+Vector3.new(x,-7,z*1.5),.13,C.Iron) end
	end
	Kit.wedge(model,"TailFin",Vector3.new(.4,10,12),CFrame.new(o+Vector3.new(0,1,26)),C.Teal,{material=Enum.Material.Fabric})
	model:SetAttribute("DriftOrigin",CFrame.new(o))
end
function World.create(): BasePart
	assert(not workspace:FindFirstChild("MolnfiskarnaPrototype"),"World already exists. Disable CreatePrototypeWorld to use a custom map.")
	local root=Instance.new("Folder")
	root.Name="MolnfiskarnaPrototype"
	-- Build before parenting: each streamed model arrives with its geometry/attributes.
	local regions={}
	-- An early spawn platform holds joining avatars while the larger world is built.
	local spawn=Instance.new("SpawnLocation")
	spawn.Name,spawn.Size,spawn.CFrame="HarborSpawn",Vector3.new(14,.3,14),CFrame.new(v(Layout.Spawn)+Vector3.yAxis*.2)*CFrame.Angles(0,math.pi,0)
	spawn.Anchored,spawn.Neutral,spawn.Duration,spawn.Transparency,spawn.CastShadow=true,true,0,1,false
	spawn.Parent=workspace
	-- A lower afternoon sun and less ambient fill give buildings and trees shade
	-- without turning the daytime map into a dark scene.
	Lighting.ClockTime,Lighting.Brightness,Lighting.GlobalShadows=15,1.9,true
	Lighting.ExposureCompensation=-.2
	Lighting.ShadowSoftness=.22
	Lighting.Ambient,Lighting.OutdoorAmbient=Color3.fromRGB(66,81,97),Color3.fromRGB(104,120,134)
	Lighting.EnvironmentDiffuseScale,Lighting.EnvironmentSpecularScale=.4,0
	local atmosphere=Instance.new("Atmosphere")
	atmosphere.Name,atmosphere.Density,atmosphere.Offset,atmosphere.Haze,atmosphere.Glare="SundriftAtmosphere",.1,0,.15,0
	atmosphere.Color,atmosphere.Decay,atmosphere.Parent=Color3.fromRGB(202,218,232),Color3.fromRGB(155,177,196),Lighting
	local sky=Instance.new("Sky")
	sky.Name,sky.SunAngularSize,sky.MoonAngularSize,sky.StarCount,sky.Parent="SundriftSky",5,5,800,Lighting
	local clouds=Instance.new("Clouds")
	clouds.Name,clouds.Cover,clouds.Density,clouds.Color,clouds.Parent="HighClouds",.12,.2,C.Cloud,workspace.Terrain
	local color=Instance.new("ColorCorrectionEffect")
	color.Name,color.Saturation,color.Contrast,color.TintColor,color.Parent="HarborGrade",-.04,.05,Color3.fromRGB(255,255,255),Lighting
	color.Brightness=-.025
	local bloom=Instance.new("BloomEffect")
	bloom.Name,bloom.Intensity,bloom.Threshold,bloom.Size,bloom.Parent="LanternBloom",0,2.2,24,Lighting
	local rays=Instance.new("SunRaysEffect")
	rays.Intensity,rays.Spread,rays.Parent=0,.85,Lighting
	workspace.Terrain.WaterColor,workspace.Terrain.WaterReflectance,workspace.Terrain.WaterTransparency=C.Water,0,.18
	workspace.Terrain.WaterWaveSize,workspace.Terrain.WaterWaveSpeed=.08,4
	for _,data in Layout.Islands do
		local tint=if data.Kind=="Cove" then C.Sand elseif data.Kind=="Summit" then C.Moss else C.Grass
		regions[data.Id]=island(root,data,tint,if data.Kind=="Cove" then Enum.Material.Sand else Enum.Material.Grass)
	end
	for i,data in Layout.Paths do path(regions[data.Island],data.Points,data.Width,nil,nil,i*.012) end
	-- The fountain has a broad walkable ring; the main trail goes around its center.
	plaza(regions.harbor)
	townDetails(regions.harbor)
	dockWorkshop(regions.harbor)
	Architecture.cottage(regions.harbor,CFrame.new(52,12,-20)*CFrame.Angles(0,math.pi,0),26,22,Color3.fromRGB(220,215,176),"Workshop")
	Architecture.cottage(regions.harbor,CFrame.new(-52,12,-20)*CFrame.Angles(0,math.pi,0),26,22,Color3.fromRGB(237,207,169),"Cafe")
	Architecture.cottage(regions.harbor,CFrame.new(67,12,-48)*CFrame.Angles(0,math.pi/4,0),21,18,Color3.fromRGB(208,218,183),"Cottage")
	Architecture.lighthouse(regions.harbor,CFrame.new(-48,12,-60))
	Architecture.props(regions.harbor,CFrame.new(-72,12,43)*CFrame.Angles(0,-.3,0),"Market")
	Architecture.props(regions.harbor,CFrame.new(66,12,43),"Market")
	Architecture.props(regions.harbor,CFrame.new(-46,12,27),"Picnic")
	Architecture.props(regions.harbor,CFrame.new(16,12,85),"Fishing")
	windmill(regions.blossom,Vector3.new(-272,28,35))
	Architecture.props(regions.blossom,CFrame.new(-216,28,47),"Picnic")
	Architecture.cottage(regions.forest,CFrame.new(299,24,-36)*CFrame.Angles(0,math.pi/2,0),20,17,Color3.fromRGB(184,201,169),"Cottage")
	Architecture.props(regions.forest,CFrame.new(249,24,45),"Fishing")
	Architecture.ruins(regions.summit,CFrame.new(244,60,-268))
	Architecture.props(regions.summit,CFrame.new(285,60,-224),"Picnic")
	Architecture.props(regions.cove,CFrame.new(-250,4,-235),"Fishing")
	Architecture.props(regions.cove,CFrame.new(-211,4,-201),"Picnic")
	grotto(regions.cove,CFrame.new(-227,4,-246)*CFrame.Angles(0,math.pi,0))
	for _,bridge in Layout.Bridges do
		local points=Layout.bridgePoints(bridge)
		for i=1,#points-1 do Architecture.dock(root,v(points[i]),v(points[i+1]),bridge.Width,bridge.Id.."_"..i,true) end
	end
	local spots=Instance.new("Folder")
	spots.Name,spots.Parent="FishingSpots",root
	local first: BasePart?=nil
	for _,data in Layout.Waters do water(root,data) end
	for _,dock in Layout.Docks do
		local portalOpening=(v(dock.Spot)-v(dock.A)):Dot((v(dock.B)-v(dock.A)).Unit)-8
		local deck=Architecture.dock(root,v(dock.A),v(dock.B),dock.Width,dock.Id.."_pier",true,portalOpening)
		local zone=nil
		for _,w in Layout.Waters do if w.Id==dock.Id then zone=w end end
		local spot=Kit.part(spots,"FishingSpot",Vector3.new(dock.Width-5,.05,10),CFrame.new(v(dock.Spot))*CFrame.Angles(0,dock.Yaw,0),C.Teal,{transparency=.72,shadow=false})
		spot:SetAttribute("ZoneId",dock.Id)
		for _,region in Layout.Islands do if region.Id==dock.Id then spot:SetAttribute("ZoneName",region.Name) end end
		spot:SetAttribute("WaterY",zone.Center[2])
		if not first then first=spot end
		local basis=CFrame.lookAt(v(dock.A),v(dock.B))
		Architecture.props(deck,basis*CFrame.new(dock.Width*.34,0,-5),"Fishing")
	end
	-- Deliberate clearings keep the paths, entrances and vistas open.
	local trees: {{any}}={
		{"harbor",-92,12,-25,1.25,"Oak"},{"harbor",90,12,34,1.35,"Oak"},{"harbor",-100,12,55,1.2,"Oak"},
		{"harbor",45,12,-72,1.05,"Blossom"},{"harbor",-75,12,-72,1.15,"Oak"},{"harbor",86,12,-17,1.0,"Oak"},
		{"blossom",-283,28,-23,1.25,"Blossom"},{"blossom",-211,28,-20,1.2,"Blossom"},{"blossom",-290,28,64,1.1,"Blossom"},
		{"blossom",-223,28,55,1,"Blossom"},{"blossom",-268,28,-35,1.15,"Blossom"},
		{"forest",221,24,27,1.25,"Pine"},{"forest",235,24,-42,1.65,"Pine"},{"forest",289,24,49,1.35,"Pine"},
		{"forest",319,24,3,1.7,"Pine"},{"forest",300,24,-65,1.3,"Pine"},{"forest",281,24,-66,1.15,"Pine"},
		{"forest",228,24,48,1.2,"Oak"},{"forest",307,24,30,1.1,"Pine"},
		{"cove",-269,4,-179,1.4,"Palm"},{"cove",-199,4,-236,1.55,"Palm"},{"cove",-259,4,-251,1.2,"Palm"},
		{"cove",-207,4,-167,1.15,"Palm"},{"cove",-278,4,-226,1.3,"Palm"},
		{"summit",219,60,-213,.95,"Pine"},{"summit",291,60,-274,1.1,"Pine"},
	}
	for i,t in trees do Nature.tree(regions[t[1]],Vector3.new(t[2],t[3],t[4]),t[5],t[6],i*17) end
	local gardens: {{any}}={
		{"harbor",-30,12,-25,10,7,20},{"harbor",28,12,35,14,9,24},{"harbor",-36,12,61,15,8,22},
		{"blossom",-280,28,1,11,9,24},{"blossom",-213,28,33,9,8,20},{"forest",239,24,23,12,10,25},
		{"forest",293,24,19,11,7,22},{"summit",223,60,-266,12,9,24},{"cove",-253,4,-185,9,8,18},
	}
	for i,g in gardens do Nature.garden(regions[g[1]],Vector3.new(g[2],g[3],g[4]),Vector2.new(g[5],g[6]),math.ceil(g[7]*.45),i*53,if g[1]=="summit" then "Lavender" else "Grass") end
	for i,pos in {Vector3.new(-95,12,34),Vector3.new(87,12,-58),Vector3.new(-289,28,38),Vector3.new(321,24,-29),Vector3.new(-182,4,-211),Vector3.new(210,60,-254)} do
		Nature.rock(root,pos,Vector3.new(11+i%3*2,8+i%2*4,9),i*19,true)
	end
	for _,p in {Vector3.new(-20,12,-35),Vector3.new(20,12,42),Vector3.new(-18,12,75),Vector3.new(-105,12,18),Vector3.new(107,12,12)} do lampPost(root,p,false) end
	waypost(root,Vector3.new(20,12,-19),"SUNDRIFT HARBOR","Rod &amp; Reel / Main Pier")
	waypost(root,Vector3.new(-94,12,20),"PETALWIND GROVE","Blossom walks / Tideglass Cove",math.pi/2)
	waypost(root,Vector3.new(96,12,-10),"EVERGREEN REACH","Forest Pier / Starfall Lookout",-math.pi/2)
	waypost(root,Vector3.new(274,24,-67),"STARFALL LOOKOUT","Follow the rising bridge")
	waypost(root,Vector3.new(-261,28,-33),"TIDEGLASS COVE","Palm shade / Quiet water")
	spawn.Parent=root
	skyship(root)
	-- Distant cloud banks frame the playable islands rather than covering walkways.
	for i=1,14 do
		local a=i*math.pi/7
		Nature.cloud(root,Vector3.new(math.cos(a)*490,-72,math.sin(a)*390-40),Vector3.new(88,22,55),i*13)
	end
	Landscaping.populate(root,regions)
	DockDetails.populate(root)
	TrailDetails.populate(root,regions)
	local population=Residents.populate(root)
	PondBackdrops.populate(root)
	local largeModels: {[Instance]: boolean}={[population]=true}
	for _,region in regions do largeModels[region]=true end
	for _,model in root:GetDescendants() do
		if model:IsA("Model") and not largeModels[model] and model.Name~="SuspendedLagoon" then
			model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic
		end
	end
	root.Parent=workspace
	assert(first,"Map needs a primary fishing spot")
	return first
end
function World.findCustom(): BasePart
	local folder=workspace:FindFirstChild("World")
	local spot=if folder then folder:FindFirstChild("FishingSpot") else nil
	assert(spot and spot:IsA("BasePart"),"Create an anchored Part at Workspace.World.FishingSpot.")
	return spot :: BasePart
end
return World
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000001B">
      <Properties>
        <string name="Name">FishingLocations</string>
        <ProtectedString name="Source">--!strict
-- Pure location selection and attempt binding. Distances and world validity are
-- supplied by the server adapter; clients never choose their fishing location.
type Candidate = { location: any, distance: number }
type Binding = { attemptId: number, location: any }
local Locations = {}
Locations.__index = Locations
type Data = { bindings: { [number]: Binding } }
export type LocationState = typeof(setmetatable({} :: Data, Locations))

function Locations.nearest(candidates: { Candidate }, maxDistance: number): any?
	if maxDistance ~= maxDistance or maxDistance &lt; 0 or maxDistance == math.huge then return nil end
	local nearest, distance = nil, maxDistance
	for _, candidate in candidates do
		local d = candidate.distance
		if candidate.location ~= nil and d == d and d &gt;= 0 and d &lt; math.huge
			and d &lt;= maxDistance and (nearest == nil or d &lt; distance) then
			nearest, distance = candidate.location, d
		end
	end
	return nearest
end

function Locations.new(): LocationState
	return setmetatable({ bindings = {} }, Locations)
end

function Locations.forAttempt(self: LocationState, userId: number, attemptId: number?): any?
	local binding = self.bindings[userId]
	return if binding and binding.attemptId == attemptId then binding.location else nil
end

function Locations.last(self: LocationState, userId: number): any?
	local binding = self.bindings[userId]
	return if binding then binding.location else nil
end

function Locations.acceptStart(
	self: LocationState, userId: number, previousAttemptId: number?, packet: any, location: any
): boolean
	-- Commit only after the state machine accepts a new Start. Rejected requests,
	-- retries, cooldowns and completed casts must preserve the last visual target.
	if previousAttemptId ~= nil or location == nil or packet == nil or packet.phase ~= "Waiting"
		or type(packet.attemptId) ~= "number" or packet.attemptId ~= packet.attemptId
		or packet.attemptId &lt;= 0 or packet.attemptId == math.huge then return false end
	self.bindings[userId] = { attemptId = packet.attemptId, location = location }
	return true
end

function Locations.remove(self: LocationState, userId: number)
	self.bindings[userId] = nil
end

return Locations
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000001C">
      <Properties>
        <string name="Name">FishingService</string>
        <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Config = require(Shared:WaitForChild("FishingConfig"))
local Rules = require(Shared:WaitForChild("FishingRules"))
local Catalog = require(Shared:WaitForChild("FishCatalog"))
local Engine = require(script.Parent:WaitForChild("FishingEngine"))
local Progression = require(script.Parent:WaitForChild("FishingProgression"))
local ProfileStore = require(script.Parent:WaitForChild("FishingProfileStore"))
local Locations = require(script.Parent:WaitForChild("FishingLocations"))
local World = require(script.Parent:WaitForChild("PrototypeWorld"))
local IslandTravel = require(script.Parent:WaitForChild("IslandTravel"))
local Aquarium = require(script.Parent:WaitForChild("AquariumService"))
local Service = {}
local started = false

function Service.start()
	assert(not started, "FishingService has already started")
	started = true
	local spot = if Config.CreatePrototypeWorld then World.create() else World.findCustom()
	local fishingSpots: { BasePart } = { spot }
	if Config.CreatePrototypeWorld then
		local world = workspace:FindFirstChild("MolnfiskarnaPrototype")
		local spots = if world then world:FindFirstChild("FishingSpots") else nil
		if spots then
			for _, child in spots:GetDescendants() do
				if child:IsA("BasePart") and child.Name == "FishingSpot" and child ~= spot then
					table.insert(fishingSpots, child)
				end
			end
		end
	end
	local locations = Locations.new()
	assert(not ReplicatedStorage:FindFirstChild("FishingRemotes"), "Install one fishing server only.")
	local remotes = Instance.new("Folder")
	remotes.Name = "FishingRemotes"
	local function remote(name: string): RemoteEvent
		local event = Instance.new("RemoteEvent")
		event.Name, event.Parent = name, remotes
		return event
	end
	local action, state, visual = remote("FishingAction"), remote("FishingState"), remote("FishingVisual")
	local random = Random.new()
	local progression = Progression.new(Catalog, function() return random:NextNumber() end)
	local engine = Engine.new(Config, Rules, progression)
	local saving = Config.EnableSaving and (not RunService:IsStudio() or Config.SaveInStudio)
	local store = if saving then ProfileStore.new(Catalog, progression, RunService:IsStudio()) else nil
	local sessions: { [Player]: any } = {}
	local loading: { [Player]: boolean } = {}
	local welcome: { [Player]: any } = {}
	local connections: { [Player]: RBXScriptConnection } = {}
	local lastVisual: { [Player]: string } = {}
	local activeAttempts: { [Player]: number } = {}
	local closing, pendingReleases = false, 0
	local aquarium: any = nil
	local nearestLocation: any = nil

	local function describeLocation(player: Player, fishingSpot: BasePart)
		local lane = (player.UserId % 4 - 1.5) * 2
		local target = (fishingSpot.CFrame * CFrame.new(lane, -1.2, -14)).Position
		local waterY = fishingSpot:GetAttribute("WaterY")
		if type(waterY) == "number" and waterY == waterY and math.abs(waterY) &lt; math.huge then
			target = Vector3.new(target.X, waterY + 0.2, target.Z)
		end
		local zoneId, zoneName = fishingSpot:GetAttribute("ZoneId"), fishingSpot:GetAttribute("ZoneName")
		return {
			spot = fishingSpot, target = target,
			zoneId = if type(zoneId) == "string" then zoneId else nil,
			zoneName = if type(zoneName) == "string" then zoneName else nil,
		}
	end
	local function decorate(player: Player, packet: any)
		local location = locations:last(player.UserId) or describeLocation(player, spot)
		packet.castTarget = location.target
		local current = if packet.phase == "Idle" and nearestLocation then nearestLocation(player) or location else location
		packet.zoneId, packet.zoneName = current.zoneId, current.zoneName
		packet.location = { zoneId = current.zoneId, zoneName = current.zoneName }
		return packet
	end
	local function publicVisual(player: Player, packet: any)
		local result = packet.result
		return decorate(player, {
			phase = packet.phase, catches = packet.catches, attemptId = packet.attemptId,
			readyAt = packet.readyAt, chargeAt = packet.chargeAt,
			timingCenter = packet.timingCenter, duration = packet.duration,
			rodLevel = if packet.profile then packet.profile.level else 0,
			result = if result then {
				species = result.species, speciesId = result.speciesId, quality = result.quality,
				rarity = result.rarity, newDiscovery = result.newDiscovery,
				variant = result.variant, weightKg = result.weightKg, newRecord = result.newRecord,
			} else nil,
		})
	end
	local function emit(player: Player, packet: any)
		activeAttempts[player] = packet.attemptId
		decorate(player, packet)
		local profile = packet.profile
		if profile then profile.persistent = saving; profile.offlineRate = profile.species * 0.25 end
		if welcome[player] then packet.offline = welcome[player]; welcome[player] = nil end
		state:FireClient(player, packet)
		local stats = player:FindFirstChild("leaderstats")
		local score = if stats then stats:FindFirstChild("Collection") else nil
		if score and score:IsA("IntValue") and profile then score.Value = profile.points end
		if aquarium and profile then aquarium.update(player, profile) end
		local key = packet.phase .. ":" .. tostring(packet.attemptId) .. ":" .. packet.catches
			.. ":" .. (if profile then profile.level else 0)
		if lastVisual[player] ~= key then
			lastVisual[player] = key
			visual:FireAllClients(player.UserId, publicVisual(player, packet))
		end
	end
	local function fishingPosition(player: Player): Vector3?
		local character = player.Character
		if not character then return nil end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		return if humanoid and humanoid.Health &gt; 0 and root and root:IsA("BasePart") then root.Position else nil
	end
	local function validSpot(fishingSpot: BasePart): boolean
		return fishingSpot.Anchored and fishingSpot:IsDescendantOf(workspace)
	end
	nearestLocation = function(player: Player)
		local position = fishingPosition(player)
		if not position then return nil end
		local candidates = {}
		for _, fishingSpot in fishingSpots do
			if validSpot(fishingSpot) then
				table.insert(candidates, {
					location = describeLocation(player, fishingSpot),
					distance = (position - fishingSpot.Position).Magnitude,
				})
			end
		end
		return Locations.nearest(candidates, Config.MaxDistance)
	end
	local function canFish(player: Player, location: any): boolean
		local position = fishingPosition(player)
		return player:GetAttribute("IslandTravelBusy") ~= true
			and position ~= nil and location ~= nil and validSpot(location.spot)
			and (position - location.spot.Position).Magnitude &lt;= Config.MaxDistance
	end
	local function release(session: any, profile: any)
		if not store or session.closed or session.releaseRequested then return end
		session.releaseRequested = true
		pendingReleases += 1
		task.spawn(function()
			local deadline = os.clock() + 20
			while session.busy and os.clock() &lt; deadline do task.wait(0.1) end
			local ok, reason = store.save(session, profile, true)
			if not ok then warn("Cloud Anglers: final save failed: " .. tostring(reason)) end
			pendingReleases -= 1
		end)
	end
	local function addPlayer(player: Player)
		if loading[player] or connections[player] then return end
		loading[player] = true
		task.spawn(function()
			local session, reason = nil, nil
			if store then session, reason = store.load(player.UserId) end
			loading[player] = nil
			if store and not session then
				warn("Cloud Anglers: profile load blocked: " .. tostring(reason))
				if player.Parent == Players then player:Kick("Your progress could not be loaded safely. Please rejoin in a moment.") end
				return
			end
			if player.Parent ~= Players or closing then
				if session then release(session, session.profile) end
				return
			end
			if session then sessions[player] = session; welcome[player] = session.offline end
			engine:addPlayer(player.UserId, workspace:GetServerTimeNow(), if session then session.profile else nil)
			local stats = player:FindFirstChild("leaderstats") or Instance.new("Folder")
			stats.Name, stats.Parent = "leaderstats", player
			if not stats:FindFirstChild("Collection") then
				local score = Instance.new("IntValue")
				score.Name, score.Parent = "Collection", stats
			end
			connections[player] = player.CharacterRemoving:Connect(function()
				local packet = engine:interrupt(player.UserId, workspace:GetServerTimeNow(), "Fishing stopped. Return to the dock after respawning.")
				if packet and player.Parent == Players then emit(player, packet) end
			end)
			-- The client asks for Sync after subscribing; it also retries while data loads.
		end)
	end
	Players.PlayerAdded:Connect(addPlayer)
	Players.PlayerRemoving:Connect(function(player)
		local profile = engine:exportProfile(player.UserId)
		local session = sessions[player]
		if session and profile then release(session, profile) end
		local connection = connections[player]
		if connection then connection:Disconnect() end
		connections[player], sessions[player], welcome[player], lastVisual[player] = nil, nil, nil, nil
		activeAttempts[player] = nil
		locations:remove(player.UserId)
		engine:removePlayer(player.UserId)
		if aquarium then aquarium.remove(player) end
	end)
	for _, player in Players:GetPlayers() do addPlayer(player) end
	if Config.CreatePrototypeWorld then
		local world=workspace:FindFirstChild("MolnfiskarnaPrototype")
		-- The generated world is a Folder; requiring a Model here silently
		-- skipped the travel service and its stands during real startup.
		if world then
			aquarium = Aquarium.start(world, {
				profile = function(player)
					local packet = engine:snapshot(player.UserId)
					return if packet then packet.profile else nil
				end,
			})
			IslandTravel.start(world,function(player)
				if closing or not connections[player] then return false end
				local packet=engine:interrupt(player.UserId,workspace:GetServerTimeNow(),"Ready for your next pond.")
				if packet then emit(player,packet) end
				return true
			end, function(player)
				if closing or not connections[player] or not engine:snapshot(player.UserId) then return nil end
				return aquarium.arrival(player)
			end)
		end
	end
	action.OnServerEvent:Connect(function(player, verb, attemptId)
		if closing then return end
		local session = sessions[player]
		if session and os.time() &gt;= session.expires then return end
		-- All state transitions emit synchronously. Keep only the active attempt ID
		-- here, avoiding a full profile snapshot before a request is rate-limited.
		local previousAttemptId = activeAttempts[player]
		local location = locations:forAttempt(player.UserId, previousAttemptId)
		if verb == "Start" and connections[player] and previousAttemptId == nil then location = nearestLocation(player) end
		local zoneId = if location and Catalog.zone(location.zoneId) then location.zoneId else nil
		local packet = engine:command(player.UserId, verb, attemptId, workspace:GetServerTimeNow(), canFish(player, location), zoneId)
		if packet then
			if verb == "Start" then locations:acceptStart(player.UserId, previousAttemptId, packet, location) end
			emit(player, packet)
			if verb == "Sync" then
				for _, other in Players:GetPlayers() do
					local otherPacket = engine:snapshot(other.UserId)
					if other ~= player and otherPacket and otherPacket.phase ~= "Idle" then
						visual:FireClient(player, other.UserId, publicVisual(other, otherPacket))
					end
				end
			end
		end
	end)
	local elapsed = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		if closing then return end
		elapsed += deltaTime
		if elapsed &lt; 0.1 then return end
		elapsed = 0
		local now = workspace:GetServerTimeNow()
		for _, player in Players:GetPlayers() do
			local packet = engine:tick(player.UserId, now, canFish(player, locations:last(player.UserId)))
			if packet then emit(player, packet) end
			-- Update the location card even when travelling without casting. The
			-- attempt binding stays unchanged until a server-accepted Start.
			if not activeAttempts[player] then
				local nearest = nearestLocation(player)
				if nearest then
					local zone = nearest.zoneId
					if player:GetAttribute("CurrentFishingZone") ~= zone then
						player:SetAttribute("CurrentFishingZone", zone)
						local snapshot = engine:snapshot(player.UserId)
						if snapshot then
							snapshot.location = { zoneId = zone, zoneName = nearest.zoneName }
							-- Do not rewrite the last cast target when only looking at a new pond.
							if snapshot.profile then snapshot.profile.persistent = saving; snapshot.profile.offlineRate = snapshot.profile.species * 0.25 end
							state:FireClient(player, snapshot)
						end
					end
				end
			end
			local session = sessions[player]
			if session and not session.releaseRequested then
				if os.time() &gt;= session.expires then
					player:Kick("Saving connection was interrupted. Please rejoin to protect your progress.")
				elseif not session.busy and os.clock() - session.lastSave &gt;= 30 then
					local profile = engine:exportProfile(player.UserId)
					if profile then
						task.spawn(function()
							local ok, reason = store.save(session, profile, false)
							if not ok then
								warn("Cloud Anglers: autosave failed: " .. tostring(reason))
								-- Back off; do not exhaust DataStore budgets on every heartbeat.
								session.lastSave = os.clock()
								if reason == "lost_lease" or reason == "invalid_data" then
									player:Kick("Your save session changed. Please rejoin safely.")
								end
							end
						end)
					end
				end
			end
		end
	end)
	game:BindToClose(function()
		closing = true
		for player, session in sessions do
			local profile = engine:exportProfile(player.UserId)
			if profile then release(session, profile) end
		end
		local deadline = os.clock() + 25
		while (pendingReleases &gt; 0 or next(loading) ~= nil) and os.clock() &lt; deadline do task.wait(0.1) end
	end)
	remotes.Parent = ReplicatedStorage
	print("Cloud Anglers: ready. Saving " .. (if saving then "enabled." else "disabled in this Studio playtest."))
end
return Service
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000001D">
      <Properties>
        <string name="Name">FishingProgression</string>
        <ProtectedString name="Source">--!strict
-- Authoritative progression. Pure functions let rewards and save migration be tested.
type Profile = {
	coins: number, level: number, catches: number, brilliant: number, goalIndex: number,
	best: { [string]: number }, duplicateCount: number,
	records: { [string]: number }, variants: { [string]: { [string]: boolean } },
	display: { string }, styles: { [string]: boolean }, equippedStyle: string,
	combo: number, zoneDuplicates: { [string]: number },
}
local Progression = {}
local ranks = { Normal = 1, Fine = 2, Brilliant = 3 }
local MAX_COINS = 1000000000

function Progression.new(catalog: any, randomRoll: () -&gt; number)
	local function roll(): number
		local value = randomRoll()
		return if type(value) == "number" and value == value then math.clamp(value, 0, .999999) else .5
	end
	local function normalize(profile: Profile)
		profile.records = profile.records or {}
		profile.variants = profile.variants or {}
		profile.styles = profile.styles or { lagoon = true }
		profile.equippedStyle = profile.equippedStyle or "lagoon"
		profile.combo = profile.combo or 0
		profile.zoneDuplicates = profile.zoneDuplicates or {}
		if not profile.display then
			profile.display = {}
			for _, species in catalog.Species do
				if profile.best[species.Id] and #profile.display &lt; 3 then table.insert(profile.display, species.Id) end
			end
		end
	end
	local function create(): Profile
		return {
			coins = 0, level = 0, catches = 0, brilliant = 0, goalIndex = 1, best = {}, duplicateCount = 0,
			records = {}, variants = {}, display = {}, styles = { lagoon = true }, equippedStyle = "lagoon",
			combo = 0, zoneDuplicates = {},
		}
	end
	local function collection(profile: Profile): (number, number)
		local count, points = 0, 0
		for _, species in catalog.Species do
			local best = profile.best[species.Id]
			if best then count += 1; points += best end
		end
		return count, points
	end
	local function zoneProgress(profile: Profile): {any}
		local zones = {}
		for _, zone in catalog.Zones or {} do
			local count, total = 0, 0
			for _, species in catalog.Species do
				if species.Zone == zone.Id then
					total += 1
					if profile.best[species.Id] then count += 1 end
				end
			end
			table.insert(zones, { id = zone.Id, name = zone.Name, count = count, total = total })
		end
		return zones
	end
	local function goalValue(profile: Profile, kind: string): number
		if kind == "Catches" then return profile.catches end
		if kind == "Rod" then return profile.level end
		if kind == "Brilliant" then return profile.brilliant end
		if kind == "Crownwhale" then return if profile.best.crownwhale then 1 else 0 end
		if kind == "Zones" then
			local count = 0
			for _, zone in zoneProgress(profile) do if zone.count &gt; 0 then count += 1 end end
			return count
		end
		local count = collection(profile)
		return count
	end
	local function resolveGoals(profile: Profile): (number, { string })
		local reward = 0
		local names: { string } = {}
		while true do
			local goal = catalog.Goals[profile.goalIndex]
			if not goal or goalValue(profile, goal.Kind) &lt; goal.Target then break end
			reward += goal.Reward
			table.insert(names, goal.Title)
			profile.goalIndex += 1
		end
		profile.coins = math.min(MAX_COINS, profile.coins + reward)
		return reward, names
	end
	local function copy(profile: Profile): Profile
		local out = create()
		out.coins, out.level, out.catches, out.brilliant = profile.coins, profile.level, profile.catches, profile.brilliant
		out.goalIndex, out.duplicateCount = profile.goalIndex, profile.duplicateCount
		for id, rank in profile.best do out.best[id] = rank end
		for id, kg in profile.records or {} do out.records[id] = kg end
		for id, variants in profile.variants or {} do
			local owned = {}
			for variant, found in variants do owned[variant] = found end
			out.variants[id] = owned
		end
		out.display = {}
		if profile.display then
			for _, id in profile.display do table.insert(out.display, id) end
		else
			for _, species in catalog.Species do
				if out.best[species.Id] and #out.display &lt; 3 then table.insert(out.display, species.Id) end
			end
		end
		for id, owned in profile.styles or {} do out.styles[id] = owned end
		out.equippedStyle, out.combo = profile.equippedStyle or "lagoon", profile.combo or 0
		for id, count in profile.zoneDuplicates or {} do out.zoneDuplicates[id] = count end
		return out
	end
	local function snapshot(profile: Profile)
		local safe = copy(profile)
		local found, points = collection(profile)
		local goal = catalog.Goals[profile.goalIndex]
		local nextRod = catalog.Rods[profile.level + 2]
		return {
			coins = profile.coins, level = profile.level, species = found, points = points, best = safe.best,
			records = safe.records, variants = safe.variants, display = safe.display,
			styles = safe.styles, equippedStyle = safe.equippedStyle, combo = safe.combo,
			catches = profile.catches, zoneProgress = zoneProgress(profile),
			rod = catalog.Rods[profile.level + 1].Name,
			nextUpgrade = if nextRod then {
				name = nextRod.Name, cost = nextRod.Cost, description = nextRod.Description,
			} else nil,
			goal = if goal then {
				title = goal.Title, progress = math.min(goalValue(profile, goal.Kind), goal.Target),
				target = goal.Target, reward = goal.Reward,
			} else { title = "Journal complete! Show your finest fish and chase records.", progress = 1, target = 1, reward = 0 },
		}
	end
	local function catch(profile: Profile, quality: string, zoneId: string?)
		assert(ranks[quality], "Unknown catch quality")
		normalize(profile)
		local zoneKnown = zoneId == nil
		for _, zone in catalog.Zones or {} do if zone.Id == zoneId then zoneKnown = true end end
		assert(zoneKnown, "Unknown fishing zone")
		local available: { any } = {}
		local unseen: { any } = {}
		local totalWeight = 0
		for _, species in catalog.Species do
			if species.Level &lt;= profile.level and (zoneId == nil or species.Zone == zoneId) then
				table.insert(available, species)
				totalWeight += species.Weight
				if not profile.best[species.Id] then table.insert(unseen, species) end
			end
		end
		assert(#available &gt; 0, "Every accessible zone needs an available species")
		local duplicates = if zoneId then profile.zoneDuplicates[zoneId] or 0 else profile.duplicateCount
		local picked = available[1]
		-- Teach the first three catches; afterwards an unlocked discovery is never
		-- more than two duplicates away in the player's current island pool.
		if #unseen &gt; 0 and (profile.catches &lt; 3 or duplicates &gt;= 2) then
			picked = unseen[1]
		else
			local choice = roll() * totalWeight
			for _, species in available do
				choice -= species.Weight
				if choice &lt; 0 then picked = species; break end
			end
		end
		local previous = profile.best[picked.Id]
		local discovery = previous == nil
		profile.best[picked.Id] = math.max(previous or 0, ranks[quality])
		profile.duplicateCount = if discovery then 0 else math.min(MAX_COINS, profile.duplicateCount + 1)
		if zoneId then profile.zoneDuplicates[zoneId] = if discovery then 0 else math.min(MAX_COINS, duplicates + 1) end
		local sizeRoll = roll() ^ 2
		local minimum, maximum = picked.WeightMin or .4, picked.WeightMax or 4
		local weightKg = math.floor((minimum + (maximum - minimum) * sizeRoll) * 100 + .5) / 100
		local oldWeight = profile.records[picked.Id]
		local newRecord = oldWeight == nil or weightKg &gt; oldWeight
		profile.records[picked.Id] = math.max(oldWeight or 0, weightKg)
		local variant = "Normal"
		if profile.catches &gt;= 3 then
			local variantRoll = roll()
			variant = if variantRoll &gt;= .995 then "Prismatic" elseif variantRoll &gt;= .97 then "Golden" else "Normal"
		end
		if variant ~= "Normal" then
			local owned = profile.variants[picked.Id] or {}
			owned[variant] = true
			profile.variants[picked.Id] = owned
		end
		if discovery and #profile.display &lt; 3 then table.insert(profile.display, picked.Id) end
		profile.catches = math.min(MAX_COINS, profile.catches + 1)
		if quality == "Brilliant" then profile.brilliant = math.min(profile.catches, profile.brilliant + 1) end
		profile.combo = if quality == "Normal" then 0 else math.min(100, profile.combo + 1)
		local comboBonus = if profile.combo &gt; 1 then math.min(20, (profile.combo - 1) * 2) else 0
		local multiplier = 1 + catalog.Rods[profile.level + 1].Bonus / 100
		local coins = math.floor(picked.Coins * multiplier
			* (if quality == "Brilliant" then 1.6 elseif quality == "Fine" then 1.25 else 1)
			* (if variant == "Prismatic" then 2.5 elseif variant == "Golden" then 1.8 else 1)
			* (1 + sizeRoll * .25)) + comboBonus
		profile.coins = math.min(MAX_COINS, profile.coins + coins)
		local bonus, goals = resolveGoals(profile)
		return {
			species = picked.Name, speciesId = picked.Id, rarity = picked.Rarity, quality = quality,
			coins = coins, goalBonus = bonus, milestones = goals, newDiscovery = discovery,
			improved = previous ~= nil and ranks[quality] &gt; previous,
			weightKg = weightKg, variant = variant, newRecord = newRecord, combo = profile.combo, comboBonus = comboBonus,
			zoneId = picked.Zone,
		}
	end
	local function upgrade(profile: Profile): { success: boolean, message: string, goalBonus: number?, milestones: { string }? }
		local nextRod = catalog.Rods[profile.level + 2]
		if not nextRod then return { success = false, message = "Your rod is fully upgraded." } end
		if profile.coins &lt; nextRod.Cost then
			return { success = false, message = "Catch more fish to afford " .. nextRod.Name .. "." }
		end
		profile.coins -= nextRod.Cost
		profile.level += 1
		local bonus, goals = resolveGoals(profile)
		return { success = true, message = nextRod.Name .. " equipped!", goalBonus = bonus, milestones = goals }
	end
	local function display(profile: Profile, speciesId: any, slot: any)
		normalize(profile)
		if type(speciesId) ~= "string" or not profile.best[speciesId] then return { success = false, message = "Discover this fish before displaying it." } end
		if type(slot) ~= "number" or slot % 1 ~= 0 or slot &lt; 1 or slot &gt; 3 or slot &gt; #profile.display + 1 then
			return { success = false, message = "Choose one of your three aquarium slots." }
		end
		local previousSlot = table.find(profile.display, speciesId)
		if previousSlot == slot then return { success = true, message = "This fish is already on display." } end
		if previousSlot then
			local replaced = profile.display[slot]
			if not replaced then return { success = false, message = "This fish is already on display. Discover another fish for the empty slot." } end
			profile.display[previousSlot] = replaced
		end
		profile.display[slot] = speciesId
		return { success = true, message = catalog.get(speciesId).Name .. " is on display!" }
	end
	local function style(profile: Profile, styleId: any)
		normalize(profile)
		local selected = nil
		for _, candidate in catalog.AquariumStyles or {} do if candidate.Id == styleId then selected = candidate end end
		if not selected then return { success = false, message = "Choose an aquarium style from the shop." } end
		if not profile.styles[styleId] then
			if profile.coins &lt; selected.Cost then return { success = false, message = "Catch more fish to afford this aquarium style." } end
			profile.coins -= selected.Cost
			profile.styles[styleId] = true
		end
		profile.equippedStyle = styleId
		return { success = true, message = selected.Name .. " aquarium equipped!" }
	end
	local function miss(profile: Profile)
		normalize(profile)
		profile.combo = 0
	end
	return { create = create, snapshot = snapshot, catch = catch, upgrade = upgrade, copy = copy,
		display = display, style = style, miss = miss }
end

return Progression
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000001E">
      <Properties>
        <string name="Name">FishingSaveRules</string>
        <ProtectedString name="Source">--!strict
-- Atomic record transitions. UpdateAsync may retry its callback; no side effects here.
local SaveRules = {}
SaveRules.LeaseSeconds = 120
SaveRules.MaxOfflineSeconds = 8 * 60 * 60
SaveRules.MaxOfflineCoins = 120

local function uint(value: any, maximum: number): boolean
	return type(value) == "number" and value == value and value &gt;= 0 and value &lt;= maximum and value % 1 == 0
end

function SaveRules.new(catalog: any, progression: any)
	local speciesById: { [string]: any } = {}
	for _, species in catalog.Species do speciesById[species.Id] = species end
	local zones: { [string]: boolean } = {}
	for _, zone in catalog.Zones or {} do zones[zone.Id] = true end
	local styles: { [string]: boolean } = { lagoon = true }
	for _, style in catalog.AquariumStyles or {} do styles[style.Id] = true end
	local function validate(profile: any): boolean
		if type(profile) ~= "table" or type(profile.best) ~= "table" then return false end
		if not uint(profile.coins, 1000000000) or not uint(profile.level, #catalog.Rods - 1)
			or not uint(profile.catches, 1000000000) or not uint(profile.brilliant, profile.catches)
			or not uint(profile.duplicateCount, 1000000000) or not uint(profile.goalIndex, #catalog.Goals + 1)
			or profile.goalIndex &lt; 1 then return false end
		for id, rank in profile.best do
			if not speciesById[id] or not uint(rank, 3) or rank &lt; 1 then return false end
		end
		-- Optional extension fields allow version-1 saves from before aquariums to
		-- migrate through progression.copy. Present fields must be fully valid.
		if profile.records ~= nil then
			if type(profile.records) ~= "table" then return false end
			for id, kg in profile.records do
				local species = speciesById[id]
				if not species or not profile.best[id] or type(kg) ~= "number" or kg ~= kg
					or kg &lt; (species.WeightMin or .4) or kg &gt; (species.WeightMax or 4) then return false end
			end
		end
		if profile.variants ~= nil then
			if type(profile.variants) ~= "table" then return false end
			for id, owned in profile.variants do
				if not speciesById[id] or not profile.best[id] or type(owned) ~= "table" then return false end
				for variant, found in owned do
					if (variant ~= "Golden" and variant ~= "Prismatic") or found ~= true then return false end
				end
			end
		end
		if profile.display ~= nil then
			if type(profile.display) ~= "table" then return false end
			local seen, count = {}, 0
			for slot, id in profile.display do
				if not uint(slot, 3) or slot &lt; 1 or type(id) ~= "string" or not profile.best[id] or seen[id] then return false end
				seen[id] = true
				count += 1
			end
			for slot = 1, count do if not profile.display[slot] then return false end end
		end
		if profile.styles ~= nil then
			if type(profile.styles) ~= "table" or profile.styles.lagoon ~= true then return false end
			for id, owned in profile.styles do if not styles[id] or owned ~= true then return false end end
		end
		if profile.equippedStyle ~= nil then
			if type(profile.equippedStyle) ~= "string" or not styles[profile.equippedStyle]
				or (profile.equippedStyle ~= "lagoon" and (not profile.styles or not profile.styles[profile.equippedStyle])) then return false end
		end
		if profile.combo ~= nil and not uint(profile.combo, 100) then return false end
		if profile.zoneDuplicates ~= nil then
			if type(profile.zoneDuplicates) ~= "table" then return false end
			for id, count in profile.zoneDuplicates do if not zones[id] or not uint(count, 1000000000) then return false end end
		end
		return true
	end
	local function recordValid(record: any): boolean
		if type(record) ~= "table" or record.version ~= 1 or not validate(record.profile)
			or not uint(record.lastSeen, 100000000000) then return false end
		local lease = record.lease
		local award = record.offlineAward
		if award ~= nil and (type(award) ~= "table" or type(award.leaseId) ~= "string"
			or not uint(award.coins, SaveRules.MaxOfflineCoins)
			or not uint(award.seconds, SaveRules.MaxOfflineSeconds)) then return false end
		return lease == nil or (type(lease) == "table" and type(lease.id) == "string"
			and uint(lease.expires, 100000000000))
	end
	local function acquire(old: any, leaseId: string, now: number): (any?, string?)
		if old == nil then
			return { version = 1, profile = progression.create(), lastSeen = now,
				lease = { id = leaseId, expires = now + SaveRules.LeaseSeconds } }, nil
		end
		if not recordValid(old) then return nil, "invalid_data" end
		if old.lease and old.lease.id == leaseId then
			return { version = 1, profile = progression.copy(old.profile), lastSeen = now,
				lease = { id = leaseId, expires = now + SaveRules.LeaseSeconds }, offlineAward = old.offlineAward }, nil
		end
		if old.lease and old.lease.expires &gt; now then return nil, "active_session" end
		local profile = progression.copy(old.profile)
		local found = 0
		for _ in profile.best do found += 1 end
		local lastActive = if old.lease then math.max(old.lastSeen, old.lease.expires) else old.lastSeen
		local elapsed = math.clamp(now - lastActive, 0, SaveRules.MaxOfflineSeconds)
		local earned = math.min(SaveRules.MaxOfflineCoins, 1000000000 - profile.coins,
			math.floor(elapsed / 60 * found * 0.25))
		profile.coins = math.min(1000000000, profile.coins + earned)
		return {
			version = 1, profile = profile, lastSeen = now,
			lease = { id = leaseId, expires = now + SaveRules.LeaseSeconds },
			offlineAward = { leaseId = leaseId, coins = earned, seconds = elapsed },
		}, nil
	end
	local function save(old: any, profile: any, leaseId: string, now: number, release: boolean): (any?, string?)
		if not recordValid(old) or not validate(profile) then return nil, "invalid_data" end
		if not old.lease or old.lease.id ~= leaseId then return nil, "lost_lease" end
		return {
			version = 1, profile = progression.copy(profile), lastSeen = now,
			lease = if release then nil else { id = leaseId, expires = now + SaveRules.LeaseSeconds },
		}, nil
	end
	return { acquire = acquire, save = save, validate = validate }
end
return SaveRules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX0000001F">
      <Properties>
        <string name="Name">FishingProfileStore</string>
        <ProtectedString name="Source">--!strict
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local SaveRules = require(script.Parent:WaitForChild("FishingSaveRules"))
local Store = {}

function Store.new(catalog: any, progression: any, studio: boolean)
	-- Test saves never share the production namespace.
	local dataStore = DataStoreService:GetDataStore(if studio then "CloudAnglers_Test_v03" else "CloudAnglers_Player_v03")
	local rules = SaveRules.new(catalog, progression)
	local function update(key: string, transform: any): (any?, string?)
		local rejection: string? = nil
		for attempt = 1, 3 do
			local ok, value = pcall(function()
				return dataStore:UpdateAsync(key, function(old)
					local record, reason = transform(old)
					rejection = reason
					return record
				end)
			end)
			if ok then return value, rejection end
			if attempt &lt; 3 then task.wait(attempt) end
		end
		return nil, "unavailable"
	end
	local function load(userId: number): (any?, string?)
		local id = HttpService:GenerateGUID(false)
		local key = "player_" .. userId
		local record, reason = update(key, function(old) return rules.acquire(old, id, os.time()) end)
		for _ = 1, 3 do
			if reason ~= "active_session" then break end
			task.wait(2)
			record, reason = update(key, function(old) return rules.acquire(old, id, os.time()) end)
		end
		if not record or not record.lease or record.lease.id ~= id then return nil, reason or "lost_lease" end
		return {
			key = key, id = id, profile = record.profile, expires = record.lease.expires,
			lastSave = os.clock(), busy = false, closed = false, offline = record.offlineAward,
		}, nil
	end
	local function save(session: any, profile: any, release: boolean): (boolean, string?)
		if session.closed or session.busy then return false, "busy" end
		session.busy = true
		-- Keep a single snapshot across UpdateAsync retries.
		local copy = progression.copy(profile)
		local record, reason = update(session.key, function(old)
			return rules.save(old, copy, session.id, os.time(), release)
		end)
		session.busy = false
		if not record then return false, reason or "unavailable" end
		session.lastSave = os.clock()
		session.expires = if record.lease then record.lease.expires else 0
		if release then session.closed = true end
		return true, nil
	end
	return { load = load, save = save }
end
return Store
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00000020">
