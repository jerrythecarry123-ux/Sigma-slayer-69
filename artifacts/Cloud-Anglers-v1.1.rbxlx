require(script.Parent:WaitForChild("FishingService")).start()
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00000005">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CameraMaxZoomDistance">38</float>
      <float name="CharacterWalkSpeed">22</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00000008">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX00000021">
        <Properties>
          <string name="Name">FishingClient</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Rules = require(Shared:WaitForChild("FishingRules"))
local audio = require(script.Parent:WaitForChild("FishingAudio")).new()
local presentation = require(script.Parent:WaitForChild("FishingPresentation")).new(audio)
local Interface = require(script.Parent:WaitForChild("FishingInterface"))
local AquariumInterface = require(script.Parent:WaitForChild("AquariumInterface"))
local TravelInterface = require(script.Parent:WaitForChild("IslandTravelInterface"))
local remotes = ReplicatedStorage:WaitForChild("FishingRemotes")
local action = remotes:WaitForChild("FishingAction") :: RemoteEvent
local state = remotes:WaitForChild("FishingState") :: RemoteEvent
local visual = remotes:WaitForChild("FishingVisual") :: RemoteEvent
local player = Players.LocalPlayer
local packet: any = { phase = "Connecting", catches = 0, nextStart = 0 }
local ui: any = nil
local aquariumUI: any = nil
local pendingSince: number? = nil
local heldInput: InputObject? = nil
local heldConnection: RBXScriptConnection? = nil
local releasedBeforeAck = false
local visiblePrompts: {[ProximityPrompt]: boolean} = {}
local message = "The pond is right ahead. Cast your first line!"
local keyHint = if UserInputService.TouchEnabled then "" elseif UserInputService.GamepadEnabled then "  [RT]" else "  [E]"
local function now(): number return workspace:GetServerTimeNow() end
local function travelling(): boolean
	return player:GetAttribute("IslandTravelMenuOpen")==true or player:GetAttribute("IslandTravelBusy")==true
end
local function clearHeld()
	heldInput = nil
	if heldConnection then heldConnection:Disconnect() end
	heldConnection = nil
	if ui then TweenService:Create(ui.buttonScale, TweenInfo.new(0.12), { Scale = 1 }):Play() end
end
local function request(verb: string, argument: any?)
	pendingSince = now()
	action:FireServer(verb, if verb == "Upgrade" or verb == "Display" or verb == "Style" then argument else packet.attemptId)
end
local function cancel()
	clearHeld()
	releasedBeforeAck = false
	if packet.attemptId then request("Cancel") end
end
local function openAquarium()
	if travelling() then return end
	cancel()
	ui.closeJournal()
	ui.hideResult()
	aquariumUI.open()
end
aquariumUI = AquariumInterface.new(player:WaitForChild("PlayerGui"), {
	display = function(id: string, slot: number)
		if packet.profile and not pendingSince then request("Display", { id = id, slot = slot }) end
	end,
	style = function(id: string)
		if packet.profile and not pendingSince then request("Style", id) end
	end,
	visit = function()
		aquariumUI.close()
		cancel()
		ui.closeJournal()
		ui.hideResult()
		if not TravelInterface.visitGallery() then ui.notify("Your gallery is getting ready. Try again in a moment.") end
	end,
	close = function() end,
})
ui = Interface.new(player:WaitForChild("PlayerGui"), audio, {
	openJournal = function() cancel(); aquariumUI.close(); ui.hideResult() end,
	openAquarium = openAquarium,
	castAgain = function()
		ui.hideResult()
		if travelling() or aquariumUI.isOpen() or pendingSince or packet.phase ~= "Idle" or now() &lt; packet.nextStart then return end
		message = "Casting into the clouds..."
		request("Start")
	end,
	upgrade = function()
		if not packet.profile or pendingSince then return end
		request("Upgrade", packet.profile.level)
	end,
})
player:GetAttributeChangedSignal("IslandTravelMenuOpen"):Connect(function()
	if travelling() then cancel(); ui.hideResult(); ui.closeJournal(); aquariumUI.close() end
end)
task.spawn(TravelInterface.start)
local function release()
	if not heldInput then return end
	clearHeld()
	if packet.phase == "Reeling" then request("Release") else releasedBeforeAck = true end
end
local function press(input: InputObject)
	if travelling() then return end
	if ui.isJournalOpen() or aquariumUI.isOpen() then return end
	if ui.isResultOpen() then ui.hideResult(); return end
	if heldInput or pendingSince then return end
	if packet.phase == "Idle" and now() &gt;= packet.nextStart then
		ui.hideResult()
		message = "Casting into the clouds..."
		request("Start")
	elseif packet.phase == "Waiting" and now() &gt;= (packet.readyAt or math.huge) then
		heldInput, releasedBeforeAck = input, false
		TweenService:Create(ui.buttonScale, TweenInfo.new(0.1), { Scale = 0.95 }):Play()
		heldConnection = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.Cancel then cancel()
			elseif input.UserInputState == Enum.UserInputState.End then release() end
		end)
		request("Hold")
	end
end
ui.button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then press(input) end
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and next(visiblePrompts)==nil and (input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonR2)
		and not UserInputService:GetFocusedTextBox() then press(input) end
end)
UserInputService.InputEnded:Connect(function(input)
	local held = heldInput
	if not held then return end
	if input == held
		or (held.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
		or (held.KeyCode == Enum.KeyCode.E and input.KeyCode == Enum.KeyCode.E)
		or (held.KeyCode == Enum.KeyCode.ButtonR2 and input.KeyCode == Enum.KeyCode.ButtonR2) then release() end
end)
UserInputService.WindowFocusReleased:Connect(cancel)
UserInputService.TextBoxFocused:Connect(cancel)
ProximityPromptService.PromptShown:Connect(function(prompt)
	if prompt.Name == "RodWorkshopPrompt" or prompt.Name == "IslandTravelPrompt" or prompt.Name == "AquariumPrompt" then visiblePrompts[prompt]=true end
end)
ProximityPromptService.PromptHidden:Connect(function(prompt)
	visiblePrompts[prompt]=nil
end)
ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
	if prompt.Name == "RodWorkshopPrompt" and who == player and not travelling() then ui.openJournal("Workshop") end
	if prompt.Name == "AquariumPrompt" and who == player then openAquarium() end
end)
visual.OnClientEvent:Connect(presentation.apply)
state.OnClientEvent:Connect(function(incoming)
	local previousId, previousCatches = packet.attemptId, packet.catches
	packet, pendingSince = incoming, nil
	ui.updateProfile(packet.profile)
	aquariumUI.updateProfile(packet.profile)
	ui.updateLocation(packet.location, packet.profile)
	ui.setTimingWindow(packet.timingCenter or 0.68, 0.14)
	ui.setState(packet.phase)
	if packet.result and packet.catches &gt; previousCatches then
		local result = packet.result
		message = (if result.variant and result.variant ~= "Normal" then result.variant .. " " else "")
			.. result.species .. " · " .. result.quality .. (if result.weightKg then string.format(" · %.2f kg", result.weightKg) else "")
		ui.showResult(result)
		if (result.goalBonus or 0) &gt; 0 then
			ui.notify("Adventure complete! +" .. result.goalBonus .. " bonus coins")
			task.delay(0.45, audio.goal)
		elseif result.newDiscovery then ui.notify("New journal entry: " .. result.species) end
	elseif packet.message then message = packet.message end
	if packet.purchase then
		if packet.purchase.success then audio.upgrade(); ui.notify(packet.purchase.message)
		else audio.ui(false); ui.notify(packet.purchase.message) end
	end
	if packet.offline and packet.offline.coins &gt; 0 then
		ui.notify("Welcome back! Your collection earned " .. packet.offline.coins .. " coins.")
		audio.coins()
	end
	if packet.phase == "Idle" or packet.attemptId ~= previousId then clearHeld(); releasedBeforeAck = false end
	if packet.phase == "Waiting" and packet.attemptId ~= previousId then ui.hideResult() end
	audio.setReeling(packet.phase == "Reeling")
	if (ui.isJournalOpen() or aquariumUI.isOpen() or travelling()) and packet.phase == "Waiting" then request("Cancel"); return end
	if packet.phase == "Reeling" then
		if releasedBeforeAck then releasedBeforeAck = false; request("Release")
		elseif not heldInput then request("Cancel") end
	end
end)
RunService.RenderStepped:Connect(function()
	local time = now()
	if pendingSince and time - pendingSince &gt; 3 then clearHeld(); releasedBeforeAck = false; request("Sync") end
	local camera = workspace.CurrentCamera
	if camera then
		ui.animate(time, camera.ViewportSize.X, camera.ViewportSize.Y)
		aquariumUI.animate(time, camera.ViewportSize.X, camera.ViewportSize.Y)
	end
	ui.button.BackgroundColor3 = Color3.fromRGB(37, 119, 109)
	ui.legend.Text = "NORMAL  ·  FINE  ·  BRILLIANT"
	if packet.phase == "Waiting" then
		if time &lt; (packet.readyAt or math.huge) then
			ui.status.Text, ui.button.Text = "Watch your bobber...", "CASTING..."
		else
			ui.status.Text = "BITE! Hold, then release inside the zone."
			ui.button.Text = if pendingSince then "ONE MOMENT..." else "HOLD TO REEL" .. keyHint
		end
	elseif packet.phase == "Reeling" then
		local progress = math.clamp((time - (packet.chargeAt or time)) / (packet.duration or 1), 0, 1)
		ui.marker.Position = UDim2.fromScale(progress, 0)
		local quality = Rules.qualityAt(progress, packet.timingCenter)
		ui.legend.Text = "NOW: " .. string.upper(quality or "OUTSIDE THE ZONE")
		ui.status.Text = if pendingSince then "Checking your catch..." else "Release in the zone. Aim for gold!"
		ui.button.Text = if pendingSince then "ONE MOMENT..." else "RELEASE!"
		ui.button.BackgroundColor3 = Color3.fromRGB(151, 105, 31)
	elseif packet.phase == "Idle" then
		ui.status.Text = message
		ui.button.Text = if pendingSince then "ONE MOMENT..." elseif time &lt; packet.nextStart then "GET READY..." else "CAST LINE" .. keyHint
	else
		ui.status.Text = "Loading your collection safely..."
		ui.button.Text = "CONNECTING..."
	end
end)
request("Sync")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000022">
        <Properties>
          <string name="Name">FishingAudio</string>
          <ProtectedString name="Source">--!strict
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Audio = {}
-- Same six shipped clips as v0.3. This release changes their mix, not the library.
local clips = {
	Cast = "rbxasset://sounds/action_jump.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Chime = "rbxasset://sounds/electronicpingshort.wav",
	Reel = "rbxasset://sounds/action_swim.mp3",
	Miss = "rbxasset://sounds/action_jump_land.mp3",
	Wind = "rbxasset://sounds/action_falling.mp3",
}
local trim = { Cast = 0.62, Splash = 0.65, Chime = 0.52, Reel = 0.5, Miss = 0.55, Wind = 0.5 }
function Audio.new()
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "CloudAnglersSounds", SoundService
	local group = Instance.new("SoundGroup")
	group.Name, group.Volume, group.Parent = "CloudAnglersMix", 0.75, SoundService
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name, eq.HighGain, eq.MidGain, eq.LowGain, eq.Parent = "SoftenUpperFrequencies", -7, -1, -2, group
	local compressor = Instance.new("CompressorSoundEffect")
	compressor.Name, compressor.Threshold, compressor.Ratio = "GentlePeakControl", -14, 3
	compressor.Attack, compressor.Release, compressor.GainMakeup, compressor.Parent = 0.02, 0.15, 0, group
	local templates: { [string]: Sound } = {}
	local preload: { Instance } = {}
	for name, path in clips do
		local sound = Instance.new("Sound")
		sound.Name, sound.SoundId, sound.SoundGroup = name, path, group
		sound.Volume, sound.RollOffMinDistance, sound.RollOffMaxDistance = 0.2, 7, 48
		sound.RollOffMode, sound.Parent = Enum.RollOffMode.InverseTapered, folder
		templates[name] = sound
		table.insert(preload, sound)
	end
	task.spawn(function()
		local ok, err = pcall(function() ContentProvider:PreloadAsync(preload) end)
		if not ok then warn("Cloud Anglers: sound preload failed: " .. tostring(err)) end
	end)
	local muted, reeling = false, false
	local reel: Sound? = nil
	local voices: { Sound } = {}
	local lastUi = -math.huge
	local melodyUntil = 0
	local rewardGeneration = 0
	local wind = templates.Wind:Clone()
	wind.Looped, wind.Volume, wind.PlaybackSpeed, wind.Parent = true, 0, 0.62, folder
	wind:Play()
	local windTween: Tween? = TweenService:Create(wind, TweenInfo.new(2), { Volume = 0.018 })
	windTween:Play()
	local function ambience(volume: number)
		if windTween then windTween:Cancel() end
		windTween = TweenService:Create(wind, TweenInfo.new(0.45), { Volume = volume })
		windTween:Play()
	end
	local function play(name: string, pitch: number?, parent: Instance?, volume: number?)
		local template = templates[name]
		if not template or muted then return end
		for i = #voices, 1, -1 do if not voices[i].Parent then table.remove(voices, i) end end
		-- Multiplayer casts cannot create an unlimited pile of overlapping sounds.
		if #voices &gt;= 10 then voices[1]:Destroy(); table.remove(voices, 1) end
		local sound = template:Clone()
		sound.PlaybackSpeed = math.clamp(pitch or 1, 0.7, 1.45)
		sound.Volume = math.clamp((volume or 0.25) * (trim[name] or 0.6), 0, 0.3)
		sound.Parent = parent or folder
		table.insert(voices, sound)
		sound.Ended:Once(function() sound:Destroy() end)
		sound:Play()
		Debris:AddItem(sound, 5)
	end
	local function setReeling(enabled: boolean)
		if reeling == enabled then return end
		reeling = enabled
		ambience(if enabled then 0.006 elseif os.clock() &lt; melodyUntil then 0.005 else 0.018)
		if enabled then
			local sound = templates.Reel:Clone()
			sound.Looped, sound.PlaybackSpeed, sound.Volume, sound.Parent = true, 1.08, 0, folder
			sound:Play()
			TweenService:Create(sound, TweenInfo.new(0.25), { Volume = 0.055 }):Play()
			reel = sound
		elseif reel then
			TweenService:Create(reel, TweenInfo.new(0.18), { Volume = 0 }):Play()
			Debris:AddItem(reel, 0.22)
			reel = nil
		end
	end
	-- One short reward phrase owns the foreground, so goals do not stack on catches.
	local function phrase(pitches: { number }, volume: number)
		rewardGeneration += 1
		local generation = rewardGeneration
		melodyUntil = os.clock() + 0.8
		ambience(0.005)
		for i, pitch in pitches do
			task.delay((i - 1) * 0.18, function()
				if generation == rewardGeneration then play("Chime", pitch, nil, volume * (1 - (i - 1) * 0.16)) end
			end)
		end
		task.delay(0.85, function()
			if generation == rewardGeneration then ambience(if reeling then 0.006 else 0.018) end
		end)
	end
	return {
		play = play, setReeling = setReeling,
		catch = function(quality: string, rarity: string?, _discovery: boolean?)
			local pitch = if rarity == "Epic" then 1.08 elseif quality == "Brilliant" then 1 else 0.88
			phrase({ pitch, pitch * 1.25 }, 0.36)
		end,
		ui = function(success: boolean?)
			if os.clock() - lastUi &lt; 0.14 then return end
			lastUi = os.clock()
			play(if success == false then "Miss" else "Chime", if success == false then 0.88 else 1.12, nil, 0.09)
		end,
		coins = function() phrase({ 1, 1.25 }, 0.24) end,
		goal = function()
			if os.clock() &lt; melodyUntil then return end
			phrase({ 0.94, 1.18 }, 0.26)
		end,
		upgrade = function() phrase({ 0.82, 1, 1.25 }, 0.34) end,
		toggle = function(): boolean
			muted = not muted
			group.Volume = if muted then 0 else 0.75
			return muted
		end,
	}
end
return Audio
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000023">
        <Properties>
          <string name="Name">FishingPresentation</string>
          <ProtectedString name="Source">--!strict
-- Local procedural animation, driven exclusively by server-approved state.
-- Every client renders the same casts; no animation asset uploads are required.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Config = require(Shared:WaitForChild("FishingConfig"))
local Fish = require(Shared:WaitForChild("FishModel"))
local Scenery = require(script.Parent:WaitForChild("WorldScenery"))
local Presentation = {}

type Actor = {
	player: Player, character: Model?, rig: Model?, tip: Attachment?,
	bobber: Part?, line: Beam?, state: any, landed: boolean, bite: boolean,
	lastCatches: number, castFrom: Vector3?, caughtFish: Model?, catchAt: number,
	catchFrom: Vector3, shoulder: Motor6D?, leftShoulder: Motor6D?, pitch: number, poseWeight: number,
}

local function visualPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cf
	object.Color = color
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.CastShadow = false
	object.Material = Enum.Material.SmoothPlastic
	object.Parent = parent
	return object
end

function Presentation.new(audio: any)
	Scenery.start()
	local folder = Instance.new("Folder")
	folder.Name = "CloudAnglersEffects"
	folder.Parent = workspace
	local actors: { [number]: Actor } = {}
	local random = Random.new()

	local function ripple(position: Vector3)
		local ring = visualPart(folder, "Ripple", Vector3.new(0.06, 0.8, 0.8),
			CFrame.new(position - Vector3.yAxis * 0.25) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(229, 251, 255))
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.45
		TweenService:Create(ring, TweenInfo.new(0.65, Enum.EasingStyle.Quad),
			{ Size = Vector3.new(0.04, 6, 6), Transparency = 1 }):Play()
		Debris:AddItem(ring, 0.7)
	end

	local function burst(position: Vector3, golden: boolean)
		for _ = 1, 12 do
			local size = random:NextNumber(0.12, 0.3)
			local bubble = visualPart(folder, "CatchSpark", Vector3.new(size, size, size), CFrame.new(position),
				if golden then Color3.fromRGB(255, 218, 120) else Color3.fromRGB(182, 239, 250))
			bubble.Shape = Enum.PartType.Ball
			bubble.Material = Enum.Material.SmoothPlastic
			TweenService:Create(bubble, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = position + Vector3.new(random:NextNumber(-2, 2), random:NextNumber(1, 4), random:NextNumber(-2, 2)),
				Transparency = 1,
			}):Play()
			Debris:AddItem(bubble, 0.7)
		end
	end

	local function clearRig(actor: Actor)
		if actor.shoulder and actor.shoulder.Parent then actor.shoulder.Transform = CFrame.identity end
		if actor.leftShoulder and actor.leftShoulder.Parent then actor.leftShoulder.Transform = CFrame.identity end
		if actor.rig then actor.rig:Destroy() end
		if actor.bobber then actor.bobber:Destroy() end
		if actor.caughtFish then actor.caughtFish:Destroy() end
		actor.rig, actor.tip, actor.bobber, actor.line = nil, nil, nil, nil
		actor.shoulder, actor.leftShoulder, actor.caughtFish = nil, nil, nil
	end

	local function getActor(player: Player): Actor
		local existing = actors[player.UserId]
		if existing then return existing end
		local actor: Actor = {
			player = player, state = { phase = "Idle", catches = 0 }, landed = false, bite = false,
			lastCatches = 0, catchAt = 0, catchFrom = Vector3.zero, pitch = 0, poseWeight = 0,
		}
		actors[player.UserId] = actor
		return actor
	end

	local function ensureRig(actor: Actor): BasePart?
		local character = actor.player.Character
		if character ~= actor.character then
			clearRig(actor)
			if actor.character then actor.state = { phase = "Idle", catches = actor.lastCatches } end
			actor.character = character
		end
		if not character then return nil end
		local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
		if not hand or not hand:IsA("BasePart") then return nil end
		if not actor.rig then
			local rig = Instance.new("Model")
			rig.Name = "FishingRod_" .. actor.player.UserId
			local origin = visualPart(rig, "Grip", Vector3.new(0.28, 0.8, 0.28), CFrame.identity, Color3.fromRGB(101, 76, 66))
			rig.PrimaryPart = origin
			visualPart(rig, "Rod", Vector3.new(0.13, 1.55, 0.13), CFrame.new(0, 1.15, 0), Color3.fromRGB(78, 174, 188))
			visualPart(rig, "RodMiddle", Vector3.new(0.105, 1.2, 0.105), CFrame.new(0, 2.525, 0), Color3.fromRGB(78, 174, 188))
			local shaft = visualPart(rig, "RodTip", Vector3.new(0.075, 0.55, 0.075), CFrame.new(0, 3.4, 0), Color3.fromRGB(78, 174, 188))
			visualPart(rig, "Reel", Vector3.new(0.45, 0.45, 0.32), CFrame.new(0, 0.35, -0.25), Color3.fromRGB(243, 196, 107))
			local tip = Instance.new("Attachment")
			tip.Position = Vector3.new(0, 0.275, 0)
			tip.Parent = shaft
			rig.Parent = folder
			actor.rig, actor.tip = rig, tip
			local right = character:FindFirstChild("RightShoulder", true) or character:FindFirstChild("Right Shoulder", true)
			local left = character:FindFirstChild("LeftShoulder", true) or character:FindFirstChild("Left Shoulder", true)
			actor.shoulder = if right and right:IsA("Motor6D") then right else nil
			actor.leftShoulder = if left and left:IsA("Motor6D") then left else nil
		end
		return hand
	end

	local function createBobber(actor: Actor)
		if actor.bobber or not actor.tip or not actor.rig then return end
		local bobber = visualPart(folder, "Bobber_" .. actor.player.UserId, Vector3.new(0.65, 0.65, 0.65),
			CFrame.new(actor.castFrom or Vector3.zero), Color3.fromRGB(255, 129, 111))
		bobber.Shape = Enum.PartType.Ball
		bobber.Material = Enum.Material.SmoothPlastic
		local anchor = Instance.new("Attachment")
		anchor.Parent = bobber
		local beam = Instance.new("Beam")
		beam.Attachment0 = actor.tip
		beam.Attachment1 = anchor
		beam.Width0, beam.Width1 = 0.045, 0.025
		beam.FaceCamera = true
		beam.Segments = 12
		beam.Color = ColorSequence.new(Color3.fromRGB(242, 248, 235))
		beam.Transparency = NumberSequence.new(0.12)
		beam.Parent = bobber
		actor.bobber, actor.line = bobber, beam
	end

	local function biteCue(actor: Actor)
		local bobber = actor.bobber
		if not bobber then return end
		actor.bite = true
		ripple(bobber.Position)
		audio.play("Chime", 1.1, bobber, 0.34)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(60, 72)
		gui.StudsOffset = Vector3.new(0, 2, 0)
		gui.AlwaysOnTop = true
		gui.Parent = bobber
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "!"
		label.Font = Enum.Font.GothamBlack
		label.TextSize = 52
		label.TextColor3 = Color3.fromRGB(255, 221, 115)
		label.TextStrokeTransparency = 0.2
		label.Parent = gui
		TweenService:Create(gui, TweenInfo.new(0.3, Enum.EasingStyle.Back), { StudsOffset = Vector3.new(0, 3, 0) }):Play()
		Debris:AddItem(gui, 0.85)
	end

	local function apply(userId: number, incoming: any)
		local player = Players:GetPlayerByUserId(userId)
		if not player then return end
		local actor = getActor(player)
		local previous = actor.state
		local changed = previous.phase ~= incoming.phase or previous.attemptId ~= incoming.attemptId
		local freshCatch = incoming.result ~= nil and incoming.catches &gt; actor.lastCatches
		local hand = ensureRig(actor)
		actor.state = incoming
		actor.lastCatches = incoming.catches
		if changed and incoming.phase == "Waiting" then
			actor.landed, actor.bite = false, false
			if actor.caughtFish then actor.caughtFish:Destroy(); actor.caughtFish = nil end
			actor.castFrom = if hand then hand.Position + Vector3.new(0, 2, 0) else incoming.castTarget
			if actor.bobber then actor.bobber:Destroy() end
			actor.bobber, actor.line = nil, nil
			createBobber(actor)
			if hand then audio.play("Cast", 0.94, hand, 0.26) end
		end
		if incoming.phase == "Idle" then
			local position = if actor.bobber then actor.bobber.Position else incoming.castTarget
			if freshCatch and position then
				if actor.caughtFish then actor.caughtFish:Destroy() end
				actor.caughtFish = Fish.create(folder, "CaughtFish", incoming.result.speciesId)
				Fish.applyAppearance(actor.caughtFish, incoming.result.variant, incoming.result.weightKg)
				actor.catchAt = workspace:GetServerTimeNow()
				actor.catchFrom = position
				burst(position, incoming.result.quality == "Brilliant" or incoming.result.variant == "Golden")
				ripple(position)
			elseif changed and previous.phase == "Reeling" and position then
				burst(position, false)
				if player == Players.LocalPlayer then audio.play("Miss", 0.8, nil, 0.16) end
			end
			if actor.bobber then actor.bobber:Destroy() end
			actor.bobber, actor.line = nil, nil
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		local actor = actors[player.UserId]
		if actor then clearRig(actor) end
		actors[player.UserId] = nil
	end)

	RunService.PreSimulation:Connect(function(deltaTime)
		-- Animator writes Transform before PreSimulation. This pass supplies the fishing pose.
		for _, actor in actors do
			local active = actor.state.phase == "Waiting" or actor.state.phase == "Reeling" or actor.caughtFish ~= nil
			local previousWeight = actor.poseWeight
			local target = if active then 1 else 0
			actor.poseWeight += (target - actor.poseWeight) * (1 - math.exp(-deltaTime * 14))
			if actor.poseWeight &lt; 0.001 then actor.poseWeight = 0 end
			if actor.poseWeight &gt; 0 then
				if actor.shoulder then
					actor.shoulder.Transform = CFrame.identity:Lerp(CFrame.Angles(1.05 + actor.pitch * 0.3, 0, -0.18), actor.poseWeight)
				end
				if actor.leftShoulder then
					actor.leftShoulder.Transform = CFrame.identity:Lerp(CFrame.Angles(0.7, 0.1, 0.4), actor.poseWeight)
				end
			elseif previousWeight &gt; 0 then
				if actor.shoulder then actor.shoulder.Transform = CFrame.identity end
				if actor.leftShoulder then actor.leftShoulder.Transform = CFrame.identity end
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		local time = workspace:GetServerTimeNow()
		local camera = workspace.CurrentCamera
		for _, player in Players:GetPlayers() do getActor(player) end
		for _, actor in actors do
			local character = actor.player.Character
			local candidateRoot = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if camera and candidateRoot and candidateRoot:IsA("BasePart") and (candidateRoot.Position - camera.CFrame.Position).Magnitude &gt; 180 then
				if actor.rig then clearRig(actor) end
				continue
			end
			local hand = ensureRig(actor)
			local root = if actor.character then actor.character:FindFirstChild("HumanoidRootPart") else nil
			if not hand or not root or not root:IsA("BasePart") or not actor.rig then continue end
			local packet = actor.state
			local active = packet.phase == "Waiting" or packet.phase == "Reeling"
			local target = packet.castTarget or (root.Position + root.CFrame.LookVector * 14)
			local flat = (target - root.Position) * Vector3.new(1, 0, 1)
			local forward = if flat.Magnitude &gt; 0.1 then flat.Unit else root.CFrame.LookVector
			local castT = if packet.readyAt then math.clamp((time - packet.readyAt + Config.PreparationTime) / 0.65, 0, 1) else 1
			local pitch = 0.95
			if packet.phase == "Waiting" then
				pitch = if castT &lt; 0.35 then 0.6 + castT / 0.35 else 1.6 - (castT - 0.35) / 0.65 * 1.1
			elseif packet.phase == "Reeling" then
				pitch = 0.65 + math.sin(time * 18) * 0.07
			end
			actor.pitch = pitch
			local direction = forward * math.cos(pitch) + Vector3.yAxis * math.sin(pitch)
			actor.rig:PivotTo(CFrame.lookAt(hand.Position, hand.Position + direction) * CFrame.Angles(-math.pi / 2, 0, 0))
			local level = packet.rodLevel or 0
			local rodColor = if level &gt;= 3 then Color3.fromRGB(222, 181, 87)
				elseif level &gt;= 2 then Color3.fromRGB(166, 136, 211) else Color3.fromRGB(68, 154, 167)
			local tension = if packet.phase == "Reeling" then math.clamp((time - (packet.chargeAt or time)) / (packet.duration or 1), 0, 1) else 0
			local bend = if packet.phase == "Reeling" then 0.07 + tension * 0.22 + math.sin(time * 17) * 0.025 else 0.015
			local rodPivot = actor.rig:GetPivot()
			local middleFrame = rodPivot * CFrame.new(0, 1.925, 0) * CFrame.Angles(-bend, 0, 0) * CFrame.new(0, 0.6, 0)
			for _, partName in { "Rod", "RodMiddle", "RodTip" } do
				local shaft = actor.rig:FindFirstChild(partName)
				if shaft and shaft:IsA("BasePart") then
					shaft.Color = rodColor
					if partName == "RodMiddle" then shaft.CFrame = middleFrame
					elseif partName == "RodTip" then shaft.CFrame = middleFrame * CFrame.new(0, 0.6, 0) * CFrame.Angles(-bend * 0.5, 0, 0) * CFrame.new(0, 0.275, 0) end
				end
			end
			if active then
				createBobber(actor)
				local bobber = actor.bobber
				if bobber then
					local from = actor.castFrom or hand.Position
					local arc = from:Lerp(target, castT) + Vector3.new(0, math.sin(castT * math.pi) * 5, 0)
					if castT &gt;= 1 then
						local bob = math.sin(time * (if packet.phase == "Reeling" then 22 else 3)) * 0.12
						local nibble = if not actor.bite and time &gt; (packet.readyAt or math.huge) - 0.2 then math.sin(time * 30) * 0.11 else 0
						local tug = if packet.phase == "Reeling" then math.sin(time * 9) * 0.16 else 0
						arc = target + Vector3.new(forward.Z * tug, bob + nibble - (if actor.bite then 0.25 else 0), -forward.X * tug)
						if not actor.landed then
							actor.landed = true
							ripple(target)
							audio.play("Splash", 0.95, bobber, 0.32)
						end
					end
					bobber.Position = arc
					if not actor.bite and time &gt;= packet.readyAt then biteCue(actor) end
					if actor.line then actor.line.CurveSize0 = if packet.phase == "Reeling" then 0 else 0.7 end
				end
			end
			if actor.caughtFish then
				local elapsed = time - actor.catchAt
				local t = math.clamp(elapsed / 0.95, 0, 1)
				local destination = root.Position + Vector3.new(0, 3.5, 0) + root.CFrame.LookVector * 1.6
				local position = actor.catchFrom:Lerp(destination, t) + Vector3.new(0, math.sin(t * math.pi) * 6.2, 0)
				actor.caughtFish:PivotTo(CFrame.new(position) * CFrame.Angles(0, t * math.pi * 2, math.sin(t * 8) * 0.18))
				Fish.animate(actor.caughtFish, time)
				if elapsed &gt;= 1.3 then
					burst(destination, packet.result ~= nil and (packet.result.quality == "Brilliant" or packet.result.variant == "Golden"))
					actor.caughtFish:Destroy()
					actor.caughtFish = nil
				end
			end
		end
	end)

	return { apply = apply }
end

return Presentation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000024">
        <Properties>
          <string name="Name">ResidentPresentation</string>
          <ProtectedString name="Source">--!strict
-- Cosmetic, deterministic life for the streamed islands. Discovery happens on
-- arrival; animation never searches the world or simulates NPCs on the server.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Presentation = {}
local started = false
local WORLD_NAME = "MolnfiskarnaPrototype"
local STEP, MAX_DISTANCE = 1 / 20, 180

type Joint = { model: Model, rest: CFrame }
type Eye = { part: BasePart, size: Vector3, glint: boolean }
type Actor = {
	model: Model, kind: string, style: string, origin: CFrame, phase: number,
	period: number, radius: Vector3, travel: Vector3?, width: number,
	joints: { [string]: Joint }, eyes: {Eye},
	line: BasePart?, rod: BasePart?, bobber: BasePart?, lineEnd: Vector3?,
	spout: BasePart?, drops: {BasePart}, waterTarget: Vector3?,
	near: boolean, greetingAt: number?, nextGreeting: number,
	gazeYaw: number, gazePitch: number, attention: number,
	stridePhase: number, lastTime: number?,
}

local JOINTS = { "ArmLeft", "ArmRight", "LegLeft", "LegRight", "HeadPose", "WingLeft", "WingRight" }
local ALLOWED_KINDS = { Resident = true, Gull = true, Butterfly = true, FishSchool = true }

local function finite(value: any): boolean
	return typeof(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

local function finiteVector(value: any): boolean
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end

local function bounded(value: any, low: number, high: number, fallback: number): number
	return if finite(value) then math.clamp(value, low, high) else fallback
end

local function namedActor(instance: Instance): boolean
	return instance:IsA("Model") and (string.sub(instance.Name, 1, 9) == "Resident_"
		or string.sub(instance.Name, 1, 11) == "IslandGull_"
		or string.sub(instance.Name, 1, 16) == "GardenButterfly_"
		or string.sub(instance.Name, 1, 17) == "LagoonFishSchool_"
		or instance:GetAttribute("AmbientKind") ~= nil)
end

local function namedJoint(instance: Instance): boolean
	if not instance:IsA("Model") then return false end
	for _, name in JOINTS do if instance.Name == name then return true end end
	return false
end

local function pose(actor: Actor, body: CFrame, name: string, pitch: number, yaw: number, roll: number)
	local joint = actor.joints[name]
	if joint and joint.model.Parent and joint.model.PrimaryPart then
		joint.model:PivotTo(body * joint.rest * CFrame.Angles(pitch, yaw, roll))
	end
end

local function inhabitant(actor: Actor, time: number, viewer: Vector3?)
	local t = time + actor.phase
	local dt = if actor.lastTime then math.clamp(time - actor.lastTime, 0, .1) else STEP
	actor.lastTime = time
	local body = actor.origin
	local walking = actor.style == "Walk" and actor.travel and actor.travel.Magnitude &gt; .1
	local stride = 0
	if walking and actor.travel then
		-- The feet follow distance travelled around the oval, so the slower end
		-- turns no longer use the same fast walk cycle as its long straight sides.
		local angle = t * math.pi * 2 / actor.period
		local perpendicular = Vector3.new(actor.travel.Z, 0, -actor.travel.X).Unit
		local position = actor.origin.Position + actor.travel * ((1 - math.cos(angle)) * .5)
			+ perpendicular * math.sin(angle) * actor.width
		local tangent = actor.travel * (math.sin(angle) * .5) + perpendicular * math.cos(angle) * actor.width
		local speed = tangent.Magnitude * math.pi * 2 / actor.period
		actor.stridePhase += speed * dt * 3.35
		stride = math.sin(actor.stridePhase)
		local lift = Vector3.yAxis * math.abs(stride) * .045
		body = CFrame.lookAt(position + lift, position + tangent + lift)
	else
		body *= CFrame.new(0, math.sin(t * 1.4) * .018, 0)
			* CFrame.Angles(0, math.sin(t * .29) * .018, math.sin(t * .6) * .006)
	end
	actor.model:PivotTo(body)

	local targetYaw, targetPitch, interest = 0, 0, 0
	if viewer then
		local relative = body:PointToObjectSpace(viewer)
		local distance = Vector3.new(relative.X, 0, relative.Z).Magnitude
		local inFront = relative.Z &lt; 1
		if distance &gt; 17 or relative.Z &gt; 6 then actor.near = false end
		if distance &lt; 13 and inFront then
			interest = 1
			targetYaw = math.clamp(math.atan2(-relative.X, -relative.Z), -.5, .5)
			targetPitch = math.clamp(math.atan2(relative.Y + 1.3 - 4.16, math.max(1, distance)), -.14, .14)
			if not actor.near and time &gt;= actor.nextGreeting then
				actor.greetingAt, actor.nextGreeting = time, time + 16 + actor.phase
			end
			actor.near = true
		end
	else actor.near = false end
	local blend = 1 - math.exp(-dt * 6)
	actor.gazeYaw += (targetYaw - actor.gazeYaw) * blend
	actor.gazePitch += (targetPitch - actor.gazePitch) * blend
	actor.attention += (interest - actor.attention) * blend
	local greeting = if actor.greetingAt then math.clamp((time - actor.greetingAt) / 1.7, 0, 1) else 1
	local wave = if greeting &gt; 0 and greeting &lt; 1 then math.sin(greeting * math.pi) ^ 2 else 0

	local leftPitch, rightPitch, leftRoll, rightRoll = .04, -.04, -.08, .08
	local headPitch, headYaw = math.sin(t * .7) * .018, math.sin(t * .31) * .10
	local pouring = 0
	if walking then
		leftPitch, rightPitch = stride * .35, -stride * .35
		pose(actor, body, "LegLeft", -stride * .28, 0, 0)
		pose(actor, body, "LegRight", stride * .28, 0, 0)
	else
		pose(actor, body, "LegLeft", 0, 0, -.012)
		pose(actor, body, "LegRight", 0, 0, .012)
		if actor.style == "Repair" then
			local working = (t % 7) &lt; 4.5
			rightPitch = .045 + (if working then math.sin(t * 3.1) * .025 else 0)
			leftPitch, headPitch, headYaw = .08, -.13, -.10
		elseif actor.style == "Fish" then
			rightPitch = math.sin(t * .8) * .012
			leftPitch, leftRoll = .45 + math.sin(t * 1.1) * .045, -.18
			headPitch = -.045
		elseif actor.style == "Garden" then
			local cycle = (t % 9) / 9
			if cycle &gt; .18 and cycle &lt; .67 then pouring = math.sin((cycle - .18) / .49 * math.pi) ^ 2 end
			pouring *= 1 - wave
			rightPitch, rightRoll = .04 + pouring * .18, .03 + pouring * .11
			leftPitch, headPitch = .10, -.13
		elseif actor.style == "Lookout" then
			local cycle = t % 15
			local glance = if cycle &gt; 8 and cycle &lt; 11 then math.sin((cycle - 8) / 3 * math.pi) ^ 2 else 0
			rightPitch, headYaw = glance * 2.45, math.sin(t * .22) * .22
		elseif actor.style == "Serve" then
			-- Keep the loaded tray level; the empty hand greets actual visitors.
			rightPitch, rightRoll = 0, 0
		end
	end
	if wave &gt; .001 then
		if actor.style == "Wave" or actor.style == "Walk" then
			rightRoll, rightPitch = wave * (2.15 + math.sin(greeting * 17) * .10), .08
		else
			leftRoll, leftPitch = -wave * (2.15 + math.sin(greeting * 17) * .10), .08
		end
	end
	headPitch = headPitch * (1 - actor.attention) + actor.gazePitch
	headYaw = headYaw * (1 - actor.attention) + actor.gazeYaw
	pose(actor, body, "ArmLeft", leftPitch, 0, leftRoll)
	pose(actor, body, "ArmRight", rightPitch, 0, rightRoll)
	pose(actor, body, "HeadPose", headPitch, headYaw, math.sin(t * .65) * .015)

	-- Eye dimensions are authored once, so a streamed or repeatedly refreshed
	-- face can never adopt an already-squashed blink as its new resting shape.
	local cycle = t % (4.6 + math.abs(actor.phase) * .13)
	local blink = if cycle &lt; .16 then math.sin(cycle / .16 * math.pi) ^ 2 else 0
	for _, eye in actor.eyes do
		if eye.part.Parent then
			eye.part.Size = Vector3.new(eye.size.X, eye.size.Y * (1 - blink * .92), eye.size.Z)
			if eye.glint then eye.part.Transparency = blink end
		end
	end
	if actor.line and actor.rod and actor.bobber and actor.lineEnd
		and actor.line.Parent and actor.rod.Parent and actor.bobber.Parent then
		local rod, endpoint = actor.rod, actor.lineEnd + Vector3.yAxis * math.sin(t * 2.2) * .025
		local tip = rod.Position + rod.CFrame.RightVector * rod.Size.X * .5
		local length = (endpoint - tip).Magnitude
		if length &gt; .001 then
			actor.line.Size = Vector3.new(length, .025, .025)
			actor.line.CFrame = CFrame.lookAt((tip + endpoint) / 2, endpoint) * CFrame.Angles(0, math.pi / 2, 0)
			actor.bobber.Position = endpoint
		end
	end
	if actor.spout and actor.spout.Parent and actor.waterTarget then
		local spout = actor.spout
		local start = spout.Position + spout.CFrame.RightVector * spout.Size.X * .5
		for index, drop in actor.drops do
			if not drop.Parent then continue end
			local progress = (time * 1.5 + index / 3) % 1
			drop.Position = start:Lerp(actor.waterTarget, progress) + Vector3.yAxis * math.sin(progress * math.pi) * .06
			drop.Transparency = if pouring &gt; .3 and progress &gt; .08 and progress &lt; .92 then .35 else 1
		end
	end
end

local function wildlife(actor: Actor, time: number)
	local angle = time * math.pi * 2 / actor.period + actor.phase
	local radius = actor.radius
	local offset = Vector3.new(math.cos(angle) * radius.X, math.sin(angle * 2) * radius.Y, math.sin(angle) * radius.Z)
	local tangent = Vector3.new(-math.sin(angle) * radius.X, math.cos(angle * 2) * radius.Y * 2, math.cos(angle) * radius.Z)
	local position = actor.origin.Position + offset
	local body = CFrame.lookAt(position, position + tangent)
	if actor.kind == "Butterfly" then
		body *= CFrame.Angles(0, 0, math.sin(time * 2 + actor.phase) * .12)
	elseif actor.kind == "Gull" then
		-- A shallow bank follows the turn rather than leaving birds rigidly level.
		body *= CFrame.Angles(0, 0, -.11 + math.sin(angle) * .025)
	end
	actor.model:PivotTo(body)
	if actor.kind == "Gull" then
		-- Occasional still-wing glides punctuate the flap cycle.
		local flap = math.sin(time * 8.0 + actor.phase) * 0.35
		local glide = math.clamp(math.sin(time * 0.6 + actor.phase) * 2.0, 0, 1)
		local roll = 0.06 + flap * (1 - glide)
		pose(actor, body, "WingLeft", 0, 0, -roll)
		pose(actor, body, "WingRight", 0, 0, roll)
	elseif actor.kind == "Butterfly" then
		local fold = math.sin(time * 29 + actor.phase) * 0.95
		pose(actor, body, "WingLeft", 0, fold, 0)
		pose(actor, body, "WingRight", 0, -fold, 0)
	end
end

function Presentation.start()
	if started then return end
	started = true
	local world: Instance? = nil
	local actors: { [Instance]: Actor } = {}
	local listeners: { [Instance]: { RBXScriptConnection } } = {}
	local worldConnections: { RBXScriptConnection } = {}

	local function refresh(instance: Instance)
		if not world or not instance:IsA("Model") or not instance:IsDescendantOf(world) then return end
		local kind, origin = instance:GetAttribute("AmbientKind"), instance:GetAttribute("AmbientOrigin")
		if typeof(kind) ~= "string" or not ALLOWED_KINDS[kind] or typeof(origin) ~= "CFrame" or not instance.PrimaryPart then
			actors[instance] = nil
			return
		end
		local joints: { [string]: Joint } = {}
		for _, name in JOINTS do
			local joint = instance:FindFirstChild(name)
			if joint and joint:IsA("Model") and joint.PrimaryPart then
				local rest = joint:GetAttribute("AmbientRest")
				if typeof(rest) == "CFrame" then joints[name] = { model = joint, rest = rest } end
			end
		end
		local radius, travel = instance:GetAttribute("AmbientRadius"), instance:GetAttribute("AmbientTravel")
		local validRadius = if finiteVector(radius) then radius else Vector3.new(8, 1, 6)
		local validTravel: Vector3? = nil
		if finiteVector(travel) then
			local horizontal = Vector3.new(travel.X, 0, travel.Z)
			if horizontal.Magnitude &gt; 0.1 and horizontal.Magnitude &lt; 80 then validTravel = horizontal end
		end
		-- Keep the velocity nonzero so lookAt never receives identical points.
		validRadius = Vector3.new(math.clamp(math.abs(validRadius.X), 0.5, 40), math.clamp(math.abs(validRadius.Y), 0, 8), math.clamp(math.abs(validRadius.Z), 0.5, 40))
		local style = instance:GetAttribute("AmbientStyle")
		local previous = actors[instance]
		local function part(container: Instance, name: string): BasePart?
			local value=container:FindFirstChild(name)
			return if value and value:IsA("BasePart") then value else nil
		end
		local eyes: {Eye} = {}
		local head=instance:FindFirstChild("HeadPose")
		if head then
			for _,value in head:GetChildren() do
				local size=value:GetAttribute("AmbientEyeSize")
				if value:IsA("BasePart") and finiteVector(size) and size.X&gt;0 and size.Y&gt;0 and size.Z&gt;0 then
					table.insert(eyes,{part=value,size=size,glint=value.Name=="EyeSpark"})
				end
			end
		end
		local right=instance:FindFirstChild("ArmRight")
		local drops: {BasePart}={}
		for index=1,3 do
			local drop=part(instance,"WateringDrop"..index)
			if drop then table.insert(drops,drop) end
		end
		local lineEnd,waterTarget=instance:GetAttribute("AmbientLineEnd"),instance:GetAttribute("AmbientWaterTarget")
		actors[instance] = {
			model = instance, kind = kind, origin = origin, joints = joints,
			style = if typeof(style) == "string" then style else "Wave",
			phase = bounded(instance:GetAttribute("AmbientPhase"), -100, 100, 0),
			period = bounded(instance:GetAttribute("AmbientPeriod"), 5, 240, 24),
			radius = validRadius,
			travel = validTravel,
			width = bounded(instance:GetAttribute("AmbientRouteWidth"), 1, 8, 3.8),
			eyes=eyes,line=part(instance,"FineFishingLine"),bobber=part(instance,"ResidentBobber"),
			rod=if right then part(right,"BambooFishingRod") else nil,
			spout=if right then part(right,"WateringSpout") else nil,drops=drops,
			lineEnd=if finiteVector(lineEnd) then lineEnd else nil,
			waterTarget=if finiteVector(waterTarget) then waterTarget else nil,
			near=if previous then previous.near else false,
			greetingAt=if previous then previous.greetingAt else nil,
			nextGreeting=if previous then previous.nextGreeting else 0,
			gazeYaw=if previous then previous.gazeYaw else 0,gazePitch=if previous then previous.gazePitch else 0,
			attention=if previous then previous.attention else 0,
			stridePhase=if previous then previous.stridePhase else 0,lastTime=if previous then previous.lastTime else nil,
		}
	end

	local function refreshAncestor(instance: Instance)
		local ancestor: Instance? = instance
		while ancestor and ancestor ~= world do
			if namedActor(ancestor) then refresh(ancestor); return end
			ancestor = ancestor.Parent
		end
	end

	local function discover(instance: Instance)
		if instance:IsA("Model") and (namedActor(instance) or namedJoint(instance)) and not listeners[instance] then
			listeners[instance] = {
				instance.AttributeChanged:Connect(function() refreshAncestor(instance) end),
				instance:GetPropertyChangedSignal("PrimaryPart"):Connect(function() refreshAncestor(instance) end),
			}
		end
		if instance:IsA("Model") or instance:IsA("BasePart") then refreshAncestor(instance) end
	end

	local function forget(instance: Instance)
		actors[instance] = nil
		local connections = listeners[instance]
		if connections then
			for _, connection in connections do connection:Disconnect() end
			listeners[instance] = nil
		end
		-- A missing animated joint cannot be reused after an individual part unload.
		for _, actor in actors do
			for name, joint in actor.joints do
				if joint.model == instance or joint.model.PrimaryPart == instance then actor.joints[name] = nil end
			end
		end
	end

	local function unbind()
		for _, connection in worldConnections do connection:Disconnect() end
		table.clear(worldConnections)
		for _, connections in listeners do for _, connection in connections do connection:Disconnect() end end
		table.clear(listeners)
		table.clear(actors)
		world = nil
	end

	local function bind(candidate: Instance)
		if candidate.Name ~= WORLD_NAME or candidate.Parent ~= workspace or candidate == world then return end
		unbind()
		world = candidate
		table.insert(worldConnections, candidate.DescendantAdded:Connect(discover))
		table.insert(worldConnections, candidate.DescendantRemoving:Connect(forget))
		table.insert(worldConnections, candidate.AncestryChanged:Connect(function()
			if candidate.Parent ~= workspace and world == candidate then unbind() end
		end))
		for _, instance in candidate:GetDescendants() do discover(instance) end
	end

	workspace.ChildAdded:Connect(bind)
	local existing = workspace:FindFirstChild(WORLD_NAME)
	if existing then bind(existing) end
	local accumulator = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator &lt; STEP then return end
		accumulator %= STEP
		local camera = workspace.CurrentCamera
		if not camera then return end
		local position, time = camera.CFrame.Position, workspace:GetServerTimeNow()
		-- Interest follows the local character, never a detached/free camera.
		local player=Players.LocalPlayer
		local character=if player then player.Character else nil
		local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
		local humanoid=if character then character:FindFirstChildOfClass("Humanoid") else nil
		local viewer=if root and root:IsA("BasePart") and humanoid and humanoid.Health&gt;0 and finiteVector(root.Position) then root.Position else nil
		for _, actor in actors do
			local distance = actor.origin.Position - position
			if actor.model.Parent and actor.model.PrimaryPart and distance:Dot(distance) &lt;= MAX_DISTANCE * MAX_DISTANCE then
				if actor.kind == "Resident" then inhabitant(actor, time, viewer) else wildlife(actor, time) end
			end
		end
	end)
end

return Presentation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000025">
        <Properties>
          <string name="Name">IslandTravelInterface</string>
          <ProtectedString name="Source">--!strict
-- Walk into a gateway, choose a pond, and cross under a short, dark transition.
-- Clients send an ID only; the server owns every landing position.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")
local Rules = require(ReplicatedStorage:WaitForChild("FishingShared"):WaitForChild("IslandTravelRules"))
local Interface = {}
local started = false
local visitGallery: (() -&gt; boolean)? = nil
local BLUE = Color3.fromRGB(55, 137, 203)
local PALE = Color3.fromRGB(214, 230, 232)
local CREAM = Color3.fromRGB(229, 229, 210)
local INK = Color3.fromRGB(40, 66, 83)
local MUTED = Color3.fromRGB(98, 118, 128)

local function rounded(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(0, radius), parent
end

local function label(parent: Instance, name: string, text: string, size: number): TextLabel
	local value = Instance.new("TextLabel")
	value.Name, value.Text, value.TextSize = name, text, size
	value.Font, value.TextColor3 = Enum.Font.GothamMedium, INK
	value.BackgroundTransparency, value.BorderSizePixel = 1, 0
	value.TextXAlignment, value.AutoLocalize = Enum.TextXAlignment.Left, false
	value.Parent = parent
	return value
end

local function mount(event: RemoteEvent)
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.DisplayOrder, gui.Enabled = "IslandTravel", false, 80, false
	gui.ZIndexBehavior, gui.IgnoreGuiInset = Enum.ZIndexBehavior.Sibling, true
	local shade = Instance.new("Frame")
	shade.Name, shade.Size = "Backdrop", UDim2.fromScale(1, 1)
	shade.BackgroundColor3, shade.BackgroundTransparency = INK, 0.28
	shade.BorderSizePixel, shade.Parent = 0, gui
	local backdrop = Instance.new("TextButton")
	backdrop.Name, backdrop.Text, backdrop.Size = "CloseBackdrop", "", UDim2.fromScale(1, 1)
	backdrop.BackgroundTransparency, backdrop.BorderSizePixel, backdrop.Parent = 1, 0, shade
	local card = Instance.new("Frame")
	card.Name, card.AnchorPoint, card.Position = "DestinationCard", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
	card.BackgroundColor3, card.BorderSizePixel, card.Active, card.Parent = CREAM, 0, true, shade
	rounded(card, 20)
	local outline = Instance.new("UIStroke")
	outline.Color, outline.Thickness, outline.Transparency, outline.Parent = Color3.fromRGB(133, 162, 167), 1, 0.3, card
	local eyebrow = label(card, "FreeLabel", "FREE PORTAL TRAVEL", 11)
	eyebrow.Font, eyebrow.TextColor3 = Enum.Font.GothamBold, BLUE
	eyebrow.Position, eyebrow.Size = UDim2.fromOffset(20, 18), UDim2.new(1, -88, 0, 16)
	local title = label(card, "Title", "Pick your next pond", 24)
	title.Font = Enum.Font.GothamBold
	title.Position, title.Size = UDim2.fromOffset(20, 38), UDim2.new(1, -86, 0, 31)
	title.TextTruncate = Enum.TextTruncate.AtEnd
	local subtitle = label(card, "Subtitle", "Choose a gateway. Arrive ready to fish.", 13)
	subtitle.TextColor3 = MUTED
	subtitle.Position, subtitle.Size = UDim2.fromOffset(20, 75), UDim2.new(1, -40, 0, 20)
	local close = Instance.new("TextButton")
	close.Name, close.Text, close.TextSize, close.Font = "Close", "X", 18, Enum.Font.GothamBold
	close.AnchorPoint, close.Position, close.Size = Vector2.new(1, 0), UDim2.new(1, -12, 0, 15), UDim2.fromOffset(48, 48)
	close.TextColor3, close.BackgroundColor3, close.BorderSizePixel = INK, PALE, 0
	close.Modal, close.Parent = true, card
	rounded(close, 14)
	local list = Instance.new("ScrollingFrame")
	list.Name, list.Position, list.Size = "Destinations", UDim2.fromOffset(12, 108), UDim2.new(1, -24, 1, -158)
	list.BackgroundTransparency, list.BorderSizePixel = 1, 0
	list.CanvasSize, list.ScrollBarThickness = UDim2.fromOffset(0, #Rules.Destinations * 64 - 8), 4
	list.ScrollBarImageColor3, list.ScrollingDirection, list.Parent = BLUE, Enum.ScrollingDirection.Y, card
	local stack = Instance.new("UIListLayout")
	stack.Padding, stack.SortOrder, stack.Parent = UDim.new(0, 8), Enum.SortOrder.LayoutOrder, list
	local status = label(card, "Status", "No coins, tickets or unlocks needed.", 12)
	status.AnchorPoint, status.Position = Vector2.new(0, 1), UDim2.new(0, 20, 1, -12)
	status.Size, status.TextWrapped, status.TextColor3 = UDim2.new(1, -40, 0, 34), true, MUTED
	-- This cover is dark ink, with no Bloom, white flash, camera shake or FOV change.
	local curtain = Instance.new("Frame")
	curtain.Name, curtain.Size, curtain.ZIndex = "PortalTransition", UDim2.fromScale(1, 1), 20
	curtain.BackgroundColor3, curtain.BackgroundTransparency = Color3.fromRGB(9, 17, 22), 1
	curtain.BorderSizePixel, curtain.Active, curtain.Visible, curtain.Parent = 0, true, false, gui
	local journey = label(curtain, "Journey", "CROSSING TO", 12)
	journey.AnchorPoint, journey.Position, journey.Size = Vector2.new(0.5, 1), UDim2.fromScale(0.5, 0.48), UDim2.new(1, -40, 0, 22)
	journey.TextColor3, journey.TextXAlignment, journey.ZIndex = Color3.fromRGB(151, 182, 189), Enum.TextXAlignment.Center, 21
	local destinationLabel = label(curtain, "Destination", "", 26)
	destinationLabel.AnchorPoint, destinationLabel.Position, destinationLabel.Size = Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0.49), UDim2.new(1, -40, 0, 42)
	destinationLabel.Font, destinationLabel.TextColor3 = Enum.Font.GothamBold, CREAM
	destinationLabel.TextXAlignment, destinationLabel.TextWrapped, destinationLabel.ZIndex = Enum.TextXAlignment.Center, true, 21
	local arrival = Instance.new("Frame")
	arrival.Name, arrival.AnchorPoint, arrival.Position = "Arrival", Vector2.new(0.5, 0), UDim2.fromScale(0.5, 0.13)
	arrival.Size, arrival.BackgroundColor3, arrival.BackgroundTransparency = UDim2.fromOffset(310, 68), INK, 0.12
	arrival.BorderSizePixel, arrival.Visible, arrival.Parent = 0, false, gui
	rounded(arrival, 16)
	local arrivalName = label(arrival, "PondName", "", 21)
	arrivalName.Position, arrivalName.Size = UDim2.fromOffset(10, 8), UDim2.new(1, -20, 0, 28)
	arrivalName.Font, arrivalName.TextColor3, arrivalName.TextXAlignment = Enum.Font.GothamBold, CREAM, Enum.TextXAlignment.Center
	arrivalName.TextTruncate = Enum.TextTruncate.AtEnd
	local ready = label(arrival, "Ready", "READY TO FISH", 11)
	ready.Position, ready.Size = UDim2.fromOffset(10, 40), UDim2.new(1, -20, 0, 18)
	ready.TextColor3, ready.TextXAlignment = Color3.fromRGB(173, 204, 197), Enum.TextXAlignment.Center
	local rows: { { id: string, button: TextButton, badge: TextLabel } } = {}
	local source, waiting, terminal = "", false, false
	local phase, destinationName = "closed", ""
	local galleryJourney = false
	local generation = 0
	local oldSelection: GuiObject? = nil
	local coverTween: Tween? = nil
	local controls: any = nil
	local movementLocked, disabledControls = false, false
	local function lockMovement(locked: boolean)
		movementLocked = locked
		if locked then
			if controls and not disabledControls and controls.controlsEnabled ~= false then
				controls:Disable(); disabledControls = true
			end
			local character = player.Character
			local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
			if humanoid then humanoid:Move(Vector3.zero) end
		elseif controls and disabledControls then
			controls:Enable()
			disabledControls = false
		end
	end
	-- Resolving PlayerModule may yield, so it never delays fishing's initial Sync.
	task.spawn(function()
		local scripts = player:WaitForChild("PlayerScripts")
		local module = scripts:WaitForChild("PlayerModule", 5)
		if not module or not module:IsA("ModuleScript") then return end
		local ok, result = pcall(function() return require(module):GetControls() end)
		if ok and result then controls = result; lockMovement(movementLocked) end
	end)
	local function restoreSelection()
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then
			GuiService.SelectedObject = if oldSelection and oldSelection.Parent then oldSelection else nil
		end
	end
	local function updateVisibility()
		shade.Visible = phase == "menu" or phase == "rejected" or (phase == "covering" and not galleryJourney)
		gui.Enabled = phase ~= "closed" or arrival.Visible
		player:SetAttribute("IslandTravelMenuOpen", phase ~= "closed")
	end
	local function cancelTween()
		if coverTween then coverTween:Cancel(); coverTween = nil end
	end
	local function reset()
		generation += 1
		cancelTween()
		phase, waiting, terminal = "closed", false, false
		curtain.Visible, curtain.BackgroundTransparency, arrival.Visible = false, 1, false
		journey.Visible, destinationLabel.Visible = false, false
		lockMovement(false)
		restoreSelection()
		updateVisibility()
	end
	local function closeMenu()
		-- Once sent, keep the view covered until the server finishes or recovery times out.
		if phase == "pending" or phase == "uncovering" then return end
		reset()
	end
	local function fadeCover(alpha: number, duration: number, token: number, complete: () -&gt; ())
		cancelTween()
		local tween = TweenService:Create(curtain, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { BackgroundTransparency = alpha })
		coverTween = tween
		tween:Play()
		task.spawn(function()
			local playback = tween.Completed:Wait()
			if generation ~= token or playback ~= Enum.PlaybackState.Completed then return end
			if coverTween == tween then coverTween = nil end
			complete()
		end)
	end
	local function refreshButtons()
		for _, row in rows do
			local current = row.id == source
			local enabled = not current and not waiting and not terminal
			row.button.Active, row.button.Selectable, row.button.AutoButtonColor = enabled, enabled, enabled
			row.button.BackgroundColor3 = if current then Color3.fromRGB(214, 209, 180) else PALE
			row.badge.Text = if current then "HERE" elseif waiting then "..." else "GO"
			row.badge.TextColor3 = if current then MUTED else BLUE
		end
	end
	local reject: (string) -&gt; ()
	local function beginJourney(destinationId: string, name: string)
		generation += 1
		local token = generation
		galleryJourney = destinationId == "gallery"
		phase, waiting, destinationName = "covering", true, name
		arrival.Visible = false
		status.Text, status.TextColor3 = "Opening your gateway...", BLUE
		curtain.Visible, curtain.BackgroundTransparency = true, 1
		journey.Visible, destinationLabel.Visible = false, false
		lockMovement(true)
		refreshButtons()
		updateVisibility()
		fadeCover(0, 0.16, token, function()
			phase = "pending"
			journey.Text, journey.Visible = "CROSSING TO", true
			destinationLabel.Text, destinationLabel.Visible = destinationName, true
			updateVisibility()
			local ok = pcall(function() event:FireServer(destinationId) end)
			if not ok then reject("Your travel could not connect. Close this menu and try again."); return end
			task.delay(8, function()
				if generation == token and phase == "pending" then
					reject("Travel took too long. Close this menu and try again.")
				end
			end)
		end)
	end
	visitGallery = function(): boolean
		if phase ~= "closed" then return false end
		oldSelection = GuiService.SelectedObject
		beginJourney("gallery", "Aquarium Gallery")
		return true
	end
	for index, destination in Rules.Destinations do
		local button = Instance.new("TextButton")
		button.Name, button.Text, button.LayoutOrder = destination.Id, "", index
		button.Size, button.BorderSizePixel, button.Parent = UDim2.new(1, -7, 0, 56), 0, list
		rounded(button, 12)
		local name = label(button, "Name", destination.Name, 17)
		name.Font, name.Position, name.Size = Enum.Font.GothamBold, UDim2.fromOffset(14, 6), UDim2.new(1, -80, 0, 23)
		name.TextTruncate = Enum.TextTruncate.AtEnd
		local detail = label(button, "Detail", destination.Detail, 11)
		detail.TextColor3, detail.Position, detail.Size = MUTED, UDim2.fromOffset(14, 31), UDim2.new(1, -80, 0, 17)
		local badge = label(button, "Badge", "GO", 12)
		badge.Font, badge.TextXAlignment = Enum.Font.GothamBold, Enum.TextXAlignment.Center
		badge.AnchorPoint, badge.Position, badge.Size = Vector2.new(1, 0.5), UDim2.new(1, -10, 0.5, 0), UDim2.fromOffset(43, 32)
		table.insert(rows, { id = destination.Id, button = button, badge = badge })
		button.Activated:Connect(function()
			if phase ~= "menu" or waiting or terminal or destination.Id == source then return end
			beginJourney(destination.Id, destination.Name)
		end)
	end
	local function resize()
		-- Fixed 56-pixel rows stay easy to tap; short screens scroll instead of shrinking buttons.
		local available = gui.AbsoluteSize
		if available.X &lt;= 0 or available.Y &lt;= 0 then return end
		card.Size = UDim2.fromOffset(math.min(440, math.max(260, available.X - 24)), math.min(478, math.max(232, available.Y - 24)))
	end
	reject = function(message: string)
		if phase ~= "pending" and phase ~= "covering" then return end
		generation += 1
		local token = generation
		waiting, terminal = false, true
		status.Text, status.TextColor3 = message, Color3.fromRGB(151, 77, 55)
		refreshButtons()
		journey.Visible, destinationLabel.Visible = false, false
		-- Rejection never traps movement, including when the server loses the world.
		lockMovement(false)
		phase = "rejected"
		updateVisibility()
		fadeCover(1, 0.2, token, function() curtain.Visible = false end)
	end
	close.Activated:Connect(closeMenu)
	backdrop.Activated:Connect(closeMenu)
	UserInputService.InputBegan:Connect(function(input, processed)
		if gui.Enabled and not processed and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then closeMenu() end
	end)
	local deathConnection: RBXScriptConnection? = nil
	local function watchCharacter(character: Model)
		if deathConnection then deathConnection:Disconnect(); deathConnection = nil end
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", 5)
			if player.Character ~= character or not humanoid or not humanoid:IsA("Humanoid") then return end
			deathConnection = humanoid.Died:Connect(reset)
		end)
	end
	player.CharacterRemoving:Connect(function() reset(); if deathConnection then deathConnection:Disconnect(); deathConnection = nil end end)
	player.CharacterAdded:Connect(function(character) reset(); watchCharacter(character) end)
	if player.Character then watchCharacter(player.Character) end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
	event.OnClientEvent:Connect(function(verb: any, argument: any)
		if verb == "Open" and Rules.isDestination(argument) then
			if phase == "pending" or phase == "covering" or phase == "uncovering" then return end
			generation += 1
			cancelTween()
			source, waiting, terminal, phase = argument, false, false, "menu"
			galleryJourney = false
			curtain.Visible, arrival.Visible = false, false
			status.Text, status.TextColor3 = "No coins, tickets or unlocks needed.", MUTED
			list.CanvasPosition = Vector2.zero
			if not GuiService.SelectedObject or not GuiService.SelectedObject:IsDescendantOf(gui) then
				oldSelection = GuiService.SelectedObject
			end
			refreshButtons()
			lockMovement(true)
			updateVisibility()
			resize()
			if UserInputService.GamepadEnabled then
				for _, row in rows do if row.button.Selectable then GuiService.SelectedObject = row.button; break end end
			end
		elseif verb == "Loading" and phase == "pending" then
			status.Text, status.TextColor3 = "Getting your next pond ready...", BLUE
		elseif verb == "Arrived" and phase == "pending" then
			generation += 1
			local token = generation
			phase, waiting, terminal = "uncovering", false, false
			journey.Visible, destinationLabel.Visible = false, false
			updateVisibility()
			fadeCover(1, 0.2, token, function()
				curtain.Visible, phase = false, "closed"
				arrivalName.Text, arrival.Visible = destinationName, true
				ready.Text = if galleryJourney then "YOUR COLLECTION ON DISPLAY" else "READY TO FISH"
				lockMovement(false)
				restoreSelection()
				updateVisibility()
				task.delay(1.4, function()
					if generation == token then arrival.Visible = false; updateVisibility() end
				end)
			end)
		elseif verb == "Rejected" then
			reject(if type(argument) == "string" then argument else "Close this menu and step into the portal again.")
		end
	end)
	gui.Parent = player:WaitForChild("PlayerGui")
	updateVisibility()
	resize()
	-- ScreenGui.AbsoluteSize settles after parenting on the first rendered frame.
	task.defer(resize)
end

function Interface.start()
	if started then return end
	started = true
	Players.LocalPlayer:SetAttribute("IslandTravelMenuOpen", false)
	-- A custom world without travel must not block the fishing client's initial Sync.
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("FishingTravelRemotes", 30)
		if not remotes then return end
		local event = remotes:WaitForChild("Travel", 5)
		if event and event:IsA("RemoteEvent") then mount(event) end
	end)
end

function Interface.visitGallery(): boolean
	return if visitGallery then visitGallery() else false
end

return Interface
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000026">
        <Properties>
          <string name="Name">AquariumInterface</string>
          <ProtectedString name="Source">--!strict
-- Three favorite catches become a real, shared-world aquarium. This interface
-- requests IDs only; the server validates ownership, slots and coin purchases.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Catalog = require(Shared:WaitForChild("FishCatalog"))
local Fish = require(Shared:WaitForChild("FishModel"))
local Theme = require(script.Parent:WaitForChild("UITheme"))
local Aquarium = {}
local animationStarted = false

-- One small local loop handles streamed tanks independently of an open menu.
local function startWorldAnimation()
	if animationStarted then return end
	animationStarted=true
	local tracked: {[Model]: any}={}
	local watching: {[Model]: {RBXScriptConnection}}={}
	local function ready(model: Model)
		local origin,phase=model:GetAttribute("AquariumSwimOrigin"),model:GetAttribute("AquariumSwimPhase")
		local body=model.PrimaryPart
		if typeof(origin)=="CFrame" and type(phase)=="number" and phase==phase and math.abs(phase)&lt;math.huge
			and body and body:IsDescendantOf(model) then
			tracked[model]={origin=origin,phase=phase}
		else tracked[model]=nil end
	end
	local function discover(node: Instance)
		if node:IsA("Model") and string.sub(node.Name,1,13)=="AquariumFish_" and not watching[node] then
			watching[node]={
				node.AttributeChanged:Connect(function() ready(node) end),
				node.ChildAdded:Connect(function() ready(node) end),
				node.ChildRemoved:Connect(function() ready(node) end),
				node:GetPropertyChangedSignal("PrimaryPart"):Connect(function() ready(node) end),
			}
			ready(node)
		elseif node:IsA("BasePart") then
			local parent=node.Parent
			if parent and parent:IsA("Model") and watching[parent] then ready(parent) end
		end
	end
	local function forget(node: Instance)
		if not node:IsA("Model") then return end
		tracked[node]=nil
		local listeners=watching[node]
		if listeners then for _,connection in listeners do connection:Disconnect() end; watching[node]=nil end
	end
	-- Listen once for gallery models; no per-frame Workspace descendants scan.
	workspace.DescendantAdded:Connect(discover)
	workspace.DescendantRemoving:Connect(forget)
	for _,node in workspace:GetDescendants() do discover(node) end
	local elapsed=0
	RunService.Heartbeat:Connect(function(dt)
		elapsed+=dt
		if elapsed&lt;.05 then return end
		elapsed%=.05
		local camera=workspace.CurrentCamera
		if not camera then return end
		local time=workspace:GetServerTimeNow()
		for model,data in tracked do
			if not model.Parent then forget(model); continue end
			local delta=data.origin.Position-camera.CFrame.Position
			if delta:Dot(delta)&gt;120*120 then continue end
			local phase=data.phase
			model:PivotTo(data.origin*CFrame.new(math.sin(time*.65+phase)*.55,math.sin(time*1.1+phase)*.22,math.cos(time*.55+phase)*.3)
				*CFrame.Angles(0,math.sin(time*.55+phase)*.22,math.sin(time*.9+phase)*.025))
			Fish.animate(model,time)
		end
	end)
end

local function center(label: TextLabel): TextLabel
	label.TextXAlignment=Enum.TextXAlignment.Center
	return label
end

function Aquarium.new(playerGui: Instance, handlers: any)
	startWorldAnimation()
	local player=Players.LocalPlayer
	local gui=Instance.new("ScreenGui")
	gui.Name,gui.ResetOnSpawn,gui.DisplayOrder,gui.Enabled="MyAquarium",false,50,false
	gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
	local backdrop=Instance.new("TextButton")
	backdrop.Name,backdrop.Text,backdrop.Size="Backdrop","",UDim2.fromScale(1,1)
	backdrop.BackgroundColor3,backdrop.BackgroundTransparency,backdrop.BorderSizePixel=Theme.Ink,.2,0
	backdrop.Parent=gui
	local card=Theme.frame(gui,"AquariumStudio",UDim2.fromOffset(640,600),UDim2.fromScale(.5,.5))
	card.AnchorPoint,card.Active=Vector2.new(.5,.5),true
	Theme.stroke(card)
	local title=Theme.text(card,"Your little ocean",UDim2.new(1,-76,0,32),UDim2.fromOffset(20,14),25,Theme.Ink,true)
	local sub=Theme.text(card,"Choose three favorites. Friends can see them in the gallery.",UDim2.new(1,-40,0,34),UDim2.fromOffset(20,47),12,Theme.Muted)
	local closeButton=Theme.button(card,"×",UDim2.fromOffset(44,44),UDim2.new(1,-54,0,10),Theme.Soft)
	closeButton.TextColor3,closeButton.TextSize=Theme.Ink,25
	local profile: any=nil
	local selectedSlot=1
	local activeTab="Fish"
	local oldSelection: GuiObject?=nil
	local slots: {any}={}
	local refresh: ()-&gt;()
	for slot=1,3 do
		local button=Theme.button(card,"",UDim2.new(1/3,-18,0,110),UDim2.new((slot-1)/3,14,0,88),Theme.Soft)
		button.Name="DisplaySlot"..slot
		local stroke=Theme.stroke(button,Theme.Line,1)
		local view=Instance.new("ViewportFrame")
		view.Name,view.Size,view.BackgroundTransparency="FishPreview",UDim2.new(1,-8,1,-26),1
		view.Position,view.Ambient,view.LightColor=UDim2.fromOffset(4,0),Color3.fromRGB(170,191,190),Color3.fromRGB(232,225,201)
		view.LightDirection,view.Parent=Vector3.new(-1,-1,-2),button
		local camera=Instance.new("Camera")
		camera.CFrame,camera.FieldOfView,camera.Parent=CFrame.lookAt(Vector3.new(3,.8,-6.7),Vector3.zero),35,view
		view.CurrentCamera=camera
		local world=Instance.new("WorldModel")
		world.Parent=view
		local name=center(Theme.text(button,"SLOT "..slot,UDim2.new(1,-12,0,22),UDim2.new(0,6,1,-24),11,Theme.Muted,true))
		name.TextTruncate=Enum.TextTruncate.AtEnd
		slots[slot]={button=button,stroke=stroke,world=world,name=name,fish=nil,signature=""}
		button.Activated:Connect(function() selectedSlot=slot; refresh() end)
	end
	local fishTab=Theme.button(card,"Choose fish",UDim2.new(.5,-22,0,42),UDim2.fromOffset(14,210),Theme.Ink)
	local stylesTab=Theme.button(card,"Tank themes",UDim2.new(.5,-22,0,42),UDim2.new(.5,8,0,210),Theme.Soft)
	stylesTab.TextColor3=Theme.Ink
	local instruction=Theme.text(card,"Choose a fish for slot 1",UDim2.new(1,-32,0,24),UDim2.fromOffset(16,261),12,Theme.Teal,true)
	local function scroll(name: string): ScrollingFrame
		local value=Instance.new("ScrollingFrame")
		value.Name,value.Position,value.Size=name,UDim2.fromOffset(14,290),UDim2.new(1,-28,1,-364)
		value.BackgroundTransparency,value.BorderSizePixel,value.ScrollBarThickness=1,0,4
		value.ScrollBarImageColor3,value.CanvasSize,value.AutomaticCanvasSize=Theme.Teal,UDim2.fromOffset(0,0),Enum.AutomaticSize.Y
		value.Parent=card
		local stack=Instance.new("UIListLayout")
		stack.Padding,stack.SortOrder,stack.Parent=UDim.new(0,7),Enum.SortOrder.LayoutOrder,value
		return value
	end
	local fishList=scroll("OwnedFish")
	local styleList=scroll("TankThemes")
	styleList.Visible=false
	local rows: {[string]: any}={}
	for index,species in Catalog.Species do
		local button=Theme.button(fishList,"",UDim2.new(1,-8,0,58),UDim2.fromOffset(0,0),Theme.Soft)
		button.Name,button.LayoutOrder=species.Id,index
		local mark=Theme.frame(button,"SpeciesColor",UDim2.fromOffset(7,34),UDim2.fromOffset(10,12),Color3.fromRGB(table.unpack(species.Body)))
		Theme.round(mark,4)
		local name=Theme.text(button,species.Name,UDim2.new(1,-98,0,24),UDim2.fromOffset(28,6),15,Theme.Ink,true)
		name.TextTruncate=Enum.TextTruncate.AtEnd
		local detail=Theme.text(button,"Catch this fish to display it",UDim2.new(1,-98,0,19),UDim2.fromOffset(28,32),10,Theme.Muted)
		local badge=Theme.text(button,"LOCKED",UDim2.fromOffset(65,30),UDim2.new(1,-75,.5,-15),10,Theme.Muted,true)
		badge.TextXAlignment=Enum.TextXAlignment.Right
		rows[species.Id]={button=button,detail=detail,badge=badge,name=name,species=species}
		button.Activated:Connect(function()
			if profile and profile.best and profile.best[species.Id] then handlers.display(species.Id,selectedSlot) end
		end)
	end
	local styleRows: {[string]: any}={}
	for index,style in Catalog.AquariumStyles do
		local button=Theme.button(styleList,"",UDim2.new(1,-8,0,62),UDim2.fromOffset(0,0),Theme.Soft)
		button.Name,button.LayoutOrder=style.Id,index
		for swatch,color in {style.Colors.Base,style.Colors.Trim,style.Colors.Accent} do
			Theme.frame(button,"ThemeSwatch",UDim2.fromOffset(12,35),UDim2.fromOffset(10+(swatch-1)*9,17),Color3.fromRGB(table.unpack(color)))
		end
		local name=Theme.text(button,style.Name,UDim2.new(1,-148,0,25),UDim2.fromOffset(49,8),16,Theme.Ink,true)
		name.TextWrapped,name.TextTruncate=false,Enum.TextTruncate.AtEnd
		local descriptions={lagoon="A tiny sunken lagoon arch",blossom="Bonsai, blossoms and a little bridge",observatory="Sunken columns and star-chart tiles",coral="Branching coral for a warm reef"}
		local detail=Theme.text(button,descriptions[style.Id] or "Permanent cosmetic theme",UDim2.new(1,-148,0,19),UDim2.fromOffset(49,39),10,Theme.Muted)
		detail.TextWrapped,detail.TextTruncate=false,Enum.TextTruncate.AtEnd
		local badge=Theme.text(button,"",UDim2.fromOffset(94,42),UDim2.new(1,-104,.5,-21),12,Theme.Teal,true)
		badge.TextXAlignment=Enum.TextXAlignment.Right
		styleRows[style.Id]={button=button,name=name,detail=detail,badge=badge,style=style}
		button.Activated:Connect(function()
			if not profile then return end
			local owned=profile.styles and profile.styles[style.Id]
			if owned or profile.coins&gt;=style.Cost then handlers.style(style.Id) end
		end)
	end
	local visit=Theme.button(card,"VISIT MY TANK",UDim2.new(1,-28,0,48),UDim2.new(0,14,1,-62),Theme.Teal)
	local function close()
		if not gui.Enabled then return end
		gui.Enabled=false
		player:SetAttribute("AquariumMenuOpen",false)
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then
			GuiService.SelectedObject=if oldSelection and oldSelection.Parent then oldSelection else nil
		end
		if handlers.close then handlers.close() end
	end
	closeButton.Activated:Connect(close)
	backdrop.Activated:Connect(close)
	visit.Activated:Connect(function() if profile and handlers.visit then close(); handlers.visit() end end)
	local function setTab(tab: string)
		activeTab=tab
		fishList.Visible,styleList.Visible=tab=="Fish",tab=="Styles"
		fishTab.BackgroundColor3=if tab=="Fish" then Theme.Ink else Theme.Soft
		fishTab.TextColor3=if tab=="Fish" then Theme.Panel else Theme.Ink
		stylesTab.BackgroundColor3=if tab=="Styles" then Theme.Ink else Theme.Soft
		stylesTab.TextColor3=if tab=="Styles" then Theme.Panel else Theme.Ink
		refresh()
	end
	refresh=function()
		instruction.Text=if activeTab=="Fish" then "Choose a fish for slot "..selectedSlot else "Cosmetic themes · earned coins · no fishing advantage"
		for slot,data in slots do
			local accessible=not profile or not profile.display or slot&lt;=math.min(3,#profile.display+1)
			data.button.Active,data.button.Selectable=accessible,accessible
			data.stroke.Color=if slot==selectedSlot then Theme.Teal else Theme.Line
			data.stroke.Thickness=if slot==selectedSlot then 2 else 1
			local id=profile and profile.display and profile.display[slot]
			local variants=profile and profile.variants and id and profile.variants[id]
			local variant=if variants and variants.Prismatic then "Prismatic" elseif variants and variants.Golden then "Golden" else "Normal"
			local signature=tostring(id)..variant..tostring(profile and profile.records and id and profile.records[id] or 0)
			if signature~=data.signature then
				if data.fish then data.fish:Destroy();data.fish=nil end
				if id and profile.best[id] then
					data.fish=Fish.create(data.world,nil,id)
					if Fish.applyAppearance then Fish.applyAppearance(data.fish,variant,profile.records and profile.records[id],.82) end
				end
				data.signature=signature
			end
			data.name.Text=if id then Catalog.get(id).Name else "SLOT "..slot
		end
		for id,row in rows do
			local unlocked=profile and profile.best and profile.best[id]
			local displayed=profile and profile.display and profile.display[selectedSlot]==id
			local otherSlot=profile and profile.display and table.find(profile.display,id)
			local canMove=not otherSlot or displayed or (profile and profile.display and profile.display[selectedSlot]~=nil)
			local variants=profile and profile.variants and profile.variants[id]
			local variant=if variants and variants.Prismatic then "Prismatic · " elseif variants and variants.Golden then "Golden · " else ""
			local record=profile and profile.records and profile.records[id]
			row.name.Text=if unlocked then row.species.Name else "Undiscovered"
			row.detail.Text=if unlocked then variant..(if record then string.format("Best %.2f kg",record) else row.species.Rarity) else row.species.Hint
			row.badge.Text=if displayed then "DISPLAYED" elseif otherSlot then "SLOT "..otherSlot elseif unlocked then "SELECT" else "LOCKED"
			row.button.BackgroundColor3=if displayed then Color3.fromRGB(209,231,217) else Theme.Soft
			row.button.Active,row.button.Selectable=unlocked~=nil and unlocked~=false and canMove,unlocked~=nil and unlocked~=false and canMove
		end
		for id,row in styleRows do
			local owned=profile and profile.styles and profile.styles[id]
			local equipped=profile and profile.equippedStyle==id
			local afford=profile and profile.coins&gt;=row.style.Cost
			row.badge.Text=if equipped then "EQUIPPED" elseif owned then "EQUIP" else tostring(row.style.Cost).." coins"
			row.badge.TextColor3=if owned or afford then Theme.Teal else Theme.Muted
			row.button.Active,row.button.Selectable=not equipped and (owned or afford)==true,not equipped and (owned or afford)==true
			row.button.BackgroundColor3=if equipped then Color3.fromRGB(209,231,217) else Theme.Soft
		end
		visit.Text=if profile then "VISIT MY TANK" else "LOADING COLLECTION..."
	end
	fishTab.Activated:Connect(function() setTab("Fish") end)
	stylesTab.Activated:Connect(function() setTab("Styles") end)
	UserInputService.InputBegan:Connect(function(input,processed)
		if gui.Enabled and not processed and (input.KeyCode==Enum.KeyCode.Escape or input.KeyCode==Enum.KeyCode.ButtonB) then close() end
	end)
	player.CharacterAdded:Connect(close)
	player:SetAttribute("AquariumMenuOpen",false)
	gui.Parent=playerGui
	local function animate(time: number,width: number,height: number)
		local canvas=gui.AbsoluteSize
		local w=if canvas.X&gt;0 then canvas.X else width
		local h=if canvas.Y&gt;0 then canvas.Y else height
		local compact=h&lt;450
		card.Size=UDim2.fromOffset(math.min(640,math.max(280,w-24)),math.min(600,math.max(228,h-(if compact then 12 else 24))))
		title.Text,title.TextSize=if compact then "Aquarium" else "Your little ocean",if compact then 16 elseif w&lt;420 then 20 else 25
		title.Size=UDim2.new(1,if compact then -210 else -76,0,32)
		sub.Visible=not compact
		local slotY=if compact then 56 else 88
		local slotHeight=if compact then 34 else 110
		for slot,data in slots do
			data.button.Position=UDim2.new((slot-1)/3,14,0,slotY)
			data.button.Size=UDim2.new(1/3,-18,0,slotHeight)
			data.button:FindFirstChild("FishPreview").Visible=not compact
			if gui.Enabled and data.fish then
				data.fish:PivotTo(CFrame.Angles(0,math.sin(time+slot)*.2,math.sin(time*1.3+slot)*.025))
				Fish.animate(data.fish,time)
			end
		end
		local tabsY=slotY+slotHeight+12
		fishTab.Position,stylesTab.Position=UDim2.fromOffset(14,tabsY),UDim2.new(.5,8,0,tabsY)
		fishTab.Size,stylesTab.Size=UDim2.new(.5,-22,0,if compact then 32 else 42),UDim2.new(.5,-22,0,if compact then 32 else 42)
		instruction.Visible=not compact
		instruction.Position=UDim2.fromOffset(16,tabsY+49)
		local contentY=tabsY+(if compact then 38 else 80)
		fishList.Position,styleList.Position=UDim2.fromOffset(14,contentY),UDim2.fromOffset(14,contentY)
		local bottom=if compact then 12 else 74
		fishList.Size,styleList.Size=UDim2.new(1,-28,1,-contentY-bottom),UDim2.new(1,-28,1,-contentY-bottom)
		visit.Position=if compact then UDim2.new(1,-170,0,14) else UDim2.new(0,14,1,-62)
		visit.Size=if compact then UDim2.fromOffset(106,36) else UDim2.new(1,-28,0,48)
		visit.TextSize=if compact then 10 else 14
		visit.Text=if profile then (if compact then "VISIT TANK" else "VISIT MY TANK") else "LOADING..."
	end
	refresh()
	return {
		open=function()
			if not gui.Enabled then oldSelection=GuiService.SelectedObject end
			gui.Enabled=true;player:SetAttribute("AquariumMenuOpen",true);refresh()
			if UserInputService.GamepadEnabled then GuiService.SelectedObject=slots[selectedSlot].button end
		end,
		close=close,isOpen=function() return gui.Enabled end,
		updateProfile=function(value: any) profile=value;refresh() end,
		animate=animate,
	}
end

return Aquarium
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000027">
        <Properties>
          <string name="Name">WorldScenery</string>
          <ProtectedString name="Source">--!strict
-- Small, streamed scenery actors are independent of fishing and never own gameplay state.
-- Track arrivals once; the animation pass only visits the currently streamed actors.
local RunService = game:GetService("RunService")
local ResidentPresentation = require(script.Parent:WaitForChild("ResidentPresentation"))

local Scenery = {}
local started = false
local WORLD_NAME = "MolnfiskarnaPrototype"
local STEP = 1 / 20

type Flow = {
	part: BasePart, origin: CFrame, phase: number, distance: number, speed: number,
	original: number, last: number, alphaOwned: boolean,
}
type Motion = { model: Model, part: BasePart, origin: CFrame, speed: number }
type Glint = { part: BasePart, phase: number, original: number, last: number }

local function finite(value: any): boolean
	return typeof(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

function Scenery.start()
	if started then return end
	started = true
	ResidentPresentation.start()
	local world: Instance? = nil
	local flows: { [Instance]: Flow } = {}
	local drifters: { [Instance]: Motion } = {}
	local boats: { [Instance]: Motion } = {}
	local swaying: { [Instance]: Motion } = {}
	local spinners: { [Instance]: Motion } = {}
	local glints: { [Instance]: Glint } = {}
	local surrenderedGlints: { [Instance]: boolean } = {}
	local listeners: { [Instance]: { RBXScriptConnection } } = {}
	local worldConnections: { RBXScriptConnection } = {}

	local function forget(instance: Instance)
		local flow=flows[instance]
		if flow and flow.alphaOwned and flow.part.Parent and math.abs(flow.part.Transparency-flow.last)&lt;.0001 then
			flow.part.Transparency=flow.original
		end
		flows[instance], drifters[instance], spinners[instance] = nil, nil, nil
		boats[instance],swaying[instance]=nil,nil
		local glint = glints[instance]
		if glint and glint.part.Parent and math.abs(glint.part.Transparency - glint.last) &lt; 0.0001 then
			glint.part.Transparency = glint.original
		end
		glints[instance] = nil
		surrenderedGlints[instance] = nil
		local connections = listeners[instance]
		if connections then
			for _, connection in connections do connection:Disconnect() end
			listeners[instance] = nil
		end
		-- A streamed-out animation root must not leave a live model entry behind.
		for _, motions in {drifters,boats,swaying,spinners} do
			for model,motion in motions do if motion.part==instance then motions[model]=nil end end
		end
	end

	local function refresh(instance: Instance)
		if not world or not instance:IsDescendantOf(world) then return end
		if instance:IsA("BasePart") then
			local origin, phase = instance:GetAttribute("FlowStart"), instance:GetAttribute("FlowPhase")
			if typeof(origin) == "CFrame" and finite(phase) then
				local distance, speed = instance:GetAttribute("FlowDistance"), instance:GetAttribute("FlowSpeed")
				local previous=flows[instance]
				flows[instance] = {
					part = instance, origin = origin, phase = phase,
					distance = if finite(distance) then math.clamp(distance, 1, 256) else 28,
					speed = if finite(speed) then math.clamp(speed, 0, 60) else 7,
					original=if previous then previous.original else instance.Transparency,
					last=if previous then previous.last else instance.Transparency,
					alphaOwned=if previous then previous.alphaOwned else true,
				}
			else
				local old=flows[instance]
				if old and old.alphaOwned and math.abs(instance.Transparency-old.last)&lt;.0001 then instance.Transparency=old.original end
				flows[instance] = nil
			end
			local glintPhase = instance:GetAttribute("GlintPhase")
			if finite(glintPhase) and not glints[instance] and not surrenderedGlints[instance] then
				glints[instance] = { part = instance, phase = glintPhase, original = instance.Transparency, last = instance.Transparency }
			elseif finite(glintPhase) and glints[instance] then
				glints[instance].phase = glintPhase
			elseif not finite(glintPhase) then
				local old = glints[instance]
				if old and math.abs(instance.Transparency - old.last) &lt; 0.0001 then instance.Transparency = old.original end
				glints[instance] = nil
			end
		elseif instance:IsA("Model") then
			-- Models can replicate before their attributes and body parts. Keep their listeners
			-- until removal so either arrival order can make the actor ready.
			local root=instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart",true)
			if not root or not root:IsA("BasePart") then
				drifters[instance],boats[instance],swaying[instance],spinners[instance]=nil,nil,nil,nil
				return
			end
			if instance.Name == "SkySail" then
				local origin = instance:GetAttribute("DriftOrigin")
				local previous = drifters[instance]
				if typeof(origin)=="CFrame" then
					if not instance.PrimaryPart and (not previous or previous.origin~=origin) then instance.WorldPivot=origin end
					drifters[instance]={model=instance,part=root,origin=origin,speed=0}
				else drifters[instance]=nil end
			end
			local boatOrigin=instance:GetAttribute("DriftOrigin")
			if instance:GetAttribute("SceneryMotion")=="Boat" and typeof(boatOrigin)=="CFrame" then
				local previous=boats[instance]
				if not instance.PrimaryPart and (not previous or previous.origin~=boatOrigin) then instance.WorldPivot=boatOrigin end
				boats[instance]={model=instance,part=root,origin=boatOrigin,speed=0}
			else boats[instance]=nil end
			local swayOrigin=instance:GetAttribute("SwayOrigin")
			if typeof(swayOrigin)=="CFrame" then
				local amplitude=instance:GetAttribute("SwayAmplitude")
				local previous=swaying[instance]
				-- WorldPivot is NotReplicated. Establish the author-defined local pivot
				-- before the first sway; a pine canopy's bounds center is far above its base.
				if not instance.PrimaryPart and (not previous or previous.origin~=swayOrigin) then instance.WorldPivot=swayOrigin end
				swaying[instance]={model=instance,part=root,origin=swayOrigin,speed=if finite(amplitude) then math.clamp(amplitude,0,.08) else .025}
			else swaying[instance]=nil end
			local rate, origin = instance:GetAttribute("SpinRate"), instance:GetAttribute("SpinOrigin")
			if finite(rate) and typeof(origin) == "CFrame" then
				local previous=spinners[instance]
				if not instance.PrimaryPart and (not previous or previous.origin~=origin) then instance.WorldPivot=origin end
				spinners[instance] = { model = instance, part=root, origin = origin, speed = math.clamp(rate, -3, 3) }
			else
				spinners[instance] = nil
			end
		end
	end

	local function discover(instance: Instance)
		if listeners[instance] then refresh(instance); return end
		local candidate = instance:IsA("Model")
		if instance:IsA("BasePart") then
			-- Restrict readiness listeners to named effect parts, rather than every stone,
			-- plank and leaf in a large map. Attributes already present are also accepted.
			candidate = string.find(instance.Name, "FlowStreak", 1, true) ~= nil
				or string.find(instance.Name, "WaterfallStreak", 1, true) ~= nil
				or instance.Name == "PondWaterfallFoam"
				or string.find(instance.Name, "WaterGlint", 1, true) ~= nil
				or instance:GetAttribute("FlowStart") ~= nil or instance:GetAttribute("GlintPhase") ~= nil
		end
		if candidate then
			listeners[instance] = { instance.AttributeChanged:Connect(function() refresh(instance) end) }
			refresh(instance)
		end
		-- The part may have arrived after the model itself. Refresh animated ancestors,
		-- including a rotor nested inside a larger streamed neighborhood model.
		if instance:IsA("BasePart") then
			local ancestor = instance.Parent
			while ancestor and ancestor ~= world do
				if ancestor:IsA("Model") then refresh(ancestor) end
				ancestor = ancestor.Parent
			end
		end
	end

	local function unbind()
		for _, connection in worldConnections do connection:Disconnect() end
		table.clear(worldConnections)
		local tracked = {}
		for instance in listeners do table.insert(tracked, instance) end
		for _, instance in tracked do forget(instance) end
		world = nil
	end

	local function bind(candidate: Instance)
		if candidate.Name ~= WORLD_NAME or candidate.Parent ~= workspace or candidate == world then return end
		unbind()
		world = candidate
		table.insert(worldConnections, candidate.DescendantAdded:Connect(discover))
		table.insert(worldConnections, candidate.DescendantRemoving:Connect(function(instance)
			forget(instance)
			-- A whole atomic model may leave in one streaming operation.
			if instance:IsA("Model") then
				for _, child in instance:GetDescendants() do forget(child) end
			end
		end))
		table.insert(worldConnections, candidate.AncestryChanged:Connect(function()
			if candidate.Parent ~= workspace and world == candidate then unbind() end
		end))
		for _, instance in candidate:GetDescendants() do discover(instance) end
	end

	workspace.ChildAdded:Connect(bind)
	local existing = workspace:FindFirstChild(WORLD_NAME)
	if existing then bind(existing) end
	local accumulator = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator &lt; STEP then return end
		accumulator %= STEP
		local time = workspace:GetServerTimeNow()
		local camera=workspace.CurrentCamera
		if not camera then return end
		local cameraPosition=camera.CFrame.Position
		local function near(origin: CFrame,radius: number): boolean
			local delta=origin.Position-cameraPosition
			return delta:Dot(delta)&lt;radius*radius
		end
		local function ready(motion: Motion): boolean
			return motion.model.Parent~=nil and motion.part.Parent~=nil and motion.part:IsDescendantOf(motion.model)
		end
		for _, boat in boats do
			if ready(boat) and near(boat.origin,200) then
				boat.model:PivotTo(boat.origin*CFrame.new(0,math.sin(time*1.4)*.12,0)*CFrame.Angles(math.sin(time*.9)*.01,0,math.sin(time*1.1)*.018))
			end
		end
		for _, canopy in swaying do
			if ready(canopy) and near(canopy.origin,110) then
				local phase=canopy.origin.Position.X*.13+canopy.origin.Position.Z*.07
				canopy.model:PivotTo(canopy.origin*CFrame.Angles(math.sin(time*.9+phase)*canopy.speed*.45,0,math.sin(time*1.2+phase)*canopy.speed))
			end
		end
		for _, flow in flows do
			if flow.part.Parent and near(flow.origin,220) then
				local cycle=((time*flow.speed+flow.phase*13)%flow.distance)/flow.distance
				flow.part.CFrame=flow.origin+Vector3.new(0,flow.distance*(.5-cycle),0)
				-- Fade before the wrap rather than teleporting a bright stripe from
				-- the bottom to the top. FlowDistance is the authored CENTER span.
				if flow.alphaOwned and math.abs(flow.part.Transparency-flow.last)&gt;.0001 then flow.alphaOwned=false end
				if flow.alphaOwned then
					local fade=if flow.speed&gt;0 then math.clamp(math.min(cycle,1-cycle)/.09,0,1) else 1
					flow.last=1-(1-flow.original)*fade
					flow.part.Transparency=flow.last
				end
			end
		end
		for _, drift in drifters do
			if ready(drift) and near(drift.origin,750) then
				drift.model:PivotTo(drift.origin * CFrame.new(math.sin(time * 0.09) * 5, math.sin(time * 0.35) * 1.1, 0)
					* CFrame.Angles(0, 0, math.sin(time * 0.23) * 0.025))
			end
		end
		for _, spin in spinners do
			if ready(spin) and near(spin.origin,180) then
				-- Server time is a large Unix timestamp. Reduce it before handing an
				-- angle to CFrame, avoiding large-angle precision jitters.
				spin.model:PivotTo(spin.origin*CFrame.Angles(0,0,(time*spin.speed)%(math.pi*2)))
			end
		end
		for instance, glint in glints do
			-- Stop touching transparency if another client system takes ownership.
			if math.abs(glint.part.Transparency - glint.last) &gt; 0.0001 then
				glints[instance] = nil
				surrenderedGlints[instance] = true
			elseif near(glint.part.CFrame,160) then
				glint.last = math.clamp(glint.original + math.sin(time * 0.8 + glint.phase) * 0.045, 0, 1)
				glint.part.Transparency = glint.last
			end
		end
	end)
end

return Scenery
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000028">
        <Properties>
          <string name="Name">InterfaceLayout</string>
          <ProtectedString name="Source">--!strict
-- Pure layout arithmetic: measured in the ScreenGui's inset-safe canvas.
local Layout = {}
function Layout.measure(width: number, height: number)
	local w, h = math.max(280, width), math.max(240, height)
	local compact = h &lt; 480
	local narrow = w &lt; 660
	local portrait = narrow and not compact
	local panelWidth = if compact then math.min(340, math.max(220, w - 320)) else math.min(360, w - 32)
	local navWidth = if compact then 128 else math.min(156, (w - 92) / 2)
	return {
		width = w, height = h, narrow = narrow, compact = compact,
		panelWidth = panelWidth, panelBottom = if portrait then 152 else 20,
		goalWidth = if narrow then w - 32 else 264,
		goalHeight = if compact then 0 else 64,
		journalY = if compact then 66 elseif narrow then 140 else 150,
		navWidth = navWidth,
		aquariumX = if compact then w - 144 else 24 + navWidth,
		aquariumY = if compact then 66 elseif narrow then 140 else 150,
		soundX = if compact then w - 190 else 32 + navWidth * 2,
		soundY = if compact then 12 elseif narrow then 140 else 150,
		bookWidth = math.min(900, w - 24), bookHeight = math.min(590, h - 24),
		columns = if narrow then 2 else 3,
		cardHeight = if compact then 124 elseif narrow then 150 else 174,
		workshopVertical = narrow and not compact,
		revealWidth = 360, revealHeight = 420,
		revealScale = math.min(1, (w - 24) / 360, (h - 32) / 420),
	}
end
return Layout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000029">
        <Properties>
          <string name="Name">UITheme</string>
          <ProtectedString name="Source">--!strict
local TweenService = game:GetService("TweenService")
local Theme = {
	Ink = Color3.fromRGB(31, 63, 66), Panel = Color3.fromRGB(255, 250, 237),
	Text = Color3.fromRGB(36, 66, 66), Muted = Color3.fromRGB(90, 111, 106),
	Teal = Color3.fromRGB(37, 119, 109), Gold = Color3.fromRGB(246, 190, 81),
	Purple = Color3.fromRGB(118, 87, 166), Blue = Color3.fromRGB(44, 113, 156),
	Line = Color3.fromRGB(226, 227, 209), Soft = Color3.fromRGB(239, 241, 224),
}
function Theme.round(parent: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end
function Theme.frame(parent: Instance, name: string, size: UDim2, position: UDim2, color: Color3?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size, frame.Position = size, position
	frame.BackgroundColor3 = color or Theme.Panel
	frame.BorderSizePixel = 0
	frame.Parent = parent
	Theme.round(frame, 18)
	return frame
end
function Theme.stroke(frame: GuiObject, color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Theme.Line
	stroke.Thickness = thickness or 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame
	return stroke
end
function Theme.surface(frame: GuiObject, _accent: Color3?)
	frame.BackgroundColor3 = Theme.Panel
	Theme.stroke(frame)
end
function Theme.text(parent: Instance, value: string, size: UDim2, position: UDim2, fontSize: number, color: Color3?, bold: boolean?): TextLabel
	local label = Instance.new("TextLabel")
	label.Size, label.Position = size, position
	label.BackgroundTransparency = 1
	label.Text = value
	label.TextSize = fontSize
	label.Font = if bold then Enum.Font.GothamBold else Enum.Font.Gotham
	label.TextColor3 = color or Theme.Text
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.AutoLocalize = false
	label.Parent = parent
	return label
end
function Theme.button(parent: Instance, value: string, size: UDim2, position: UDim2, color: Color3?): TextButton
	local button = Instance.new("TextButton")
	button.Size, button.Position = size, position
	button.BackgroundColor3 = color or Theme.Teal
	button.TextColor3 = Color3.fromRGB(255, 253, 243)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 14
	button.Text = value
	button.AutoLocalize = false
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Parent = parent
	Theme.round(button, 14)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.14), { BackgroundTransparency = 0.12 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.14), { BackgroundTransparency = 0 }):Play()
	end)
	return button
end
-- Drawn locally: no icon asset IDs or image permissions required.
function Theme.coin(parent: Instance, position: UDim2, diameter: number)
	local disc = Theme.frame(parent, "CoinIcon", UDim2.fromOffset(diameter, diameter), position, Theme.Gold)
	Theme.round(disc, diameter)
	local inset = Theme.frame(disc, "Emboss", UDim2.new(1, -8, 1, -8), UDim2.fromOffset(4, 4), Theme.Gold)
	Theme.stroke(inset, Color3.fromRGB(201, 143, 45), 1.5)
	local mark = Theme.text(disc, "+", UDim2.fromScale(1, 1), UDim2.fromOffset(0, -1), diameter * 0.65, Color3.fromRGB(157, 105, 32), true)
	mark.TextXAlignment = Enum.TextXAlignment.Center
end
function Theme.rarity(name: string): Color3
	return if name == "Legendary" then Theme.Gold elseif name == "Epic" then Theme.Purple elseif name == "Rare" then Theme.Blue
		elseif name == "Uncommon" then Theme.Teal else Color3.fromRGB(132, 94, 34)
end
return Theme
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000002A">
        <Properties>
          <string name="Name">FishingInterface</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("FishingShared")
local Catalog = require(Shared:WaitForChild("FishCatalog"))
local Rules = require(Shared:WaitForChild("FishingRules"))
local Fish = require(Shared:WaitForChild("FishModel"))
local Theme = require(script.Parent:WaitForChild("UITheme"))
local Layout = require(script.Parent:WaitForChild("InterfaceLayout"))
local Interface = {}

local function centered(label: TextLabel): TextLabel
	label.TextXAlignment = Enum.TextXAlignment.Center
	return label
end
local function viewport(parent: Instance, name: string, size: UDim2, position: UDim2)
	local view = Instance.new("ViewportFrame")
	view.Name, view.Size, view.Position = name, size, position
	view.BackgroundTransparency = 1
	view.Ambient = Color3.fromRGB(185, 204, 204)
	view.LightColor = Color3.fromRGB(255, 240, 213)
	view.LightDirection = Vector3.new(-1, -1, -2)
	view.Parent = parent
	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.lookAt(Vector3.new(3, 1, -6.5), Vector3.zero)
	camera.FieldOfView = 36
	camera.Parent = view
	view.CurrentCamera = camera
	local world = Instance.new("WorldModel")
	world.Parent = view
	return view, world, camera
end

function Interface.new(playerGui: Instance, audio: any, handlers: any)
	assert(not playerGui:FindFirstChild("MolnfiskarnaFishing"), "Install one fishing interface only.")
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn = "MolnfiskarnaFishing", false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui
	local totalSpecies = #Catalog.Species
	local activeZoneId, activeZoneName = "harbor", "Sundrift Harbor"
	local currentProfile: any = nil
	local function zoneName(id: string?): string
		for _, zone in Catalog.Zones or {} do
			if zone.Id == id then return zone.Name end
		end
		return if id == "harbor" then "Sundrift Harbor" else "Explore the islands"
	end
	local function zoneFound(profile: any): (number, number)
		for _, zone in (if profile then profile.zoneProgress or {} else {}) do
			if zone.id == activeZoneId then return zone.count, zone.total end
		end
		return 0, 3
	end
	local function nextStep(profile: any): string
		if not profile or (profile.catches or 0) == 0 then return "CAST  &gt;  HOLD AT THE BITE  &gt;  RELEASE ON GOLD" end
		if profile.catches == 1 then return "YOUR FIRST FISH IS HOME  ·  OPEN MY AQUARIUM" end
		if (profile.combo or 0) &gt;= 2 then return "FINE+ CHAIN  x" .. profile.combo .. "  ·  KEEP THE RHYTHM" end
		if profile.nextUpgrade and profile.coins &gt;= profile.nextUpgrade.cost then return "YOUR NEXT ROD IS READY  ·  VISIT THE WORKSHOP" end
		local found, total = zoneFound(profile)
		if found &gt;= total then return "POND COLLECTION COMPLETE  ·  TRY ANOTHER PORTAL" end
		return found .. "/" .. total .. " FOUND HERE  ·  " .. profile.species .. "/" .. totalSpecies .. " ACROSS THE ISLANDS"
	end
	-- A small location label leaves the landscape visible, with one wallet chip.
	local location = Theme.frame(gui, "Location", UDim2.fromOffset(208, 48), UDim2.fromOffset(16, 12))
	location.BackgroundTransparency = 0.08
	local locationName = Theme.text(location, "SUNDRIFT HARBOR", UDim2.new(1, -24, 0, 21), UDim2.fromOffset(12, 5), 14, Theme.Ink, true)
	locationName.TextTruncate = Enum.TextTruncate.AtEnd
	local locationSub = Theme.text(location, "3 LOCAL SPECIES TO FIND", UDim2.new(1, -24, 0, 14), UDim2.fromOffset(12, 28), 9, Theme.Muted, true)
	locationSub.TextTruncate = Enum.TextTruncate.AtEnd
	local coins = Theme.frame(gui, "Wallet", UDim2.fromOffset(122, 48), UDim2.new(1, -138, 0, 12))
	Theme.surface(coins)
	Theme.coin(coins, UDim2.fromOffset(10, 10), 28)
	local coinText = Theme.text(coins, "0", UDim2.new(1, -50, 1, 0), UDim2.fromOffset(46, 0), 19, Theme.Ink, true)
	local coinValue = Instance.new("NumberValue")
	coinValue.Parent = gui
	coinValue.Changed:Connect(function(value)
		local amount = math.floor(value + 0.5)
		coinText.Text = if amount &gt;= 1000000 then string.format("%.1fm", amount / 1000000)
			elseif amount &gt;= 10000 then string.format("%.1fk", amount / 1000) else tostring(amount)
	end)
	local coinTween: Tween? = nil
	local soundButton = Theme.button(gui, "SFX", UDim2.fromOffset(44, 48), UDim2.new(1, -190, 0, 12), Theme.Panel)
	soundButton.TextColor3, soundButton.TextSize = Theme.Teal, 11
	soundButton.Activated:Connect(function()
		local muted = audio.toggle()
		soundButton.Text = if muted then "OFF" else "SFX"
		if not muted then audio.ui() end
	end)
	local goalCard = Theme.frame(gui, "Adventure", UDim2.fromOffset(264, 64), UDim2.fromOffset(16, 72))
	Theme.surface(goalCard)
	local goalKicker = Theme.text(goalCard, "NEXT ADVENTURE", UDim2.new(1, -70, 0, 13), UDim2.fromOffset(14, 9), 9, Theme.Teal, true)
	local goalTitle = Theme.text(goalCard, "Land your first fish", UDim2.new(1, -70, 0, 25), UDim2.fromOffset(14, 25), 13, nil, true)
	local goalReward = Theme.text(goalCard, "+10", UDim2.fromOffset(42, 35), UDim2.new(1, -52, 0, 12), 15, Theme.rarity("Common"), true)
	goalReward.TextXAlignment = Enum.TextXAlignment.Right
	local goalTrack = Theme.frame(goalCard, "Progress", UDim2.new(1, -28, 0, 3), UDim2.fromOffset(14, 55), Theme.Line)
	goalTrack.ClipsDescendants = true
	local goalFill = Theme.frame(goalTrack, "Fill", UDim2.fromScale(0, 1), UDim2.fromOffset(0, 0), Theme.Teal)
	local journalButton = Theme.button(gui, "JOURNAL  0/" .. totalSpecies, UDim2.fromOffset(156, 48), UDim2.fromOffset(16, 150), Theme.Ink)
	journalButton.TextSize = 12
	local aquariumButton = Theme.button(gui, "MY AQUARIUM", UDim2.fromOffset(156, 48), UDim2.fromOffset(180, 150), Theme.Teal)
	aquariumButton.TextSize = 12
	aquariumButton.Activated:Connect(function()
		if handlers.openAquarium then audio.ui(); handlers.openAquarium() end
	end)

	local panel = Theme.frame(gui, "CastCard", UDim2.fromOffset(360, 122), UDim2.new(0.5, 0, 1, -20))
	panel.AnchorPoint = Vector2.new(0.5, 1)
	Theme.surface(panel)
	local status = centered(Theme.text(panel, "The water is right ahead. Cast your first line!", UDim2.new(1, -32, 0, 34), UDim2.fromOffset(16, 8), 12, Theme.Muted))
	local meter = Theme.frame(panel, "TimingTrack", UDim2.new(1, -40, 0, 20), UDim2.fromOffset(20, 52), Theme.Ink)
	meter.ClipsDescendants = true
	local timingAreas: { [string]: Frame } = {}
	for _, zone in {
		{"Normal", Rules.NormalMin, Rules.NormalMax, Color3.fromRGB(151, 186, 147)},
		{"Fine", Rules.FineMin, Rules.FineMax, Color3.fromRGB(74, 166, 151)},
		{"Brilliant", Rules.BrilliantMin, Rules.BrilliantMax, Theme.Gold},
	} do
		local area = Instance.new("Frame")
		area.Name, area.Position = zone[1], UDim2.fromScale(zone[2], 0)
		area.Size, area.BackgroundColor3 = UDim2.fromScale(zone[3] - zone[2], 1), zone[4]
		area.BorderSizePixel, area.Parent = 0, meter
		timingAreas[zone[1]] = area
	end
	local function setTimingWindow(center: number?, width: number?)
		local target = math.clamp(center or (Rules.BrilliantMin + Rules.BrilliantMax) / 2, 0.38, 0.79)
		local span = math.clamp(width or (Rules.BrilliantMax - Rules.BrilliantMin), 0.08, 0.22)
		local fineMin, fineMax = math.max(Rules.NormalMin, target - 0.20), math.min(Rules.NormalMax, target + 0.16)
		timingAreas.Fine.Position, timingAreas.Fine.Size = UDim2.fromScale(fineMin, 0), UDim2.fromScale(fineMax - fineMin, 1)
		timingAreas.Brilliant.Position, timingAreas.Brilliant.Size = UDim2.fromScale(target - span / 2, 0), UDim2.fromScale(span, 1)
	end
	local marker = Instance.new("Frame")
	marker.Name, marker.Size = "Needle", UDim2.new(0, 4, 1, 0)
	marker.AnchorPoint, marker.BackgroundColor3 = Vector2.new(0.5, 0), Color3.new(1, 1, 1)
	marker.BorderSizePixel, marker.ZIndex, marker.Parent = 0, 2, meter
	local legend = centered(Theme.text(panel, "AIM FOR GOLD", UDim2.new(1, -32, 0, 18), UDim2.fromOffset(16, 78), 10, Theme.Teal, true))
	local button = Theme.button(panel, "CONNECTING...", UDim2.new(1, -24, 0, 52), UDim2.new(0.5, 0, 0, 46))
	button.AnchorPoint, button.TextSize = Vector2.new(0.5, 0), 16
	local buttonScale = Instance.new("UIScale")
	buttonScale.Parent = button
	local sessionText = centered(Theme.text(panel, "YOUR FIRST DISCOVERY IS WAITING", UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, 101), 9, Theme.Muted))

	local toast = Theme.frame(gui, "Notice", UDim2.fromOffset(340, 54), UDim2.new(0.5, 0, 0, 12), Theme.Ink)
	toast.AnchorPoint, toast.ZIndex, toast.Visible = Vector2.new(0.5, 0), 30, false
	local toastText = centered(Theme.text(toast, "", UDim2.new(1, -28, 1, 0), UDim2.fromOffset(14, 0), 13, Theme.Panel, true))
	local toastGeneration = 0
	local function notify(text: string)
		toastGeneration += 1
		local generation = toastGeneration
		toastText.Text, toast.Visible = text, true
		task.delay(3, function() if toastGeneration == generation then toast.Visible = false end end)
	end
	-- The collection is a gallery, with a separate workshop rather than squeezed controls.
	local modal = Instance.new("Frame")
	modal.Name, modal.Size = "CollectionOverlay", UDim2.fromScale(1, 1)
	modal.BackgroundColor3, modal.BackgroundTransparency = Theme.Ink, 0.26
	modal.BorderSizePixel, modal.ZIndex, modal.Visible, modal.Parent = 0, 10, false, gui
	modal.Active = true
	local book = Theme.frame(modal, "CollectionBook", UDim2.fromOffset(900, 590), UDim2.fromScale(0.5, 0.5))
	book.AnchorPoint, book.ClipsDescendants = Vector2.new(0.5, 0.5), true
	Theme.surface(book)
	local title = Theme.text(book, "The fish collection", UDim2.new(1, -84, 0, 32), UDim2.fromOffset(22, 16), 25, Theme.Ink, true)
	local bookStats = Theme.text(book, "0 of " .. totalSpecies .. " discovered", UDim2.new(1, -44, 0, 20), UDim2.fromOffset(22, 50), 12, Theme.Muted)
	local close = Theme.button(book, "×", UDim2.fromOffset(44, 44), UDim2.new(1, -58, 0, 14), Theme.Soft)
	close.TextColor3, close.TextSize = Theme.Ink, 25
	local collectionTab = Theme.button(book, "Collection", UDim2.new(0.5, -26, 0, 44), UDim2.fromOffset(18, 80), Theme.Ink)
	local workshopTab = Theme.button(book, "Rod workshop", UDim2.new(0.5, -26, 0, 44), UDim2.new(0.5, 8, 0, 80), Theme.Soft)
	workshopTab.TextColor3 = Theme.Ink
	local function scrollFrame(name: string): ScrollingFrame
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name, scroll.Position = name, UDim2.fromOffset(18, 136)
		scroll.Size = UDim2.new(1, -36, 1, -182)
		scroll.BackgroundTransparency, scroll.BorderSizePixel = 1, 0
		scroll.ScrollBarThickness, scroll.ScrollBarImageColor3 = 3, Theme.Teal
		scroll.CanvasSize, scroll.AutomaticCanvasSize = UDim2.fromOffset(0, 0), Enum.AutomaticSize.Y
		scroll.Parent = book
		return scroll
	end
	local collection = scrollFrame("FishGallery")
	local grid = Instance.new("UIGridLayout")
	grid.CellSize, grid.CellPadding = UDim2.new(1 / 3, -8, 0, 174), UDim2.fromOffset(10, 10)
	grid.SortOrder, grid.Parent = Enum.SortOrder.LayoutOrder, collection
	local entries: { [string]: any } = {}
	local selectedId = Catalog.Species[1].Id
	local hint = Theme.text(book, "Select a fish to explore its entry.", UDim2.new(1, -44, 0, 34), UDim2.new(0, 22, 1, -40), 12, Theme.Muted)
	local function selectSpecies(id: string)
		selectedId = id
		for fishId, entry in entries do
			entry.stroke.Color = if fishId == id then Theme.Teal else Theme.Line
			entry.stroke.Thickness = if fishId == id then 2 else 1
		end
		local species = Catalog.get(id)
		local record = if currentProfile and currentProfile.records then currentProfile.records[id] else nil
		local variant = if currentProfile and currentProfile.variants then currentProfile.variants[id] else nil
		local recordText = if record then string.format("Best %.2f kg", record) else species.Hint
		local special = if variant and variant.Prismatic then " · Prismatic found" elseif variant and variant.Golden then " · Golden found" else ""
		hint.Text = species.Name .. " · " .. zoneName(species.Zone) .. "\n" .. recordText .. special
	end
	for index, species in Catalog.Species do
		local card = Theme.button(collection, "", UDim2.fromOffset(200, 174), UDim2.fromOffset(0, 0), Theme.Soft)
		card.Name, card.LayoutOrder = species.Id, index
		local stroke = Theme.stroke(card)
		local view, world = viewport(card, "Portrait", UDim2.new(1, -8, 1, -56), UDim2.fromOffset(4, 0))
		view.Active = false
		local fish = Fish.create(world, nil, species.Id)
		fish:PivotTo(CFrame.Angles(0, -0.24, 0))
		local badge = Theme.frame(card, "RarityDot", UDim2.fromOffset(7, 7), UDim2.fromOffset(12, 12), Theme.rarity(species.Rarity))
		local habitat = Theme.text(card, string.upper(string.split(zoneName(species.Zone), " ")[1]), UDim2.new(1, -32, 0, 14), UDim2.fromOffset(24, 8), 8, Theme.Muted, true)
		habitat.TextTruncate = Enum.TextTruncate.AtEnd
		local name = Theme.text(card, species.Name, UDim2.new(1, -20, 0, 23), UDim2.new(0, 10, 1, -51), 14, Theme.Ink, true)
		local best = Theme.text(card, "Undiscovered", UDim2.new(1, -20, 0, 18), UDim2.new(0, 10, 1, -27), 11, Theme.Muted)
		entries[species.Id] = { view = view, model = fish, status = best, name = name, badge = badge, stroke = stroke, species = species }
		card.Activated:Connect(function() selectSpecies(species.Id); audio.ui() end)
	end
	selectSpecies(selectedId)
	local workshop = scrollFrame("WorkshopPage")
	workshop.Visible = false
	local shopBody = Theme.frame(workshop, "WorkshopContent", UDim2.new(1, -6, 0, 362), UDim2.fromOffset(0, 0), Theme.Panel)
	shopBody.BackgroundTransparency = 1
	local rodStage = Theme.frame(shopBody, "RodStage", UDim2.new(0.4, -12, 0, 230), UDim2.fromOffset(0, 0), Theme.Soft)
	local rodView, rodWorld, rodCamera = viewport(rodStage, "RodPreview", UDim2.fromScale(1, 1), UDim2.fromOffset(0, 0))
	rodCamera.CFrame = CFrame.lookAt(Vector3.new(0, 0, -11), Vector3.zero)
	local rod = Instance.new("Model")
	local function rodPart(name: string, size: Vector3, cf: CFrame, color: Color3)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color = name, size, cf, color
		p.Anchored, p.CanCollide, p.Material, p.Parent = true, false, Enum.Material.SmoothPlastic, rod
		return p
	end
	local grip = rodPart("Grip", Vector3.new(0.28, 1.5, 0.28), CFrame.new(0, -1.7, 0), Color3.fromRGB(133, 91, 59))
	rod.PrimaryPart = grip
	rodPart("Shaft", Vector3.new(0.1, 4.6, 0.1), CFrame.new(0, 1.1, 0), Theme.Teal)
	local reelPart = rodPart("Reel", Vector3.new(0.7, 0.7, 0.34), CFrame.new(0.32, -1.4, -0.1), Theme.Gold)
	reelPart.Shape = Enum.PartType.Cylinder
	for y = -1, 3, 0.8 do rodPart("Binding", Vector3.new(0.16, 0.08, 0.16), CFrame.new(0, y, 0), Theme.Gold) end
	-- Set a central model pivot before rotating it as a unit.
	rod.PrimaryPart = nil
	rod.WorldPivot = CFrame.identity
	rod.Parent = rodWorld
	rod:PivotTo(CFrame.Angles(0, 0, -0.4))
	local equipped = centered(Theme.text(rodStage, "EQUIPPED · DRIFTWOOD", UDim2.new(1, -16, 0, 26), UDim2.new(0, 8, 1, -32), 10, Theme.Teal, true))
	local shopInfo = Theme.frame(shopBody, "UpgradeDetails", UDim2.new(0.6, -8, 0, 230), UDim2.new(0.4, 8, 0, 0), Theme.Panel)
	shopInfo.BackgroundTransparency = 1
	Theme.text(shopInfo, "YOUR NEXT UPGRADE", UDim2.new(1, 0, 0, 20), UDim2.fromOffset(0, 8), 10, Theme.Teal, true)
	local upgradeName = Theme.text(shopInfo, "Breeze Rod", UDim2.new(1, 0, 0, 38), UDim2.fromOffset(0, 30), 27, Theme.Ink, true)
	local upgradeDesc = Theme.text(shopInfo, "Unlock more fish and earn extra coins.", UDim2.new(1, 0, 0, 58), UDim2.fromOffset(0, 75), 14, Theme.Muted)
	local upgradeButton = Theme.button(book, "Upgrade · 32 coins", UDim2.new(1, -36, 0, 48), UDim2.new(0, 18, 1, -62))
	upgradeButton.Visible = false
	upgradeButton.Activated:Connect(function()
		local nextRod = if currentProfile then currentProfile.nextUpgrade else nil
		if not nextRod then return end
		if currentProfile.coins &lt; nextRod.cost then
			audio.ui(false)
			notify("Just " .. (nextRod.cost - currentProfile.coins) .. " more coins to go!")
			return
		end
		handlers.upgrade()
	end)
	local income = Theme.frame(shopBody, "OfflineIncome", UDim2.new(1, 0, 0, 100), UDim2.fromOffset(0, 248), Theme.Soft)
	Theme.text(income, "A little gift for your next visit", UDim2.new(1, -32, 0, 27), UDim2.fromOffset(16, 10), 15, Theme.Teal, true)
	local incomeText = Theme.text(income, "Discover fish to earn coins while you are away.", UDim2.new(1, -32, 0, 52), UDim2.fromOffset(16, 40), 12, Theme.Muted)
	local tab = "Collection"
	local function setTab(nextTab: string)
		tab = nextTab
		collection.Visible, workshop.Visible = tab == "Collection", tab == "Workshop"
		collectionTab.BackgroundColor3 = if collection.Visible then Theme.Ink else Theme.Soft
		collectionTab.TextColor3 = if collection.Visible then Theme.Panel else Theme.Ink
		workshopTab.BackgroundColor3 = if workshop.Visible then Theme.Ink else Theme.Soft
		workshopTab.TextColor3 = if workshop.Visible then Theme.Panel else Theme.Ink
		hint.Visible = collection.Visible
		upgradeButton.Visible = workshop.Visible
		title.Text = if collection.Visible then "The fish collection" else "Rod &amp; Reel"
	end
	collectionTab.Activated:Connect(function() setTab("Collection"); audio.ui() end)
	workshopTab.Activated:Connect(function() setTab("Workshop"); audio.ui() end)
	local function openJournal(target: string?)
		setTab(if target == "Workshop" then "Workshop" else "Collection")
		handlers.openJournal()
		audio.ui()
		modal.Visible, panel.Visible = true, false
	end
	journalButton.Activated:Connect(function() openJournal("Collection") end)
	close.Activated:Connect(function() audio.ui(); modal.Visible, panel.Visible = false, true end)

	local reveal = Theme.frame(gui, "DiscoveryCard", UDim2.fromOffset(360, 420), UDim2.fromScale(0.5, 0.48))
	reveal.AnchorPoint, reveal.ZIndex, reveal.Visible = Vector2.new(0.5, 0.5), 5, false
	Theme.surface(reveal)
	local revealScale = Instance.new("UIScale")
	revealScale.Parent = reveal
	local revealTitle = centered(Theme.text(reveal, "A FRESH CATCH", UDim2.new(1, -64, 0, 22), UDim2.fromOffset(32, 18), 11, Theme.Teal, true))
	local halo = Theme.frame(reveal, "PortraitHalo", UDim2.fromOffset(160, 160), UDim2.new(0.5, -80, 0, 49), Theme.Soft)
	Theme.round(halo, 100)
	local view, fishWorld = viewport(reveal, "CatchPortrait", UDim2.new(1, 0, 0, 176), UDim2.fromOffset(0, 39))
	local revealFish: Model? = nil
	local revealName = centered(Theme.text(reveal, "Pufflet", UDim2.new(1, -32, 0, 36), UDim2.fromOffset(16, 213), 27, Theme.Ink, true))
	local revealQuality = centered(Theme.text(reveal, "Common · Normal", UDim2.new(1, -32, 0, 22), UDim2.fromOffset(16, 250), 12, Theme.Muted))
	local revealWeight = centered(Theme.text(reveal, "1.00 kg", UDim2.new(1, -32, 0, 24), UDim2.fromOffset(16, 278), 15, Theme.Teal, true))
	local earnings = Theme.frame(reveal, "Earnings", UDim2.new(1, -40, 0, 40), UDim2.fromOffset(20, 310), Theme.Soft)
	Theme.coin(earnings, UDim2.fromOffset(14, 7), 26)
	local revealCoins = centered(Theme.text(earnings, "+8 coins", UDim2.new(1, -58, 1, 0), UDim2.fromOffset(46, 0), 16, Theme.Ink, true))
	local closeReveal = Theme.button(reveal, "×", UDim2.fromOffset(44, 44), UDim2.new(1, -48, 0, 3), Theme.Panel)
	closeReveal.TextColor3, closeReveal.TextSize = Theme.Muted, 23
	local revealAquarium = Theme.button(reveal, "MY AQUARIUM", UDim2.fromOffset(154, 46), UDim2.fromOffset(20, 360), Theme.Soft)
	revealAquarium.TextColor3, revealAquarium.TextSize = Theme.Ink, 11
	local revealContinue = Theme.button(reveal, "CAST AGAIN", UDim2.fromOffset(154, 46), UDim2.fromOffset(186, 360), Theme.Teal)
	revealContinue.TextSize = 12
	local revealGeneration, revealBaseScale = 0, 1
	local revealTween: Tween? = nil
	local function hideResult()
		revealGeneration += 1
		if revealTween then revealTween:Cancel() end
		reveal.Visible, panel.Visible = false, not modal.Visible
	end
	closeReveal.Activated:Connect(hideResult)
	revealContinue.Activated:Connect(function()
		hideResult()
		if handlers.castAgain then handlers.castAgain() end
	end)
	revealAquarium.Activated:Connect(function()
		hideResult()
		if handlers.openAquarium then audio.ui(); handlers.openAquarium() end
	end)
	local lastPhase = ""
	local panelWidth = 360
	local panelTween: Tween? = nil
	local function updateLocation(nextLocation: any, profile: any?)
		if type(nextLocation) == "table" then
			if type(nextLocation.zoneId) == "string" then activeZoneId = nextLocation.zoneId end
			if type(nextLocation.zoneName) == "string" then activeZoneName = nextLocation.zoneName else activeZoneName = zoneName(activeZoneId) end
		end
		local data = profile or currentProfile
		local found, total = zoneFound(data)
		locationName.Text = string.upper(activeZoneName)
		locationSub.Text = found .. "/" .. total .. " LOCAL SPECIES FOUND"
		sessionText.Text = nextStep(data)
	end
	local function setState(phase: string)
		if phase == lastPhase then return end
		lastPhase = phase
		local reeling = phase == "Reeling"
		meter.Visible, legend.Visible, marker.Visible = reeling, reeling, reeling
		button.Position = UDim2.new(0.5, 0, 0, if reeling then 104 else 46)
		sessionText.Position = UDim2.fromOffset(12, if reeling then 159 else 101)
		if panelTween then panelTween:Cancel() end
		panelTween = TweenService:Create(panel, TweenInfo.new(0.18, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(panelWidth, if reeling then 180 else 122) })
		panelTween:Play()
	end
	local function updateProfile(profile: any)
		if not profile then return end
		if not currentProfile or profile.coins ~= currentProfile.coins then
			if coinTween then coinTween:Cancel() end
			coinTween = TweenService:Create(coinValue, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Value = profile.coins })
			coinTween:Play()
		end
		currentProfile = profile
		journalButton.Text = "JOURNAL  " .. profile.species .. "/" .. totalSpecies
		updateLocation(nil, profile)
		bookStats.Text = profile.species .. " / " .. totalSpecies .. " fish found   ·   " .. profile.points .. " / " .. totalSpecies * 3 .. " collection points"
		equipped.Text = "EQUIPPED · " .. string.upper(profile.rod)
		incomeText.Text = if profile.persistent then "Your fish earn " .. profile.offlineRate .. " coins/min while you are away. Up to 120 coins over 8 hours. Progress saves automatically."
			else "Offline earnings start in the published game. This Studio playtest uses temporary progress."
		goalTitle.Text = profile.goal.title
		goalKicker.Text = (if (profile.catches or 0) &lt; 3 then "FIRST STEPS" else "NEXT ADVENTURE") .. "  ·  " .. profile.goal.progress .. "/" .. profile.goal.target
		goalReward.Text = "+" .. profile.goal.reward
		TweenService:Create(goalFill, TweenInfo.new(0.35), { Size = UDim2.fromScale(math.clamp(profile.goal.progress / math.max(1, profile.goal.target), 0, 1), 1) }):Play()
		for id, entry in entries do
			local best = profile.best[id]
			entry.view.ImageColor3 = if best then Color3.new(1, 1, 1) else Color3.fromRGB(83, 112, 108)
			entry.view.ImageTransparency = if best then 0 else 0.45
			entry.name.Text = if best then entry.species.Name else "???"
			local record = if profile.records then profile.records[id] else nil
			entry.status.Text = if best and record then string.format("%.2f kg · %s", record, ({"Normal", "Fine", "Brilliant"})[best])
				elseif best then entry.species.Rarity .. " · " .. ({"Normal", "Fine", "Brilliant"})[best]
				elseif entry.species.Level &gt; profile.level then "Needs " .. Catalog.Rods[entry.species.Level + 1].Name else zoneName(entry.species.Zone)
		end
		selectSpecies(selectedId)
		local nextRod = profile.nextUpgrade
		upgradeName.Text = if nextRod then nextRod.name else "Beautifully equipped"
		upgradeDesc.Text = if nextRod then nextRod.description else "Your rod is fully upgraded. Find every fish and chase Brilliant catches."
		upgradeButton.Text = if nextRod then "Upgrade · " .. nextRod.cost .. " coins" else "Fully upgraded"
		upgradeButton.BackgroundColor3 = if nextRod and profile.coins &gt;= nextRod.cost then Theme.Teal else Theme.Muted
	end
	local function showResult(result: any)
		revealGeneration += 1
		local generation = revealGeneration
		audio.catch(result.quality, result.rarity, result.newDiscovery)
		task.delay(0.65, function()
			if generation ~= revealGeneration or modal.Visible then return end
			if revealFish then revealFish:Destroy() end
			revealFish = Fish.create(fishWorld, nil, result.speciesId)
			if Fish.applyAppearance then Fish.applyAppearance(revealFish, result.variant, nil) end
			local variant = if result.variant and result.variant ~= "Normal" then result.variant else nil
			local accent = if variant == "Prismatic" then Theme.Purple elseif variant == "Golden" then Theme.Gold else Theme.rarity(result.rarity or "Common")
			revealTitle.Text = if variant then string.upper(variant) .. " CATCH" elseif result.newDiscovery then "A NEW DISCOVERY" elseif result.newRecord then "YOUR NEW SIZE RECORD" elseif result.improved then "YOUR NEW BEST GRADE" else "A FRESH CATCH"
			revealTitle.TextColor3 = accent
			halo.BackgroundColor3 = accent:Lerp(Theme.Panel, 0.86)
			revealName.Text = result.species
			revealQuality.Text = (result.rarity or "Common") .. " · " .. result.quality .. (if (result.combo or 0) &gt;= 2 then " · x" .. result.combo .. " CHAIN" else "")
			revealWeight.Text = string.format("%.2f kg", result.weightKg or 1) .. (if result.newRecord then "  ·  NEW RECORD" else "")
			local bonus = result.goalBonus or 0
			revealCoins.Text = "+" .. (result.coins or 0) .. " coins" .. (if bonus &gt; 0 then "  +" .. bonus .. " bonus" else "")
			panel.Visible, reveal.Visible = false, true
			revealScale.Scale = revealBaseScale * 0.85
			if revealTween then revealTween:Cancel() end
			revealTween = TweenService:Create(revealScale, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = revealBaseScale })
			revealTween:Play()
			task.delay(if result.newDiscovery or variant then 2.8 else 1.4, function() if generation == revealGeneration then hideResult() end end)
		end)
	end
	local lastWidth, lastHeight = 0, 0
	local function animate(time: number, width: number, height: number)
		if reveal.Visible and revealFish then
			revealFish:PivotTo(CFrame.Angles(0, math.sin(time * 1.3) * 0.24, math.sin(time * 2) * 0.035))
			Fish.animate(revealFish, time)
		end
		if modal.Visible and collection.Visible then
			local entry = entries[selectedId]
			entry.model:PivotTo(CFrame.Angles(0, -0.24 + math.sin(time) * 0.18, math.sin(time * 1.5) * 0.035))
			Fish.animate(entry.model, time)
		end
		local canvas = gui.AbsoluteSize
		local safeWidth = if canvas.X &gt; 0 then canvas.X else width
		local safeHeight = if canvas.Y &gt; 0 then canvas.Y else height
		if safeWidth == lastWidth and safeHeight == lastHeight then return end
		lastWidth, lastHeight = safeWidth, safeHeight
		if panelTween then panelTween:Cancel() end
		if revealTween then revealTween:Cancel() end
		local layout = Layout.measure(safeWidth, safeHeight)
		location.Size = UDim2.fromOffset(math.min(208, layout.width - (if layout.compact then 218 else 162)), 48)
		locationName.TextSize = if layout.narrow then 11 else 14
		locationSub.TextSize = if layout.narrow then 8 else 9
		goalCard.Size, goalCard.Visible = UDim2.fromOffset(layout.goalWidth, 64), not layout.compact
		journalButton.Position = UDim2.fromOffset(16, layout.journalY)
		journalButton.Size = UDim2.fromOffset(layout.navWidth, 48)
		journalButton.TextSize = if layout.narrow then 11 else 12
		aquariumButton.Position, aquariumButton.Size = UDim2.fromOffset(layout.aquariumX, layout.aquariumY), UDim2.fromOffset(layout.navWidth, 48)
		aquariumButton.TextSize = if layout.narrow then 10 else 12
		soundButton.Position = UDim2.fromOffset(layout.soundX, layout.soundY)
		panelWidth = layout.panelWidth
		panel.Size = UDim2.fromOffset(panelWidth, if lastPhase == "Reeling" then 180 else 122)
		panel.Position = UDim2.new(0.5, 0, 1, -layout.panelBottom)
		book.Size = UDim2.fromOffset(layout.bookWidth, layout.bookHeight)
		title.TextSize = if layout.narrow or layout.compact then 20 else 25
		bookStats.Visible = not layout.compact
		collectionTab.Position = UDim2.fromOffset(18, if layout.compact then 50 else 80)
		workshopTab.Position = UDim2.new(0.5, 8, 0, if layout.compact then 50 else 80)
		local contentY = if layout.compact then 108 else 136
		collection.Position, collection.Size = UDim2.fromOffset(18, contentY), UDim2.new(1, -36, 1, -contentY - 46)
		workshop.Position, workshop.Size = UDim2.fromOffset(18, contentY), UDim2.new(1, -36, 1, -contentY - 78)
